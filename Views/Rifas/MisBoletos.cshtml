            <div class="modal-body p-4 bg-light">
                @if (!string.IsNullOrEmpty(Model.InfoRifa.EnlaceCompra))
                {
                    <div class="mb-3 p-3 bg-white border rounded-3 shadow-sm">
                        <label class="text-muted fw-bold small mb-2"><i class="fa-solid fa-link text-primary me-1"></i> Enlace Público de Venta</label>
                        <div class="d-flex align-items-center bg-light border rounded-2 p-1">
                            <input type="text" class="form-control border-0 bg-transparent text-dark fw-bold px-2 shadow-none w-100" readonly value="@Model.InfoRifa.EnlaceCompra" style="font-size: 0.75rem;">
                            <button type="button" class="btn border-0 rounded-1 d-flex align-items-center justify-content-center flex-shrink-0"
                                    onclick="copiarTexto('@Model.InfoRifa.EnlaceCompra', 'iconoLinkCompra')"
