@model RedAJP.Models.IglesiaWebPublicaViewModel

<style>
    .nav-clasico {
        background-color: var(--theme-surface);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        padding: 1rem 0;
        border-bottom: 1px solid rgba(128, 128, 128, 0.1);
    }

        .nav-clasico .navbar-brand {
            color: var(--theme-primary) !important;
            font-family: var(--theme-font-title);
            font-weight: 800;
            font-size: 1.5rem;
        }

        .nav-clasico .nav-link {
            color: var(--theme-text-main) !important;
            font-family: var(--theme-font-body);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 0.5px;
            transition: color 0.3s;
        }

            .nav-clasico .nav-link:hover {
                color: var(--theme-accent) !important;
            }

        .nav-clasico .btn-nav {
            background-color: var(--theme-accent) !important;
            color: var(--theme-bg) !important; /* Texto dinámico */
            border-radius: 50px;
            font-weight: 600;
            padding: 0.5rem 1.5rem;
        }
</style>

<nav class="navbar navbar-expand-lg nav-clasico sticky-top">
    <div class="container">
        <a class="navbar-brand text-truncate" style="max-width: 250px;" href="#">
            <i class="fa-solid fa-church me-2" style="color: var(--theme-accent);"></i>
            @(string.IsNullOrWhiteSpace(Model.NombreIglesia) ? "Nuestra Iglesia" : Model.NombreIglesia)
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navClasicoCollapse">
            <i class="fa-solid fa-bars" style="color: var(--theme-text-main);"></i>
        </button>
        <div class="collapse navbar-collapse" id="navClasicoCollapse">
            <ul class="navbar-nav ms-auto align-items-center gap-2">
                <li class="nav-item"><a class="nav-link" href="#nosotros">Nosotros</a></li>
                <li class="nav-item"><a class="nav-link" href="#actividad">Actividades</a></li>
                <li class="nav-item"><a class="nav-link" href="#galeria">Galería</a></li>
                <li class="nav-item ms-lg-3">
                    <a href="#contacto" class="nav-link btn-nav">Contacto</a>
                </li>
            </ul>
        </div>
    </div>
</nav>