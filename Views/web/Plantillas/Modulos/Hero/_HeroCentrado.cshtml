@model RedAJP.Models.IglesiaWebPublicaViewModel
@{
    string heroBg = Model.Galeria != null && Model.Galeria.Any() && !string.IsNullOrWhiteSpace(Model.Galeria.First().UrlImagen)
                    ? Model.Galeria.First().UrlImagen
                    : "https://via.placeholder.com/1920x1080?text=Fondo+de+Cabecera";
}

<style>
    .hero-centrado {
        height: 85vh;
        min-height: 600px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        position: relative;
        background: url('@Html.Raw(heroBg)') center/cover no-repeat;
        background-color: var(--theme-primary);
    }

    .hero-centrado-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.8));
        z-index: 1;
    }

    .hero-centrado-content {
        position: relative;
        z-index: 2;
        color: #ffffff;
        padding: 0 20px;
        max-width: 900px;
        width: 100%;
    }

    .hero-centrado-title {
        color: #ffffff;
        font-family: var(--theme-font-title);
        font-size: clamp(3rem, 6vw, 5rem);
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 1rem;
        text-transform: uppercase;
    }

    .hero-centrado-subtitle {
        color: rgba(255,255,255,0.9);
        font-family: var(--theme-font-body);
        font-size: clamp(1.1rem, 2vw, 1.4rem);
        font-weight: 300;
        margin-bottom: 2.5rem;
    }

    .hero-btn-primary {
        background-color: var(--theme-accent);
        color: #ffffff !important;
        border-radius: 50px;
        padding: 14px 36px;
        font-family: var(--theme-font-body);
        font-weight: bold;
        text-decoration: none;
        transition: transform 0.3s;
    }

        .hero-btn-primary:hover {
            transform: translateY(-3px);
        }

    .hero-btn-outline {
        border: 2px solid #ffffff;
        color: #ffffff;
        background-color: transparent;
        border-radius: 50px;
        padding: 12px 32px;
        font-family: var(--theme-font-body);
        font-weight: bold;
        text-decoration: none;
        transition: all 0.3s;
    }

        .hero-btn-outline:hover {
            background: #ffffff;
            color: #000000 !important; /* Siempre negro al hacer hover para no chocar con el tema */
        }
</style>

<header class="hero-centrado fade-in-up">
    <div class="hero-centrado-overlay"></div>
    <div class="container hero-centrado-content">
        <span class="badge mb-3 px-3 py-2 rounded-pill fw-bold" style="background-color: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); color: #ffffff;">
            <i class="fa-solid fa-location-dot me-1" style="color: var(--theme-accent);"></i> @(string.IsNullOrWhiteSpace(Model.Municipio) ? "Ubicación Global" : Model.Municipio)
        </span>

        <h1 class="hero-centrado-title">@(string.IsNullOrWhiteSpace(Model.NombreIglesia) ? "Nuestra Congregación" : Model.NombreIglesia)</h1>

        <p class="hero-centrado-subtitle">
            Un espacio para conectar, crecer y adorar juntos. Descubre nuestra historia, horarios y eventos.
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-3">
            @if (!string.IsNullOrWhiteSpace(Model.Whatsapp))
            {
                <a href="https://wa.me/52@(Model.Whatsapp)" target="_blank" class="hero-btn-primary">
                    <i class="fa-brands fa-whatsapp me-2 fs-5"></i> Escríbenos
                </a>
            }
            <a href="#actividad" class="hero-btn-outline">Ver Actividades</a>
        </div>
    </div>
</header>