            <style>
                /* Estilizar Select2 para que se vea redondeado y bonito como los inputs de Bootstrap */
                #modalVinculacion .select2-container--default .select2-selection--single {
                    border-radius: 50rem; /* Forma de píldora */
                    height: 50px;
                    display: flex;
                    align-items: center;
                    border: 1px solid #ced4da;
                    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
                }

                    #modalVinculacion .select2-container--default .select2-selection--single .select2-selection__rendered {
                        padding-left: 20px;
                        color: #495057;
                        font-size: 1.1rem;
                    }

                    #modalVinculacion .select2-container--default .select2-selection--single .select2-selection__arrow {
                        height: 50px;
                        right: 15px;
                    }

                #modalVinculacion .select2-dropdown {
                    border-radius: 1rem;
                    border: 1px solid #ced4da;
                    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
                    overflow: hidden;
                }
                /* Quitar borde negro al enfocar */
                #modalVinculacion .select2-container--default.select2-container--focus .select2-selection--single {
                    border-color: #86b7fe;
                    outline: 0;
                }
            </style>

            <link href="~/lib/select2/select2.min.css" rel="stylesheet" />
            <script src="~/lib/select2/select2.min.js"></script>

            <script>
                $(document).ready(function () {
                    // 1. Configuración inicial y Select2
                    $('body').css('overflow', 'hidden');

                    $.get('@Url.Action("ObtenerCatalogos", "Vinculacion")', function (data) {
                        // Forzamos un elemento vacío al inicio para que el placeholder funcione y no preseleccione
                        data.iglesias.unshift({ id: '', text: '' });

                        var selectIglesia = $('#selectIglesiaVinculacion').select2({
                            data: data.iglesias,
                            placeholder: "🔍 Buscar congregación...",
                            allowClear: true,
                            dropdownParent: $('#modalVinculacion'),
                            width: '100%'
                        });
                        // Aseguramos que inicie en blanco
                        selectIglesia.val(null).trigger('change');

                        $('#v_municipio').select2({
                            data: data.municipios,
                            placeholder: "Seleccionar Municipio *",
                            dropdownParent: $('#modalVinculacion'),
                            width: '100%'
                        });
                        $('#v_municipio').val(null).trigger('change');
                    });

                    // 2. Navegación: Ir a registrar Nueva Iglesia
                    $('#btnIrNuevaIglesia').click(function () {
                        $('#vistaBienvenida').fadeOut(150, function() {
                            $('#selectIglesiaVinculacion').val(null).trigger('change');
                            // Si el panel de horarios está vacío, no hacemos nada hasta que abran el acordeón
                            $('#vistaNuevaIglesia').fadeIn(250);
                        });
                    });

                    // 3. Navegación: Volver a la lista de Iglesias
                    $('#btnVolverVistaA').click(function () {
                        $('#vistaNuevaIglesia').fadeOut(150, function() {
                            $('#formNuevaIglesia')[0].reset();
                            $('#v_municipio').val(null).trigger('change');
                            $('#contenedor-horarios-vinculacion').empty();
                            $('#seccionOpcional').collapse('hide'); // Cerramos el acordeón por si quedó abierto

                            $('#textoBienvenidaVinculacion')
                                .html('<strong>Si registras una nueva iglesia, pasará por una breve revisión.</strong><br><span class="fs-6 text-muted">Te sugerimos buscarla primero en la lista. Si tu congregación ya está registrada, la nueva solicitud no podrá ser aprobada para evitar duplicados.</span>')
                                .removeClass('text-muted')
                                .addClass('text-warning');

                            $('#vistaBienvenida').fadeIn(250);
                        });
                    });

                    // 4. Enviar: Formulario Existente (Automático por el botón de submit, solo evitamos re-clicks)
                    $('#formVinculacionExistente').on('submit', function() {
                        $('#btnElegirIglesia').html('<i class="fa-solid fa-spinner fa-spin me-2"></i> Procesando...').prop('disabled', true);
                        $('#btnIrNuevaIglesia').prop('disabled', true);
                    });

                    // 5. Enviar: Formulario de Nueva Iglesia
                    $('#formNuevaIglesia').on('submit', function (e) {
                        let horariosFinal = [];
                        $('#contenedor-horarios-vinculacion .horario-row').each(function() {
                            let d = $(this).find('.horario-dia').val().trim();
                            let h = $(this).find('.horario-hora').val().trim();
                            let a = $(this).find('.horario-act').val().trim();

                            if(h !== '' && a !== '') {
                                h = h.replace(/\|/g, '-');
                                a = a.replace(/\|/g, '-');
                                horariosFinal.push(`${d} | ${h} | ${a}`);
                            }
                        });

                        // VALIDACIÓN CLIENTE
                        if (horariosFinal.length === 0) {
                            e.preventDefault(); // Detenemos el envío
                            $('#errorHorarios').slideDown();
                            return;
                        } else {
                            $('#errorHorarios').slideUp();
                        }

                        // Pasamos los horarios armados al input hidden
                        $('#v_horarios_hidden').val(horariosFinal.join('\n'));

                        // Bloqueamos botón para evitar doble submit
                        $('#btnEnviarNuevaIglesia').html('<i class="fa-solid fa-spinner fa-spin me-2"></i> Procesando...').prop('disabled', true);
                    });


                    $('#seccionOpcional').on('hide.bs.collapse', function () {
                        $('#iconoColapso').css('transform', 'rotate(0deg)');
                    });
                });

                // 8. Funciones auxiliares para la tabla de horarios (Afuera del document.ready para que el onClick del HTML las vea)
                function agregarHorarioVinculacion(dia = 'Domingo', hora = '', act = '') {
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = document.getElementById('template-horario-vinculacion').innerHTML;
                    const row = tempDiv.firstElementChild;

                    row.querySelector('.horario-dia').value = dia;
                    row.querySelector('.horario-hora').value = hora;
                    row.querySelector('.horario-act').value = act;

                    document.getElementById('contenedor-horarios-vinculacion').appendChild(row);
                }

                function eliminarHorarioVinculacion(btn) {
                    $(btn).closest('.horario-row').remove();
                }
            </script>
        }
    }


    </body>
</html>
