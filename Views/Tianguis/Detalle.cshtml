<div class="modal fade" id="modalReserva" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="fa-solid fa-boxes-packing text-warning me-2"></i> Confirmar Reserva
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="@Url.Action("ReservarStock", "Tianguis")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p class="text-muted mb-4">
                        Vas a reservar para <strong id="modalReservaAlias" class="text-dark"></strong>. Confirma o ajusta el pedido.
                    </p>

                    <input type="hidden" name="idInteresado" id="modalReservaIdInteresado" />
                    <input type="hidden" name="idPublicacion" value="@Model.IdPublicacion" />

                    @if (Model.TipoVenta == "TIE" && Model.Tallas != null && Model.Tallas.Count > 0)
                    {
                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold text-dark small text-uppercase">Talla a Reservar:</label>
                            <select name="nuevaTalla" id="modalReservaTalla" class="form-select border shadow-sm" required>
                                <option value="" disabled selected>Selecciona una Talla...</option>
                                @foreach (var t in Model.Tallas)
                                {
                                    <option value="@t.IdTalla" data-stock="@t.Stock" disabled="@(t.Stock == 0 ? "disabled" : null)">
                                        Talla @t.NombreTalla @(t.Stock == 0 ? "(Agotada)" : $"- {t.Stock} disp.")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold text-dark small text-uppercase">Cantidad:</label>
                            <input type="number" name="nuevaCantidad" id="modalReservaCantidad" class="form-control border shadow-sm" value="1" min="1" required>
                        </div>
                    }
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold text-dark shadow-sm">Confirmar Reserva</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
        function abrirModalReserva(idInteresado, alias, idTalla, cantidad) {
        // 1. Cargar los datos ocultos
        document.getElementById('modalReservaIdInteresado').value = idInteresado;
        document.getElementById('modalReservaAlias').innerText = alias;

        var selectTalla = document.getElementById('modalReservaTalla');
        var inputCantidad = document.getElementById('modalReservaCantidad');

        if (selectTalla && inputCantidad) {

            // 2. Pre-seleccionar la talla original si existe
            if (idTalla) {
                selectTalla.value = idTalla;
            } else {
                selectTalla.selectedIndex = 0; // Reset a default si no trae talla
            }

            // 3. Forzar el evento "change" para que corra tu lógica de max_stock
            var evt = new Event('change');
            selectTalla.dispatchEvent(evt);

            // 4. Pre-llenar la cantidad asegurándonos de que no exceda el stock actual disponible
            if (cantidad) {
                var maxStock = parseInt(inputCantidad.max) || 999;
                // Si el comprador pidió 3, pero ya solo quedan 2, el modal te protegerá pre-llenando "2"
                inputCantidad.value = Math.min(parseInt(cantidad), maxStock);
            }
        }

        // 5. Mostrar el modal
        var modal = new bootstrap.Modal(document.getElementById('modalReserva'));
        modal.show();
    }
</script>
@if (Model.EsMio)
{
    <script>
        function toggleVista() {
            var vistaDueno = document.getElementById('vista-dueno');
            var vistaPublica = document.getElementById('vista-publica');
            var btn = document.getElementById('btnToggleVista');

            if (vistaDueno.style.display === 'none') {
                vistaDueno.style.display = 'block';
                vistaPublica.style.display = 'none';
                btn.innerHTML = '<i class="fa-regular fa-eye me-1"></i> Ver como público';
                btn.classList.replace('btn-primary', 'btn-outline-secondary');
            } else {
                vistaDueno.style.display = 'none';
                vistaPublica.style.display = 'flex'; // Usamos flex porque es un row de bootstrap
                btn.innerHTML = '<i class="fa-solid fa-unlock-keyhole me-1"></i> Volver a panel de dueño';
                btn.classList.replace('btn-outline-secondary', 'btn-primary');
            }
        }
    </script>
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // 1. AUTO-SCROLL AL CARGAR
        function hacerScrollAbajo(contenedor) {
            if(contenedor) {
                contenedor.scrollTop = contenedor.scrollHeight;
            }
        }

        var chatBoxComprador = document.getElementById("chatBoxComprador");
        var chatBoxDueno = document.getElementById("chatBoxDueno");
        var chatBoxActual = chatBoxDueno || chatBoxComprador;
        hacerScrollAbajo(chatBoxActual);

        // Control de stock máximo para la vista principal
        var selectTalla = document.getElementById('selectTalla');
        var inputCantidad = document.getElementById('inputCantidad');

        if (selectTalla && inputCantidad) {
            selectTalla.addEventListener('change', function () {
                 var selectedOption = this.options[this.selectedIndex];
                 var maxStock = selectedOption.getAttribute('data-stock');
                if (maxStock) {
                    inputCantidad.max = maxStock;
                    if (parseInt(inputCantidad.value) > parseInt(maxStock)) inputCantidad.value = maxStock;
                }
            });
        }

        // Control de stock máximo dinámico para el Modal de Reserva
        var modalReservaTalla = document.getElementById('modalReservaTalla');
        var modalReservaCantidad = document.getElementById('modalReservaCantidad');

        if (modalReservaTalla && modalReservaCantidad) {
            modalReservaTalla.addEventListener('change', function () {
                var selectedOption = this.options[this.selectedIndex];
                if (selectedOption && !selectedOption.disabled) {
                    var maxStock = selectedOption.getAttribute('data-stock');
                    if (maxStock) {
                        // 1. Establecer el nuevo tope máximo
                        modalReservaCantidad.max = maxStock;

                        // 2. Si lo que ya estaba escrito es mayor al nuevo stock, lo bajamos
                        if (parseInt(modalReservaCantidad.value) > parseInt(maxStock)) {
                            modalReservaCantidad.value = maxStock;
                        }
                    }
                }
            });
        }

        // ==========================================
        // 2. LÓGICA DE CHAT EN TIEMPO REAL (SIGNALR)
        // ==========================================

        var formChat = document.querySelector('form[action*="EnviarMensaje"]');
        var idInteresadoActual = formChat ? formChat.querySelector('input[name="idInteresado"]').value : null;
        var miIdUsuario = "@(Model.EstaAutenticado? User.FindFirst("IdUsuario").Value : "0")";

        // ¡IMPORTANTE! Encendemos SignalR siempre que el usuario tenga sesión,
        // sin importar si tiene un chat abierto o no.
        if (miIdUsuario !== "0") {
            var conexionSignalR = new signalR.HubConnectionBuilder()
                .withUrl("/chatTianguisHub")
                .withAutomaticReconnect()
                .build();

            conexionSignalR.on("RecibirMensaje", function (texto, remitenteIdUsuario, idInteresadoRecibido) {
                var esMio = (remitenteIdUsuario.toString() === miIdUsuario.toString());
                var chatTargetId = idInteresadoRecibido || idInteresadoActual;

                // 1. DIBUJAR BURBUJA (Solo si es para el chat que está ABIERTO en pantalla)
                if (chatBoxActual && idInteresadoActual && chatTargetId.toString() === idInteresadoActual.toString()) {
                    var divWrapper = document.createElement("div");
                    divWrapper.className = esMio ? "d-flex flex-column align-items-end mb-3 fade-in" : "d-flex flex-column align-items-start mb-3 fade-in";

                    var globo = document.createElement("div");
                    if (esMio) {
                        globo.className = "text-white rounded-4 rounded-bottom-0 p-3 shadow-sm text-start";
                        globo.style.backgroundColor = "var(--pez-azul)";
                        globo.style.maxWidth = "85%";
                        globo.style.fontSize = "0.95rem";
                    } else {
                        globo.className = "bg-white text-dark rounded-4 rounded-bottom-0 p-3 shadow-sm border";
                        globo.style.maxWidth = "85%";
                        globo.style.fontSize = "0.95rem";
                    }

                    globo.innerText = texto;
                    divWrapper.appendChild(globo);

                    var timeSpan = document.createElement("small");
                    timeSpan.className = "text-muted mt-1";
                    timeSpan.style.fontSize = "0.7rem";
                    var now = new Date();
                    timeSpan.innerText = now.getHours().toString().padStart(2, '0') + ":" + now.getMinutes().toString().padStart(2, '0');
                    divWrapper.appendChild(timeSpan);

                    chatBoxActual.appendChild(divWrapper);
                    hacerScrollAbajo(chatBoxActual);
                }

                // 2. ACTUALIZAR LA LISTA LATERAL (Para TODOS los chats)
                if (chatTargetId) {
                    var msjLateral = document.getElementById("msj-lateral-" + chatTargetId);
                    if (msjLateral) {
                        msjLateral.innerText = texto;
                        msjLateral.classList.replace("text-muted", "text-dark");
                        msjLateral.classList.add("fw-bold");
                        setTimeout(() => {
                            msjLateral.classList.remove("fw-bold");
                            msjLateral.classList.replace("text-dark", "text-muted");
                        }, 3000);
                    }

                    // 3. ACTUALIZAR PRECIO (Si es un aumento de oferta automático)
                    if (texto.includes("¡He aumentado mi oferta a $")) {
                        var cantidad = texto.split("$")[1].replace("!", "").trim();
                        var ofertaLateral = document.getElementById("oferta-lateral-" + chatTargetId);

                        if (ofertaLateral) {
                            ofertaLateral.innerText = "$" + cantidad;
                            ofertaLateral.style.transform = "scale(1.2)";
                            ofertaLateral.style.transition = "transform 0.3s ease";
                            setTimeout(() => { ofertaLateral.style.transform = "scale(1)"; }, 400);
                        }
                    }
                }
            });

            conexionSignalR.on("RecargarPagina", function () {
                setTimeout(function() { window.location.reload(); }, 500);
            });

            conexionSignalR.start().then(function () {
                var idsChats = [];

                // Agregar el chat principal si está abierto
                if (idInteresadoActual) {
                    idsChats.push(parseInt(idInteresadoActual));
                }

                // Agregar todos los chats del panel lateral
                document.querySelectorAll('[id^="msj-lateral-"]').forEach(function(elemento) {
                    var idChatLateral = parseInt(elemento.id.replace("msj-lateral-", ""));
                    if (!idsChats.includes(idChatLateral)) {
                        idsChats.push(idChatLateral);
                    }
                });

                // Unir al usuario a todos los grupos de golpe usando el método optimizado
                if (idsChats.length > 0) {
                    conexionSignalR.invoke("UnirseAMultiplesChats", idsChats).catch(function (err) {
                        console.error("Error uniéndose a múltiples grupos:", err.toString());
                    });
                }
            }).catch(function (err) {
                console.error("SignalR Connection Error: ", err);
            });

            // 3. EVENTO DE ENVÍO DEL FORMULARIO
            if (formChat) {
                formChat.addEventListener("submit", async function (e) {
                    e.preventDefault();

                    var inputTexto = formChat.querySelector('input[name="texto"]');
                    var texto = inputTexto.value.trim();
                    if(!texto) return;

                    var formData = new FormData(formChat);
                    inputTexto.value = "";
                    inputTexto.focus();

                    try {
                        var response = await fetch(formChat.action, { method: 'POST', body: formData });

                        if (response.status === 401 || response.status === 403 || response.redirected && response.url.includes("Login")) {
                            alert("Tu sesión ha expirado por inactividad. Por favor, vuelve a iniciar sesión.");
                            window.location.href = '/Login';
                            return;
                        }

                        var result = await response.json();
                        if(!result.success) {
                            alert("Error al enviar: " + result.message);
                        }
                    } catch (error) {
                        console.error("Error de red enviando mensaje:", error);
                    }
                });
            }
        }
    });
</script>