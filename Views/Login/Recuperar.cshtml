@{
    Layout = "Principal";
    ViewData["Title"] = "Recuperar Contraseña";
}

<script>
    window.addEventListener('load', function() {
        if(typeof activarMenu === 'function') {
            activarMenu('menu-miembros');
        }
    });
</script>

<div class="row justify-content-center align-items-center py-5" style="min-height: 80vh;">
    <div class="col-11 col-sm-8 col-md-6 col-lg-5 col-xl-4">

        <div class="login-card-modern">
            <div class="login-header-modern">
                <i class="fa-solid fa-key login-wheat-icon"></i>
                <h4 class="login-title">Recuperar Acceso</h4>
                <p class="login-subtitle">Te enviaremos un enlace a tu correo registrado.</p>
            </div>

            <div class="login-body">
                <form method="post" action="@Url.Action("Recuperar", "Login")">
                    @Html.AntiForgeryToken()

                    <div class="form-floating mb-4">
                        <input type="email" class="form-control" id="floatingEmail" placeholder="nombre@ejemplo.com" name="email" required>
                        <label for="floatingEmail"><i class="fa-solid fa-envelope me-2"></i>Correo Electrónico</label>
                    </div>

                    <div class="d-grid gap-2 mb-4">
                        <button type="submit" class="btn btn-login-action">
                            ENVIAR ENLACE <i class="fa-solid fa-paper-plane ms-2"></i>
                        </button>
                    </div>

                    <div class="text-center pt-2">
                        <a href="@Url.Action("Index", "Login")" class="link-register small">
                            <i class="fa-solid fa-arrow-left me-1"></i> Volver al Inicio de Sesión
                        </a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>