@{
    Layout = "Principal";
    ViewData["Title"] = "Error";
}

<div class="d-flex flex-column justify-content-center align-items-center" style="min-height: 60vh;">

    <div class="text-center mb-4">
        <i class="fa-solid fa-fish fa-flip-vertical fa-5x text-secondary" style="opacity: 0.5;"></i>
        <i class="fa-solid fa-question fa-3x text-warning position-absolute" style="margin-left: -20px; margin-top: -20px;"></i>
    </div>

    <h1 class="display-4 fw-bold" style="color: var(--header-footer);">¡Aguas turbulentas!</h1>

    <p class="lead text-center text-muted" style="max-width: 600px;">
        Ocurrió un error inesperado al procesar tu solicitud.
    </p>

    <div class="mt-4">
        <a href="@Url.Action("Login", "Home")" class="btn btn-nautico px-4 py-2 rounded-pill">
            <i class="fa-solid fa-anchor me-2"></i> Regresar a puerto seguro
        </a>
    </div>

    <div class="mt-5 text-muted small">
        Código de estado: 500
    </div>

</div>

<style>
    .btn-nautico {
        background-color: var(--header-footer);
        color: white;
        transition: 0.3s;
    }

        .btn-nautico:hover {
            background-color: var(--pez-azul);
            color: white;
            transform: translateY(-2px);
        }
</style>

<script>
    // No necesitamos activar ningún menú aquí porque es una página de error
</script>