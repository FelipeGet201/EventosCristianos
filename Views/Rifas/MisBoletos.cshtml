<div id="contenedorBoletoOculto" style="position: absolute; left: -9999px; top: 0; width: 380px; padding: 20px; background: white;">
    <div style="border: 2px dashed #94a3b8; border-radius: 12px; padding: 20px; display: flex; flex-direction: column; align-items: center; text-align: center; background: #ffffff;">
        <h4 style="color: #0ea5e9; font-weight: 800; margin-bottom: 5px;">@Model.InfoRifa.Titulo</h4>
        <span style="font-size: 0.85rem; color: #64748b; margin-bottom: 15px;">¡Conserva este boleto digital!</span>
        <div id="boletoDigitalNombre" style="font-size: 1.2rem; font-weight: 700; color: #1e293b; text-transform: uppercase;"></div>
        <div style="font-size: 0.8rem; font-weight: 800; color: #94a3b8; margin-bottom: 5px;">COSTO: @Model.InfoRifa.CostoBoleto.ToString("C")</div>
        <div id="boletoDigitalNum" style="color: #22c55e; font-weight: 900; font-size: 3.5rem; line-height: 1;">#000</div>
        
        @if (!string.IsNullOrEmpty(Model.InfoRifa.QrEnlaceCompraUrl))
