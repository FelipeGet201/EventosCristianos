@model RedAJP.Models.IglesiaWebPublicaViewModel

<div class="container py-5 fade-in-up">
    <h2 class="text-center mb-5" style="font-family: var(--theme-font-title); font-weight: 800; color: var(--theme-primary);">Mensajes y Predicaciones</h2>

    @if (Model.Multimedia != null && Model.Multimedia.Any())
    {
        <div class="row g-4 justify-content-center">
            @foreach (var m in Model.Multimedia)
            {
                <div class="col-md-6">
                    <div class="p-3 rounded-4 h-100" style="background: var(--theme-surface); border: 1px solid rgba(128, 128, 128, 0.2); box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
                        <h6 class="mb-3 text-truncate" style="font-family: var(--theme-font-title); font-weight: 700; color: var(--theme-text-main);">
                            <i class="fa-brands fa-youtube me-2" style="color: #ef4444;"></i>@(string.IsNullOrWhiteSpace(m.Titulo) ? "Video" : m.Titulo)
                        </h6>
                        <div class="ratio ratio-16x9 rounded-3 overflow-hidden" style="background: var(--theme-bg); border: 1px solid rgba(128, 128, 128, 0.2);">
                            @if (!string.IsNullOrWhiteSpace(m.UrlEmbed))
                            {
                                string embedUrl = m.UrlEmbed;
                                string ytId = "";
                                if (embedUrl.Contains("youtu.be/")) ytId = embedUrl.Split(new[] { "youtu.be/" }, StringSplitOptions.None)[1];
                                else if (embedUrl.Contains("watch?v=")) ytId = embedUrl.Split(new[] { "watch?v=" }, StringSplitOptions.None)[1];
                                else if (embedUrl.Contains("embed/")) ytId = embedUrl.Split(new[] { "embed/" }, StringSplitOptions.None)[1];
                                else if (embedUrl.Contains("/shorts/")) ytId = embedUrl.Split(new[] { "/shorts/" }, StringSplitOptions.None)[1];
                                else if (embedUrl.Contains("/live/")) ytId = embedUrl.Split(new[] { "/live/" }, StringSplitOptions.None)[1];
                                if (!string.IsNullOrEmpty(ytId)) { embedUrl = "https://www.youtube.com/embed/" + ytId.Split('?')[0].Split('&')[0].Trim('/'); }
                                <iframe src="@embedUrl" frameborder="0" allowfullscreen></iframe>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center text-muted">URL no disponible</div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>