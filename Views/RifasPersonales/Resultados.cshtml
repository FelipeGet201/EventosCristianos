@model RedAJP.Models.TableroRifaPersonalViewModel
@{
    Layout = "_LayoutRifasPersonales";
    ViewData["Title"] = "Resultados del Sorteo";
    bool esCreador = ViewBag.EsCreador ?? false;
    bool estaFinalizada = Model.InfoRifa.Estado == "Finalizada";
}

<style>
    .winner-card {
        background: #ffffff;
        border: 3px solid #fbbf24; /* Borde dorado */
        border-radius: 24px;
        box-shadow: 0 20px 40px -10px rgba(251, 191, 36, 0.3), 0 0 20px rgba(251, 191, 36, 0.1) inset;
        overflow: hidden;
        position: relative;
    }

    .winner-header {
        background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
        color: white;
        padding: 15px 20px;
        text-transform: uppercase;
        letter-spacing: 3px;
        font-weight: 800;
        font-size: 1.1rem;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
    }

    .winning-number {
        font-size: 4.5rem;
        font-weight: 900;
        color: #0f172a;
        line-height: 1;
        text-shadow: 3px 3px 0px #fef3c7;
        margin-top: -10px;
    }

    .winning-name {
        font-size: 1.8rem;
        color: #334155;
        font-weight: 800;
        text-transform: uppercase;
    }

    .details-box {
        background-color: #f8fafc;
        border-radius: 16px;
        padding: 20px;
        border: 1px dashed #cbd5e1;
        text-align: left;
    }

    .pending-card {
        background-color: #ffffff;
        border: 2px dashed #94a3b8;
        border-radius: 24px;
        padding: 40px 20px;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
    }

    .icon-detail {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e0f2fe;
        color: #0ea5e9;
        margin-right: 12px;
    }
</style>

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-rifaspersonales');
        }
        
        // Disparar confeti si acaba de finalizar
        @if (estaFinalizada)
        {
            <text>
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 150,
                    spread: 80,
                    origin: { y: 0.6 },
                    colors: ['#fbbf24', '#f59e0b', '#38bdf8', '#ffffff']
                });
            }
            </text>
        }
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<div class="container-fluid mt-2 mb-5">
    <div class="row justify-content-center fade-in">
        <div class="col-lg-8 mx-auto text-center">

            @if (estaFinalizada)
            {
                <div class="winner-card mt-3 mb-5">
                    <div class="winner-header">
                        <i class="fa-solid fa-trophy me-2"></i> Dinámica Finalizada
                    </div>
                    
                    <div class="p-4 p-md-5">
                        <div class="mb-3 text-warning">
                            <i class="fa-solid fa-crown" style="font-size: 4.5rem; filter: drop-shadow(0 4px 6px rgba(251,191,36,0.4));"></i>
                        </div>
                        
                        <p class="text-muted fw-bold mb-1 text-uppercase" style="letter-spacing: 2px; font-size: 0.9rem;">Boleto Ganador</p>
                        
                        <div class="winning-number mb-2">#@Model.BoletoGanadorTexto</div>
                        <div class="winning-name mb-4">@Model.NombreGanador</div>

                        @if (ViewBag.VendedorGanador != null || ViewBag.TelefonoGanador != null || ViewBag.ComentariosGanador != null)
                        {
                            <div class="details-box mx-auto">
                                <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2 text-uppercase" style="font-size: 0.85rem; letter-spacing: 1px;">
                                    Información de Contacto
                                </h6>
                                <div class="d-flex flex-column gap-3 text-dark fs-6">
                                    @if (!string.IsNullOrEmpty(ViewBag.VendedorGanador as string))
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="icon-detail"><i class="fa-solid fa-store"></i></div>
                                            <div>
                                                <div class="small text-muted fw-bold lh-1">Vendido por</div>
                                                <div class="fw-bold">@ViewBag.VendedorGanador</div>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(ViewBag.TelefonoGanador as string))
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="icon-detail bg-success bg-opacity-10 text-success"><i class="fa-brands fa-whatsapp"></i></div>
                                            <div>
                                                <div class="small text-muted fw-bold lh-1">Teléfono</div>
                                                <div class="fw-bold">@ViewBag.TelefonoGanador</div>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(ViewBag.ComentariosGanador as string))
                                    {
                                        <div class="d-flex align-items-start">
                                            <div class="icon-detail bg-warning bg-opacity-10 text-warning mt-1"><i class="fa-solid fa-comment-dots"></i></div>
                                            <div>
                                                <div class="small text-muted fw-bold lh-1">Notas</div>
                                                <div class="fw-medium text-secondary">@ViewBag.ComentariosGanador</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="pending-card mt-4 mb-5">
                    <div class="mb-4">
                        <i class="fa-regular fa-clock fa-5x text-primary opacity-50"></i>
                    </div>
                    <h2 class="fw-bold text-dark">Sorteo Pendiente</h2>
                    <p class="text-muted fs-5 mb-1">La dinámica se llevará a cabo el día:</p>
                    <div class="d-inline-block bg-primary bg-opacity-10 text-primary fw-bold rounded-pill px-4 py-2 mt-2" style="font-size: 1.3rem;">
                        <i class="fa-regular fa-calendar-check me-2"></i> @Model.InfoRifa.FechaSorteo.ToString("dd MMMM yyyy, HH:mm") hrs
                    </div>
                    
                    @if (!esCreador)
                    {
                        <p class="text-muted mt-4 px-md-4">
                            Regresa a esta página después de la fecha programada para conocer al afortunado ganador de la dinámica.
                        </p>
                        <a href="@Url.Action("PuntoDeVenta", "RifasPersonales", new { token = Model.InfoRifa.Token })" class="btn btn-outline-primary rounded-pill px-4 fw-bold shadow-sm mt-2">
                            <i class="fa-solid fa-arrow-left me-2"></i> Volver a mis boletos
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    @if (!estaFinalizada && (!string.IsNullOrEmpty(Model.InfoRifa.EnlaceGrupoWhatsapp) || !string.IsNullOrEmpty(Model.InfoRifa.QrGrupoWhatsappUrl)))
    {
        <div class="row fade-in mb-5">
            <div class="col-lg-8 mx-auto">
                <div class="card border-0 bg-white shadow-sm rounded-4 overflow-hidden" style="border-left: 6px solid #25D366 !important;">
                    <div class="card-body p-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-4 text-center text-md-start">
                        <div>
                            <div class="d-inline-block mb-2" style="color: #25D366;">
                                <i class="fa-brands fa-whatsapp fa-2x"></i>
                            </div>
                            <h4 class="fw-bold text-dark mb-1">¡Únete a la Comunidad!</h4>
                            <p class="text-muted small mb-0">Escanea el código o únete usando el enlace para enterarte de los resultados en tiempo real y participar en futuras dinámicas.</p>
                        </div>
                        <div class="d-flex flex-column flex-sm-row align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(Model.InfoRifa.QrGrupoWhatsappUrl))
                            {
                                <div class="bg-light p-2 rounded-3 shadow-sm border">
                                    <img src="@Model.InfoRifa.QrGrupoWhatsappUrl" alt="Código QR del Grupo" style="width: 100px; height: 100px; object-fit: cover;" />
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.InfoRifa.EnlaceGrupoWhatsapp))
                            {
                                <a href="@Model.InfoRifa.EnlaceGrupoWhatsapp" target="_blank" class="btn text-white rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center justify-content-center" style="background-color: #25D366; min-height: 45px; white-space: nowrap;">
                                    <i class="fa-solid fa-arrow-up-right-from-square me-2"></i> Unirme al Grupo
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>