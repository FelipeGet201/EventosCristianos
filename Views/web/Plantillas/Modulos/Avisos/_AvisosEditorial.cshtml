@model RedAJP.Models.IglesiaWebPublicaViewModel

<div class="container py-5 fade-in-up">
    <div class="text-center mb-5">
        <span class="d-block mb-2" style="font-family: var(--theme-font-title); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 2px; color: var(--theme-accent);">Tablero</span>
        <h2 style="font-family: var(--theme-font-title); font-style: italic; color: var(--theme-primary); font-size: 2.5rem;">Avisos Recientes</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            @if (Model.Avisos != null && Model.Avisos.Any())
            {
                foreach (var aviso in Model.Avisos)
                {
                    <div class="mb-4 pb-4" style="border-bottom: 1px solid rgba(128, 128, 128, 0.2);">
                        <h5 class="mb-2" style="font-family: var(--theme-font-title); color: var(--theme-text-main);">@aviso.Titulo</h5>
                        <p class="mb-2" style="font-family: var(--theme-font-body); color: var(--theme-text-muted);">@aviso.Descripcion</p>
                        <span class="small fst-italic" style="font-family: var(--theme-font-body); color: var(--theme-accent);">Vence el @(aviso.FechaExpiracion == default ? "--" : aviso.FechaExpiracion.ToString("dd MMM, yyyy"))</span>
                    </div>
                }
            }
            else
            {
                <div class="text-center p-5 fst-italic" style="border: 1px dashed rgba(128, 128, 128, 0.3); font-family: var(--theme-font-body); color: var(--theme-text-muted);">No hay avisos recientes.</div>
            }
        </div>
    </div>
</div>