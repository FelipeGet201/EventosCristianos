            <option value="AGR_@ag.Id_Agrupacion">⭐ @ag.Nombre_Descriptivo</option>
        }}
    </optgroup>
</template>
<template id="templateModalidades">
    <optgroup label="Modalidades Fijas">
        @foreach(var sub in Model.Subtipos) {
            <option value="SUB_@sub.Id_Subtipo">🔹 @sub.Nombre</option>
        }
    </optgroup>
</template>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    // -----------------------------------------------------------
    // FUNCIONES DE REGLAS DE SELECCIÓN Y AGRUPACIONES
    // -----------------------------------------------------------
    const modalPortalConfigUi = new bootstrap.Modal(document.getElementById('modalPortalConfig'));
    function abrirModalPortal() { modalPortalConfigUi.show(); }

    function agregarFormularioAlojamiento(nom = "", gen = "", caps = []) {
        const template = document.getElementById('templateAlojamientoBlock');
        const container = document.getElementById('contenedorFormulariosAlojamientos');
    
        // Clonamos el contenido del template
        const clone = document.importNode(template.content, true);
        const block = clone.querySelector('.alojamiento-block');
        const idBlock = "block-" + Date.now() + Math.random().toString(36).substr(2, 5);
    
        block.id = idBlock;

        // Configurar valores iniciales si existen (para edición o clonado)
        if (nom) block.querySelector('.txt-nombre-aloj').value = nom;
        if (gen) block.querySelector('.sel-genero-aloj').value = gen;

        // Configurar el botón de "Agregar Capacidad" de este bloque específico
        const btnCap = block.querySelector('.btn-mas-capacidad');
        const capContainer = block.querySelector('.contenedor-capacidades');
        capContainer.id = "caps-" + idBlock;
        btnCap.onclick = () => agregarFilaCapacidad(idBlock);

        // Inyectar el bloque en el DOM
        container.appendChild(clone);
        actualizarBotonesEliminarAloj();

        // Rellenar capacidades
        if (caps.length > 0) {
            caps.forEach(c => { 
                let tipo = c.IdAgrupacion > 0 ? `AGR_${c.IdAgrupacion}` : `SUB_${c.IdSubtipo}`;
                agregarFilaCapacidad(idBlock, tipo, c.CapacidadTotal);
            });
        } else {
            agregarFilaCapacidad(idBlock); // Una fila vacía por defecto
        }
    }

    // Función auxiliar para eliminar y actualizar la visibilidad de los botones cerrar
    function removerBloqueAlojamiento(btn) {
        btn.closest('.alojamiento-block').remove();
        actualizarBotonesEliminarAloj();
    }
    async function guardarConfigPortal() {
        mostrarLoader();
        let req = { 
            IdEvento: @Model.IdEvento, 
            PortalActivo: document.getElementById('chkPortalActivo').checked, 
            SoloPagados: document.getElementById('chkSoloPagados').checked,
            MostrarTodasLasHabitaciones: document.getElementById('chkMostrarTodas').checked 
        };
        try {
            let r = await fetch('@Url.Action("ApiGuardarConfigPortal", "Eventos")', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(req) });
            let d = await r.json();
            if (d.exito) { modalPortalConfigUi.hide(); ocultarLoader(); mostrarAlerta("Reglas de selección guardadas.", true); } 
            else { ocultarLoader(); mostrarAlerta(d.mensaje); }
        } catch (e) { ocultarLoader(); mostrarAlerta("Error de conexión."); }
    }

    async function crearAgrupacion() {
        let nom = document.getElementById('txtNombreAgrupacion').value;
        if(!nom) return mostrarAlerta("Ingresa un nombre para la agrupación.");
        let subs = Array.from(document.querySelectorAll('.chk-subtipo-agr:checked')).map(c => parseInt(c.value));
        if(subs.length === 0) return mostrarAlerta("Selecciona al menos una modalidad.");

        mostrarLoader();
        try {
            let r = await fetch('@Url.Action("ApiCrearAgrupacion", "Eventos")', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ IdEvento: @Model.IdEvento, Nombre: nom, Subtipos: subs }) });
            let d = await r.json();
            if (d.exito) { await recargarInterfazSilenciosamente(); ocultarLoader(); } else { ocultarLoader(); mostrarAlerta(d.mensaje); }
        } catch (e) { ocultarLoader(); mostrarAlerta("Error de conexión."); }
    }

    function eliminarAgrupacion(id) {
        solicitarConfirmacion("Eliminar Agrupación", "Las habitaciones que utilicen esta agrupación perderán su configuración de cupo. ¿Continuar?", "fa-solid fa-trash text-danger", "Sí, Eliminar", "danger", async () => {
            mostrarLoader();
            try {
                let r = await fetch(`@Url.Action("ApiEliminarAgrupacion", "Eventos")?idAgrupacion=${id}`, { method: 'POST' });
                let d = await r.json();
                if (d.exito) { await recargarInterfazSilenciosamente(); ocultarLoader(); } else { ocultarLoader(); mostrarAlerta(d.mensaje); }
            } catch (e) { ocultarLoader(); mostrarAlerta("Error de conexión."); }
        });
    }

    async function togglePublicacion(idAloj, estadoNuevo, btnElement) {
        mostrarLoader();
        try {
            let r = await fetch(`@Url.Action("ApiToggleAlojamientoPortal", "Eventos")?idAlojamiento=${idAloj}&publicar=${estadoNuevo}`, { method: 'POST' });
            let d = await r.json();
        
            if (d.exito) { 
                // En lugar de recargar TODA la página, solo actualizamos el ícono y el botón en el DOM
                let icon = btnElement.querySelector('i');
            
                if(estadoNuevo) {
                    icon.className = "fa-solid fa-eye text-success";
                    btnElement.title = "Visible para Asistentes";
                    // Preparamos el botón para que el próximo clic lo apague
                    btnElement.setAttribute("onclick", `togglePublicacion(${idAloj}, false, this)`);
                } else {
                    icon.className = "fa-solid fa-eye-slash text-muted";
                    btnElement.title = "Oculto para Asistentes";
                    // Preparamos el botón para que el próximo clic lo encienda
                    btnElement.setAttribute("onclick", `togglePublicacion(${idAloj}, true, this)`);
                }
            
                ocultarLoader(); 
            } else { 
                ocultarLoader(); 
                mostrarAlerta(d.mensaje); 
            }
        } catch (e) { 
            ocultarLoader(); 
            mostrarAlerta("Error de conexión."); 
        }
    }

    // -----------------------------------------------------------
    // ALOJAMIENTO HÍBRIDO
    // -----------------------------------------------------------
    function agregarFilaCapacidad(valorTipo = '', cap = 0) {
        // leemos los options actualizados directamente del template
        let listaAgrup = document.getElementById('templateAgrupaciones').innerHTML;
        let listaMod = document.getElementById('templateModalidades').innerHTML;

        let idFila = Date.now() + Math.random().toString(36).substr(2, 5);
        let html = `
            <div class="d-flex justify-content-between align-items-center p-2 bg-white border rounded-3 fila-capacidad shadow-sm" id="fila-${idFila}">
                <select class="form-select form-select-sm rounded-pill border-primary w-75 sel-capo-tipo">
                    <option value="">Seleccione Modalidad o Agrupación...</option>
                    ${listaAgrup}
                    ${listaMod}
                </select>
                <input type="number" class="form-control form-control-sm rounded-pill text-center mx-2 w-25 input-capa-val border-primary" value="${cap}" min="1" placeholder="Cupo">
                <button type="button" class="btn btn-sm btn-outline-danger rounded-circle" onclick="document.getElementById('fila-${idFila}').remove()"><i class="fa-solid fa-xmark"></i></button>
            </div>
        `;
        document.getElementById('contenedorCapacidades').insertAdjacentHTML('beforeend', html);
        if(valorTipo) document.querySelector(`#fila-${idFila} .sel-capo-tipo`).value = valorTipo;
    }
        
    // -----------------------------------------------------------
    // ALOJAMIENTO HÍBRIDO (CREACIÓN MÚLTIPLE CON TEMPLATE)
    // -----------------------------------------------------------
    
    function abrirModalAlojamiento(idZ, arr) { 
        document.getElementById('tituloModalAloj').innerText = "Nuevo Cuarto";
        document.getElementById('hdnIdAlojamientoEdit').value = "0"; 
        document.getElementById('hdnIdZonaAloj').value = idZ; 
    
        // Limpiamos el contenedor donde se inyectan los templates
        document.getElementById('contenedorFormulariosAlojamientos').innerHTML = "";
        
        // Como es nuevo, sí mostramos el botón de añadir más cuartos
        document.getElementById('wrapperBtnAgregarOtro').style.display = "block";
        
        // Agregamos un bloque de formulario vacío para empezar
        agregarFormularioAlojamiento(); 
        modalA.show();
    }

    function abrirModalEditarAlojamiento(idAl, idZ, nom, gen, arr) { 
        document.getElementById('tituloModalAloj').innerText = "Editar Cuarto";
        document.getElementById('hdnIdAlojamientoEdit').value = idAl; 
        document.getElementById('hdnIdZonaAloj').value = idZ; 
    
        // Limpiamos el contenedor
        document.getElementById('contenedorFormulariosAlojamientos').innerHTML = "";
        
        // Ocultamos el botón de agregar más, ya que al editar se hace 1 a la vez
        document.getElementById('wrapperBtnAgregarOtro').style.display = "none";
        
        // Leemos el JSON oculto de capacidades que está en la tarjeta
        let capsInfo = document.getElementById('caps-' + idAl).value;
        let caps = capsInfo ? JSON.parse(capsInfo) : [];
    
        // Agregamos el bloque inyectando los datos que ya existen
        agregarFormularioAlojamiento(nom, gen, caps);
        modalA.show();
    }

    function agregarFormularioAlojamiento(nom = "", gen = "", caps = []) {
        const template = document.getElementById('templateAlojamientoBlock');
        const container = document.getElementById('contenedorFormulariosAlojamientos');
    
        // Clonamos el contenido del template
        const clone = document.importNode(template.content, true);
        const block = clone.querySelector('.alojamiento-block');
        const idBlock = "block-" + Date.now() + Math.random().toString(36).substr(2, 5);
    
        block.id = idBlock;

        // Configurar valores iniciales si existen
        if (nom) block.querySelector('.txt-nombre-aloj').value = nom;
        if (gen) block.querySelector('.sel-genero-aloj').value = gen;

        // Configurar el botón de "Agregar Capacidad" y su contenedor para este bloque específico
        const btnCap = block.querySelector('.btn-mas-capacidad');
        const capContainer = block.querySelector('.contenedor-capacidades');
        capContainer.id = "caps-" + idBlock; // ID Dinámico súper importante
        
        btnCap.onclick = () => agregarFilaCapacidad(idBlock);

        // Inyectar el bloque en el DOM
        container.appendChild(clone);
        actualizarBotonesEliminarAloj();

        // Rellenar capacidades
        if (caps.length > 0) {
            caps.forEach(c => { 
                let tipo = c.IdAgrupacion > 0 ? `AGR_${c.IdAgrupacion}` : `SUB_${c.IdSubtipo}`;
                agregarFilaCapacidad(idBlock, tipo, c.CapacidadTotal);
            });
        } else {
            agregarFilaCapacidad(idBlock); // Fila vacía por defecto
        }
    }

    function agregarFilaCapacidad(idBlock, valorTipo = '', cap = 0) {
        let listaAgrup = document.getElementById('templateAgrupaciones').innerHTML;
        let listaMod = document.getElementById('templateModalidades').innerHTML;
        let idFila = Date.now() + Math.random().toString(36).substr(2, 5);

        let html = `
            <div class="d-flex justify-content-between align-items-center p-2 bg-white border rounded-3 fila-capacidad shadow-sm mb-2" id="fila-${idFila}">
                <select class="form-select form-select-sm rounded-pill border-primary w-75 sel-capo-tipo">
                    <option value="">Seleccione Modalidad o Agrupación...</option>
                    ${listaAgrup}
                    ${listaMod}
                </select>
                <input type="number" class="form-control form-control-sm rounded-pill text-center mx-2 w-25 input-capa-val border-primary" value="${cap}" min="1" placeholder="Cupo">
                <button type="button" class="btn btn-sm btn-outline-danger rounded-circle" onclick="document.getElementById('fila-${idFila}').remove()"><i class="fa-solid fa-xmark"></i></button>
            </div>
        `;
        
        // Buscamos el contenedor específico de ESTE bloque
        document.getElementById(`caps-${idBlock}`).insertAdjacentHTML('beforeend', html);
        
        if(valorTipo) document.querySelector(`#fila-${idFila} .sel-capo-tipo`).value = valorTipo;
    }

    function removerBloqueAlojamiento(btn) {
        btn.closest('.alojamiento-block').remove();
        actualizarBotonesEliminarAloj();
    }

    function actualizarBotonesEliminarAloj() {
        let bloques = document.querySelectorAll('.alojamiento-block');
        bloques.forEach(b => {
            let btn = b.querySelector('.btn-eliminar-bloque');
            if(btn) btn.style.display = bloques.length > 1 ? 'block' : 'none';
        });
    }

    async function guardarAlojamiento() { 
        let idEdit = parseInt(document.getElementById('hdnIdAlojamientoEdit').value);
        let idZona = parseInt(document.getElementById('hdnIdZonaAloj').value);
    
        let bloques = document.querySelectorAll('.alojamiento-block');
        let listaPeticiones = [];
    
        for(let i = 0; i < bloques.length; i++) {
            let el = bloques[i];
            let nom = el.querySelector('.txt-nombre-aloj').value;
            if (!nom) return mostrarAlerta(`Por favor ingresa el nombre para el alojamiento #${i+1}.`);
        
            let gen = el.querySelector('.sel-genero-aloj').value;
            let capArray = [];
            let tot = 0;
        
            el.querySelectorAll('.fila-capacidad').forEach(fila => { 
                let valTipo = fila.querySelector('.sel-capo-tipo').value;
                let valCap = parseInt(fila.querySelector('.input-capa-val').value) || 0;
                if(valTipo && valCap > 0) {
                    let isAgrupacion = valTipo.startsWith('AGR_');
                    let idReal = parseInt(valTipo.replace('AGR_', '').replace('SUB_', ''));
                    capArray.push({ IdSubtipo: isAgrupacion ? null : idReal, IdAgrupacion: isAgrupacion ? idReal : null, CapacidadTotal: valCap });
                    tot += valCap;
                }
            });
            
            if (tot === 0) return mostrarAlerta(`Define al menos un cupo válido para '${nom}'.`); 
            
            listaPeticiones.push({
                IdAlojamiento: idEdit, 
                IdZona: idZona,
                Nombre: nom,
                GeneroAsignado: gen,
                CapacidadesArray: capArray
            });
        }

        modalA.hide(); 
        mostrarLoader(); 

        try {
            let url = idEdit > 0 ? '@Url.Action("ApiEditarAlojamiento", "Eventos")' : '@Url.Action("ApiCrearAlojamientoMultiple", "Eventos")'; 
            let payload = idEdit > 0 ? JSON.stringify(listaPeticiones[0]) : JSON.stringify(listaPeticiones);

            let r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload });
            let d = await r.json(); 
            
            if (d.exito) { 
                await recargarInterfazSilenciosamente(); 
                ocultarLoader(); 
            } else { 
                ocultarLoader(); 
                mostrarAlerta(d.mensaje); 
            } 
        } catch (err) { 
            ocultarLoader(); 
            mostrarAlerta("Error de conexión."); 
        }
    }

    // -----------------------------------------------------------
    // CÓDIGO ORIGINAL INTACTO
    // -----------------------------------------------------------    
    const modalDetalleM = new bootstrap.Modal(document.getElementById('modalDetalleModalidad'));
    function renderStatTab(prefix, dataTab) {
        document.getElementById(`${prefix}-espacios`).innerText = dataTab.espacios;
        document.getElementById(`${prefix}-ocupados`).innerText = dataTab.ocupados;
        document.getElementById(`${prefix}-libres`).innerText = dataTab.libres;
    
        if(document.getElementById(`${prefix}-espera`)) {
            document.getElementById(`${prefix}-espera`).innerText = dataTab.porAsignar;
            document.getElementById(`${prefix}-proceso`).innerText = dataTab.enProceso;
        }

        let container = document.getElementById(`${prefix}-lista`);
        container.innerHTML = "";
        if (dataTab.lista.length === 0) {
            container.innerHTML = '<div class="p-4 text-center text-muted small">No hay personas en esta categoría.</div>';
        } else {
            dataTab.lista.forEach((p, idx) => {
                let badgeClass = p.estado === 'Pagado' ? 'bg-success' : 'bg-warning text-dark';
                let genIcon = p.genero === 'H' ? '👨' : (p.genero === 'M' ? '👩' : '👤');
                container.innerHTML += `
                    <div class="list-group-item bg-transparent border-bottom-0 py-2 d-flex justify-content-between align-items-center">
                        <div class="text-truncate">
                            <span class="text-muted fw-bold me-2 small" style="width:20px; display:inline-block;">${idx + 1}.</span>
                            <span class="fw-bold text-dark" style="font-size:0.85rem;">${genIcon} ${p.nombre}</span><br>
                            <small class="text-muted ms-4" style="font-size:0.7rem;">${p.diagnostico}</small>
                        </div>
                        <span class="badge ${badgeClass} rounded-pill" style="font-size:0.6rem; padding: 0.4em 0.8em;">${p.estado}</span>
                    </div>`;
            });
        }
    }

    async function consultarDetalleModalidad(idSub) {
        mostrarLoader();
        try {
            let resp = await fetch(`@Url.Action("ApiGetEstadisticasModalidad", "Eventos")?idEvento=@Model.IdEvento&idSubtipo=${idSub}`);
            let data = await resp.json();
            ocultarLoader();
            if(data.exito) {
                document.getElementById('lblDetalleModalidad').innerText = data.titulo;
                document.getElementById('statCupoBD').innerText = data.cupoBD;
            
                renderStatTab('h', data.h);
                renderStatTab('m', data.m);
                renderStatTab('x', data.x);

                modalDetalleM.show();
            } else { mostrarAlerta("Error: " + data.mensaje); }
        } catch (err) { ocultarLoader(); mostrarAlerta("Error de conexión al servidor."); }
    }

    let tabActivoActual = sessionStorage.getItem('activeTabAlojamientos_@Model.IdEvento') || null;
    function guardarTabActivo(targetId) { tabActivoActual = targetId; sessionStorage.setItem('activeTabAlojamientos_@Model.IdEvento', targetId); }
    function restaurarTabActivo() { if(tabActivoActual) { let targetTab = document.querySelector(`button[data-bs-target="${tabActivoActual}"]`); if(targetTab) new bootstrap.Tab(targetTab).show(); } else { let primerTab = document.querySelector('.custom-tabs .nav-link'); if(primerTab) new bootstrap.Tab(primerTab).show(); } }

    document.addEventListener("DOMContentLoaded", function() { 
        restaurarTabActivo(); filtrarEspera(); 
        document.addEventListener('click', function(e) {
            let isRadarButton = e.target.closest('.btn-radar'); let isCard = e.target.closest('.tarjeta-asistente, .badge-asistente-asignado'); let isActionBtn = e.target.closest('button:not(.btn-radar), a'); let isModal = e.target.closest('.modal'); 
            if (document.body.classList.contains('dim-background') && !isRadarButton && !isModal) { document.body.classList.remove('dim-background'); document.querySelectorAll('.companion-highlight').forEach(el => el.classList.remove('companion-highlight')); if (!isCard) deseleccionarTodos(); }
            if(isActionBtn || isModal) return; if(isCard) isCard.classList.toggle('selected-card');
            document.querySelectorAll('.btn-radar').forEach(b => b.remove()); let seleccionados = document.querySelectorAll('.selected-card');
            if(seleccionados.length === 1) {
                let unicaCard = seleccionados[0]; let btn = document.createElement('button'); btn.className = 'btn btn-sm btn-dark btn-radar position-absolute';
                btn.style.cssText = 'bottom: -15px; left: 50%; transform: translateX(-50%); z-index: 1050; border-radius: 20px; box-shadow: 0 4px 8px rgba(0,0,0,0.5); font-size: 0.65rem; padding: 3px 12px; cursor: pointer; border: 1px solid #fff;'; btn.innerHTML = '<i class="fa-solid fa-satellite-dish text-info me-1"></i>Grupo';
                btn.onclick = (event) => { event.stopPropagation(); ubicarGrupoVisualmente(unicaCard.dataset.id); }; unicaCard.appendChild(btn);
            }
        });
        $('#selectBuscadorAmigos').select2({ dropdownParent: $('#modalBuscadorGrupo'), theme: 'bootstrap-5', placeholder: "Escribe el nombre aquí...", allowClear: true });
        $('#selectBuscadorAmigos').on('change', async function() {
            let idA = $(this).val(); let divResultados = document.getElementById('resultadosBuscadorGrupo'); let divLoader = document.getElementById('loaderBuscador'); divResultados.innerHTML = ""; if(!idA) return; divLoader.classList.remove('d-none');
            try {
                let resp = await fetch(`@Url.Action("ApiBuscarGrupoAsistente", "Eventos")?idAsistente=${idA}&idEvento=@Model.IdEvento`); let data = await resp.json(); divLoader.classList.add('d-none');
                if(data.exito) {
                    let htmlList = `<div class="list-group shadow-sm">
                        <div class="list-group-item bg-light text-center text-muted fw-bold" style="font-size: 0.85rem;">GRUPO INSCRITO POR: <span class="text-primary">${data.lider.toUpperCase()}</span> (${data.fecha})</div>`;
                    
                    data.companeros.forEach(c => {
                        let idAsis = c.idAsistente || c.IdAsistente; 
                        let nombre = c.nombre || c.Nombre; 
                        let genero = c.genero || c.Genero; 
                        let modalidad = c.modalidad || c.Modalidad; 
                        let alojamiento = c.alojamiento || c.Alojamiento; 
                        let estaAsignado = c.estaAsignado !== undefined ? c.estaAsignado : c.EstaAsignado;
                        let esCortesia = c.esCortesia !== undefined ? c.esCortesia : c.EsCortesia;
                        
                        let badgeColor = estaAsignado ? "bg-success" : "bg-warning text-dark"; 
                        let iconoGen = genero === "H" ? '<i class="fa-solid fa-person text-primary" style="font-size: 1.2rem;"></i>' : '<i class="fa-solid fa-person-dress text-pink" style="font-size: 1.2rem;"></i>'; 
                        let rowBg = idAsis == idA ? "bg-info bg-opacity-10" : "";
                        let iconoCortesia = esCortesia ? '<i class="fa-solid fa-star text-danger ms-1" title="Cortesía VIP"></i>' : '';

                        htmlList += `<div class="list-group-item d-flex justify-content-between align-items-center ${rowBg}">
                            <div><h6 class="mb-0 fw-bold d-flex align-items-center gap-2">${iconoGen} ${nombre} ${iconoCortesia}</h6><small class="text-muted"><i class="fa-solid fa-tag me-1"></i>${modalidad}</small></div>
                            <div class="text-end"><span class="badge ${badgeColor} rounded-pill px-3 py-2"><i class="fa-solid fa-door-closed me-1"></i>${alojamiento}</span></div>
                        </div>`;
                    });
                    htmlList += `</div>`; divResultados.innerHTML = htmlList;
                } else { divResultados.innerHTML = `<div class="alert alert-warning border-0 shadow-sm"><i class="fa-solid fa-triangle-exclamation me-2"></i>${data.mensaje}</div>`; }
            } catch (err) { divLoader.classList.add('d-none'); divResultados.innerHTML = `<div class="alert alert-danger border-0 shadow-sm"><i class="fa-solid fa-circle-xmark me-2"></i>Error al consultar al servidor.</div>`; }
        });
    });

    async function ubicarGrupoVisualmente(idAsistente) {
        mostrarLoader();
        try {
            let resp = await fetch(`@Url.Action("ApiBuscarGrupoAsistente", "Eventos")?idAsistente=${idAsistente}&idEvento=@Model.IdEvento`);
            let data = await resp.json(); ocultarLoader();
            
            if(data.exito) { 
                document.querySelectorAll('.companion-highlight').forEach(el => el.classList.remove('companion-highlight')); 
                document.body.classList.add('dim-background');
                
                data.companeros.forEach(c => { 
                    let id = c.idAsistente || c.IdAsistente; 
                    let elementoDOM = document.getElementById('usr-' + id); 
                    if(elementoDOM) { elementoDOM.classList.add('companion-highlight'); } 
                });

                // Lanzar la alerta sutil Toast
                const toastEl = document.getElementById('toastGrupoLider');
                if(toastEl) {
                    const toast = new bootstrap.Toast(toastEl, { delay: 5000 });
                    document.getElementById('toastGrupoLiderTexto').innerHTML = `<i class="fa-solid fa-clipboard-user text-info me-2"></i>Grupo registrado por <span class="text-info">${data.lider}</span> el ${data.fecha}`;
                    toast.show();
                }

            } else { mostrarAlerta(data.mensaje); }
        } catch (err) { ocultarLoader(); mostrarAlerta("Error de conexión al buscar el grupo."); }
    }

    function seleccionarTodos() { document.querySelectorAll('#listaEspera .tarjeta-asistente:not(.d-none)').forEach(el => el.classList.add('selected-card')); }
