@model RedAJP.Models.IglesiaWebPublicaViewModel
@{
    Layout = "~/Views/Shared/LayoutPaginasWEB.cshtml";
    string nombreReal = string.IsNullOrWhiteSpace(Model.NombreIglesia) ? "" : Model.NombreIglesia;
    ViewData["Title"] = nombreReal;

    bool hasEventos = Model.Eventos != null && Model.Eventos.Any();
    bool hasAvisos = Model.Avisos != null && Model.Avisos.Any();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Jost:wght@300;400;500;700&display=swap" rel="stylesheet">

<style>
    :root {
        --gv-bg: #ffffff;
        --gv-text: #1a1a1a;
        --gv-muted: #737373;
        --gv-border: #e5e5e5;
        --gv-accent: #cda434; /* Dorado elegante, muy usado en fotografía y bodas */
        --gv-dark: #0a0a0a;
        --font-heading: 'Cormorant Garamond', serif;
        --font-body: 'Jost', sans-serif;
    }

    body {
        background-color: var(--gv-bg);
        color: var(--gv-text);
        font-family: var(--font-body);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4, h5, h6, .serif-font {
        font-family: var(--font-heading);
        color: var(--gv-dark);
        font-weight: 600;
    }

    /* Navegación Superpuesta */
    .gv-navbar {
        position: absolute;
        top: 0;
        width: 100%;
        z-index: 1040;
        background: linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, transparent 100%);
        padding: 1.5rem 0;
    }

        .gv-navbar .navbar-brand {
            font-size: 2rem;
            color: #ffffff !important;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

    .gv-nav-link {
        color: rgba(255,255,255,0.8);
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 1.5px;
        margin: 0 15px;
        text-decoration: none;
        transition: color 0.3s;
    }

        .gv-nav-link:hover {
            color: #ffffff;
        }

    /* Carrusel Principal (Hero) */
    .hero-carousel {
        height: 90vh;
        min-height: 600px;
        background-color: var(--gv-dark);
        position: relative;
    }

    .carousel-inner, .carousel-item {
        height: 100%;
    }

        .carousel-item img {
            object-fit: cover;
            height: 100%;
            width: 100%;
            opacity: 0.7; /* Oscurecemos para que resalte el texto */
        }

    .carousel-caption-custom {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        width: 100%;
        max-width: 900px;
        padding: 0 20px;
        z-index: 10;
        color: #ffffff;
    }

    /* Secciones minimalistas */
    .gv-section {
        padding: 100px 0;
    }

    .gv-section-title {
        font-size: 3rem;
        margin-bottom: 3rem;
        text-align: center;
        letter-spacing: -0.5px;
    }

    /* Grid de Fotografías (Masonry) */
    .masonry-gallery {
        column-count: 1;
        column-gap: 20px;
    }

    @@media (min-width: 576px) {
        .masonry-gallery {
            column-count: 2;
        }
    }

    @@media (min-width: 992px) {
        .masonry-gallery {
            column-count: 3;
        }
    }

    .masonry-item {
        break-inside: avoid;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
        background-color: var(--gv-border);
    }

        .masonry-item img {
            width: 100%;
            display: block;
            transition: transform 0.6s ease, filter 0.6s ease;
            filter: grayscale(20%); /* Toque fotográfico */
        }

        .masonry-item:hover img {
            transform: scale(1.03);
            filter: grayscale(0%);
        }

    .masonry-caption {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 30px 20px 20px;
        background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
        color: white;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .masonry-item:hover .masonry-caption {
        opacity: 1;
    }

    /* Tarjetas Editoriales (Eventos y Avisos) */
    .editorial-card {
        background: var(--gv-bg);
        border: 1px solid var(--gv-border);
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: box-shadow 0.4s;
    }

        .editorial-card:hover {
            box-shadow: 0 15px 40px rgba(0,0,0,0.06);
        }

    .editorial-img-wrapper {
        position: relative;
        padding-top: 65%;
        background-color: var(--gv-border);
        overflow: hidden;
    }

        .editorial-img-wrapper img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .date-tag {
        font-family: var(--font-body);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--gv-accent);
        font-weight: 500;
        margin-bottom: 10px;
        display: block;
    }

    /* Puntos Doctrinales Adaptación Minimalista */
    .doctrina-wrapper {
        border: 1px solid var(--gv-border);
        padding: 3rem;
        background: #fff;
    }

        .doctrina-wrapper .doctrina-main-title {
            color: var(--gv-dark);
            font-family: var(--font-heading);
            text-align: left !important;
            font-size: 2.5rem;
        }

        .doctrina-wrapper .doctrina-badge {
            background-color: var(--gv-dark) !important;
            display: none; /* Oculto por estética */
        }

        .doctrina-wrapper .doctrina-num {
            color: var(--gv-accent) !important;
            font-family: var(--font-heading);
            font-size: 1.5rem;
        }

        .doctrina-wrapper .doctrina-title {
            font-family: var(--font-body);
            font-weight: 500;
            letter-spacing: 1px;
        }

        .doctrina-wrapper .accordion-button {
            padding: 1.5rem 1rem;
        }

            .doctrina-wrapper .accordion-button:not(.collapsed) {
                background-color: transparent;
                box-shadow: none;
                color: var(--gv-accent);
            }

    /* Botones */
    .btn-gv {
        background-color: transparent;
        color: #ffffff;
        border: 1px solid #ffffff;
        padding: 12px 35px;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.85rem;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-gv:hover {
            background-color: #ffffff;
            color: var(--gv-dark);
        }

    .btn-gv-dark {
        background-color: var(--gv-dark);
        color: #ffffff;
        border: 1px solid var(--gv-dark);
        padding: 12px 35px;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.85rem;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-gv-dark:hover {
            background-color: transparent;
            color: var(--gv-dark);
        }
</style>

<nav class="gv-navbar">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
        <a class="navbar-brand serif-font mb-3 mb-md-0" href="#">@nombreReal</a>
        <div class="d-none d-lg-flex align-items-center">
            @if (Model.Galeria != null && Model.Galeria.Any())
            {
                <a href="#galeria" class="gv-nav-link">Galería</a>
            }
            @if (hasEventos || hasAvisos)
            {
                <a href="#eventos" class="gv-nav-link">Eventos</a>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Historia))
            {
                <a href="#nosotros" class="gv-nav-link">Nosotros</a>
            }
            <a href="#contacto" class="gv-nav-link">Contacto</a>
        </div>
        <button class="btn btn-outline-light d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#menuMovil">
            <i class="fa-solid fa-bars"></i> Menú
        </button>
    </div>
    <div class="collapse d-lg-none bg-dark w-100 mt-3 p-3 text-center" id="menuMovil">
        @if (Model.Galeria != null && Model.Galeria.Any())
        {
            <a href="#galeria" class="d-block text-white text-decoration-none py-2 border-bottom border-secondary">Galería</a>
        }
        @if (hasEventos || hasAvisos)
        {
            <a href="#eventos" class="d-block text-white text-decoration-none py-2 border-bottom border-secondary">Eventos</a>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Historia))
        {
            <a href="#nosotros" class="d-block text-white text-decoration-none py-2 border-bottom border-secondary">Nosotros</a>
        }
        <a href="#contacto" class="d-block text-white text-decoration-none py-2">Contacto</a>
    </div>
</nav>

<header class="hero-carousel fade-in-up">
    @if (Model.Galeria != null && Model.Galeria.Any())
    {
        <div id="galeriaPrincipal" class="carousel slide carousel-fade h-100" data-bs-ride="carousel" data-bs-pause="false">
            <div class="carousel-inner h-100">
                @{
                    int idx = 0;
                }
                @foreach (var img in Model.Galeria.Take(5)) // Tomamos máx 5 para el hero
                {
                    <div class="carousel-item h-100 @(idx == 0 ? "active" : "")" data-bs-interval="5000">
                        <img src="@img.UrlImagen" alt="Imagen Hero" class="d-block w-100 h-100 object-fit-cover">
                    </div>
                    idx++;
                }
            </div>
            @if (Model.Galeria.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#galeriaPrincipal" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#galeriaPrincipal" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            }
        </div>
    }
    else
    {
        <div class="h-100 w-100 bg-dark d-flex align-items-center justify-content-center">
            <div class="position-absolute w-100 h-100" style="background: linear-gradient(45deg, #1a1a1a, #4a4a4a);"></div>
        </div>
    }

    <div class="carousel-caption-custom">
        @if (!string.IsNullOrWhiteSpace(Model.Municipio))
        {
            <span class="d-block text-uppercase mb-3" style="letter-spacing: 3px; font-size: 0.9rem;">
                <i class="fa-solid fa-location-dot me-2 text-warning"></i> @Model.Municipio
            </span>
        }
        <h1 class="serif-font text-white mb-4" style="font-size: clamp(3rem, 6vw, 5.5rem); line-height: 1.1;">@nombreReal</h1>

        <div class="d-flex justify-content-center gap-3 mt-5">
            @if (!string.IsNullOrWhiteSpace(Model.Whatsapp))
            {
                <a href="https://wa.me/52@(Model.Whatsapp)" target="_blank" class="btn-gv bg-success border-success text-white fw-bold">
                    <i class="fa-brands fa-whatsapp me-2"></i> WhatsApp
                </a>
            }
            <a href="#contacto" class="btn-gv">Nuestra Ubicación</a>
        </div>
    </div>
</header>

<main>
    @if (Model.Galeria != null && Model.Galeria.Any())
    {
        <section class="gv-section" id="galeria">
            <div class="container">
                <h2 class="gv-section-title serif-font">Momentos</h2>
                <div class="masonry-gallery">
                    @foreach (var img in Model.Galeria)
                    {
                        @if (!string.IsNullOrWhiteSpace(img.UrlImagen))
                        {
                            <div class="masonry-item">
                                <img src="@img.UrlImagen" alt="@(img.Titulo ?? "Fotografía")" loading="lazy">
                                @if (!string.IsNullOrWhiteSpace(img.Titulo))
                                {
                                    <div class="masonry-caption">
                                        <h6 class="m-0 serif-font fs-5 text-white">@img.Titulo</h6>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </section>
    }

    @if (hasEventos || hasAvisos)
    {
        <section class="gv-section bg-light border-top border-bottom" id="eventos">
            <div class="container">
                <div class="row g-5">

                    @if (hasEventos)
                    {
                        <div class="@(hasAvisos ? "col-lg-8" : "col-lg-10 mx-auto")">
                            <div class="d-flex align-items-baseline justify-content-between mb-4">
                                <h2 class="serif-font m-0" style="font-size: 2.5rem;">Próximos Eventos</h2>
                            </div>

                            <div class="row g-4">
                                @foreach (var ev in Model.Eventos)
                                {
                                    <div class="col-md-6">
                                        <div class="editorial-card">
                                            @if (!string.IsNullOrWhiteSpace(ev.ImagenUrl))
                                            {
                                                <div class="editorial-img-wrapper">
                                                    <img src="@ev.ImagenUrl" alt="Evento">
                                                </div>
                                            }
                                            <div class="p-4 d-flex flex-column flex-grow-1 bg-white">
                                                @if (ev.Fecha != default)
                                                {
                                                    <span class="date-tag">@ev.Fecha.ToString("dd MMM yyyy")</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(ev.Titulo))
                                                {
                                                    <h4 class="serif-font mb-2">@ev.Titulo</h4>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(ev.Horarios))
                                                {
                                                    <span class="small text-muted mb-3"><i class="fa-regular fa-clock me-1"></i> @ev.Horarios</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(ev.Descripcion))
                                                {
                                                    <p class="mb-0 text-muted small mt-auto theme-strict-text">
                                                        @Html.Raw(ev.Descripcion.Replace("\n", "<br>").Replace("\r\n", "<br>"))
                                                    </p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (hasAvisos)
                    {
                        <div class="@(hasEventos ? "col-lg-4" : "col-lg-8 mx-auto")">
                            <h2 class="serif-font mb-4" style="font-size: 2.5rem;">Avisos</h2>
                            <div class="d-flex flex-column gap-4">
                                @foreach (var aviso in Model.Avisos)
                                {
                                    <div class="p-4 bg-white border">
                                        @if (!string.IsNullOrWhiteSpace(aviso.Titulo))
                                        {
                                            <h5 class="serif-font mb-2" style="color: var(--gv-accent);">@aviso.Titulo</h5>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(aviso.Descripcion))
                                        {
                                            <p class="text-muted small mb-3 theme-strict-text">
                                                @Html.Raw(aviso.Descripcion.Replace("\n", "<br>").Replace("\r\n", "<br>"))
                                            </p>
                                        }
                                        @if (aviso.FechaExpiracion != default)
                                        {
                                            <div class="border-top pt-2 text-muted" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">
                                                Vence: @aviso.FechaExpiracion.ToString("dd/MM/yyyy")
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="gv-section" id="nosotros">
        <div class="container">
            @if (!string.IsNullOrWhiteSpace(Model.Historia))
            {
                <div class="row justify-content-center mb-5 pb-5 border-bottom">
                    <div class="col-lg-8 text-center">
                        <span class="date-tag mb-2">Nuestra Esencia</span>
                        <h2 class="gv-section-title serif-font mb-4">Historia</h2>
                        <div class="fs-5 text-muted theme-strict-text" style="line-height: 1.8; text-align: justify; text-align-last: center;">
                            @Html.Raw(Model.Historia.Replace("\n", "<br>").Replace("\r\n", "<br>"))
                        </div>
                    </div>
                </div>
            }

            <div class="row justify-content-center mt-5">
                <div class="col-lg-10">
                    <div class="text-center mb-5">
                        <span class="date-tag mb-2">Fundamento</span>
                        <h2 class="serif-font mb-0" style="font-size: 2.5rem;">Declaración de Fe</h2>
                    </div>
                    @await Html.PartialAsync("../_PuntosDoctrinales.cshtml")
                </div>
            </div>
        </div>
    </section>

    @if (Model.Multimedia != null && Model.Multimedia.Any())
    {
        <section class="gv-section bg-dark text-white">
            <div class="container">
                <div class="text-center mb-5">
                    <span class="date-tag text-white-50 mb-2">Archivo Audiovisual</span>
                    <h2 class="serif-font text-white" style="font-size: 3rem;">Multimedia</h2>
                </div>

                <div class="row justify-content-center g-5">
                    @foreach (var m in Model.Multimedia)
                    {
                        @if (!string.IsNullOrWhiteSpace(m.UrlEmbed))
                        {
                            <div class="col-lg-8">
                                @if (!string.IsNullOrWhiteSpace(m.Titulo))
                                {
                                    <h4 class="serif-font text-center text-white mb-3">@m.Titulo</h4>
                                }
                                <div class="ratio ratio-16x9 border border-secondary p-1 bg-black">
                                    @{
                                        string embedUrl = m.UrlEmbed;
                                        string ytId = "";
                                        if (embedUrl.Contains("youtu.be/")) ytId = embedUrl.Split(new[] { "youtu.be/" }, StringSplitOptions.None)[1];
                                        else if (embedUrl.Contains("watch?v=")) ytId = embedUrl.Split(new[] { "watch?v=" }, StringSplitOptions.None)[1];
                                        else if (embedUrl.Contains("embed/")) ytId = embedUrl.Split(new[] { "embed/" }, StringSplitOptions.None)[1];
                                        else if (embedUrl.Contains("/shorts/")) ytId = embedUrl.Split(new[] { "/shorts/" }, StringSplitOptions.None)[1];
                                        else if (embedUrl.Contains("/live/")) ytId = embedUrl.Split(new[] { "/live/" }, StringSplitOptions.None)[1];
                                        if (!string.IsNullOrEmpty(ytId))
                                        {
                                            ytId = ytId.Split('?')[0].Split('&')[0].Trim('/');
                                            embedUrl = "https://www.youtube.com/embed/" + ytId;
                                        }
                                    }
                                    <iframe src="@embedUrl" frameborder="0" allowfullscreen></iframe>
                                </div>
                            </div>
                        }
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.YoutubeUrl))
                {
                    <div class="text-center mt-5">
                        <a href="@Model.YoutubeUrl" target="_blank" class="btn-gv border-white text-white">Visitar Canal Completo</a>
                    </div>
                }
            </div>
        </section>
    }
</main>

<footer class="bg-light pt-5 pb-3 border-top" id="contacto">
    <div class="container pt-4">
        <div class="row g-5 mb-5 pb-5 border-bottom">
            <div class="col-lg-4">
                <h3 class="serif-font mb-4">@nombreReal</h3>

                @if (!string.IsNullOrWhiteSpace(Model.DireccionCompleta) || !string.IsNullOrWhiteSpace(Model.Municipio))
                {
                    <div class="mb-4">
                        <span class="date-tag text-muted mb-1">Dirección</span>
                        @if (!string.IsNullOrWhiteSpace(Model.DireccionCompleta))
                        {
                            <p class="mb-0 fs-5 text-dark">@Model.DireccionCompleta</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Municipio))
                        {
                            <p class="text-muted">@Model.Municipio</p>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Telefono) || !string.IsNullOrWhiteSpace(Model.Whatsapp))
                {
                    <div class="d-flex flex-column gap-3 mb-4">
                        @if (!string.IsNullOrWhiteSpace(Model.Telefono))
                        {
                            <a href="tel:@Model.Telefono" class="text-decoration-none text-dark fs-5"><i class="fa-solid fa-phone me-2 text-muted"></i> @Model.Telefono</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Whatsapp))
                        {
                            <a href="https://wa.me/52@(Model.Whatsapp)" class="text-decoration-none text-dark fs-5"><i class="fa-brands fa-whatsapp me-2 text-success"></i> WhatsApp</a>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl) || !string.IsNullOrWhiteSpace(Model.InstagramUrl) || !string.IsNullOrWhiteSpace(Model.YoutubeUrl))
                {
                    <div class="d-flex gap-3">
                        @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                        {
                            <a href="@Model.FacebookUrl" target="_blank" class="text-dark fs-4"><i class="fa-brands fa-facebook-f"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                        {
                            <a href="@Model.InstagramUrl" target="_blank" class="text-dark fs-4"><i class="fa-brands fa-instagram"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.YoutubeUrl))
                        {
                            <a href="@Model.YoutubeUrl" target="_blank" class="text-dark fs-4"><i class="fa-brands fa-youtube"></i></a>
                        }
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Horarios))
            {
                <div class="col-lg-3">
                    <h5 class="serif-font mb-4">Horarios</h5>
                    <ul class="list-unstyled">
                        @{
                            var lineas = Model.Horarios.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
                            foreach (var linea in lineas)
                            {
                                var partes = linea.Split(" | ");
                                if (partes.Length == 3)
                                {
                                    <li class="mb-3">
                                        <strong class="d-block text-dark">@partes[0]</strong>
                                        <span style="color: var(--gv-accent);">@partes[1]</span><br>
                                        <small class="text-muted theme-strict-text">@partes[2]</small>
                                    </li>
                                }
                                else
                                {
                                    <li class="mb-2 text-muted theme-strict-text">@linea</li>
                                }
                            }
                        }
                    </ul>
                </div>
            }

            @if ((Model.Latitud.HasValue && Model.Longitud.HasValue) || !string.IsNullOrWhiteSpace(Model.MapaUrl))
            {
                <div class="col-lg-5">
                    <div class="ratio ratio-4x3 bg-dark h-100">
                        @if (Model.Latitud.HasValue && Model.Longitud.HasValue)
                        {
                            string latLng = $"{Model.Latitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{Model.Longitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
                            <iframe src="https://maps.google.com/maps?q=@latLng&z=15&output=embed" frameborder="0" style="border:0; filter: grayscale(100%) contrast(1.2);" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.MapaUrl))
                        {
                            <div class="d-flex align-items-center justify-content-center text-center p-4">
                                <div>
                                    <i class="fa-solid fa-map-location-dot fs-1 text-white-50 mb-3"></i><br>
                                    <a href="@Model.MapaUrl" target="_blank" class="btn-gv-dark bg-white text-dark">Abrir en Google Maps</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="text-center text-muted small">
            <p class="mb-0">
                © @DateTime.Now.Year @nombreReal. Todos los derechos reservados.
                @if (!string.IsNullOrWhiteSpace(Model.PlantillaVista))
                {
                    <span>Plantilla: @Model.PlantillaVista</span>
                }
            </p>
        </div>
    </div>
</footer>