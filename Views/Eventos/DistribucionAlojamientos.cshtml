    //El siguiente fragmento es para mejorar el arastre de elementos, si da error borrarlo:
    // =========================================================================
    // --- MEJORA DE UX: AUTO-SCROLL SUAVE AL ARRASTRAR (DRAG & DROP) ---
    // =========================================================================
    let dragScrollInterval = null;
    let currentScrollContainer = null;
    let scrollDirection = 0; 
    let scrollSpeedBase = 12; // Velocidad del scroll (Ajústala si lo sientes muy rápido/lento)

    document.addEventListener('dragover', function(e) {
        // Buscamos si el mouse está sobre alguno de los dos paneles principales con scroll
        let container = e.target.closest('.scroll-mobile');
        
        if (!container) {
            detenerAutoScroll();
            return;
        }

        let rect = container.getBoundingClientRect();
        let threshold = 80; // Área sensible magnética en píxeles (80px desde arriba o abajo)
        
        let distToTop = e.clientY - rect.top;
        let distToBottom = rect.bottom - e.clientY;

        // Determinar dirección de movimiento
        if (distToTop < threshold && container.scrollTop > 0) {
            scrollDirection = -1; // Mover hacia arriba
            currentScrollContainer = container;
            iniciarAutoScroll();
        } else if (distToBottom < threshold && (container.scrollTop + container.clientHeight < container.scrollHeight)) {
            scrollDirection = 1; // Mover hacia abajo
            currentScrollContainer = container;
            iniciarAutoScroll();
        } else {
            detenerAutoScroll(); // Mouse en el centro seguro, detener motor
        }
    });

    // Apagar el motor si soltamos el clic o cancelamos el arrastre
    document.addEventListener('dragend', detenerAutoScroll);
    document.addEventListener('drop', detenerAutoScroll);
    document.addEventListener('dragleave', function(e) {
        if (!e.relatedTarget) detenerAutoScroll();
    });

    function iniciarAutoScroll() {
        if (dragScrollInterval) return; // Evitar duplicar el motor si ya está corriendo
        
        // Un ciclo de 20 milisegundos crea una animación súper fluida de ~50 FPS
        dragScrollInterval = setInterval(function() {
            if (currentScrollContainer) {
                currentScrollContainer.scrollTop += (scrollSpeedBase * scrollDirection);
            }
        }, 20); 
    }

    function detenerAutoScroll() {
        if (dragScrollInterval) {
            clearInterval(dragScrollInterval);
            dragScrollInterval = null;
        }
        currentScrollContainer = null;
        scrollDirection = 0;
    }
</script>
