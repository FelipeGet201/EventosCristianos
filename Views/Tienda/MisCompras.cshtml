@model List<RedAJP.Models.PedidoEntregaViewModel>
@{
    Layout = "Principal";
    ViewData["Title"] = "Mis Compras";
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-usuario');
            activarMenu('submenu-miscompras');
        }
    });
</script>

<div class="container py-5 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa-solid fa-bag-shopping me-2"></i>Mis Compras</h2>
        <a href="@Url.Action("Index")" class="btn btn-outline-primary rounded-pill px-4 shadow-sm">
            <i class="fa-solid fa-store me-2"></i> Ir a la Tienda
        </a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5 bg-light rounded-4 border border-light shadow-sm mt-4">
            <div class="mb-3">
                <i class="fa-solid fa-cart-arrow-down fa-4x text-muted opacity-25"></i>
            </div>
            <h4 class="fw-bold text-muted">Aún no tienes compras</h4>
            <p class="text-muted mb-4">Explora nuestro catálogo y encuentra productos increíbles.</p>

            <a href="@Url.Action("Index")" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm hover-scale">
                ¡Empezar a Comprar!
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                // Variables de C# para evitar errores de sintaxis en Razor
                string cardBorder = item.MensajesSinLeer > 0 ? "border border-danger border-opacity-50" : "border-0";
                string btnClass = item.MensajesSinLeer > 0 ? "btn-danger text-white shadow-sm" : "btn-outline-dark";

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 @cardBorder shadow-sm rounded-4 overflow-hidden position-relative hover-card">

                        <div class="position-absolute top-0 end-0 mt-3 me-3 z-1">
                            @if (item.IdEstatus == 30)
                            {
                                <span class="badge bg-success rounded-pill shadow-sm px-3 py-2">
                                    <i class="fa-solid fa-box-open me-1"></i> Por Recoger
                                </span>
                            }
                            else if (item.IdEstatus == 15)
                            {
                                <span class="badge bg-warning text-dark rounded-pill shadow-sm px-3 py-2">
                                    <i class="fa-solid fa-clock me-1"></i> Verificando Pago
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-dark rounded-pill px-3 py-2">Entregado</span>
                            }
                        </div>

                        <div class="card-body p-0 d-flex flex-column h-100">
                            <div class="d-flex p-3 align-items-center bg-light border-bottom flex-shrink-0">
                                <div class="bg-white rounded-3 overflow-hidden border shadow-sm flex-shrink-0" style="width: 80px; height: 80px;">
                                    @if (!string.IsNullOrEmpty(item.ImagenPreviewUrl))
                                    {
                                        <img src="@item.ImagenPreviewUrl" class="w-100 h-100 object-fit-cover">
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100 text-muted"><i class="fa-solid fa-image fa-lg"></i></div>
                                    }
                                </div>

                                <div class="ms-3 overflow-hidden pe-5 me-3">
                                    <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">PEDIDO #@item.IdPedido</small>
                                    <h6 class="mb-1 fw-bold text-dark text-truncate">@item.ResumenCompra</h6>

                                    @if (item.CantidadArticulos > 1)
                                    {
                                        <span class="badge bg-secondary bg-opacity-75 text-white rounded-pill" style="font-size: 0.65rem;">
                                            +@(item.CantidadArticulos - 1) artículos más
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="p-3 flex-grow-1">
                                <small class="d-block text-muted mb-2">
                                    <i class="fa-solid fa-cart-shopping me-1"></i> Comprado: @item.Fecha.ToString("dd/MM/yyyy")
                                </small>

                                @if (item.IdEstatus == 50)
                                {
                                    <small class="d-block text-success fw-bold mb-1">
                                        <i class="fa-solid fa-check-circle me-1"></i> ¡Entregado!
                                    </small>
                                }
                                else if (item.FechaEstimada.Year == 1900)
                                {
                                    <small class="d-block text-warning text-dark fw-bold mb-1 bg-warning bg-opacity-25 px-2 rounded" style="width: fit-content;">
                                        <i class="fa-regular fa-clock me-1"></i> Entrega: Pendiente
                                    </small>
                                }
                                else
                                {
                                    <small class="d-block text-dark fw-bold mb-1">
                                        <i class="fa-solid fa-truck-fast me-1 text-secondary"></i> Se Entrega el: @item.FechaEstimada.ToString("dd/MM/yyyy")
                                    </small>
                                }

                                <span class="fs-5 fw-bold text-primary mt-2 d-block">$@item.Total.ToString("N2")</span>
                            </div>

                            <div class="p-3 bg-white border-top mt-auto flex-shrink-0">
                                <div class="d-grid gap-2">
                                    @if (item.IdEstatus == 15)
                                    {
                                        @if (string.IsNullOrEmpty(item.RefPasarela))
                                        {
                                            <form action="@Url.Action("ReactivarPedido", "Tienda")" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idPedido" value="@item.IdPedido" />
                                                <button type="submit" class="btn btn-sm btn-warning text-dark rounded-pill fw-bold shadow-sm w-100 hover-scale" title="Continuar con la compra">
                                                    <i class="fa-solid fa-cart-arrow-down me-1"></i> Retomar Pago
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form action="@Url.Action("ReactivarPedido", "Tienda")" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idPedido" value="@item.IdPedido" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill fw-bold w-100 hover-scale" title="Verificar si el pago ya pasó">
                                                    <i class="fa-solid fa-rotate me-1"></i> Estatus del Pago
                                                </button>
                                            </form>
                                        }
                                    }

                                    @if (item.MensajesSinLeer > 0)
                                    {
                                        <a href="@Url.Action("MensajesPedido", "Tienda", new { id = item.IdPedido })"
                                           class="btn btn-sm btn-light border border-danger text-danger rounded-pill px-3 fw-bold shadow-sm d-flex justify-content-between align-items-center hover-scale">
                                            <span><i class="fa-solid fa-envelope-open-text me-2"></i>Mensajes de la Tienda</span>
                                            <span class="badge bg-danger rounded-pill pulse-icon">
                                                @item.MensajesSinLeer
                                            </span>
                                        </a>
                                    }
                                    <a href="@Url.Action("DetalleCompra", "Tienda", new { id = item.IdPedido })"
                                       class="btn btn-sm btn-dark rounded-pill px-3 fw-bold hover-scale">
                                        Ver Detalles
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-scale { transition: transform 0.2s; }
    .hover-scale:hover { transform: scale(1.05); }
    .hover-card { transition: box-shadow 0.3s; }
    .hover-card:hover { box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important; }

    @@keyframes pulse-icon {
        0% { transform: scale(1); }
        50% { transform: scale(1.25); }
        100% { transform: scale(1); }
    }
    .pulse-icon { animation: pulse-icon 1.5s infinite; }
</style>