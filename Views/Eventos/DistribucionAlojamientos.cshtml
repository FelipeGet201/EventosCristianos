    function mostrarAlerta(m, e = false) { document.getElementById('txtMensajeAlerta').innerText = m; document.getElementById('iconoAlerta').className = e ? "fa-solid fa-circle-check text-success fa-3x mb-3" : "fa-solid fa-circle-exclamation text-warning fa-3x mb-3"; modalAlertaUi.show(); }
    function solicitarConfirmacion(t, m, i, b, c, cb) { document.getElementById('tituloConfirmacion').innerText = t; document.getElementById('textoConfirmacion').innerText = m; document.getElementById('iconoConfirmacion').className = i + " fa-3x mb-3"; let btn = document.getElementById('btnAceptarConfirmacion'); btn.innerText = b; btn.className = `btn btn-${c} rounded-pill px-4 fw-bold`; accionConfirmadaCallback = cb; modalConfirmacionUi.show(); }
    async function ejecutarAccionConfirmada() { modalConfirmacionUi.hide(); if(accionConfirmadaCallback) await accionConfirmadaCallback(); }
    function filtrarEspera() { 
        let fG = document.getElementById('filtroGenero').value; 
        let fM = document.getElementById('filtroModalidad').value;
        let fA = document.getElementById('filtroAgrupacion').value; 
        let fT = document.getElementById('buscadorEspera').value.toLowerCase(); 
        let idx = 1; 
        
        document.querySelectorAll('#listaEspera .tarjeta-asistente').forEach(el => { 
            let n = el.querySelector('h6').innerText.toLowerCase(); 
            let g = el.dataset.genero; 
            let m = el.dataset.subtipo; 
            let ag = el.dataset.agrupacion;
            
            // Evaluamos la coincidencia sumando la condición de la agrupación
            if ((fG === "ALL" || g === fG) && 
                (fM === "ALL" || m === fM) && 
                (fA === "ALL" || ag === fA) && 
                n.includes(fT)) { 
                
                el.classList.remove('d-none'); 
                let spanIdx = el.querySelector('.index-asistente'); 
                if(spanIdx) spanIdx.innerText = idx + "."; 
                idx++; 
            } else {
                el.classList.add('d-none'); 
            }
        });
    }

