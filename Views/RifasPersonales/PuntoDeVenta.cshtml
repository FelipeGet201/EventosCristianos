        @if (!string.IsNullOrEmpty(Model.InfoRifa.QrGrupoWhatsappUrl))
        {
            <div style="margin-top: 20px; padding: 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; display: flex; align-items: center; gap: 15px; width: 100%;">
                <div style="font-size: 0.75rem; color: #475569; text-align: left; flex-grow: 1;">
                    <strong style="color: #0f172a; display: block; font-size: 0.85rem; margin-bottom: 4px; white-space: nowrap;">
                        <i class="fa-solid fa-trophy" style="color: #d97706;"></i> ¡Descubre si ganaste!
                    </strong>
                    Apunta tu cámara aquí para ver los resultados el día de la rifa y conocer al ganador.
                </div>
