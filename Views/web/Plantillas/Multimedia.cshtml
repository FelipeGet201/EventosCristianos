@model RedAJP.Models.IglesiaWebPublicaViewModel
@{
    Layout = "~/Views/Shared/LayoutPaginasWEB.cshtml";
    string nombreReal = string.IsNullOrWhiteSpace(Model.NombreIglesia) ? "" : Model.NombreIglesia;
    ViewData["Title"] = nombreReal;

    bool hasEventos = Model.Eventos != null && Model.Eventos.Any();
    bool hasAvisos = Model.Avisos != null && Model.Avisos.Any();

    // Obtenemos el primer video para la pantalla principal
    string mainVideoUrl = "";
    string mainVideoTitle = "";

    if (Model.Multimedia != null && Model.Multimedia.Any())
    {
        var primerVideo = Model.Multimedia.First();
        if (!string.IsNullOrWhiteSpace(primerVideo.Titulo)) { mainVideoTitle = primerVideo.Titulo; }

        if (!string.IsNullOrWhiteSpace(primerVideo.UrlEmbed))
        {
            string ytId = "";
            string embedUrl = primerVideo.UrlEmbed;
            if (embedUrl.Contains("youtu.be/")) ytId = embedUrl.Split(new[] { "youtu.be/" }, StringSplitOptions.None)[1];
            else if (embedUrl.Contains("watch?v=")) ytId = embedUrl.Split(new[] { "watch?v=" }, StringSplitOptions.None)[1];
            else if (embedUrl.Contains("embed/")) ytId = embedUrl.Split(new[] { "embed/" }, StringSplitOptions.None)[1];
            else if (embedUrl.Contains("/shorts/")) ytId = embedUrl.Split(new[] { "/shorts/" }, StringSplitOptions.None)[1];
            else if (embedUrl.Contains("/live/")) ytId = embedUrl.Split(new[] { "/live/" }, StringSplitOptions.None)[1];

            if (!string.IsNullOrEmpty(ytId))
            {
                ytId = ytId.Split('?')[0].Split('&')[0].Trim('/');
                mainVideoUrl = "https://www.youtube.com/embed/" + ytId;
            }
        }
    }
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        /* Paleta Formal / Institucional */
        --bc-bg-base: #0b1120; /* Azul muy oscuro */
        --bc-bg-surface: #1e293b; /* Slate 800 */
        --bc-bg-hover: #334155; /* Slate 700 */
        /* Textos protegidos para modo oscuro */
        --bc-text-main: #f8fafc; /* Blanco puro para títulos */
        --bc-text-muted: #cbd5e1; /* Slate 300 - Gris claro para párrafos */

        --bc-accent: #d4af37; /* Dorado elegante */
        --bc-accent-hover: #b5952f;
        --bc-border: rgba(255, 255, 255, 0.1);
        --font-heading: 'Montserrat', sans-serif;
        --font-body: 'Inter', sans-serif;
    }

    /* ¡BLINDAJE DE FONDO! El !important fuerza el fondo oscuro sobre el Layout maestro */
    body, html {
        background-color: var(--bc-bg-base) !important;
        color: var(--bc-text-muted) !important;
        font-family: var(--font-body);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
    }

    /* Aseguramos que main y las secciones base también respeten el fondo */
    main {
        background-color: var(--bc-bg-base) !important;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-heading);
        color: var(--bc-text-main) !important;
        font-weight: 700;
        margin-bottom: 0;
    }

    /* Clases de Utilidad estrictas */
    .text-main-fix {
        color: var(--bc-text-main) !important;
    }

    .text-muted-fix {
        color: var(--bc-text-muted) !important;
    }

    .text-accent-fix {
        color: var(--bc-accent) !important;
    }

    /* Navbar Formal */
    .nav-broadcast {
        background-color: rgba(11, 17, 32, 0.95) !important;
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--bc-border);
        padding: 1.2rem 0;
    }

    .nav-brand {
        font-family: var(--font-heading);
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--bc-text-main) !important;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .nav-brand i {
            color: var(--bc-accent);
        }

    .nav-link-bc {
        color: var(--bc-text-muted);
        font-weight: 500;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-left: 2rem;
        text-decoration: none;
        transition: color 0.3s;
    }

        .nav-link-bc:hover {
            color: var(--bc-accent);
        }

    /* Botones Elegantes */
    .btn-gold {
        background-color: var(--bc-accent);
        color: #000000 !important;
        border: none;
        border-radius: 4px;
        padding: 10px 24px;
        font-family: var(--font-heading);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
    }

        .btn-gold:hover {
            background-color: var(--bc-accent-hover);
            transform: translateY(-2px);
        }

    .btn-outline-gold {
        background-color: transparent;
        color: var(--bc-accent) !important;
        border: 1px solid var(--bc-accent);
        border-radius: 4px;
        padding: 10px 24px;
        font-family: var(--font-heading);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
    }

        .btn-outline-gold:hover {
            background-color: rgba(212, 175, 55, 0.1);
        }

    /* Theater Mode (Hero) */
    .theater-section {
        padding: 4rem 0 6rem;
        background: radial-gradient(circle at top center, var(--bc-bg-surface), var(--bc-bg-base) 80%) !important;
        border-bottom: 1px solid var(--bc-border);
    }

    .theater-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .theater-player {
        background-color: #000;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        border: 1px solid var(--bc-border);
    }

    /* Secciones y Tarjetas */
    .bc-section {
        padding: 5rem 0;
        background-color: var(--bc-bg-base) !important;
    }

    .bc-section-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        color: var(--bc-text-main) !important;
    }

        .bc-section-title::before {
            content: '';
            display: inline-block;
            width: 4px;
            height: 24px;
            background-color: var(--bc-accent);
            margin-right: 12px;
        }

    .bc-card {
        background-color: var(--bc-bg-surface);
        border: 1px solid var(--bc-border);
        border-radius: 8px;
        padding: 2rem;
        height: 100%;
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

        .bc-card:hover {
            transform: translateY(-4px);
            border-color: var(--bc-accent);
        }

    /* Carrusel de Mensajes */
    .video-scroll-container {
        display: flex;
        overflow-x: auto;
        gap: 1.5rem;
        padding-bottom: 1.5rem;
        scroll-snap-type: x mandatory;
        scrollbar-width: thin;
        scrollbar-color: var(--bc-accent) var(--bc-bg-surface);
    }

        .video-scroll-container::-webkit-scrollbar {
            height: 8px;
        }

        .video-scroll-container::-webkit-scrollbar-track {
            background: var(--bc-bg-surface);
            border-radius: 4px;
        }

        .video-scroll-container::-webkit-scrollbar-thumb {
            background-color: var(--bc-accent);
            border-radius: 4px;
        }

    .video-item {
        flex: 0 0 85%;
        scroll-snap-align: start;
        background-color: var(--bc-bg-surface);
        border: 1px solid var(--bc-border);
        border-radius: 8px;
        overflow: hidden;
    }

    @@media (min-width: 768px) {
        .video-item {
            flex: 0 0 45%;
        }
    }

    @@media (min-width: 992px) {
        .video-item {
            flex: 0 0 30%;
        }
    }

    /* Galería */
    .galeria-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .galeria-card {
        aspect-ratio: 16/9;
        border-radius: 8px;
        overflow: hidden;
        position: relative;
        border: 1px solid var(--bc-border);
    }

        .galeria-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .galeria-card:hover img {
            transform: scale(1.05);
        }

    /* Puntos Doctrinales Forzados */
    .doctrina-wrapper {
        background: transparent !important;
        border: 1px solid var(--bc-border);
        border-radius: 8px;
    }

        .doctrina-wrapper .doctrina-header {
            display: none;
        }

        .doctrina-wrapper .accordion {
            border-radius: 0;
            box-shadow: none !important;
        }

        .doctrina-wrapper .doctrina-item {
            background: transparent !important;
            border: none !important;
            border-bottom: 1px solid var(--bc-border) !important;
        }

            .doctrina-wrapper .doctrina-item:last-child {
                border-bottom: none !important;
            }

        .doctrina-wrapper .doctrina-btn {
            background: var(--bc-bg-surface) !important;
            color: var(--bc-text-main) !important;
            padding: 1.5rem;
            font-family: var(--font-heading);
            font-size: 1.05rem;
        }

            .doctrina-wrapper .doctrina-btn:not(.collapsed) {
                background: rgba(212, 175, 55, 0.1) !important;
                color: var(--bc-accent) !important;
                box-shadow: inset 0 -1px 0 var(--bc-border);
            }

        .doctrina-wrapper .doctrina-num {
            color: var(--bc-accent) !important;
            font-weight: 700;
        }

        .doctrina-wrapper .doctrina-body {
            background: var(--bc-bg-base) !important;
            padding: 2rem;
            color: var(--bc-text-muted) !important;
            border-top: 1px solid var(--bc-border);
        }

        .doctrina-wrapper .text-dark {
            color: var(--bc-text-main) !important;
        }

        .doctrina-wrapper .text-secondary {
            color: var(--bc-text-muted) !important;
        }

        .doctrina-wrapper .accordion-button::after {
            filter: invert(1) grayscale(100%) brightness(200%);
        }
</style>

<nav class="nav-broadcast sticky-top">
    <div class="container d-flex justify-content-between align-items-center">
        <a href="#" class="nav-brand text-decoration-none">
            <i class="fa-solid fa-satellite-dish me-2"></i>@nombreReal
        </a>
        <div class="d-none d-lg-flex align-items-center">
            @if (Model.Multimedia != null && Model.Multimedia.Count > 1)
            {
                <a href="#archivo" class="nav-link-bc">Archivo</a>
            }
            @if (hasEventos || hasAvisos)
            {
                <a href="#agenda" class="nav-link-bc">Agenda</a>
            }
            @if (Model.Galeria != null && Model.Galeria.Any())
            {
                <a href="#galeria" class="nav-link-bc">Galería</a>
            }
            <a href="#institucional" class="nav-link-bc">Institucional</a>
        </div>
        <button class="btn btn-outline-light d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#menuMovil">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>
</nav>

<div class="collapse bg-dark d-lg-none border-bottom" id="menuMovil" style="border-color: var(--bc-border) !important;">
    <div class="container py-3 d-flex flex-column gap-3 text-start">
        @if (Model.Multimedia != null && Model.Multimedia.Count > 1)
        {
            <a href="#archivo" class="text-main-fix text-decoration-none fw-bold text-uppercase">Archivo</a>
        }
        @if (hasEventos || hasAvisos)
        {
            <a href="#agenda" class="text-main-fix text-decoration-none fw-bold text-uppercase">Agenda</a>
        }
        @if (Model.Galeria != null && Model.Galeria.Any())
        {
            <a href="#galeria" class="text-main-fix text-decoration-none fw-bold text-uppercase">Galería</a>
        }
        <a href="#institucional" class="text-main-fix text-decoration-none fw-bold text-uppercase">Institucional</a>
    </div>
</div>

<main>
    @if (!string.IsNullOrWhiteSpace(mainVideoUrl))
    {
        <section class="theater-section fade-in-up">
            <div class="container theater-container">
                <div class="text-center mb-4">
                    @if (!string.IsNullOrWhiteSpace(Model.Municipio))
                    {
                        <span class="badge mb-3 py-2 px-3" style="background-color: rgba(212, 175, 55, 0.1); color: var(--bc-accent); border: 1px solid var(--bc-accent); font-weight: 500; letter-spacing: 1px;">
                            <i class="fa-solid fa-circle-dot me-2"></i> Desde @Model.Municipio
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(mainVideoTitle))
                    {
                        <h1 class="display-5 text-main-fix mb-2">@mainVideoTitle</h1>
                    }
                </div>

                <div class="theater-player ratio ratio-16x9 mb-5">
                    <iframe src="@mainVideoUrl" frameborder="0" allowfullscreen></iframe>
                </div>

                <div class="d-flex justify-content-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(Model.Whatsapp))
                    {
                        <a href="https://wa.me/52@(Model.Whatsapp)" class="btn-gold">
                            <i class="fa-brands fa-whatsapp me-2 fs-5"></i> Contacto Directo
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.YoutubeUrl))
                    {
                        <a href="@Model.YoutubeUrl" target="_blank" class="btn-outline-gold">
                            <i class="fa-brands fa-youtube me-2 fs-5"></i> Suscribirse
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    @if (Model.Multimedia != null && Model.Multimedia.Count > 1)
    {
        <section id="archivo" class="bc-section border-bottom" style="border-color: var(--bc-border) !important;">
            <div class="container">
                <h2 class="bc-section-title">Archivo de Mensajes</h2>
                <div class="video-scroll-container">
                    @foreach (var m in Model.Multimedia.Skip(1))
                    {
                        <div class="video-item d-flex flex-column">
                            <div class="ratio ratio-16x9 border-bottom" style="border-color: var(--bc-border) !important;">
                                @if (!string.IsNullOrWhiteSpace(m.UrlEmbed))
                                {
                                    string embedUrl = m.UrlEmbed;
                                    string ytId = "";
                                    if (embedUrl.Contains("youtu.be/")) ytId = embedUrl.Split(new[] { "youtu.be/" }, StringSplitOptions.None)[1];
                                    else if (embedUrl.Contains("watch?v=")) ytId = embedUrl.Split(new[] { "watch?v=" }, StringSplitOptions.None)[1];
                                    else if (embedUrl.Contains("embed/")) ytId = embedUrl.Split(new[] { "embed/" }, StringSplitOptions.None)[1];
                                    else if (embedUrl.Contains("/shorts/")) ytId = embedUrl.Split(new[] { "shorts/" }, StringSplitOptions.None)[1];
                                    else if (embedUrl.Contains("/live/")) ytId = embedUrl.Split(new[] { "live/" }, StringSplitOptions.None)[1];

                                    if (!string.IsNullOrEmpty(ytId)) { embedUrl = "https://www.youtube.com/embed/" + ytId.Split('?')[0].Split('&')[0].Trim('/'); }
                                    <iframe src="@embedUrl" frameborder="0" allowfullscreen loading="lazy"></iframe>
                                }
                            </div>
                            <div class="p-3 flex-grow-1 d-flex align-items-center">
                                <h6 class="mb-0 text-main-fix fw-bold text-truncate" title="@m.Titulo">@(string.IsNullOrWhiteSpace(m.Titulo) ? "Video" : m.Titulo)</h6>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @if (hasEventos || hasAvisos)
    {
        <section id="agenda" class="bc-section border-bottom" style="border-color: var(--bc-border) !important; background-color: var(--bc-bg-surface) !important;">
            <div class="container">
                <div class="row g-5">

                    @if (hasEventos)
                    {
                        <div class="@(hasAvisos ? "col-lg-7" : "col-lg-8 mx-auto")">
                            <h2 class="bc-section-title">Próximos Eventos</h2>
                            <div class="d-flex flex-column gap-4">
                                @foreach (var ev in Model.Eventos)
                                {
                                    <div class="bc-card d-flex flex-column flex-md-row gap-4 align-items-center align-items-md-start" style="background-color: var(--bc-bg-base) !important;">
                                        @if (!string.IsNullOrWhiteSpace(ev.ImagenUrl))
                                        {
                                            <div style="width: 140px; height: 140px; border-radius: 4px; overflow: hidden; flex-shrink: 0; border: 1px solid var(--bc-border);">
                                                <img src="@ev.ImagenUrl" alt="Evento" style="width: 100%; height: 100%; object-fit: cover;">
                                            </div>
                                        }
                                        <div class="flex-grow-1 w-100 text-center text-md-start">
                                            @if (!string.IsNullOrWhiteSpace(ev.Titulo))
                                            {
                                                <h4 class="text-main-fix mb-2">@ev.Titulo</h4>
                                            }
                                            <div class="d-flex flex-wrap justify-content-center justify-content-md-start gap-3 mb-3">
                                                @if (ev.Fecha != default)
                                                {
                                                    <span class="badge text-dark" style="background-color: var(--bc-accent);"><i class="fa-regular fa-calendar me-1"></i> @ev.Fecha.ToString("dd MMM yyyy")</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(ev.Horarios))
                                                {
                                                    <span class="text-accent-fix small fw-bold"><i class="fa-regular fa-clock me-1"></i> @ev.Horarios</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(ev.Descripcion))
                                            {
                                                <p class="text-muted-fix small mb-0">@Html.Raw(ev.Descripcion.Replace("\n", "<br>").Replace("\r\n", "<br>"))</p>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (hasAvisos)
                    {
                        <div class="@(hasEventos ? "col-lg-5" : "col-lg-8 mx-auto")">
                            <h2 class="bc-section-title">Tablero de Avisos</h2>
                            <div class="d-flex flex-column gap-3">
                                @foreach (var aviso in Model.Avisos)
                                {
                                    <div class="bc-card" style="border-left: 4px solid var(--bc-accent); background-color: var(--bc-bg-base) !important;">
                                        @if (!string.IsNullOrWhiteSpace(aviso.Titulo))
                                        {
                                            <h6 class="text-main-fix mb-2">@aviso.Titulo</h6>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(aviso.Descripcion))
                                        {
                                            <p class="text-muted-fix small mb-3">@Html.Raw(aviso.Descripcion.Replace("\n", "<br>").Replace("\r\n", "<br>"))</p>
                                        }
                                        @if (aviso.FechaExpiracion != default)
                                        {
                                            <div class="border-top pt-2 text-muted-fix" style="border-color: var(--bc-border) !important; font-size: 0.75rem; text-transform: uppercase;">
                                                Válido hasta: @aviso.FechaExpiracion.ToString("dd/MM/yyyy")
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @if (Model.Galeria != null && Model.Galeria.Any())
    {
        <section id="galeria" class="bc-section border-bottom" style="border-color: var(--bc-border) !important;">
            <div class="container">
                <h2 class="bc-section-title">Galería Institucional</h2>
                <div class="galeria-grid">
                    @foreach (var img in Model.Galeria)
                    {
                        @if (!string.IsNullOrWhiteSpace(img.UrlImagen))
                        {
                            <div class="galeria-card">
                                <img src="@img.UrlImagen" alt="@(img.Titulo ?? "Foto")" loading="lazy">
                                @if (!string.IsNullOrWhiteSpace(img.Titulo))
                                {
                                    <div class="position-absolute bottom-0 start-0 w-100 p-2" style="background: linear-gradient(transparent, rgba(0,0,0,0.9));">
                                        <span class="text-main-fix small fw-bold">@img.Titulo</span>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </section>
    }

    <section id="institucional" class="bc-section">
        <div class="container">
            <div class="row g-5">
                @if (!string.IsNullOrWhiteSpace(Model.Historia))
                {
                    <div class="col-lg-5">
                        <h2 class="bc-section-title">Nuestra Historia</h2>
                        <div class="text-muted-fix fs-6" style="text-align: justify;">
                            @Html.Raw(Model.Historia.Replace("\n", "<br>").Replace("\r\n", "<br>"))
                        </div>
                    </div>
                }
                <div class="@(!string.IsNullOrWhiteSpace(Model.Historia) ? "col-lg-7" : "col-lg-8 mx-auto")">
                    <h2 class="bc-section-title">Declaración de Fe</h2>
                    <div class="mt-4">
                        @await Html.PartialAsync("../_PuntosDoctrinales.cshtml")
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<footer class="border-top pt-5 pb-4" style="border-color: var(--bc-border) !important; background-color: #070b14 !important;">
    <div class="container">
        <div class="row g-5 mb-5 pb-5 border-bottom" style="border-color: var(--bc-border) !important;">

            <div class="col-lg-4 text-center text-lg-start">
                <h3 class="text-main-fix mb-4 font-heading" style="text-transform: uppercase; letter-spacing: 1px;">@nombreReal</h3>

                @if (!string.IsNullOrWhiteSpace(Model.DireccionCompleta) || !string.IsNullOrWhiteSpace(Model.Municipio) || !string.IsNullOrWhiteSpace(Model.Telefono) || !string.IsNullOrWhiteSpace(Model.Whatsapp))
                {
                    <div class="d-flex flex-column gap-3 mb-4 text-muted-fix">
                        @if (!string.IsNullOrWhiteSpace(Model.DireccionCompleta) || !string.IsNullOrWhiteSpace(Model.Municipio))
                        {
                            <div>
                                <i class="fa-solid fa-map-pin text-accent-fix me-2"></i>
                                @if (!string.IsNullOrWhiteSpace(Model.DireccionCompleta))
                                {
                                    <span>@Model.DireccionCompleta</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Municipio))
                                {
                                    <br>
                        
                                    <small class="ms-4">@Model.Municipio</small>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Telefono))
                        {
                            <div><i class="fa-solid fa-phone text-accent-fix me-2"></i> @Model.Telefono</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Whatsapp))
                        {
                            <div><i class="fa-brands fa-whatsapp text-accent-fix me-2"></i> @Model.Whatsapp</div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl) || !string.IsNullOrWhiteSpace(Model.InstagramUrl) || !string.IsNullOrWhiteSpace(Model.YoutubeUrl))
                {
                    <div class="d-flex gap-3 justify-content-center justify-content-lg-start">
                        @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                        {
                            <a href="@Model.FacebookUrl" target="_blank" class="text-muted-fix fs-4"><i class="fa-brands fa-facebook-f"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                        {
                            <a href="@Model.InstagramUrl" target="_blank" class="text-muted-fix fs-4"><i class="fa-brands fa-instagram"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.YoutubeUrl))
                        {
                            <a href="@Model.YoutubeUrl" target="_blank" class="text-muted-fix fs-4"><i class="fa-brands fa-youtube"></i></a>
                        }
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Horarios))
            {
                <div class="col-lg-3 text-center text-lg-start">
                    <h5 class="text-main-fix font-heading mb-4 text-uppercase" style="font-size: 1rem; letter-spacing: 1px;">Horarios Generales</h5>
                    <div class="text-muted-fix small">
                        @{
                            var lineas = Model.Horarios.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
                            foreach (var linea in lineas)
                            {
                                var partes = linea.Split(" | ");
                                if (partes.Length == 3)
                                {
                                    <div class="mb-3 border-bottom pb-2" style="border-color: var(--bc-border) !important;">
                                        <strong class="text-main-fix">@partes[0]</strong>
                                        <span class="text-accent-fix float-end fw-bold">@partes[1]</span><br>
                                        <span style="opacity: 0.8;">@partes[2]</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="mb-3 border-bottom pb-2 text-truncate" style="border-color: var(--bc-border) !important;">@linea</div>
                                }
                            }
                        }
                    </div>
                </div>
            }

            @if ((Model.Latitud.HasValue && Model.Longitud.HasValue) || !string.IsNullOrWhiteSpace(Model.MapaUrl))
            {
                <div class="col-lg-5">
                    <div class="ratio ratio-16x9 ratio-lg-4x3 rounded overflow-hidden border" style="border-color: var(--bc-border); background-color: var(--bc-bg-surface) !important;">
                        @if (Model.Latitud.HasValue && Model.Longitud.HasValue)
                        {
                            string lat = Model.Latitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
                            string lon = Model.Longitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
                            string mapUrl = $"https://maps.google.com/maps?q={lat},{lon}&hl=es&z=16&output=embed";

                            <iframe src="@mapUrl" frameborder="0" style="border:0; filter: invert(90%) hue-rotate(180deg) grayscale(40%) contrast(110%); width: 100%; height: 100%;" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.MapaUrl))
                        {
                            <div class="d-flex align-items-center justify-content-center p-3">
                                <a href="@Model.MapaUrl" target="_blank" class="btn-outline-gold rounded-pill">Ver en Google Maps</a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-muted-fix" style="font-size: 0.8rem; opacity: 0.6;">
            <p class="mb-2 mb-md-0">© @DateTime.Now.Year @nombreReal. Todos los derechos reservados.</p>
            @if (!string.IsNullOrWhiteSpace(Model.PlantillaVista))
            {
                <p class="mb-0">Plantilla: @Model.PlantillaVista</p>
            }
        </div>
    </div>
</footer>