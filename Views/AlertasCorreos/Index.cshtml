@using RedAJP.Globales
@model List<RedAJP.Models.AlertaCorreoViewModel>

@{
    Layout = "Principal";
    ViewData["Title"] = "Gestión de Alertas de Correo";

    bool p_Editar = User.TienePermiso(Parametros.Modulos.AlertasCorreos, Parametros.Permisos.Editar);
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-alertascorreos');
        }
    });
</script>

<div class="container py-4 fade-in">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--header-footer);">
                <i class="fa-solid fa-envelopes-bulk me-2 text-primary"></i>Alertas del Sistema
            </h2>
            <p class="text-muted mb-0 small">Configura a quién le llegan los avisos automáticos</p>
        </div>

        <div class="alert alert-primary py-2 px-3 border-0 small shadow-sm mb-0 text-center rounded-3">
            <i class="fa-solid fa-shield-halved me-1"></i>
            Aqui puedes agregar o borrar destinatarios para cada alerta del sistema.
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 15px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4">Evento / Alerta</th>
                            <th class="d-none d-lg-table-cell">Destinatarios</th>
                            <th class="d-none d-md-table-cell">Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-circle p-2 me-3 text-primary d-none d-sm-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="fa-solid fa-bell"></i>
                                        </div>
                                        <div style="min-width: 0;">
                                            <span class="fw-bold d-block text-dark text-wrap text-break mb-1">
                                                @item.ClaveEvento
                                            </span>
                                            <div class="small text-muted text-wrap text-break mb-2" style="max-width: 400px;">
                                                @item.Descripcion
                                            </div>

                                            <div class="d-lg-none d-flex flex-column gap-1 mt-2">
                                                <div class="small text-primary text-wrap text-break fw-bold">
                                                    <i class="fa-solid fa-at me-1"></i> @item.CorreosDestino
                                                </div>
                                                <div class="d-md-none mt-1">
                                                    @if (item.Activo)
                                                    {
                                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill">Activo</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill">Inactivo</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td class="d-none d-lg-table-cell" style="max-width: 250px;">
                                    <div class="small text-primary text-wrap text-break fw-bold">
                                        @item.CorreosDestino
                                    </div>
                                </td>

                                <td class="d-none d-md-table-cell">
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill">Inactivo</span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end flex-wrap gap-1">
                                        @if (p_Editar)
                                        {
                                            <button class="btn btn-light btn-sm text-primary"
                                                    onclick="abrirModalEditar(@item.IdAlerta, '@item.ClaveEvento', '@item.CorreosDestino')">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>

                                            <form method="post" action="@Url.Action("ToggleEstado", "AlertasCorreos")" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.IdAlerta" />
                                                <input type="hidden" name="estadoActual" value="@item.Activo.ToString()" />

                                                <button type="submit" class="btn btn-light btn-sm @(item.Activo ? "text-success" : "text-secondary")"
                                                        title="@(item.Activo ? "Apagar Alerta" : "Encender Alerta")">
                                                    <i class="fa-solid @(item.Activo ? "fa-toggle-on fa-lg" : "fa-toggle-off fa-lg")"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title fw-bold text-muted">Configurar Destinatarios</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" action="@Url.Action("Editar", "AlertasCorreos")">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" id="Edit_Id" name="Id_Alerta" />
                    <input type="hidden" id="Edit_Correos_Hidden" name="Correos_Destino" />

                    <div class="mb-3">
                        <label class="small fw-bold text-muted">Evento / Clave</label>
                        <input type="text" class="form-control bg-light text-muted" id="Edit_Clave" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="small fw-bold text-muted">Agregar Correo</label>
                        <div class="input-group mb-2">
                            <input type="email" id="nuevoCorreoInput" class="form-control" placeholder="ejemplo@@gmail.com">
                            <button type="button" class="btn btn-secondary" onclick="agregarCorreoBadge()">
                                <i class="fa-solid fa-plus"></i> Añadir
                            </button>
                        </div>
                    </div>

                    <div>
                        <label class="small fw-bold text-muted mb-2">Destinatarios Actuales:</label>
                        <div id="contenedorCorreos" class="d-flex flex-wrap gap-2 p-3 border rounded bg-light" style="min-height: 80px; border-style: dashed !important;">
                        </div>
                    </div>

                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" style="background-color: var(--header-footer); border: none;">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let listaCorreosActuales = [];
    const inputNuevoCorreo = document.getElementById('nuevoCorreoInput');

    // Limpia el tooltip de error apenas el usuario empiece a escribir de nuevo
    inputNuevoCorreo.addEventListener('input', function() {
        this.setCustomValidity('');
    });

    function abrirModalEditar(id, clave, correosString) {
        document.getElementById('Edit_Id').value = id;
        document.getElementById('Edit_Clave').value = clave;

        inputNuevoCorreo.value = '';
        inputNuevoCorreo.setCustomValidity(''); // Resetea cualquier error previo

        if (correosString && correosString.trim() !== '') {
            listaCorreosActuales = correosString.split(',').map(c => c.trim()).filter(c => c !== '');
        } else {
            listaCorreosActuales = [];
        }

        renderizarCorreos();
        new bootstrap.Modal(document.getElementById('modalEditar')).show();
    }

    function renderizarCorreos() {
        const contenedor = document.getElementById('contenedorCorreos');
        contenedor.innerHTML = '';

        if (listaCorreosActuales.length === 0) {
            contenedor.innerHTML = '<span class="text-muted small w-100 text-center my-auto">No hay correos configurados.</span>';
        } else {
            listaCorreosActuales.forEach((correo, index) => {
                const badge = document.createElement('span');
                badge.className = 'badge bg-primary d-flex align-items-center gap-2 py-2 px-3 shadow-sm text-wrap text-break';
                badge.style.fontSize = '14px';
                badge.innerHTML = `
                    <i class="fa-solid fa-envelope"></i> ${correo}
                    <i class="fa-solid fa-xmark ms-1" style="cursor: pointer; font-size: 16px;" onclick="eliminarCorreo(${index})" title="Quitar correo"></i>
                `;
                contenedor.appendChild(badge);
            });
        }

        document.getElementById('Edit_Correos_Hidden').value = listaCorreosActuales.join(',');
    }

    function agregarCorreoBadge() {
        const nuevoCorreo = inputNuevoCorreo.value.trim().toLowerCase();

        // Limpiar errores previos
        inputNuevoCorreo.setCustomValidity('');

        if (nuevoCorreo === '') return;

        const regexEmail = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

        if (!regexEmail.test(nuevoCorreo)) {
            // Muestra el globo nativo de error en el input en vez del alert()
            inputNuevoCorreo.setCustomValidity('Por favor, ingresa un formato de correo electrónico válido.');
            inputNuevoCorreo.reportValidity();
            return;
        }

        if (listaCorreosActuales.includes(nuevoCorreo)) {
            // Muestra el globo nativo de error
            inputNuevoCorreo.setCustomValidity('Este correo ya está en la lista.');
            inputNuevoCorreo.reportValidity();
            return;
        }

        listaCorreosActuales.push(nuevoCorreo);
        inputNuevoCorreo.value = '';
        renderizarCorreos();
    }

    function eliminarCorreo(index) {
        listaCorreosActuales.splice(index, 1);
        renderizarCorreos();
    }

    // Evitar submit al dar Enter y disparar la validación/agregado
    inputNuevoCorreo.addEventListener('keypress', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            agregarCorreoBadge();
        }
    });
</script>

<style>
    .fade-in {
        animation: fadeIn 0.5s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>