<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Lora:ital,wght@0,400;0,600;1,400&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">

    @{
        var modelo = ViewData.Model as RedAJP.Models.IglesiaWebPublicaViewModel;
        var tema = modelo?.Diseno?.TemaVisual;
    }
    @if (tema != null)
    {
        <style>
            :root {
                --theme-bg: @Html.Raw(tema.ColorFondo);
                --theme-surface: @Html.Raw(tema.ColorSuperficie);
                --theme-primary: @Html.Raw(tema.ColorPrimario);
                --theme-accent: @Html.Raw(tema.ColorAcento);
                --theme-text-main: @Html.Raw(tema.ColorTextoPrincipal);
                --theme-text-muted: @Html.Raw(tema.ColorTextoSecundario);
                --theme-font-title: @Html.Raw(tema.FuenteTitulos);
                --theme-font-body: @Html.Raw(tema.FuenteCuerpo);
                --radius-lg: @Html.Raw(tema.RadioBordes);
            }

            body {
                font-family: var(--theme-font-body);
                background-color: var(--theme-bg) !important;
                color: var(--theme-text-main);
            }

            h1, h2, h3, h4, h5, h6 {
                font-family: var(--theme-font-title);
                color: var(--theme-primary);
            }

            /* LA MAGIA PARA QUE LOS TEXTOS DEL USUARIO OBEDEZCAN AL TEMA */
            .theme-strict-text {
                color: var(--theme-text-main) !important;
                font-family: var(--theme-font-body) !important;
            }

                .theme-strict-text * {
                    color: inherit !important;
                    font-family: inherit !important;
                    background-color: transparent !important; /* Evita que traigan fondos blancos de Word */
                }
        </style>
    }

    <style>
        html {
            scroll-behavior: smooth;
        }

        .fade-in-up {
            animation: fadeInUp 0.8s ease-out forwards;
        }

        @Html.Raw("@") keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        /* Estilo general para iframes de video responsive */
        .ratio-16x9 iframe {
            border-radius: 0.5rem;
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15);
        }
    </style>
</head>
<body>

    @if (ViewBag.ModoPrevia == true)
    {
        <div class="alert alert-warning alert-dismissible fade show text-center fw-bold sticky-top mb-0 rounded-0 border-0" role="alert" style="z-index: 2000; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <i class="fa-solid fa-eye me-2"></i> ESTÁS EN MODO VISTA PREVIA (BORRADOR).
            <span class="fw-normal d-none d-md-inline">El público no ve esto aún.</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @RenderBody()

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>