                    <div class="modal-footer border-0 pt-0 justify-content-center">
                        <button type="button" class="btn btn-light
                            rounded-pill px-4" data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">Sí, eliminar</button>
                    </div>
                </form>
            </div>
