@model IEnumerable<RedAJP.Models.RifaPersonalViewModel>
@{
    Layout = "~/Views/Shared/Principal.cshtml";
    ViewData["Title"] = "Gestor de Rifas Personales";
    // Obtenemos el ID del usuario actual para saber si es el dueño de la rifa o un invitado
    int idUsuarioActual = int.Parse(User.FindFirst("IdUsuario")?.Value ?? "0");
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-rifaspersonales');
        }
    });
</script>
<style>
    /* Estilos Premium para las Tarjetas */
    .card-rifa {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: 1px solid rgba(0,0,0,0.05);
    }
    .card-rifa:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
    }
    .img-portada {
        height: 160px;
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        position: relative;
    }
    .img-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.6) 100%);
    }
    .badge-blur {
        backdrop-filter: blur(5px);
        background-color: rgba(255,255,255,0.9) !important;
        color: #212529 !important;
        font-weight: 700;
    }
    .icon-header-gradient {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
    }
</style>

<div class="container py-5 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-5 gap-3">
        
        <div class="d-flex align-items-center gap-3">
            <div class="icon-header-gradient p-3 rounded-circle d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 60px; height: 60px;">
                <i class="fa-solid fa-ticket fa-2x text-white"></i> </div>
            <div>
                <h2 class="fw-bold mb-0 text-dark">Mis Rifas</h2>
                <p class="mb-0 text-muted d-none d-sm-block">Gestión de sorteos y asignación de boletos.</p>
            </div>
        </div>

        <div class="flex-shrink-0">
            <a href="@Url.Action("CrearEditar", "RifasPersonales")" class="btn btn-primary rounded-pill fw-bold shadow-sm d-flex align-items-center px-3 px-md-4 py-2">
                <i class="fa-solid fa-plus me-md-2"></i> 
                <span class="d-none d-md-inline">Crear Rifa</span>
            </a>
        </div>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var rifa in Model)
            {
                bool esCreador = rifa.IdUsuarioCreador == idUsuarioActual;
                // Si no hay imagen, usamos un gradiente azul elegante de fondo
                string fondoEstilo = !string.IsNullOrEmpty(rifa.ImagenUrl) 
                    ? $"background-image: url('{rifa.ImagenUrl}');" 
                    : "background: linear-gradient(135deg, #2b5876 0%, #4e4376 100%);";

                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card card-rifa rounded-4 h-100 d-flex flex-column overflow-hidden shadow-sm bg-white">
                        
                        <div class="img-portada" style="@fondoEstilo">
                            <div class="img-overlay"></div>
                            
                            <div class="position-absolute top-0 w-100 p-3 d-flex justify-content-between align-items-start">
                                <span class="badge @(rifa.Estado == "Activa" ? "bg-success" : "bg-danger") shadow-sm">@rifa.Estado</span>
                                
                                @if (esCreador)
                                {
                                    <span class="badge badge-blur shadow-sm"><i class="fa-solid fa-crown text-warning me-1"></i> Admin</span>
                                }
                                else
                                {
                                    <span class="badge badge-blur shadow-sm"><i class="fa-solid fa-user-tag text-info me-1"></i> Vendedor</span>
                                }
                            </div>
                        </div>
                        
                        <div class="card-body p-4 flex-grow-1 mt-n2">
                            <h5 class="fw-bold text-dark text-truncate mb-1" title="@rifa.Titulo">@rifa.Titulo</h5>
                            <p class="text-muted small mb-4">
                                <i class="fa-regular fa-calendar-check text-primary me-1"></i> Sorteo: @rifa.FechaSorteo.ToString("dd MMM yyyy")
                            </p>
                            
                            <div class="d-flex justify-content-between align-items-center bg-light rounded-3 p-3 border">
                                <div class="text-center w-50 border-end">
                                    <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Costo</div>
                                    <div class="fw-bold text-success fs-5">$@rifa.CostoBoleto.ToString("0")</div>
                                </div>
                                <div class="text-center w-50">
                                    <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Boletos</div>
                                    <div class="fw-bold text-dark fs-5">@rifa.MetaBoletos</div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 p-4 pt-0">
                            <div class="row g-2">
                                @if (esCreador)
                                {
                                    if (rifa.Estado == "Activa")
                                    {
                                        <div class="col-9">
                                            <a href="@Url.Action("PanelAdministracion", "RifasPersonales", new { token = rifa.Token })" class="btn btn-dark w-100 rounded-pill fw-bold shadow-sm">
                                                <i class="fa-solid fa-chart-pie me-1"></i> Administrar
                                            </a>
                                        </div>
                                        <div class="col-3">
                                            <a href="@Url.Action("CrearEditar", "RifasPersonales", new { token = rifa.Token })" class="btn btn-outline-primary w-100 rounded-pill fw-bold shadow-sm" title="Editar Rifa">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-12">
                                            <a href="@Url.Action("PanelAdministracion", "RifasPersonales", new { token = rifa.Token })" class="btn btn-dark w-100 rounded-pill fw-bold shadow-sm">
                                                <i class="fa-solid fa-chart-pie me-1"></i> Administrar
                                            </a>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12">
                                        <a href="@Url.Action("PuntoDeVenta", "RifasPersonales", new { token = rifa.Token })" class="btn btn-dark w-100 rounded-pill fw-bold shadow-sm">
                                            <i class="fa-solid fa-store me-1"></i> Mis Boletos
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                        
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="bg-light border rounded-circle shadow-sm d-inline-flex p-4 mb-4" style="width: 110px; height: 110px; align-items: center; justify-content: center;">
                    <i class="fa-solid fa-ticket fa-3x text-primary opacity-50"></i>
                </div>
                <h4 class="fw-bold text-dark">Aún no tienes dinámicas</h4>
                <p class="text-muted mb-4">Crea tu primera rifa y empieza a administrar todo fácilmente.</p>
                <a href="@Url.Action("CrearEditar", "RifasPersonales")" class="btn btn-primary rounded-pill px-4 fw-bold">
                    Comenzar Ahora
                </a>
            </div>
        }
    </div>
</div>