                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sId" value="@Model.sIdIglesia" />
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Sí, Publicar Ahora</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        // =========================================================
        // 0. CARGAR PREVIA DE PLANTILLA Y DRAG&DROP
        // =========================================================
        document.addEventListener("DOMContentLoaded", function() {
            actualizarPreviaPlantilla(); 
            inicializarHorarios();
            var galeriaContainer = document.getElementById('contenedor-galeria');
            if (galeriaContainer) {
                new Sortable(galeriaContainer, { animation: 150, ghostClass: 'sortable-ghost', cursor: 'grabbing' });
            }
        });
        function actualizarPreviaPlantilla() {
            const select = document.getElementById('selectPlantilla');
            const img = document.getElementById('imgPreviaPlantilla');
            const icon = document.getElementById('iconPreviaPlantilla');
            const msgModular = document.getElementById('msgPlantillaModular');
            const notaModular = document.getElementById('noteModular');

            if (!select || select.selectedIndex === -1) return;

            const opcionSeleccionada = select.selectedOptions[0];
            const urlImagen = opcionSeleccionada.dataset.img;
            const esPersonalizable = opcionSeleccionada.dataset.personalizable === "true";

            // Ocultar todo por defecto
            img.style.display = 'none';
            icon.style.display = 'none';
            msgModular.style.display = 'none';
            if (notaModular) notaModular.style.display = 'none';

            if (esPersonalizable) {
                // Muestra el icono de la paleta y la nota informativa
                msgModular.style.display = 'block';
                if (notaModular) notaModular.style.display = 'block';
            }
            else if (urlImagen) {
                // Lógica para plantillas estáticas
                img.onerror = () => {
                    img.style.display = 'none';
                    icon.style.display = 'block';
                };
                img.src = urlImagen;
                img.style.display = 'block';
            } else {
                icon.style.display = 'block';
            }
        }

        // =========================================================
        // 1. REINDEXACIÓN AL ENVIAR FORMULARIO
        // =========================================================
        $('#formEditorWeb').on('submit', function () {
            $('#contenedor-avisos > .dynamic-row').each(function (index) {
                $(this).find('input, select, textarea').each(function () {
                    var name = $(this).attr('name');
                    if (name && !name.includes('Avisos.Index')) { $(this).attr('name', name.replace(/Avisos\[.*?\]/, 'Avisos[' + index + ']')); }
                });
                $(this).find('input[name="Avisos.Index"]').val(index);
            });

            $('#contenedor-eventos > .dynamic-row').each(function (index) {
                $(this).find('input, select, textarea').each(function () {
                    var name = $(this).attr('name');
                    if (name && !name.includes('Eventos.Index')) { $(this).attr('name', name.replace(/Eventos\[.*?\]/, 'Eventos[' + index + ']')); }
                });
                $(this).find('input[name="Eventos.Index"]').val(index);
            });

            $('#contenedor-galeria > .dynamic-row').each(function (index) {
                $(this).find('input').each(function () {
                    var name = $(this).attr('name');
                    if (name && !name.includes('Galeria.Index')) { $(this).attr('name', name.replace(/Galeria\[.*?\]/, 'Galeria[' + index + ']')); }
                });
                $(this).find('input[name="Galeria.Index"]').val(index);
                $(this).find('.input-orden').val(index + 1); // Fuerza el orden visual a la BD
            });

            $('#contenedor-multi > .dynamic-row').each(function (index) {
                $(this).find('input').each(function () {
                    var name = $(this).attr('name');
                    if (name && !name.includes('Multimedia.Index')) { $(this).attr('name', name.replace(/Multimedia\[.*?\]/, 'Multimedia[' + index + ']')); }
                });
                $(this).find('input[name="Multimedia.Index"]').val(index);
            });

            // COMPILAR HORARIOS A TEXTO PLANO SEPARADO POR BARRAS ( | )
            let horariosFinal = [];
            $('#contenedor-horarios .horario-row').each(function() {
                let d = $(this).find('.horario-dia').val().trim();
                let h = $(this).find('.horario-hora').val().trim();
                let a = $(this).find('.horario-act').val().trim();

                if(h !== '' || a !== '') {
                    // Removemos si escribieron | por error para no romper la lectura futura
                    h = h.replace(/\|/g, '-');
                    a = a.replace(/\|/g, '-');
                    horariosFinal.push(`${d} | ${h} | ${a}`);
                }
            });
            $('#hiddenHorarios').val(horariosFinal.join('\n'));
            return true;
        });

        // =========================================================
        // 2. GESTOR DE ARCHIVOS NUEVOS CON TÍTULOS (DATATRANSFER)
        // =========================================================
        const globalDataTransfer = new DataTransfer();
        const inputFile = document.getElementById('inputNuevasFotos');
        const previewContainer = document.getElementById('preview-nuevas-fotos');

        function agregarNuevasFotos(input) {
            if (input.files) {
                Array.from(input.files).forEach(file => {
                    if (file.size > 10 * 1024 * 1024) { alert(`El archivo ${file.name} es demasiado grande.`); return; }
                    globalDataTransfer.items.add(file);

                    var reader = new FileReader();
                    reader.onload = function(e) {
                        var div = document.createElement('div');
                        div.className = 'position-relative text-center dynamic-row bg-light p-2 rounded shadow-sm border';
                        div.style.width = '140px';

                        var img = document.createElement('img');
                        img.src = e.target.result;
                        img.className = 'img-preview-small shadow-sm w-100 mb-2 rounded';

                        // Inyección del input para el Título
                        var titleInput = document.createElement('input');
                        titleInput.type = 'text';
                        titleInput.name = 'NuevasImagenesTitulos';
                        titleInput.className = 'form-control form-control-sm mb-1';
                        titleInput.placeholder = 'Título de foto';

                        var btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'btn btn-danger btn-remove-new';
                        btn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
                        btn.onclick = function() { eliminarFotoNueva(file.name, div); };

                        div.appendChild(img);
                        div.appendChild(titleInput);
                        div.appendChild(btn);
                        previewContainer.appendChild(div);
                    }
                    reader.readAsDataURL(file);
                });
                inputFile.files = globalDataTransfer.files;
            }
        }

        function eliminarFotoNueva(fileName, divElement) {
            divElement.remove();
            const newDt = new DataTransfer();
            for (let i = 0; i < globalDataTransfer.files.length; i++) {
                if (globalDataTransfer.files[i].name !== fileName) newDt.items.add(globalDataTransfer.files[i]);
            }
            globalDataTransfer.items.clear();
            for (let i = 0; i < newDt.files.length; i++) globalDataTransfer.items.add(newDt.files[i]);
            inputFile.files = globalDataTransfer.files;
        }

        // =========================================================
        // 3. FUNCIONES COMPARTIDAS
        // =========================================================
        function eliminarFila(btn) { $(btn).closest('.dynamic-row').remove(); }

        function eliminarFotoVisual(id) {
            document.getElementById('hdnDel_' + id).value = 'true';
            document.getElementById('imgBox_' + id).style.display = 'none';
        }

        function previewImagenUnica(input, imgId) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) { document.getElementById(imgId).src = e.target.result; }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function inyectarTemplate(templateId, contenedorId) {
            var templateHtml = document.getElementById(templateId).innerHTML;
            var uid = 'Nuevo_' + Date.now();
            var finalHtml = templateHtml.replace(/__INDEX__/g, uid);
            document.getElementById(contenedorId).insertAdjacentHTML('beforeend', finalHtml);
        }

        function agregarAviso() { inyectarTemplate('template-aviso', 'contenedor-avisos'); }
        function agregarEvento() { inyectarTemplate('template-evento', 'contenedor-eventos'); }
        function agregarMulti() { inyectarTemplate('template-multimedia', 'contenedor-multi'); }
        function agregarUrlGaleria() { inyectarTemplate('template-galeria-url', 'contenedor-urls'); }

                // ====== GESTOR DE HORARIOS ESTRUCTURADOS ======
        const rawHorariosStr = `@Html.Raw((Model.HorariosIglesia ?? "").Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", "\\n").Replace("\r", ""))`;

        function inicializarHorarios() {
            const lineas = rawHorariosStr.split(/\r?\n/);
            let encontrados = 0;

            lineas.forEach(linea => {
                if (!linea.trim()) return;
                const partes = linea.split(' | ');

                // Si respeta el formato "Día | Hora | Actividad" lo dibuja hermoso
                if (partes.length === 3) {
                    agregarHorario(partes[0].trim(), partes[1].trim(), partes[2].trim());
                    encontrados++;
                }
            });

            // Si el texto está vacío o era texto viejo sin formato, ponemos 1 fila limpia en blanco
            if (encontrados === 0) agregarHorario('Domingo', '', '');
        }

        function agregarHorario(dia = 'Domingo', hora = '', act = '') {
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = document.getElementById('template-horario').innerHTML;
            const row = tempDiv.firstElementChild;

            const selectDia = row.querySelector('.horario-dia');
            // Si el día guardado en la BD no existe en el Select, lo creamos dinámicamente
            if (!Array.from(selectDia.options).some(opt => opt.value === dia) && dia !== "") {
                selectDia.add(new Option(dia, dia));
            }
            selectDia.value = dia;
            row.querySelector('.horario-hora').value = hora;
            row.querySelector('.horario-act').value = act;

            document.getElementById('contenedor-horarios').appendChild(row);
        }
        function verDemoPlantilla() {
            const select = document.getElementById('selectPlantilla');
            if (!select || select.selectedIndex === -1) {
                alert("Por favor, selecciona una plantilla primero.");
                return;
            }
            const plantillaId = select.value;
            // Abrimos la ruta del WebController en una nueva pestaña
            window.open('/web/demo/' + plantillaId, '_blank');
        }
    </script>
}