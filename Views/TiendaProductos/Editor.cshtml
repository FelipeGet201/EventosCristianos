@model RedAJP.Models.EditorProductoViewModel
@using RedAJP.Globales

@{
    Layout = "Principal";
    ViewData["Title"] = (Model.Id_Producto == 0 ? "Nuevo" : "Editar") + " Producto";
    var listaCat = ViewBag.Categorias as IEnumerable<dynamic>;
    bool p_Borrar = User.TienePermiso(Parametros.Modulos.TiendaConfig, Parametros.Permisos.Borrar);
    bool enUso = ViewBag.ProductoEnUso != null && (bool)ViewBag.ProductoEnUso;
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-productos');
        }
    });
</script>

<div class="fade-in py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <a href="@Url.Action("Index")" class="btn btn-light rounded-circle me-3 border"><i class="fa-solid fa-arrow-left"></i></a>
            <h3 class="fw-bold mb-0 text-dark">@ViewData["Title"]</h3>
        </div>
        <div class="d-flex gap-2 align-items-center">

            @if (Model.Id_Producto > 0 && p_Borrar)
            {
                if (enUso)
                {
                    <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary px-3 py-2"
                          data-bs-toggle="tooltip"
                          title="Este producto no se puede eliminar porque tiene ventas, diseños o está en carritos activos.">
                        <i class="fa-solid fa-lock me-1"></i> Protegido
                    </span>
                }
                else
                {
                    <form id="formEliminarProducto" method="post" action="@Url.Action("Eliminar", "TiendaProductos")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id_Producto" />
                        <button type="button" class="btn btn-outline-danger rounded-pill px-3 fw-bold" onclick="mostrarModalConfirmacion()">
                            <i class="fa-solid fa-trash me-2"></i> Eliminar
                        </button>
                    </form>
                }
            }

            <button type="button" onclick="enviarFormulario()" class="btn btn-nautico rounded-pill px-4 fw-bold">
                <i class="fa-solid fa-save me-2"></i> Guardar Producto
            </button>
        </div>
    </div>

    <form id="formProducto" method="post" action="@Url.Action("Guardar", "TiendaProductos")" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id_Producto" value="@Model.Id_Producto" />
        <input type="hidden" asp-for="ImagenActualUrl" />

        <input type="hidden" name="Area_X" id="hdnX" value="@Model.Area_X" />
        <input type="hidden" name="Area_Y" id="hdnY" value="@Model.Area_Y" />
        <input type="hidden" name="Area_Ancho" id="hdnW" value="@Model.Area_Ancho" />
        <input type="hidden" name="Area_Alto" id="hdnH" value="@Model.Area_Alto" />

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm p-4" style="border-radius: 15px;">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-bold text-muted">Nombre Comercial</label>
                            <input type="text" class="form-control" name="Nombre_Comercial" value="@Model.Nombre_Comercial" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Categoría</label>
                            <select name="Id_Categoria" id="selectCategoria" class="form-select" onchange="actualizarMedidasSugeridas()" required>
                                <option value="">-- Selecciona --</option>
                                @if (listaCat != null)
                                {
                                    foreach (dynamic c in listaCat)
                                    {
                                        var selected = (Model.Id_Categoria == c.Id) ? "selected" : "";
                                        <option value="@c.Id" data-medidas="@c.Medidas" @selected>@c.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Descripción</label>
                            <textarea class="form-control" name="Descripcion" rows="3">@Model.Descripcion</textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Precio Venta ($)</label>
                            <input type="number" step="0.01" class="form-control fw-bold text-success mb-2" name="Precio_Venta"
                                   value="@Model.Precio_Venta.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required />
                            
                            <div class="form-check form-switch mt-1 p-2 bg-light rounded border border-light">
                                <input class="form-check-input ms-0 me-2" type="checkbox" id="chkComision" name="Cobrar_Comision_Extra" value="true" @(Model.Cobrar_Comision_Extra ? "checked" : "") style="cursor: pointer;">
                                <input type="hidden" name="Cobrar_Comision_Extra" value="false" />
                                <label class="form-check-label small fw-bold text-muted" for="chkComision" style="cursor: pointer;" data-bs-toggle="tooltip" title="Si se desactiva, la tienda absorberá los gastos de gestión de Stripe para este producto.">
                                    Cobrar comisión extra
                                </label>
                            </div>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label small fw-bold text-muted">Medidas y Stock</label>

                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="chkHeredar" name="Usa_Medidas_Categoria" value="true" @(Model.Usa_Medidas_Categoria ? "checked" : "") onchange="toggleMedidas()">
                                <input type="hidden" name="Usa_Medidas_Categoria" value="false" />
                                <label class="form-check-label small" for="chkHeredar">
                                    Usar medidas de la categoría (<span id="lblMedidasCat" class="fst-italic text-muted">...</span>)
                                </label>
                            </div>

                            <div id="contenedorMedidas" class="bg-light p-3 rounded border" style="max-height: 250px; overflow-y: auto;">
                            </div>

                            <button type="button" id="btnAgregarMedida" class="btn btn-sm btn-link text-decoration-none mt-1" onclick="agregarFilaMedida('', 0)">
                                <i class="fa-solid fa-plus-circle"></i> Agregar otra medida
                            </button>
                        </div>

                        <div class="col-md-6 pt-3">
                            <div class="p-3 bg-light rounded border h-100 d-flex flex-column justify-content-center">
                                <div class="form-check form-switch d-flex align-items-center">
                                    <input class="form-check-input me-3" type="checkbox" id="chkPersonalizable" name="Es_Personalizable" value="true" @(Model.Es_Personalizable ? "checked" : "") onchange="togglePersonalizable()" style="width: 3em; height: 1.5em; cursor: pointer;">
                                    <input type="hidden" name="Es_Personalizable" value="false" />
                                    <div>
                                        <label class="form-check-label fw-bold mb-0" for="chkPersonalizable" style="cursor: pointer;">¿Es Personalizable?</label>
                                        <div class="form-text small mt-0 lh-sm">Habilita la zona de impresión en la imagen principal.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Stock Total (Calculado)</label>
                            <input type="number" class="form-control bg-light" id="inputStockTotal" name="Stock_Tienda" value="@Model.Stock_Tienda" readonly tabindex="-1" />
                            <div class="form-text small">Suma automática de las tallas.</div>
                        </div>
                    </div>
                    <div class="row g3">
                        <div class="mt-4 border-top pt-3">
                            <h6 class="fw-bold text-primary mb-2 text-center">
                                <i class="fa-solid fa-print me-2"></i>Diseños a Imprimir (Solo uso interno)
                            </h6>
                            <p class="small text-muted text-center mb-3 lh-sm" style="font-size: 0.8rem;">
                                Sube las imágenes base (sin fondo) que se estamparán en este producto.<br>
                                Estas imágenes <strong>NO</strong> serán visibles para los clientes en la tienda.
                            </p>

                            <div class="row g-3">
                                <div class="col-md-6 border-end text-center">
                                    <span class="badge bg-dark mb-2 px-3 py-1 text-uppercase tracking-wider" style="font-size: 0.7rem;">Vista Frontal</span>
                                    <div class="d-flex flex-column align-items-center mt-2">
                                        <img id="previewImpresion" src="@(Model.ImagenImpresionUrl != null ? Model.ImagenImpresionUrl : "")"
                                             class="rounded border shadow-sm mb-3 object-fit-contain bg-light"
                                             style="width: 120px; height: 120px; display: @(Model.ImagenImpresionUrl != null ? "block" : "none");" />

                                        <div class="d-flex gap-2 justify-content-center mt-2">
                                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill fw-bold px-3" onclick="document.getElementById('fileImpresion').click()">
                                                <i class="fa-solid fa-upload me-2"></i> @(Model.ImagenImpresionUrl != null ? "Cambiar" : "Subir Frontal")
                                            </button>

                                            @if (Model.ImagenImpresionUrl != null)
                                            {
                                                <a href="@Model.ImagenImpresionUrl" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                                    <i class="fa-solid fa-download"></i>
                                                </a>
                                            }
                                        </div>

                                        @if (Model.ImagenImpresionUrl != null)
                                        {
                                            <div class="form-check mt-3">
                                                <input class="form-check-input" type="checkbox" name="BorrarImagenImpresion" id="chkBorrarImp" value="true">
                                                <label class="form-check-label small text-danger fw-bold" for="chkBorrarImp">
                                                    <i class="fa-solid fa-eraser me-1"></i> Eliminar frontal
                                                </label>
                                            </div>
                                        }

                                        <input type="file" id="fileImpresion" name="ArchivoImagenImpresion" accept="image/*" class="d-none" onchange="mostrarPreviewImpresion(this, 'previewImpresion')" />
                                    </div>
                                </div>

                                <div class="col-md-6 text-center">
                                    <span class="badge bg-dark mb-2 px-3 py-1 text-uppercase tracking-wider" style="font-size: 0.7rem;">Vista Posterior</span>
                                    <div class="d-flex flex-column align-items-center mt-2">
                                        <img id="previewImpresionPosterior" src="@(Model.ImagenImpresionPosteriorUrl != null ? Model.ImagenImpresionPosteriorUrl : "")"
                                             class="rounded border shadow-sm mb-3 object-fit-contain bg-light"
                                             style="width: 120px; height: 120px; display: @(Model.ImagenImpresionPosteriorUrl != null ? "block" : "none");" />

                                        <div class="d-flex gap-2 justify-content-center mt-2">
                                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill fw-bold px-3" onclick="document.getElementById('fileImpresionPosterior').click()">
                                                <i class="fa-solid fa-upload me-2"></i> @(Model.ImagenImpresionPosteriorUrl != null ? "Cambiar" : "Subir Posterior")
                                            </button>

                                            @if (Model.ImagenImpresionPosteriorUrl != null)
                                            {
                                                <a href="@Model.ImagenImpresionPosteriorUrl" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                                    <i class="fa-solid fa-download"></i>
                                                </a>
                                            }
                                        </div>

                                        @if (Model.ImagenImpresionPosteriorUrl != null)
                                        {
                                            <div class="form-check mt-3">
                                                <input class="form-check-input" type="checkbox" name="BorrarImagenImpresionPosterior" id="chkBorrarImpPost" value="true">
                                                <label class="form-check-label small text-danger fw-bold" for="chkBorrarImpPost">
                                                    <i class="fa-solid fa-eraser me-1"></i> Eliminar posterior
                                                </label>
                                            </div>
                                        }

                                        <input type="file" id="fileImpresionPosterior" name="ArchivoImagenImpresionPosterior" accept="image/*" class="d-none" onchange="mostrarPreviewImpresion(this, 'previewImpresionPosterior')" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm p-3" style="border-radius: 15px;">
                    <h6 class="fw-bold text-muted mb-3 text-center">Imagen Principal (Admite Edición)</h6>

                    <div class="position-relative bg-white rounded mb-3 overflow-hidden border mx-auto"
                         style="height: 400px; width: 100%; cursor: crosshair; background-image: url('/Images/grid_bg.png');"
                         id="contenedorImagen">

                        <img id="previewImg"
                             src="@(Model.ImagenActualUrl != null ? Model.ImagenActualUrl : "")"
                             class="w-100 h-100 object-fit-contain"
                             style="display: @(Model.ImagenActualUrl != null ? "block" : "none");" />

                        <div id="placeholderImg" class="position-absolute top-50 start-50 translate-middle text-center w-100"
                             style="display: @(Model.ImagenActualUrl != null ? "none" : "block");">
                            <i class="fa-solid fa-cloud-arrow-up fa-3x text-muted opacity-50 mb-2"></i>
                            <p class="small text-muted">Clic abajo para subir imagen principal</p>
                        </div>

                        <div id="areaRoja" class="position-absolute border border-danger bg-danger bg-opacity-25 align-items-center justify-content-center text-danger fw-bold small text-center"
                             style="display: none; box-shadow: 0 0 0 1000px rgba(0,0,0,0.5); z-index: 10;">
                            ZONA<br>IMPRESIÓN
                        </div>
                    </div>

                    <input type="file" id="fileInput" name="ArchivoImagen" accept="image/*" class="d-none" onchange="mostrarPreview(this)" />
                    <button type="button" class="btn btn-outline-dark w-100 mb-3 fw-bold" onclick="document.getElementById('fileInput').click()">
                        <i class="fa-solid fa-star me-2"></i> Cargar / Cambiar Imagen Principal
                    </button>

                    <div id="controlesArea" class="bg-light p-3 rounded border" style="display: none;">
                        <small class="text-primary fw-bold d-block mb-3 border-bottom pb-2">
                            <i class="fa-solid fa-crop-simple me-2"></i> Definir Área Permitida
                        </small>

                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-3 text-muted small text-end">Pos X</div>
                            <div class="col-9"><input type="range" class="form-range" min="0" max="100" id="sliderX" value="@Model.Area_X" oninput="actualizarDesdeSliders()"></div>
                        </div>
                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-3 text-muted small text-end">Pos Y</div>
                            <div class="col-9"><input type="range" class="form-range" min="0" max="100" id="sliderY" value="@Model.Area_Y" oninput="actualizarDesdeSliders()"></div>
                        </div>
                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-3 text-muted small text-end">Ancho</div>
                            <div class="col-9"><input type="range" class="form-range" min="10" max="100" id="sliderW" value="@Model.Area_Ancho" oninput="actualizarDesdeSliders()"></div>
                        </div>
                        <div class="row g-2 align-items-center">
                            <div class="col-3 text-muted small text-end">Alto</div>
                            <div class="col-9"><input type="range" class="form-range" min="10" max="100" id="sliderH" value="@Model.Area_Alto" oninput="actualizarDesdeSliders()"></div>
                        </div>
                    </div>

                    <div class="mt-4 border-top pt-3">
                        <h6 class="fw-bold text-muted mb-3 text-center">Galería Adicional (Vista de producto)</h6>

                        @if (Model.GaleriaActualUrls != null && Model.GaleriaActualUrls.Count > 0)
                        {
                            <div id="galeriaActualContainer" class="d-flex flex-wrap gap-2 mb-3 justify-content-center" style="transition: opacity 0.3s;">
                                @foreach (var imgGal in Model.GaleriaActualUrls)
                                {
                                    <img src="@imgGal" class="rounded border shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" />
                                }
                            </div>
                        }

                        <label class="small text-muted mb-1 d-block text-center">Subir fotos extras (Máximo 4)</label>
                        <input type="file" id="fileGaleria" name="ArchivosGaleria" accept="image/*" class="form-control form-control-sm mb-2" multiple onchange="validarGaleria(this)" />
                        <small class="text-muted d-block text-center mb-3" style="font-size: 0.75rem;">Nota: Si subes archivos aquí, reemplazarán la galería actual. Estas fotos no admiten edición ni área de impresión.</small>
                        
                        <div id="galeriaPreviewContainer" class="d-flex flex-wrap gap-3 justify-content-center mt-2"></div>
                    </div>

                    <div class="form-check form-switch mt-3 d-flex justify-content-center border-top pt-3">
                        <input class="form-check-input me-2" type="checkbox" id="Activo" name="Activo" value="true" @(Model.Activo ? "checked" : "")>
                        <input type="hidden" name="Activo" value="false" />
                        <label class="form-check-label fw-bold" for="Activo">Visible en Tienda</label>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal fade" id="alertaModal" tabindex="-1" aria-labelledby="alertaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header bg-warning text-dark border-0" style="border-radius: 15px 15px 0 0;">
                <h5 class="modal-title fw-bold" id="alertaModalLabel">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i><span id="alertaModalTitulo">Atención</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p id="alertaModalMensaje" class="mb-0 fs-6 text-muted"></p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-dark px-4 rounded-pill fw-bold" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header bg-danger text-white border-0" style="border-radius: 15px 15px 0 0;">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-trash-can me-2"></i>Confirmar Acción
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-0 fs-6 text-muted">¿Estás seguro de eliminar este producto? Esta acción no se puede deshacer y borrará permanentemente sus imágenes de la nube.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-light border px-4 rounded-pill fw-bold" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger px-4 rounded-pill fw-bold" onclick="ejecutarEliminar()">Sí, Eliminar</button>
            </div>
        </div>
    </div>
</div>

<script>
    var tallasExistentes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TallasStock));
    var archivosGaleriaArray = [];

    function mostrarAlerta(titulo, mensaje) {
        document.getElementById('alertaModalTitulo').innerText = titulo;
        document.getElementById('alertaModalMensaje').innerText = mensaje;
        var alertaModal = new bootstrap.Modal(document.getElementById('alertaModal'));
        alertaModal.show();
    }

    function mostrarModalConfirmacion() {
        var confirmarModal = new bootstrap.Modal(document.getElementById('confirmarModal'));
        confirmarModal.show();
    }

    function ejecutarEliminar() {
        document.getElementById('formEliminarProducto').submit();
    }

    function validarGaleria(input) {
        if (input.files.length > 4) {
            mostrarAlerta('Límite de imágenes', 'Solo puedes subir un máximo de 4 imágenes adicionales de galería.');
            input.value = '';
            archivosGaleriaArray = [];
            renderizarPreviewGaleria();
            return;
        }

        archivosGaleriaArray = Array.from(input.files);
        var galeriaActual = document.getElementById('galeriaActualContainer');
        if(galeriaActual) {
            galeriaActual.style.opacity = archivosGaleriaArray.length > 0 ? '0.3' : '1';
        }

        renderizarPreviewGaleria();
    }

    function renderizarPreviewGaleria() {
        var container = document.getElementById('galeriaPreviewContainer');
        container.innerHTML = '';
        
        archivosGaleriaArray.forEach((file, index) => {
            var reader = new FileReader();
            reader.onload = function(e) {
                var col = document.createElement('div');
                col.className = 'd-flex flex-column align-items-center gap-1';
                
                var imgWrapper = document.createElement('div');
                imgWrapper.className = 'position-relative border rounded shadow-sm bg-white';
                imgWrapper.style.padding = '3px';
                
                var img = document.createElement('img');
                img.src = e.target.result;
                img.style.width = '70px';
                img.style.height = '70px';
                img.style.objectFit = 'cover';
                img.className = 'rounded';
                
                var btnDel = document.createElement('button');
                btnDel.type = 'button';
                btnDel.className = 'btn btn-danger p-0 position-absolute rounded-circle shadow';
                btnDel.style.width = '20px';
                btnDel.style.height = '20px';
                btnDel.style.top = '-8px';
                btnDel.style.right = '-8px';
                btnDel.style.lineHeight = '0';
                btnDel.innerHTML = '<i class="fa-solid fa-times" style="font-size:11px;"></i>';
                btnDel.onclick = function() { eliminarArchivoGaleria(index); };
                
                imgWrapper.appendChild(img);
                imgWrapper.appendChild(btnDel);

                var controls = document.createElement('div');
                controls.className = 'btn-group w-100 shadow-sm';
                
                var btnLeft = document.createElement('button');
                btnLeft.type = 'button';
                btnLeft.className = 'btn btn-sm btn-light border py-0 text-secondary';
                btnLeft.innerHTML = '<i class="fa-solid fa-caret-left"></i>';
                btnLeft.disabled = index === 0;
                btnLeft.onclick = function() { moverArchivoGaleria(index, -1); };

                var btnRight = document.createElement('button');
                btnRight.type = 'button';
                btnRight.className = 'btn btn-sm btn-light border py-0 text-secondary';
                btnRight.innerHTML = '<i class="fa-solid fa-caret-right"></i>';
                btnRight.disabled = index === archivosGaleriaArray.length - 1;
                btnRight.onclick = function() { moverArchivoGaleria(index, 1); };
                
                controls.appendChild(btnLeft);
                controls.appendChild(btnRight);
                
                col.appendChild(imgWrapper);
                col.appendChild(controls);
                
                container.appendChild(col);
            };
            reader.readAsDataURL(file);
        });
        
        sincronizarInputGaleria();
    }

    function sincronizarInputGaleria() {
        var dt = new DataTransfer();
        archivosGaleriaArray.forEach(f => dt.items.add(f));
        document.getElementById('fileGaleria').files = dt.files;
        
        if(archivosGaleriaArray.length === 0) {
            var galeriaActual = document.getElementById('galeriaActualContainer');
            if(galeriaActual) galeriaActual.style.opacity = '1';
        }
    }

    function moverArchivoGaleria(index, direccion) {
        var temp = archivosGaleriaArray[index];
        archivosGaleriaArray[index] = archivosGaleriaArray[index + direccion];
        archivosGaleriaArray[index + direccion] = temp;
        renderizarPreviewGaleria();
    }

    function eliminarArchivoGaleria(index) {
        archivosGaleriaArray.splice(index, 1);
        renderizarPreviewGaleria();
    }

    function mostrarPreview(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('previewImg').src = e.target.result;
                document.getElementById('previewImg').style.display = 'block';
                document.getElementById('placeholderImg').style.display = 'none';
                togglePersonalizable();
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    function actualizarDesdeSliders() {
        var x = document.getElementById('sliderX').value;
        var y = document.getElementById('sliderY').value;
        var w = document.getElementById('sliderW').value;
        var h = document.getElementById('sliderH').value;
        var box = document.getElementById('areaRoja');
        
        box.style.left = x + '%';
        box.style.top = y + '%';
        box.style.width = w + '%';
        box.style.height = h + '%';
        
        document.getElementById('hdnX').value = x;
        document.getElementById('hdnY').value = y;
        document.getElementById('hdnW').value = w;
        document.getElementById('hdnH').value = h;
    }

    function togglePersonalizable() {
        var chk = document.getElementById('chkPersonalizable');
        var img = document.getElementById('previewImg');
        var hayImagen = img && img.style.display !== 'none' && img.getAttribute('src') && img.getAttribute('src').length > 50;
        var area = document.getElementById('areaRoja');
        var controles = document.getElementById('controlesArea');

        if (chk.checked && hayImagen) {
            area.style.display = 'flex';
            controles.style.display = 'block';
            actualizarDesdeSliders();
        } else {
            area.style.display = 'none';
            controles.style.display = 'none';
        }
    }

    function enviarFormulario() {
        var chk = document.getElementById('chkPersonalizable');
        if (!chk.checked) {
             document.getElementById('hdnX').value = 0;
             document.getElementById('hdnY').value = 0;
             document.getElementById('hdnW').value = 0;
             document.getElementById('hdnH').value = 0;
        } else {
             actualizarDesdeSliders();
        }
        document.getElementById('formProducto').submit();
    }

    function toggleMedidas() {
        var chk = document.getElementById('chkHeredar');
        var btnAdd = document.getElementById('btnAgregarMedida');

        if (chk.checked) {
            btnAdd.style.display = 'none';
            actualizarMedidasSugeridas();
        } else {
            btnAdd.style.display = 'inline-block';
            var filas = document.getElementsByClassName('fila-medida');
            for(var i=0; i < filas.length; i++) {
                var inputs = filas[i].getElementsByTagName('input');
                if (inputs.length > 0) {
                    inputs[0].readOnly = false;
                    inputs[0].classList.remove('bg-light');
                }
                var btnDel = filas[i].querySelector('.btn-outline-danger');
                if (btnDel) {
                    btnDel.style.display = 'inline-block';
                }
            }
        }
        calcularTotalStock();
    }

    function actualizarMedidasSugeridas() {
        var sel = document.getElementById('selectCategoria');
        var chk = document.getElementById('chkHeredar');
        var container = document.getElementById('contenedorMedidas');

        var opt = sel.options[sel.selectedIndex];
        var txtMedidas = opt ? (opt.getAttribute('data-medidas') || '...') : '...';
        document.getElementById('lblMedidasCat').innerText = txtMedidas;
        
        if (sel && chk && chk.checked) {
            container.innerHTML = '';
            var medidas = txtMedidas.split(',');
            medidas.forEach((m, index) => {
                var nombreLimpio = m.trim();
                if(nombreLimpio) {
                    var stockPrevio = 0;
                    if(tallasExistentes) {
                        var existente = tallasExistentes.find(t => t.Nombre === nombreLimpio);
                        if(existente) stockPrevio = existente.Stock;
                    }
                    agregarFilaMedida(nombreLimpio, stockPrevio, true);
                }
            });
            calcularTotalStock();
        }
    }

    function agregarFilaMedida(nombre, stock, nombreReadonly = false) {
        var container = document.getElementById('contenedorMedidas');
        var index = container.children.length;

        var div = document.createElement('div');
        div.className = 'd-flex gap-2 mb-2 align-items-center fila-medida';

        var inputNom = document.createElement('input');
        inputNom.type = 'text';
        inputNom.className = 'form-control form-control-sm';
        inputNom.placeholder = 'Talla (Ej: XL)';
        inputNom.name = `TallasStock[${index}].Nombre`;
        inputNom.value = nombre;
        if(nombreReadonly) {
            inputNom.readOnly = true;
            inputNom.classList.add('bg-light');
        }

        var inputStock = document.createElement('input');
        inputStock.type = 'number';
        inputStock.className = 'form-control form-control-sm input-stock-calc';
        inputStock.placeholder = 'Stock';
        inputStock.name = `TallasStock[${index}].Stock`;
        inputStock.value = stock;
        inputStock.min = 0;
        inputStock.style.width = '100px';
        inputStock.oninput = calcularTotalStock;

        var btnDel = document.createElement('button');
        btnDel.type = 'button';
        btnDel.className = 'btn btn-sm btn-outline-danger border-0';
        btnDel.innerHTML = '<i class="fa-solid fa-times"></i>';
        btnDel.onclick = function() {
            div.remove();
            calcularTotalStock();
            reindexar();
        };
        if(nombreReadonly) btnDel.style.display = 'none';

        div.appendChild(inputNom);
        div.appendChild(inputStock);
        div.appendChild(btnDel);
        container.appendChild(div);
    }

    function calcularTotalStock() {
        var inputs = document.getElementsByClassName('input-stock-calc');
        var total = 0;
        for(var i=0; i<inputs.length; i++) {
            total += parseInt(inputs[i].value || 0);
        }
        document.getElementById('inputStockTotal').value = total;
    }

    function reindexar() {
        var filas = document.getElementsByClassName('fila-medida');
        for(var i=0; i<filas.length; i++) {
            var inputs = filas[i].getElementsByTagName('input');
            inputs[0].name = `TallasStock[${i}].Nombre`;
            inputs[1].name = `TallasStock[${i}].Stock`;
        }
    }

    window.addEventListener('load', function() {
        var chk = document.getElementById('chkHeredar');
        var container = document.getElementById('contenedorMedidas');

        if (tallasExistentes && tallasExistentes.length > 0) {
            tallasExistentes.forEach(t => {
                agregarFilaMedida(t.Nombre, t.Stock, chk.checked);
            });
        } else {
             if(chk.checked) actualizarMedidasSugeridas();
        }

        // Inicializar tooltips de Bootstrap
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
          return new bootstrap.Tooltip(tooltipTriggerEl)
        })

        toggleMedidas();
        actualizarDesdeSliders();
        togglePersonalizable();
        calcularTotalStock();
    });

    function mostrarPreviewImpresion(input, idPreview) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                var preview = document.getElementById(idPreview);
                preview.src = e.target.result;
                preview.style.display = 'block';
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

