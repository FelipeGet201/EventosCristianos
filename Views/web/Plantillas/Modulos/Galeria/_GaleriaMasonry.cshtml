@model RedAJP.Models.IglesiaWebPublicaViewModel

<style>
    .galeria-masonry {
        column-count: 1;
        column-gap: 1.5rem;
    }
    @Html.Raw("@") media (min-width: 576px) {
        .galeria-masonry {
            column-count: 2;
        }
    }
    @Html.Raw("@") media (min-width: 992px) {
        .galeria-masonry {
            column-count: 3;
        }
    }

    .masonry-item {
        break-inside: avoid;
        margin-bottom: 1.5rem;
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        background-color: var(--theme-surface);
        border: 1px solid rgba(128, 128, 128, 0.2); /* Borde adaptativo */
    }

        .masonry-item img {
            width: 100%;
            display: block;
            transition: transform 0.5s ease;
        }

        .masonry-item:hover img {
            transform: scale(1.05);
        }

    .masonry-caption {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 30px 20px 20px;
        background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
        color: #ffffff; /* Se mantiene blanco por ser un overlay oscuro fijo */
        opacity: 0;
        transition: opacity 0.4s ease;
        font-family: var(--theme-font-body);
    }

    .masonry-item:hover .masonry-caption {
        opacity: 1;
    }
</style>

<div class="container py-5 fade-in-up">
    <h2 class="mb-5 text-center" style="font-family: var(--theme-font-title); font-weight: 800; color: var(--theme-primary);">
        Portafolio Visual
    </h2>

    @if (Model.Galeria != null && Model.Galeria.Any())
    {
        <div class="galeria-masonry">
            @foreach (var img in Model.Galeria)
            {
                <div class="masonry-item">
                    @if (!string.IsNullOrWhiteSpace(img.UrlImagen))
                    {
                        <img src="@img.UrlImagen" alt="@(img.Titulo ?? "Fotografía")" loading="lazy">
                        @if (!string.IsNullOrWhiteSpace(img.Titulo))
                        {
                            <div class="masonry-caption">
                                <h6 class="m-0 fw-bold" style="font-family: var(--theme-font-title);">@img.Titulo</h6>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-5 text-center" style="font-family: var(--theme-font-body); background: var(--theme-bg); color: var(--theme-text-muted);">Sin imagen</div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center p-5" style="border: 2px dashed rgba(128, 128, 128, 0.3); border-radius: 16px;">
            <p style="color: var(--theme-text-muted); font-family: var(--theme-font-body); margin: 0;">No hay fotografías registradas.</p>
        </div>
    }
</div>