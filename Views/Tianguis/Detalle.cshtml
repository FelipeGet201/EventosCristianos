@model RedAJP.Models.TianguisDetalleViewModel
@{
    Layout = "~/Views/Shared/Principal.cshtml"; ViewData["Title"] = Model.Titulo;
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-tienda');
        }
    });
</script>
<style>
    .thumbnail-galeria {
        cursor: pointer;
        transition: opacity 0.2s, transform 0.2s;
        opacity: 0.6;
    }

        .thumbnail-galeria:hover, .thumbnail-galeria.activa {
            opacity: 1;
            border-color: var(--pez-azul) !important;
            transform: scale(1.05);
        }

    .badge-reservada {
        background-color: var(--acento-dorado);
        color: var(--header-footer);
    }

    .badge-vendido {
        background-color: var(--header-footer);
        color: var(--acento-dorado);
        border: 1px solid var(--acento-dorado);
    }

    .input-oferta-wrapper {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        display: flex;
        align-items: center;
        overflow: hidden;
        height: 42px;
    }

    .input-oferta-prefix {
        color: #495057;
        font-weight: bold;
        padding-left: 1rem;
        padding-right: 0.5rem;
    }

    .input-oferta-field {
        border: none;
        box-shadow: none;
        font-weight: normal;
        color: #495057;
        padding: 0.5rem;
        width: 100%;
        outline: none;
    }

    .btn-oferta-solid {
        background-color: var(--pez-azul);
        color: #ffffff;
        font-weight: 600;
        border: none;
        border-radius: 6px;
        height: 42px;
        padding: 0 20px;
        transition: all 0.2s;
        cursor: pointer;
        white-space: nowrap;
    }

        .btn-oferta-solid:hover {
            background-color: #00acc1;
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    /* Oculta la vista pública por defecto si eres dueño */
    #vista-publica {
        display: none;
    }

    /* Diseño tipo App para la lista de interesados */
    .item-interesado {
        transition: background-color 0.2s ease;
        border-bottom: 1px solid #f0f0f0 !important;
    }

        .item-interesado.activo {
            background-color: #f4fcfe; /* Azul muy clarito para el seleccionado */
        }

    /* === NUEVOS BOTONES MÁS ELEGANTES Y MENOS ESCANDALOSOS === */
    .btn-interesado {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 8px 4px;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 700;
        line-height: 1.2;
        transition: all 0.15s ease;
        background-color: #f8f9fa; /* Fondo gris claro por defecto */
        color: #6c757d; /* Texto gris por defecto */
        border: 1px solid transparent;
    }

        .btn-interesado i {
            font-size: 1.15rem;
            margin-bottom: 4px;
        }

        /* Estilos específicos al pasar el mouse o para destacar */
        .btn-interesado.btn-chat-activo {
            background-color: var(--pez-azul);
            color: white;
            box-shadow: 0 4px 8px rgba(0, 184, 212, 0.2) !important;
        }

        .btn-interesado.btn-chat-inactivo:hover {
            background-color: #e3f2fd;
            color: var(--pez-azul);
        }

        .btn-interesado.btn-reservar {
            background-color: rgba(255, 193, 7, 0.15); /* Dorado suave */
            color: #d39e00; /* Texto dorado oscuro */
        }

            .btn-interesado.btn-reservar:hover {
                background-color: #ffc107;
                color: white;
            }

        .btn-interesado.btn-vendido {
            background-color: rgba(25, 135, 84, 0.1); /* Verde suave */
            color: #198754;
        }

            .btn-interesado.btn-vendido:hover {
                background-color: #198754;
                color: white;
            }

        .btn-interesado.btn-cancelar {
            background-color: rgba(220, 53, 69, 0.1); /* Rojo suave */
            color: #dc3545;
        }

            .btn-interesado.btn-cancelar:hover {
                background-color: #dc3545;
                color: white;
            }
</style>

<div class="fade-in py-4 mt-3">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <a href="@Url.Action("Index", "Tianguis")" class="text-decoration-none fw-bold text-muted hover-primary"><i class="fa-solid fa-arrow-left me-2"></i> Volver al Tianguis</a>

        @if (Model.EsMio)
        {
            <button id="btnToggleVista" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="toggleVista()">
                <i class="fa-regular fa-eye me-1"></i> Ver como público
            </button>
        }
    </div>

    @if (Model.EsMio)
    {
        <div id="vista-dueno">

            <div class="p-3 shadow-sm mb-4 d-flex flex-wrap justify-content-between align-items-center position-relative overflow-hidden"
                 style="background-color:#dbf6fa; border-radius: 16px; border: none;">

                <div style="position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background-color: var(--header-footer);"></div>

                <div class="d-flex align-items-center mb-2 mb-md-0 ps-2">
                    <img src="@Model.ImagenesUrls[0]" class="rounded-3 me-3 shadow-sm" style="width: 60px; height: 60px; object-fit: cover; border: 2px solid white;">

                    <div class="d-flex flex-column justify-content-center">
                        <div class="mb-1">
                            <span class="badge rounded-pill" style="background-color: rgba(7, 50, 56, 0.08); color: var(--header-footer); border: 1px solid rgba(7, 50, 56, 0.15); letter-spacing: 0.5px; font-size: 0.65rem;">
                                <i class="fa-solid fa-user-tie me-1"></i> MI PUBLICACIÓN
                            </span>
                        </div>

                        <h5 class="mb-1 fw-bold text-dark" style="line-height: 1;">@Model.Titulo</h5>

                        @if (Model.Estado == "ACT")
                        {
                            <div>
                                <a href="@Url.Action("Formulario", "Tianguis", new { sId = Model.sIdPublicacion })"
                                   class="btn btn-sm mt-1 rounded-pill shadow-sm"
                                   style="background-color: var(--header-footer); color: #ffffff; font-size: 0.7rem; padding: 4px 14px; font-weight: 600; transition: all 0.2s;">
                                    <i class="fa-solid fa-pen me-1" style="font-size: 0.6rem;"></i> Editar Información
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex align-items-center pe-3 mt-2 mt-md-0">
                    <div class="text-md-end">
                        <small class="text-muted fw-bold d-block mb-1" style="font-size:0.65rem; letter-spacing: 1px;">ESTADO ACTUAL</small>
                        @if (Model.Estado == "ACT")
                        {
                            <span class="badge rounded-pill text-white shadow-sm px-3 py-2" style="background-color: var(--alga-verde); font-size: 0.8rem;">DISPONIBLE</span>
                        }
                        else if (Model.Estado == "RES")
                        {
                            <span class="badge badge-reservada rounded-pill shadow-sm px-3 py-2" style="font-size: 0.8rem;"><i class="fa-solid fa-lock me-1"></i> RESERVADA</span>
                        }
                        else
                        {
                            <span class="badge badge-vendido rounded-pill shadow-sm px-3 py-2" style="font-size: 0.8rem;"><i class="fa-solid fa-lock me-1"></i> CERRADA</span>
                        }
                    </div>
                </div>
            </div>

            @if (Model.Estado == "VEN" || Model.Estado == "AGO")
            {
                <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white position-relative overflow-hidden">
                    <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3 mx-auto" style="width: 80px; height: 80px; background-color: rgba(0,43,54,0.05); color: var(--header-footer);">
                        <i class="fa-solid fa-handshake fa-3x"></i>
                    </div>
                    <h2 class="fw-bold text-dark mb-2">¡Artículo Entregado!</h2>
                    <p class="text-muted mb-4">Se cerró el trato con: <strong>@Model.CompradorFinalAlias</strong>.</p>
                    <span class="badge bg-light text-muted border rounded-pill px-4 py-2 mx-auto mb-4"><i class="fa-solid fa-lock me-2"></i> Transacción Finalizada.</span>

                    <div class="mx-4 mt-2 pt-4 border-top">
                        <p class="text-muted small mb-2"><i class="fa-solid fa-heart text-danger me-1"></i> ¿Te fue útil la plataforma para realizar tu venta?</p>
                        <a href="@Url.Action("Index", "Donaciones")" class="btn btn-sm btn-outline-danger rounded-pill px-4 fw-bold shadow-sm transition-all">
                            <i class="fa-solid fa-hand-holding-dollar me-1"></i> Agradecer con una Ofrenda
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden" style="border-top: 5px solid #dee2e6 !important;">

                            <div class="card-header bg-white fw-bold py-3 border-bottom text-dark d-flex align-items-center">
                                <i class="fa-solid fa-users text-muted me-2"></i> Interesados (@Model.Interesados.Count)
                            </div>

                            <div class="list-group list-group-flush overflow-auto" style="max-height: 550px;">
                                @if (Model.Interesados.Count == 0)
                                {
                                    <p class="text-center text-muted p-4">Nadie ha contactado aún.</p>
                                }
                                @{
                                    // Ordenamos: 1° Reservados, 2° Activos (INT), 3° Vendidos (COM)
                                    // Y sub-ordenamos por Talla para agrupar los de la misma variante
                                    var listaOrdenada = Model.Interesados
                                    .OrderBy(p => p.EstadoTrato == "RES" ? 1 : p.EstadoTrato == "INT" ? 2 : 3)
                                    .ThenBy(p => p.Talla)
                                    .ToList();

                                    string grupoActual = "";
                                }

                                @foreach (var p in listaOrdenada)
                                {
                                    string nombreGrupo = p.EstadoTrato == "RES" ? "📌 RESERVADOS" :
                                    p.EstadoTrato == "INT" ? "💬 EN NEGOCIACIÓN" : "✅ VENDIDOS";

                                    string estiloGrupo = p.EstadoTrato == "RES" ? "background-color: rgba(255, 193, 7, 0.15); color: #d39e00; border-bottom: 1px solid #f0f0f0;" :
                                    p.EstadoTrato == "INT" ? "background-color: rgba(0, 184, 212, 0.05); color: var(--pez-azul); border-bottom: 1px solid #f0f0f0;" :
                                    "background-color: rgba(25, 135, 84, 0.1); color: #198754; border-bottom: 1px solid #f0f0f0;";

                                    // Imprimir el encabezado solo cuando cambia el grupo
                                    if (grupoActual != p.EstadoTrato)
                                    {
                                        <div class="px-3 py-2 fw-bold text-uppercase d-flex align-items-center" style="@estiloGrupo font-size: 0.7rem; letter-spacing: 0.5px;">
                                            @nombreGrupo
                                        </div>
                                        grupoActual = p.EstadoTrato;
                                    }

                                    bool esElChatActivo = ViewBag.ChatActivo != null && (int)ViewBag.ChatActivo == p.IdInteresado;

                                    <div class="list-group-item border-0 position-relative p-3 item-interesado @(esElChatActivo ? "activo" : "")" style="border-bottom: 1px solid #f0f0f0 !important;">

                                        @if (esElChatActivo)
                                        {
                                            <div style="position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background-color: var(--pez-azul);"></div>
                                        }

                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <strong class="text-dark">@p.AliasAnonimo</strong>
                                            @if (p.EstadoTrato == "RES")
                                            {
                                                <span class="badge badge-reservada shadow-sm" style="font-size: 0.6rem;">RESERVADO</span>
                                            }
                                        </div>

                                        @if (Model.TipoVenta == "TIE")
                                        {
                                            <div class="mb-2">
                                                <span class="badge bg-light text-dark border" style="font-size: 0.65rem;">
                                                    <i class="fa-solid fa-tag text-primary me-1"></i> Talla: @p.Talla | Cantidad: @p.Cantidad
                                                </span>
                                            </div>
                                        }

                                        <div class="d-flex justify-content-between align-items-end mt-2 mb-3">
                                            <small id="msj-lateral-@p.IdInteresado" class="text-muted text-truncate" style="max-width: 60%;">@p.UltimoMensaje</small>

                                            @if (Model.TipoVenta == "SUB")
                                            {
                                                <span id="oferta-lateral-@p.IdInteresado" class="fw-bold text-success">$@p.Oferta.ToString("N0")</span>
                                            }
                                        </div>

                                        <div class="row g-2">
                                            @if (Model.Estado == "ACT" && p.EstadoTrato == "INT")
                                            {
                                                <div class="col-6">
                                                    <a href="@Url.Action("Detalle", "Tianguis", new { sId = Model.sIdPublicacion, sChatId = p.sIdInteresado })"
                                                       class="btn w-100 btn-interesado @(esElChatActivo ? "btn-chat-activo" : "btn-chat-inactivo")">
                                                        <i class="fa-regular fa-comments"></i>
                                                        <span>Chat</span>
                                                    </a>
                                                </div>
                                                <div class="col-6">
                                                    <button type="button" class="btn w-100 btn-interesado btn-reservar"
                                                            onclick="abrirModalReserva('@p.IdInteresado', '@p.AliasAnonimo', '@p.IdTalla', '@p.Cantidad')">
                                                        <i class="fa-solid fa-boxes-packing"></i>
                                                        <span>Reservar</span>
                                                    </button>
                                                </div>
                                            }
                                            else if (p.EstadoTrato == "RES")
                                            {
                                                <div class="col-4">
                                                    <a href="@Url.Action("Detalle", "Tianguis", new { sId = Model.sIdPublicacion, sChatId = p.sIdInteresado })"
                                                       class="btn w-100 btn-interesado @(esElChatActivo ? "btn-chat-activo" : "btn-chat-inactivo")">
                                                        <i class="fa-regular fa-comments"></i>
                                                        <span>Chat</span>
                                                    </a>
                                                </div>
                                                <div class="col-4">
                                                    <form action="@Url.Action("ConfirmarVenta", "Tianguis")" method="post" class="m-0 h-100">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idInteresado" value="@p.IdInteresado" />
                                                        <input type="hidden" name="idPublicacion" value="@Model.IdPublicacion" />
                                                        <button type="submit" class="btn w-100 btn-interesado btn-vendido h-100">
                                                            <i class="fa-solid fa-check"></i>
                                                            <span>Entregado</span>
                                                        </button>
                                                    </form>
                                                </div>
                                                <div class="col-4">
                                                    <form action="@Url.Action("ReabrirPublicacion", "Tianguis")" method="post" class="m-0 h-100">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idInteresado" value="@p.IdInteresado" />
                                                        <input type="hidden" name="idPublicacion" value="@Model.IdPublicacion" />
                                                        <button type="submit" class="btn w-100 btn-interesado btn-cancelar h-100">
                                                            <i class="fa-solid fa-xmark"></i>
                                                            <span>Cancelar</span>
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="col-12">
                                                    <a href="@Url.Action("Detalle", "Tianguis", new { sId = Model.sIdPublicacion, sChatId = p.sIdInteresado })"
                                                       class="btn w-100 btn-interesado @(esElChatActivo ? "btn-chat-activo" : "btn-chat-inactivo")">
                                                        <i class="fa-regular fa-comments"></i>
                                                        <span>Ver Chat</span>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-8">
                        @if (ViewBag.ChatActivo != null)
                        {
                            <div class="card border-0 shadow-sm rounded-4 d-flex flex-column h-100 overflow-hidden" style="min-height: 550px;">
                                <div style="height: 5px; background-color: var(--pez-azul); width: 100%;"></div>

                                <div class="bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark">Chat con @ViewBag.ChatAlias</h6>
                                        @if (Model.TipoVenta == "TIE")
                                        {
                                            <span class="badge bg-light text-dark border mt-1 me-1" style="font-size:0.75rem;">
                                                <i class="fa-solid fa-tag text-primary me-1"></i> Talla: @ViewBag.ChatTalla | Cant: @ViewBag.ChatCantidad
                                            </span>
                                        }
                                        @if (ViewBag.ChatEstado == "RES")
                                        {
                                            <span class="badge bg-warning text-dark mt-1" style="font-size:0.65rem;">
                                                <i class="fa-solid fa-lock me-1"></i> RESERVADO
                                            </span>
                                        }
                                    </div>
                                    <div class="text-end">
                                        @if (Model.TipoVenta == "SUB")
                                        {
                                            <small class="text-muted d-block fw-bold" style="font-size: 0.6rem; text-transform: uppercase;">Oferta</small>
                                            <span class="fs-5 fw-bold" style="color: var(--alga-verde);">$@(((decimal)ViewBag.ChatOferta).ToString("N2"))</span>
                                        }
                                        else if (Model.TipoVenta == "TIE" && Model.PrecioActual == 0)
                                        {
                                            <span class="badge bg-danger text-white mt-1 shadow-sm"><i class="fa-solid fa-hand-holding-heart me-1"></i> DONACIÓN</span>
                                        }
                                    </div>
                                </div>

                                <div class="card-body overflow-auto p-4" id="chatBoxDueno" style="background-color: #fcfcfc;">
                                    @foreach (var msg in Model.Mensajes)
                                    {
                                        if (msg.EsMio)
                                        {
                                            <div class="d-flex flex-column align-items-end mb-3">
                                                <div class="text-white rounded-4 rounded-bottom-0 p-3 shadow-sm text-start" style="background-color: var(--pez-azul); max-width: 85%; font-size: 0.95rem;">
                                                    @msg.Texto
                                                </div>
                                                <small class="text-muted mt-1" style="font-size: 0.7rem;">@msg.Fecha.ToString("HH:mm")</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column align-items-start mb-3">
                                                <div class="bg-white text-dark rounded-4 rounded-bottom-0 p-3 shadow-sm border" style="max-width: 85%; font-size: 0.95rem;">
                                                    @msg.Texto
                                                </div>
                                                <small class="text-muted mt-1" style="font-size: 0.7rem;">@msg.Fecha.ToString("HH:mm")</small>
                                            </div>
                                        }
                                    }
                                </div>

                                <div class="card-footer bg-white p-3 border-0">
                                    <form action="@Url.Action("EnviarMensaje", "Tianguis")" method="post" class="input-group shadow-sm rounded-pill overflow-hidden border">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idInteresado" value="@ViewBag.ChatActivo" />
                                        <input type="hidden" name="idPublicacion" value="@Model.IdPublicacion" />
                                        <input type="hidden" name="soyDueno" value="true" />
                                        <input type="text" name="texto" class="form-control border-0 px-4" placeholder="Responder a @ViewBag.ChatAlias..." required autocomplete="off" style="box-shadow: none;">
                                        <button class="btn btn-white text-primary px-4 border-0" type="submit">
                                            <i class="fa-solid fa-paper-plane"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <script>
                                var chatBox = document.getElementById("chatBoxDueno");
                                if(chatBox) chatBox.scrollTop = chatBox.scrollHeight;
                            </script>
                        }
                        else
                        {
                            <div class="card border-0 shadow-sm rounded-4 d-flex flex-column bg-white h-100 align-items-center justify-content-center p-5 text-center" style="min-height: 550px;">
                                <i class="fa-regular fa-comments fa-3x text-muted mb-3"></i>
                                <h5 class="fw-bold text-dark">Gestión de Interesados</h5>
                                <p class="text-muted">Selecciona "Chat" en la lista de la izquierda para platicar con el interesado, o presiona "Reservar" para apartarle el artículo.</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <div id="vista-publica" class="row g-4 mt-1" style="@(!Model.EsMio ? "display: flex;" : "")">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 p-3 p-md-4 bg-white">
                <div class="mb-3 text-center bg-light rounded-4 overflow-hidden position-relative border" style="height: 350px;">
                    <img id="imgPrincipal" src="@Model.ImagenesUrls[0]" class="img-fluid h-100 w-100" style="object-fit: contain; padding: 10px;">
                    <span class="badge position-absolute top-0 start-0 m-3 shadow-sm text-white px-3 py-2 rounded-pill" style="background-color: var(--header-footer);">@Model.Categoria</span>
                </div>

                @if (Model.ImagenesUrls.Count > 1)
                {
                    <div class="d-flex gap-2 overflow-auto pb-3 justify-content-center">
                        @foreach (var img in Model.ImagenesUrls)
                        {
                            <img src="@img" class="thumbnail-galeria rounded-3 border bg-light shadow-sm" style="width: 70px; height: 70px; object-fit: cover;"
                                 onclick="document.getElementById('imgPrincipal').src = this.src; document.querySelectorAll('.thumbnail-galeria').forEach(el => el.classList.remove('activa')); this.classList.add('activa');">
                        }
                    </div>
                }

                @if (Model.Estado == "ACT")
                {
                    <span class="badge mb-3 px-3 py-2 rounded-pill text-white" style="background-color: var(--alga-verde);">DISPONIBLE</span>
                }
                else if (Model.Estado == "RES")
                {
                    <span class="badge mb-3 px-3 py-2 rounded-pill badge-reservada"><i class="fa-solid fa-lock me-1"></i> RESERVADA</span>
                }
                else
                {
                    <span class="badge mb-3 px-3 py-2 rounded-pill badge-vendido"><i class="fa-solid fa-lock me-1"></i> CERRADO</span>
                }

                <h2 class="fw-bold mb-2 text-dark">@Model.Titulo</h2>
                <p class="text-muted mb-4"><i class="fa-solid fa-user-secret me-2"></i> @Model.VendedorAlias</p>
                <p class="text-secondary" style="line-height: 1.6;">@Model.Descripcion</p>
            </div>
        </div>

        <div class="col-lg-6">
            @if (!Model.EstaAutenticado)
            {
                <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white">
                    <i class="fa-solid fa-user-lock fa-3x text-muted mb-3"></i>
                    <h4 class="fw-bold text-dark">Inicia sesión para participar</h4>
                    <p class="text-muted px-4">Debes estar registrado para poder hacer una oferta o contactar al vendedor de forma segura y anónima.</p>
                    <a href="@Url.Action("Index", "Login")" class="btn btn-outline-dark rounded-pill mt-3 mx-auto fw-bold px-4">Iniciar Sesión</a>
                </div>
            }
            else if (Model.Participando)
            {
                <div class="card border border-light shadow-sm rounded-4 d-flex flex-column" style="height: 600px;">
