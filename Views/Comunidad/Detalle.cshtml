@model RedAJP.Models.ComunidadDetalleViewModel
@{
    Layout = "Principal";
    ViewData["Title"] = "Detalle del Mensaje";
    
    bool esAdmin = ViewBag.EsAdmin ?? false;
    bool esDirectivo = ViewBag.EsDirectivo ?? false;
    int idUserLogueado = ViewBag.IdUserLogueado ?? 0;
    bool puedeEditar = ViewBag.PuedeEditar ?? false;
    bool esAutor = Model.Id_Usuario_Autor == idUserLogueado;
    
    // Un directivo puede revisar si no es su propio mensaje privado a la directiva
    bool puedeRevisar = esDirectivo && !(esAutor && Model.Destinatario != "Directiva");
    var cultura = new System.Globalization.CultureInfo("es-MX");

    bool esInstitucionalMsg = Model.NombreAutor == "Directiva Corbán";
    bool respondeComoDirectiva = esDirectivo && (!esAutor || esInstitucionalMsg);
    bool tieneRespuestas = Model.Respuestas.Any();
    
    // Lógica de visualización del Chat
    bool tieneAutorValido = Model.Id_Usuario_Autor > 0;
    bool permisosChat = esAutor || esDirectivo || esAdmin || (Model.Destinatario == "Todos" && esInstitucionalMsg) || Model.Destinatario == "Especificos";
    bool mostrarChat = (Model.Estado == "APR") && permisosChat && tieneAutorValido;

    // Variables de Hilos para Directiva y Autores
    var hilosDisponibles = ViewBag.HilosDisponibles as List<SelectListItem> ?? new List<SelectListItem>();
    int? hiloSeleccionado = ViewBag.HiloSeleccionado as int?;
    
    // El buzón multihilo aparece para Directivos, Admins o el Autor cuando el mensaje es para "Todos" o "Especificos"
    bool esBuzonMultiHilo = (esDirectivo || esAdmin || esAutor) && (Model.Destinatario == "Todos" || Model.Destinatario == "Especificos");
}

<style>
    .rounded-pill-custom { border-radius: 50rem !important; }
    .btn-light-custom { background-color: #ffffff; border: 1px solid #dee2e6; color: #6c757d; }
    .btn-light-custom:hover { background-color: #f8f9fa; color: #495057; }
    
    .badge-privado { background-color: #6f42c1; color: white; }
    .bg-privado-subtle { background-color: #f3ebff; color: #55289d; border: 1px solid #e0cffc; }
    
    .chat-bubble { max-width: 85%; padding: 1rem 1.25rem; border-radius: 1.25rem; position: relative; word-break: break-word; overflow-wrap: anywhere; }
    .chat-mine { background-color: #0d6efd; color: white; border-bottom-right-radius: 0.25rem; }
    .chat-other { background-color: #ffffff; border: 1px solid #e9ecef; color: #212529; border-bottom-left-radius: 0.25rem; }
    
    .interaction-panel { background: linear-gradient(to right, #f8f9fc, #ffffff); border: 2px dashed #b6effb; border-radius: 1.25rem; padding: 1.5rem; }
    
    .select-hilo-nuevo { border: 2px solid #0d6efd !important; background-color: #f0f7ff !important; }
    .fade-in { animation: fadeIn 0.5s ease-in-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

<div class="container-fluid py-4 fade-in">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            
            <div class="mb-4 d-flex justify-content-between align-items-center">
                <a href="@Url.Action("Index")" class="btn btn-light-custom rounded-pill-custom px-4 fw-bold shadow-sm">
                    <i class="fa-solid fa-arrow-left me-2"></i> Volver al Buzón
                </a>
            </div>

            @* --- CARD DEL MENSAJE PRINCIPAL --- *@
            <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden">
                <div class="bg-white p-4">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-light d-flex justify-content-center align-items-center text-secondary shadow-sm" style="width: 65px; height: 65px; font-size: 1.8rem;">
                                @if(esInstitucionalMsg) { <i class="fa-solid fa-building-columns text-primary"></i> } 
                                else { <i class="fa-solid fa-user"></i> }
                            </div>
                            <div>
                                <h4 class="fw-bolder mb-1 text-dark">@Model.NombreAutor</h4>
                                <div class="d-flex align-items-center gap-2 flex-wrap text-muted small">
                                    <span><i class="fa-regular fa-calendar text-primary me-1"></i> @Model.Fecha_Creacion.ToString("dd MMM yyyy, hh:mm tt", cultura)</span>
                                    <span class="badge bg-secondary rounded-pill-custom px-3">@Model.Tipo_Mensaje</span>
                                    
                                    @if(Model.Destinatario == "Directiva") {
                                        <span class="badge bg-dark rounded-pill-custom px-3"><i class="fa-solid fa-lock me-1"></i> A Directiva</span>
                                    } else if(Model.Destinatario == "Especificos") {
                                        <span class="badge badge-privado rounded-pill-custom px-3"><i class="fa-solid fa-envelope-open-text me-1"></i> Mensaje Privado</span>
                                    }
                                </div>
                            </div>
                        </div>
                        
                        <div class="text-end">
                            @if (Model.Estado == "PEN") {
                                <span class="badge bg-warning text-dark fs-6 rounded-pill-custom px-3 py-2 shadow-sm"><i class="fa-solid fa-clock me-1"></i> Pendiente</span>
                            } else if (Model.Estado == "REC") {
                                <span class="badge bg-danger fs-6 rounded-pill-custom px-3 py-2 shadow-sm"><i class="fa-solid fa-ban me-1"></i> Rechazado</span>
                            } else if (Model.Estado == "CAN") {
                                <span class="badge bg-secondary fs-6 rounded-pill-custom px-3 py-2 shadow-sm"><i class="fa-solid fa-xmark me-1"></i> Cancelado</span>
                            }
                        </div>
                    </div>

                    <div class="mt-4">
                        @if (Model.Estado == "REC" && !string.IsNullOrEmpty(Model.Motivo_Rechazo)) {
                            <div class="alert alert-danger border-0 border-start border-4 border-danger rounded-3 mb-4 shadow-sm">
                                <h6 class="text-danger fw-bold mb-1"><i class="fa-solid fa-circle-exclamation me-2"></i>Motivo del rechazo:</h6>
                                <p class="mb-0 text-dark small" style="white-space: pre-wrap;">@Model.Motivo_Rechazo</p>
                            </div>
                        }

                        <p class="text-dark fs-5 mb-4" style="white-space: pre-wrap; line-height: 1.6;">@Model.Contenido</p>
                        
                        @if(Model.Editado) {
                            <div class="text-end mb-3">
                                @if (esAdmin) {
                                    <a href="@Url.Action("HistorialEdiciones", new { id = Model.Id_Mensaje })" class="badge bg-light text-primary border rounded-pill-custom px-3 py-2 fw-bold text-decoration-none shadow-sm">
                                        <i class="fa-solid fa-pen me-1"></i> Editado (Ver Cambios)
                                    </a>
                                } else {
                                    <span class="badge bg-light text-muted border rounded-pill-custom px-3 py-2 fw-normal">
                                        <i class="fa-solid fa-pen me-1"></i> Editado
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    @* Interacciones de Oración *@
                    @if(Model.Tipo_Mensaje == "Oracion" && Model.Destinatario == "Todos" && Model.Estado == "APR") {
                        <div class="interaction-panel mt-2 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                <div class="w-100">
                                    <h6 class="fw-bold text-dark mb-1"><i class="fa-solid fa-hands-praying text-info me-2 fs-5"></i> Apoyo de la Comunidad</h6>
                                    <p class="small text-muted mb-0">@(Model.Oracion_Atendida ? "La comunidad ya está orando." : "Sé el primero en unirte a orar.")</p>
                                </div>
                                @if(!esAutor && !Model.Oracion_Atendida) {
                                    <div class="w-100 text-end">
                                        <form action="@Url.Action("AtenderOracion")" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idMensaje" value="@Model.Id_Mensaje" />
                                            <button type="submit" class="btn btn-info text-white rounded-pill-custom px-4 py-2 fw-bold shadow-sm">Me uno a orar</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                
                @* Acciones de Autor *@
                @if(esAutor && Model.Estado != "CAN" && puedeEditar) {
                    <div class="bg-white p-3 border-top d-flex justify-content-end gap-2 flex-wrap">
                        @if(Model.Estado == "REC") {
                            <button type="button" class="btn btn-success rounded-pill-custom px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalReenviar">
                                <i class="fa-solid fa-paper-plane me-2"></i> Reenviar a Revisión
                            </button>
                        }
                        <button type="button" class="btn btn-outline-primary rounded-pill-custom px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalEditar">
                            <i class="fa-solid fa-pen me-2"></i> Editar
                        </button>
                        <button type="button" class="btn btn-outline-danger rounded-pill-custom px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCancelar">
                            <i class="fa-solid fa-trash me-2"></i> Cancelar
                        </button>
                    </div>
                }
                
                @* Panel de Moderación *@
                @if(puedeRevisar && Model.Estado == "PEN") {
                    <div class="bg-white p-4 border-top" style="border-top: 4px solid #ffc107 !important;">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-shield-halved text-warning fs-3"></i>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">Panel de Moderación</h6>
                                    <small class="text-muted">Como <strong>Directiva</strong>, debes validar este mensaje.</small>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-success rounded-pill-custom px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAprobar">
                                    <i class="fa-solid fa-check me-2"></i> Aprobar
                                </button>
                                <button type="button" class="btn btn-danger rounded-pill-custom px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalRechazar">
                                    <i class="fa-solid fa-ban me-2"></i> Rechazar
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* --- SECCIÓN DE CONVERSACIÓN (CHAT) --- *@
            @if(mostrarChat)
            {
                <div class="d-flex align-items-center mb-4 mt-5">
                    <hr class="flex-grow-1 text-muted opacity-25">
                    <h5 class="fw-bold text-secondary mx-3 mb-0"><i class="fa-regular fa-comments me-2"></i> Conversación</h5>
                    <hr class="flex-grow-1 text-muted opacity-25">
                </div>

                @* SELECTOR DE HILOS (Solo Directiva/Admin/Autor en Mensajes Multihilo) *@
                @if(esBuzonMultiHilo)
                {
                    <div class="card shadow-sm border-0 rounded-4 mb-4">
                        <div class="card-body p-3 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 bg-light rounded-4">
                            <div class="d-flex align-items-center">
                                <i class="fa-solid fa-users-viewfinder text-primary fs-3 me-3"></i>
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">Chats Activos</h6>
                                    <small class="text-muted">Selecciona un usuario para ver su hilo privado.</small>
                                </div>
                            </div>
                            <div style="min-width: 280px;">
                                @if(hilosDisponibles.Any())
                                {
                                    <form action="@Url.Action("Detalle")" method="get" id="formSelectorHilo">
                                        <input type="hidden" name="id" value="@Model.Id_Mensaje" />
                                        <select class="form-select fw-bold border-primary shadow-sm @(hilosDisponibles.Any(x => x.Text.Contains("nuevos")) ? "select-hilo-nuevo" : "")" 
                                                name="idHilo" onchange="this.form.submit();">
                                            @foreach(var hilo in hilosDisponibles)
                                            {
                                                <option value="@hilo.Value" selected="@(hiloSeleccionado?.ToString() == hilo.Value)">
                                                    @hilo.Text
                                                </option>
                                            }
                                        </select>
                                    </form>
                                }
                                else {
                                    <span class="badge bg-secondary opacity-75 d-block py-2">Sin chats activos aún</span>
                                }
                            </div>
                        </div>
                    </div>
                }
                
                @* Burbujas de Chat *@
                <div class="d-flex flex-column gap-3 mb-4">
                    @if(tieneRespuestas) {
                        @foreach(var resp in Model.Respuestas)
                        {
                            bool esMia = (resp.Id_Usuario_Hilo == idUserLogueado && !resp.EsDeDirectiva) || (resp.EsDeDirectiva && esDirectivo && resp.Nombre_Responde == "Directiva Corbán");
                            <div class="d-flex @(esMia ? "justify-content-end" : "justify-content-start") w-100">
                                <div class="chat-bubble shadow-sm @(esMia ? "chat-mine" : "chat-other")">
                                    <div class="d-flex justify-content-between align-items-center mb-1 gap-4">
                                        <span class="fw-bold small @(esMia ? "text-light" : "text-primary")">
                                            @if(resp.EsDeDirectiva) { <i class="fa-solid fa-building-columns me-1"></i> }
                                            @resp.Nombre_Responde
                                        </span>
                                    </div>
                                    <p class="mb-1" style="white-space: pre-wrap; font-size: 0.95rem;">@resp.Contenido</p>
                                    <div class="text-end mt-1">
                                        <span class="small @(esMia ? "text-white-50" : "text-muted")" style="font-size: 0.7rem;">
                                            @resp.Fecha_Creacion.ToString("dd MMM HH:mm") <i class="fa-solid fa-check ms-1"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    } else {
                        <div class="text-center py-4 text-muted opacity-50">
                            <i class="fa-regular fa-comment-dots fs-1 mb-2"></i>
                            <p>No hay mensajes en este hilo aún.</p>
                        </div>
                    }
                </div>

                @* Área de Respuesta *@
                <div class="card shadow-sm border-0 rounded-4 mb-5 overflow-hidden">
                    @if(respondeComoDirectiva) {
                        <div class="bg-warning text-dark text-center py-2 small fw-bold"><i class="fa-solid fa-building-columns me-2"></i> RESPONDIENDO COMO DIRECTIVA CORBÁN</div>
                    }
                    <div class="card-body p-2 bg-white">
                        <form action="@Url.Action("Responder")" method="post" class="d-flex align-items-end gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idMensaje" value="@Model.Id_Mensaje" />
                            @if(hiloSeleccionado.HasValue) { <input type="hidden" name="idUsuarioHilo" value="@hiloSeleccionado.Value" /> }

                            <textarea class="form-control border-0 bg-light py-3 px-4 rounded-4" name="contenido" rows="2" 
                                      placeholder="@(respondeComoDirectiva ? "Escribe la respuesta institucional..." : "Escribe tu mensaje...")" 
                                      required style="resize: none;"></textarea>
                            <button class="btn btn-primary rounded-circle shadow me-2 mb-1 d-flex align-items-center justify-content-center" 
                                    type="submit" style="width: 50px; height: 50px; flex-shrink: 0;"
                                    @(esBuzonMultiHilo && !hiloSeleccionado.HasValue && !esAutor ? "disabled" : "")>
                                <i class="fa-solid fa-paper-plane fs-5"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* --- MODALES DE ACCIÓN --- *@
@if(puedeRevisar && Model.Estado == "PEN") {
    @* Modal Aprobar *@
    <div class="modal fade" id="modalAprobar" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form action="@Url.Action("RevisarMensaje")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idMensaje" value="@Model.Id_Mensaje" />
                    <input type="hidden" name="accion" value="APR" />
                    <div class="modal-body p-5 text-center">
                        <div class="mb-4 text-success"><i class="fa-solid fa-circle-check" style="font-size: 4rem;"></i></div>
                        <h4 class="fw-bold text-dark mb-3">¿Aprobar Mensaje?</h4>
                        <p class="text-muted">Se publicará inmediatamente para los destinatarios.</p>
                    </div>
                    <div class="modal-footer border-0 pb-4 px-4 d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-light rounded-pill-custom px-4 fw-bold" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success rounded-pill-custom px-5 fw-bold shadow-sm">Sí, Aprobar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    @* Modal Rechazar *@
    <div class="modal fade" id="modalRechazar" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form action="@Url.Action("RevisarMensaje")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idMensaje" value="@Model.Id_Mensaje" />
                    <input type="hidden" name="accion" value="REC" />
                    <div class="modal-header border-bottom-0 pt-4 px-4 pb-0">
                        <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-ban me-2"></i> Rechazar Mensaje</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body px-4 pt-3">
                        <textarea class="form-control rounded-3 bg-light border-0 p-3" name="motivoRechazo" rows="5" placeholder="Explica el motivo aquí..." required></textarea>
                    </div>
                    <div class="modal-footer border-top-0 pb-4 px-4">
                        <button type="button" class="btn btn-light rounded-pill-custom px-4 fw-bold" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger rounded-pill-custom px-4 fw-bold shadow-sm">Confirmar Rechazo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if(esAutor && Model.Estado != "CAN" && puedeEditar) {
    @* Modal Editar *@
    <div class="modal fade" id="modalEditar" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form action="@Url.Action("EditarMensaje")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idMensaje" value="@Model.Id_Mensaje" />
                    <div class="modal-header border-bottom-0 pt-4 px-4 pb-0">
                        <h5 class="modal-title fw-bold text-primary"><i class="fa-solid fa-pen me-2"></i> Editar Mensaje</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body px-4 pt-3">
                        <textarea class="form-control rounded-3 bg-light border-0 p-3" name="nuevoContenido" rows="5" required>@Model.Contenido</textarea>
                    </div>
                    <div class="modal-footer border-top-0 pb-4 px-4">
                        <button type="button" class="btn btn-light rounded-pill-custom px-4 fw-bold" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary rounded-pill-custom px-4 fw-bold shadow-sm">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* Modal Cancelar *@
    <div class="modal fade" id="modalCancelar" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form action="@Url.Action("CancelarMensaje")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idMensaje" value="@Model.Id_Mensaje" />
                    <div class="modal-body p-5 text-center">
                        <div class="mb-4 text-danger"><i class="fa-solid fa-triangle-exclamation" style="font-size: 4rem;"></i></div>
                        <h4 class="fw-bold text-dark mb-3">¿Cancelar Mensaje?</h4>
                        <p class="text-muted">El mensaje ya no será visible para nadie. Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer border-0 pb-4 px-4 d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-light rounded-pill-custom px-4 fw-bold" data-bs-dismiss="modal">Volver</button>
                        <button type="submit" class="btn btn-danger rounded-pill-custom px-5 fw-bold shadow-sm">Sí, Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* Modal Reenviar *@
    @if(Model.Estado == "REC") {
        <div class="modal fade" id="modalReenviar" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow">
                    <form action="@Url.Action("ReenviarMensaje")" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idMensaje" value="@Model.Id_Mensaje" />
                        <div class="modal-body p-5 text-center">
                            <div class="mb-4 text-success"><i class="fa-solid fa-paper-plane" style="font-size: 4rem;"></i></div>
                            <h4 class="fw-bold text-dark mb-3">¿Reenviar a Revisión?</h4>
                            <p class="text-muted">Tu mensaje volverá a la fila de la Directiva para ser evaluado nuevamente.</p>
                        </div>
                        <div class="modal-footer border-0 pb-4 px-4 d-flex justify-content-center gap-2">
                            <button type="button" class="btn btn-light rounded-pill-custom px-4 fw-bold" data-bs-dismiss="modal">Volver</button>
                            <button type="submit" class="btn btn-success rounded-pill-custom px-5 fw-bold shadow-sm">Sí, Reenviar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}