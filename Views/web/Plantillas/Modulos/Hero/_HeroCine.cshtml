@model RedAJP.Models.IglesiaWebPublicaViewModel
@{
    string mainVideoUrl = "";
    string mainVideoTitle = "Transmisión Principal";
    if (Model.Multimedia != null && Model.Multimedia.Any())
    {
        var primerVideo = Model.Multimedia.First();
        if (!string.IsNullOrWhiteSpace(primerVideo.Titulo)) { mainVideoTitle = primerVideo.Titulo; }
        if (!string.IsNullOrWhiteSpace(primerVideo.UrlEmbed))
        {
            string ytId = "";
            string embedUrl = primerVideo.UrlEmbed;
            if (embedUrl.Contains("youtu.be/")) ytId = embedUrl.Split(new[] { "youtu.be/" }, StringSplitOptions.None)[1];
            else if (embedUrl.Contains("watch?v=")) ytId = embedUrl.Split(new[] { "watch?v=" }, StringSplitOptions.None)[1];
            else if (embedUrl.Contains("embed/")) ytId = embedUrl.Split(new[] { "embed/" }, StringSplitOptions.None)[1];
            else if (embedUrl.Contains("/shorts/")) ytId = embedUrl.Split(new[] { "/shorts/" }, StringSplitOptions.None)[1];
            else if (embedUrl.Contains("/live/")) ytId = embedUrl.Split(new[] { "/live/" }, StringSplitOptions.None)[1];
            if (!string.IsNullOrEmpty(ytId))
            {
                ytId = ytId.Split('?')[0].Split('&')[0].Trim('/');
                mainVideoUrl = "https://www.youtube.com/embed/" + ytId;
            }
        }
    }
}

<style>
    .hero-cine {
        padding: 4rem 0 6rem;
        background: radial-gradient(circle at top center, var(--theme-surface), var(--theme-bg) 80%);
        border-bottom: 1px solid rgba(128, 128, 128, 0.2);
        padding-top: 120px;
    }

    .hero-cine-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .hero-cine-player {
        background-color: #000;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        border: 1px solid rgba(128, 128, 128, 0.2);
    }

    .hero-cine-btn {
        background-color: var(--theme-primary);
        color: var(--theme-bg); /* Forzamos contraste con su propio fondo */
        border-radius: 8px;
        padding: 12px 28px;
        font-family: var(--theme-font-title);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
        transition: all 0.3s;
    }

        .hero-cine-btn:hover {
            background-color: var(--theme-accent);
            color: #ffffff;
            transform: translateY(-2px);
        }
</style>

<section class="hero-cine fade-in-up">
    <div class="container hero-cine-container">
        <div class="text-center mb-4">
            <span class="badge mb-3 py-2 px-3" style="background-color: rgba(128, 128, 128, 0.1); color: var(--theme-accent); border: 1px solid var(--theme-accent);">
                <i class="fa-solid fa-circle-dot me-2"></i> @(string.IsNullOrWhiteSpace(Model.Municipio) ? "En Vivo" : "Desde " + Model.Municipio)
            </span>
            <h1 class="display-5 mb-2" style="font-family: var(--theme-font-title); color: var(--theme-text-main); font-weight: 800;">
                @mainVideoTitle
            </h1>
        </div>

        <div class="hero-cine-player ratio ratio-16x9 mb-5">
            @if (!string.IsNullOrWhiteSpace(mainVideoUrl))
            {
                <iframe src="@mainVideoUrl" frameborder="0" allowfullscreen></iframe>
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center h-100 w-100" style="background: var(--theme-surface);">
                    <i class="fa-solid fa-video-slash fs-1 mb-3" style="color: var(--theme-text-muted);"></i>
                    <span style="color: var(--theme-text-muted); font-family: var(--theme-font-body);">Transmisión no disponible</span>
                </div>
            }
        </div>

        <div class="d-flex justify-content-center gap-3">
            @if (!string.IsNullOrWhiteSpace(Model.YoutubeUrl))
            {
                <a href="@Model.YoutubeUrl" target="_blank" class="hero-cine-btn" style="background-color: #ef4444; color: #ffffff;">
                    <i class="fa-brands fa-youtube me-2 fs-5"></i> Canal Oficial
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Whatsapp))
            {
                <a href="https://wa.me/52@(Model.Whatsapp)" class="hero-cine-btn">
                    Contacto Directo
                </a>
            }
        </div>
    </div>
</section>