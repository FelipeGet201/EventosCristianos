@model RedAJP.Models.IglesiaWebPublicaViewModel

<style>
    .video-scroll-container {
        display: flex;
        overflow-x: auto;
        gap: 1.5rem;
        padding-bottom: 1.5rem;
        scroll-snap-type: x mandatory;
        scrollbar-width: thin;
        scrollbar-color: var(--theme-accent) var(--theme-bg);
    }

        .video-scroll-container::-webkit-scrollbar {
            height: 8px;
        }

        .video-scroll-container::-webkit-scrollbar-track {
            background: var(--theme-bg);
            border-radius: 4px;
        }

        .video-scroll-container::-webkit-scrollbar-thumb {
            background-color: var(--theme-accent);
            border-radius: 4px;
        }

    .video-item {
        flex: 0 0 85%;
        scroll-snap-align: start;
        background-color: var(--theme-surface);
        border: 1px solid rgba(128, 128, 128, 0.2); /* Borde adaptativo */
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }
    @Html.Raw("@") media (min-width: 768px) {
        .video-item {
            flex: 0 0 45%;
        }
    }
    @Html.Raw("@") media (min-width: 992px) {
        .video-item {
            flex: 0 0 35%;
        }
    }
</style>

<div class="container py-5 fade-in-up">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <h2 style="font-family: var(--theme-font-title); font-weight: 800; color: var(--theme-primary); margin: 0;">Mensajes Recientes</h2>
        @if (!string.IsNullOrWhiteSpace(Model.YoutubeUrl))
        {
            <a href="@Model.YoutubeUrl" target="_blank" class="btn btn-sm" style="background: var(--theme-accent); color: var(--theme-bg); font-weight: bold; border-radius: 50px; padding: 0.5rem 1.5rem;">Ver Canal</a>
        }
    </div>

    @if (Model.Multimedia != null && Model.Multimedia.Any())
    {
        <div class="video-scroll-container">
            @foreach (var m in Model.Multimedia)
            {
                <div class="video-item d-flex flex-column">
                    <div class="ratio ratio-16x9 border-bottom" style="border-color: rgba(128, 128, 128, 0.2) !important;">
                        @if (!string.IsNullOrWhiteSpace(m.UrlEmbed))
                        {
                            string embedUrl = m.UrlEmbed;
                            string ytId = "";
                            if (embedUrl.Contains("youtu.be/")) ytId = embedUrl.Split(new[] { "youtu.be/" }, StringSplitOptions.None)[1];
                            else if (embedUrl.Contains("watch?v=")) ytId = embedUrl.Split(new[] { "watch?v=" }, StringSplitOptions.None)[1];
                            else if (embedUrl.Contains("embed/")) ytId = embedUrl.Split(new[] { "embed/" }, StringSplitOptions.None)[1];
                            else if (embedUrl.Contains("/shorts/")) ytId = embedUrl.Split(new[] { "/shorts/" }, StringSplitOptions.None)[1];
                            else if (embedUrl.Contains("/live/")) ytId = embedUrl.Split(new[] { "/live/" }, StringSplitOptions.None)[1];
                            if (!string.IsNullOrEmpty(ytId)) { embedUrl = "https://www.youtube.com/embed/" + ytId.Split('?')[0].Split('&')[0].Trim('/'); }
                            <iframe src="@embedUrl" frameborder="0" allowfullscreen loading="lazy"></iframe>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center" style="background: var(--theme-bg); color: var(--theme-text-muted);">Enlace roto</div>
                        }
                    </div>
                    <div class="p-3 flex-grow-1 d-flex align-items-center">
                        <h6 class="mb-0 fw-bold text-truncate" title="@m.Titulo" style="color: var(--theme-text-main); font-family: var(--theme-font-body);">
                            @(string.IsNullOrWhiteSpace(m.Titulo) ? "Video sin título" : m.Titulo)
                        </h6>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center p-5" style="border: 2px dashed rgba(128, 128, 128, 0.3); border-radius: 16px;">
            <p style="color: var(--theme-text-muted); font-family: var(--theme-font-body); margin: 0;">El archivo multimedia está vacío.</p>
        </div>
    }
</div>