@model RedAJP.Models.IglesiaWebPublicaViewModel

<style>
    /* ==================================================================== */
    /* SOBRESCRITURA ADAPTATIVA PARA PUNTOS DOCTRINALES                     */
    /* ==================================================================== */

    .doctrina-wrapper {
        background: transparent !important;
        padding: 0 !important;
        border: none !important;
    }

        .doctrina-wrapper .doctrina-header {
            margin-bottom: 3rem !important;
        }

        .doctrina-wrapper .doctrina-main-title {
            font-family: var(--theme-font-title) !important;
            font-weight: 800 !important;
            color: var(--theme-primary) !important;
            font-size: 2.5rem !important;
        }

        .doctrina-wrapper .doctrina-subtitle {
            color: var(--theme-text-muted) !important;
            font-family: var(--theme-font-body) !important;
            font-size: 1.1rem !important;
        }

        .doctrina-wrapper .doctrina-badge {
            display: none !important; /* Limpieza visual */
        }

        /* Contenedor del acordeón con bordes adaptativos */
        .doctrina-wrapper .doctrina-accordion {
            background: var(--theme-surface) !important;
            border: 1px solid rgba(128, 128, 128, 0.2) !important;
            border-radius: var(--radius-lg, 16px) !important;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.02) !important;
        }

        .doctrina-wrapper .doctrina-item {
            background: transparent !important;
            border: none !important;
            border-bottom: 1px solid rgba(128, 128, 128, 0.2) !important;
        }

            .doctrina-wrapper .doctrina-item:last-child {
                border-bottom: none !important;
            }

        /* Botón del acordeón: Texto principal por defecto */
        .doctrina-wrapper .doctrina-btn {
            background: transparent !important;
            color: var(--theme-text-main) !important;
            font-family: var(--theme-font-title) !important;
            font-size: 1.1rem !important;
            font-weight: 700 !important;
            padding: 1.2rem 1.5rem !important;
            box-shadow: none !important;
        }

            /* Estado activo (Abierto): Fondo sutil y color primario */
            .doctrina-wrapper .doctrina-btn:not(.collapsed) {
                background: var(--theme-bg) !important;
                color: var(--theme-primary) !important;
                box-shadow: inset 0 -1px 0 rgba(128, 128, 128, 0.2) !important;
            }

            /* Icono de flecha: Se ajusta al color de texto principal */
            .doctrina-wrapper .doctrina-btn::after {
                filter: grayscale(1) brightness(var(--theme-text-main-brightness, 1));
            }

        .doctrina-wrapper .doctrina-num {
            color: var(--theme-accent) !important;
            font-weight: 900 !important;
        }

        .doctrina-wrapper .doctrina-title {
            color: inherit !important;
        }

        /* Cuerpo del acordeón: Texto silenciado y fondo de superficie */
        .doctrina-wrapper .doctrina-body {
            background: var(--theme-surface) !important;
            color: var(--theme-text-muted) !important;
            font-family: var(--theme-font-body) !important;
            line-height: 1.8 !important;
            padding: 1.5rem 2rem !important;
        }

        /* Forzar herencia en todos los elementos de texto internos */
        .doctrina-wrapper .doctrina-text,
        .doctrina-wrapper .text-dark,
        .doctrina-wrapper .text-secondary,
        .doctrina-wrapper strong {
            color: inherit !important;
        }
</style>

<section id="doctrina" class="container py-5 fade-in-up">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            @await Html.PartialAsync("~/Views/web/_PuntosDoctrinales.cshtml")
        </div>
    </div>
</section>