@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Seleccionar Evento";
    Layout = "Principal";
    string redir = ViewBag.RedirAccion as string ?? "VerExtras";
}

<div class="container py-5 fade-in">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 text-center">
                    <h4 class="fw-bold text-dark mb-0">Selecciona el Evento</h4>
                    <p class="text-secondary small mt-1">Elige un evento activo para gestionar.</p>
                </div>
                <div class="card-body p-0 mt-3">
                    <div class="list-group list-group-flush rounded-bottom">
                        @if (!Model.Any())
                        {
                            <div class="text-center p-4 text-secondary">
                                <i class="fa-solid fa-calendar-xmark fa-3x mb-3 opacity-50"></i>
                                <h6>No hay eventos activos</h6>
                            </div>
                        }
                        else
                        {
                            foreach (var e in Model)
                            {
                                <a href="@Url.Action(redir, "Eventos", new { sid = e.Id })" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3 px-4 border-bottom">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                                            <i class="fa-solid fa-calendar-check text-primary fs-5"></i>
                                        </div>
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 1.1rem;">@e.Titulo</h6>
                                    </div>
                                    <i class="fa-solid fa-chevron-right text-secondary small"></i>
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
