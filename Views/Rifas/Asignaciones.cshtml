@model RedAJP.Models.GestionTableroViewModel
@{
    Layout = "_LayoutRifasOficiales";
    ViewData["Title"] = "Gestión de Vendedores";
    var listaUsuarios = ViewBag.Usuarios as List<SelectListItem>;
    var idUsuarioActual = User.FindFirst("IdUsuario")?.Value;
}

<style>
    .bg-pastel-blue {
        background-color: #e0f2fe !important;
        color: #0c4a6e !important;
    }

    .text-pastel-blue {
        color: #0ea5e9 !important;
    }

    .text-pastel-dark {
        color: #0c4a6e !important;
    }

    .border-pastel-blue {
        border-color: #7dd3fc !important;
    }

    .btn-pastel-blue {
        background-color: #3b82f6;
        color: white;
        border: none;
    }

        .btn-pastel-blue:hover {
            background-color: #2563eb;
            color: white;
        }

    .btn-outline-pastel {
        border: 2px solid #7dd3fc;
        color: #0ea5e9;
        background-color: transparent;
    }

        .btn-outline-pastel:hover {
            background-color: #e0f2fe;
            color: #0c4a6e;
            border-color: #3b82f6;
        }

    .progress-pastel {
        background-color: #3b82f6;
    }
</style>

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-rifas');
        }
    });
</script>

<div class="container-fluid py-4 fade-in">
    <div class="mb-3">
        <a href="@Url.Action("Tablero", "Rifas", new { id = Model.InfoRifa.IdRifaEncriptado })" class="text-muted text-decoration-none fw-bold">
            <i class="fa-solid fa-arrow-left me-2"></i> Volver al Tablero
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-body p-4 p-md-5 position-relative bg-pastel-blue">
            <div class="position-absolute top-50 end-0 translate-middle-y pe-4 d-none d-sm-block" style="opacity: 0.05; pointer-events: none;">
                <i class="fa-solid fa-ticket-alt" style="font-size: 8rem; color: #0c4a6e;"></i>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center position-relative z-1 gap-3">
                <div>
                    <h2 class="fw-bold mb-1 text-pastel-dark d-flex align-items-center gap-2">
                        <span style="font-size: 2.5rem;">@Model.BoletosLibresParaAsignar</span>
                        <span class="fs-4 fw-normal mt-2">Boletos Libres</span>
                    </h2>
                    <p class="mb-0 fs-6 text-pastel-dark" style="opacity: 0.8;"><i class="fa-solid fa-circle-info me-1"></i>Disponibles para asignar a tus promotores.</p>
                </div>
                <button class="btn btn-light rounded-circle shadow-sm d-flex align-items-center justify-content-center text-pastel-blue"
                        style="width: 60px; height: 60px; flex-shrink: 0; border: 2px solid #ffffff;"
                        onclick="abrirModalAsignacion('', '', '')"
                    @(Model.BoletosLibresParaAsignar == 0 ? "disabled" : "")
                        title="Nueva Asignación">
                    <i class="fa-solid fa-plus fa-xl"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-header bg-white border-bottom p-4">
            <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-users-gear text-pastel-blue me-2"></i> Mis Vendedores</h5>
        </div>
        <div class="card-body p-0" style="padding: 0 !important;">

            <div class="table-responsive d-none d-lg-block">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Promotor</th>
                            <th class="text-center py-3">Boletos (Asig/Ven)</th>
                            <th class="py-3">Finanzas</th>
                            <th class="text-center text-pastel-blue py-3">Avance</th>
                            <th class="text-end pe-4 py-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Promotores.Any())
                        {
                            foreach (var p in Model.Promotores.OrderByDescending(x => x.VendidosSinPagar))
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">
                                        @p.Nombre
                                        @if (p.Nombre.Contains("Venta Directa"))
                                        {
                                            <span class="badge bg-pastel-blue ms-2"><i class="fa-solid fa-star"></i></span>
                                        }
                                        else if (p.Nombre.Contains("(Externo)"))
                                        {
                                            <span class="badge bg-light text-secondary border ms-2"><i class="fa-solid fa-user-astronaut"></i> Externo</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <span class="fw-bold text-dark">@p.Asignados</span> /
                                        <span class="text-success fw-bold">@p.VendidosSinPagar</span>
                                    </td>

                                    <td>
                                        <div class="d-flex flex-column" style="font-size: 0.85rem;">
                                            <span><span class="text-muted">Deuda por Ventas:</span> <strong>$@p.DeudaTotal.ToString("N2")</strong></span>
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <div class="progress flex-grow-1 bg-light" style="width: 60px; height: 8px;">
                                                <div class="progress-bar progress-pastel" style="width: @p.PorcentajeVenta%"></div>
                                            </div>
                                            <small class="text-muted fw-bold">@p.PorcentajeVenta%</small>
                                        </div>
                                    </td>

                                    <td class="text-end pe-4">
                                        @if (p.IdUsuario == null && !string.IsNullOrEmpty(p.NombrePromotorExterno))
                                        {
                                            <button class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-2 me-1"
                                                    onclick="abrirModalVincular('@p.NombrePromotorExterno')" title="Vincular a Cuenta Registrada">
                                                <i class="fa-solid fa-link"></i>
                                            </button>
                                        }

                                        <a href="@Url.Action("ImprimirPlanilla", "Rifas", new { idRifa = Model.InfoRifa.IdRifaEncriptado, idDestino = p.IdUsuario, externo = p.NombrePromotorExterno, nombreMostrar = p.Nombre })"
                                           target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold px-2 me-1" title="Imprimir Planilla">
                                            <i class="fa-solid fa-print"></i>
                                        </a>

                                        <button class="btn btn-sm btn-outline-pastel rounded-pill fw-bold px-2 me-1"
                                                onclick="abrirModalAsignacion('@(p.IdUsuario?.ToString() ?? "")', '@(p.NombrePromotorExterno ?? "")', '@p.Nombre')"
                                            @(Model.BoletosLibresParaAsignar == 0 ? "disabled" : "") title="Agregar Boletos">
                                            <i class="fa-solid fa-plus"></i> Bol
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">Aún no hay boletos asignados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalAsignacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-header bg-pastel-blue border-0 p-4">
                <h5 class="modal-title fw-bold" id="modalAsignacionTitle">Nueva Asignación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form action="@Url.Action("AsignarBoletos", "Rifas")" method="post" id="formAsignacion">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idRifa" value="@Model.InfoRifa.IdRifaEncriptado" />
                <input type="hidden" name="IdUsuarioDestino" id="inputUsuarioOculto" disabled />
                <input type="hidden" name="NombrePromotorExterno" id="inputExternoOculto" disabled />

                <div class="modal-body p-4 bg-light">
                    <div class="alert bg-white border border-pastel-blue small mb-4 shadow-sm text-pastel-dark">
                        <i class="fa-solid fa-circle-info me-1 text-pastel-blue"></i> Solo puedes <strong>agregar más boletos</strong> a un vendedor, no se pueden quitar.
                    </div>

                    <div id="bloqueSelectUsuario">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="chkUsuarioRegistrado" checked onchange="toggleTipoVendedor()">
                            <label class="form-check-label fw-bold text-dark" for="chkUsuarioRegistrado">Usuario registrado en plataforma</label>
                        </div>

                        <div class="mb-3" id="contenedorSelectUsuario">
                            <select name="IdUsuarioDestino" id="selectUsuarioDestino" class="form-select border-pastel-blue shadow-sm" style="width: 100%;">
                                <option value="@idUsuarioActual">-- Asignarme a Mi --</option>
                                @if (listaUsuarios != null)
                                {
                                    foreach (var user in listaUsuarios)
                                    {
                                        <option value="@user.Value">@user.Text</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3 d-none" id="contenedorPromotorExterno">
                            <label class="form-label fw-bold small text-dark text-uppercase">Nombre del Promotor</label>
                            <input type="text" name="NombrePromotorExterno" id="inputPromotorExterno" class="form-control border-pastel-blue shadow-sm" placeholder="Ej. Juan Pérez..." />
                        </div>
                    </div>

                    <div class="mb-3 d-none" id="bloqueInputUsuario">
                        <label class="form-label fw-bold small text-dark text-uppercase">Vendedor Seleccionado</label>
                        <input type="text" id="inputNombreVendedor" class="form-control bg-white text-muted fw-bold border-pastel-blue" readonly />
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <div class="mb-2">
                        <label class="form-label fw-bold small text-pastel-blue text-uppercase">Cantidad a Agregar</label>
                        <input type="number" name="CantidadBoletos" id="inputCantidad" class="form-control form-control-lg border-pastel-blue shadow-sm text-center fw-bold text-pastel-blue" min="1" max="@Model.BoletosLibresParaAsignar" placeholder="0" required />
                    </div>
                    <div class="text-end small text-muted">
                        Máximo a asignar: <strong>@Model.BoletosLibresParaAsignar</strong>
                    </div>
                </div>

                <div class="modal-footer border-0 bg-white p-4">
                    <button type="submit" class="btn btn-pastel-blue btn-lg w-100 rounded-pill fw-bold shadow-sm">
                        <i class="fa-solid fa-check me-2"></i> Confirmar Boletos
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalVincular" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white border-0 p-4">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-link me-2"></i> Vincular Promotor</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="@Url.Action("VincularPromotorExterno", "Rifas")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idRifa" value="@Model.InfoRifa.IdRifaEncriptado" />
                <input type="hidden" name="NombrePromotorExterno" id="inputVincularExternoOculto" />

                <div class="modal-body p-4 bg-light">
                    <p class="small text-muted mb-4">Selecciona un usuario registrado en la plataforma para transferirle toda la información y ventas de <strong id="lblNombreVincular" class="text-dark"></strong>.</p>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark text-uppercase">Usuario a Vincular</label>
                        <select name="IdUsuarioDestino" id="selectUsuarioVincular" class="form-select shadow-sm border-primary" style="width: 100%;" required>
                            <option value="">Selecciona un usuario...</option>
                            @if (listaUsuarios != null)
                            {
                                foreach (var user in listaUsuarios)
                                {
                                    <option value="@user.Value">@user.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-white p-4">
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm">
                        <i class="fa-solid fa-exchange-alt me-2"></i> Confirmar Vinculación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        var modalAsignacionJS = null;
        var modalVincularJS = null;

        document.addEventListener("DOMContentLoaded", function() {
        modalAsignacionJS = new bootstrap.Modal(document.getElementById('modalAsignacion'));
        modalVincularJS = new bootstrap.Modal(document.getElementById('modalVincular'));

        $('#selectUsuarioDestino').select2({
        theme: 'bootstrap-5',
        dropdownParent: $('#modalAsignacion'),
        placeholder: "Buscar usuario...",
        width: '100%'
        });

        $('#selectUsuarioVincular').select2({
        theme: 'bootstrap-5',
        dropdownParent: $('#modalVincular'),
        placeholder: "Buscar usuario para vincular...",
        width: '100%'
        });
        });

        function abrirModalVincular(nombreExterno) {
        document.getElementById('lblNombreVincular').innerText = nombreExterno;
        document.getElementById('inputVincularExternoOculto').value = nombreExterno;
        $('#selectUsuarioVincular').val('').trigger('change');
        modalVincularJS.show();
        }

        function toggleTipoVendedor() {
        const isRegistrado = document.getElementById('chkUsuarioRegistrado').checked;
        const selectContainer = document.getElementById('contenedorSelectUsuario');
        const externoContainer = document.getElementById('contenedorPromotorExterno');
        const selectDestino = $('#selectUsuarioDestino');
        const inputExterno = document.getElementById('inputPromotorExterno');

        if (isRegistrado) {
        selectContainer.classList.remove('d-none');
        externoContainer.classList.add('d-none');
        inputExterno.value = '';
        inputExterno.disabled = true;
        selectDestino.prop('disabled', false);
        } else {
        selectContainer.classList.add('d-none');
        externoContainer.classList.remove('d-none');
        selectDestino.val('').trigger('change');
        selectDestino.prop('disabled', true);
        inputExterno.disabled = false;
        }
        }

        function abrirModalAsignacion(idUsuario, nombreExterno, nombreMostrar) {
        const isEdit = nombreMostrar != null && nombreMostrar !== '';
        const title = document.getElementById('modalAsignacionTitle');
        const bloqueSelect = document.getElementById('bloqueSelectUsuario');
        const bloqueInput = document.getElementById('bloqueInputUsuario');
        const inputNombre = document.getElementById('inputNombreVendedor');
        const selectDestino = $('#selectUsuarioDestino');
        const inputPromotorExt = document.getElementById('inputPromotorExterno');
        const inputOcultoId = document.getElementById('inputUsuarioOculto');
        const inputOcultoExt = document.getElementById('inputExternoOculto');

        document.getElementById('inputCantidad').value = '';

        if (isEdit) {
        title.innerText = 'Agregar Boletos a Promotor';
        bloqueSelect.classList.add('d-none');
        bloqueInput.classList.remove('d-none');
        inputNombre.value = nombreMostrar;

        selectDestino.prop('disabled', true);
        inputPromotorExt.disabled = true;
        inputOcultoId.disabled = false;
        inputOcultoId.value = idUsuario;
        inputOcultoExt.disabled = false;
        inputOcultoExt.value = nombreExterno;
        } else {
        title.innerText = 'Nueva Asignación';
        bloqueSelect.classList.remove('d-none');
        bloqueInput.classList.add('d-none');
        inputOcultoId.disabled = true;
        inputOcultoExt.disabled = true;

        const chk = document.getElementById('chkUsuarioRegistrado');
        chk.checked = true;
        toggleTipoVendedor();
        selectDestino.val('@idUsuarioActual').trigger('change');
        }

        modalAsignacionJS.show();
        }
    </script>
}