@model RedAJP.Models.IglesiaWebPublicaViewModel

<style>
    .hero-carrusel {
        height: 90vh;
        min-height: 600px;
        background-color: var(--theme-primary);
        position: relative;
    }

        .hero-carrusel .carousel-inner, .hero-carrusel .carousel-item {
            height: 100%;
        }

            .hero-carrusel .carousel-item img {
                object-fit: cover;
                height: 100%;
                width: 100%;
                opacity: 0.6;
            }

    .hero-carrusel-caption {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        width: 100%;
        max-width: 900px;
        padding: 0 20px;
        z-index: 10;
        color: #ffffff !important;
    }
</style>

<header class="hero-carrusel fade-in-up">
    @if (Model.Galeria != null && Model.Galeria.Any())
    {
        <div id="heroCarousel" class="carousel slide carousel-fade h-100" data-bs-ride="carousel">
            <div class="carousel-inner h-100">
                @{
                    int idx = 0;
                }
                @foreach (var img in Model.Galeria.Take(5))
                {
                    <div class="carousel-item h-100 @(idx == 0 ? "active" : "")" data-bs-interval="4000">
                        <img src="@img.UrlImagen" alt="Hero" class="d-block w-100 h-100">
                    </div>
                    idx++;
                }
            </div>
        </div>
    }
    else
    {
        <div class="h-100 w-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(45deg, var(--theme-primary), var(--theme-accent));"></div>
    }

    <div class="hero-carrusel-caption">
        <h1 class="mb-4" style="font-family: var(--theme-font-title); font-size: clamp(3rem, 6vw, 5.5rem); font-weight: 800; text-transform: uppercase; color: #ffffff;">
            @(string.IsNullOrWhiteSpace(Model.NombreIglesia) ? "Bienvenidos" : Model.NombreIglesia)
        </h1>
        <p class="fs-4" style="font-family: var(--theme-font-body); font-weight: 300; color: rgba(255,255,255,0.9);">
            <i class="fa-solid fa-location-dot me-2" style="color: var(--theme-accent);"></i> @Model.Municipio
        </p>
    </div>
</header>