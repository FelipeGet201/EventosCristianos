<div class="modal fade" id="modalPortalConfig" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0 bg-primary text-white rounded-top-4">
                <h5 class="fw-bold py-2"><i class="fa-solid fa-users-gear me-2"></i>Reglas de Selección y Agrupaciones</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <ul class="nav nav-pills mb-3" id="pills-tab-portal" role="tablist">
                  <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold rounded-pill" data-bs-toggle="pill" data-bs-target="#pills-general" type="button" role="tab">Reglas del Portal</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold rounded-pill" data-bs-toggle="pill" data-bs-target="#pills-cluster" type="button" role="tab">Agrupaciones de Modalidades</button>
                  </li>
                </ul>

                <div class="tab-content">
                  <div class="tab-pane fade show active bg-white p-3 border rounded-3 shadow-sm" id="pills-general" role="tabpanel">
                      <div class="form-check form-switch mb-3">
                          <input class="form-check-input" type="checkbox" id="chkPortalActivo" @(Model.ConfigPortal?.Portal_Activo == true ? "checked" : "")>
                          <label class="form-check-label fw-bold" for="chkPortalActivo">Habilitar Selección de Habitaciones por los Asistentes</label>
                      </div>
                      <div class="form-check form-switch mb-3">
                          <input class="form-check-input" type="checkbox" id="chkSoloPagados" @(Model.ConfigPortal?.Solo_Pagados == true ? "checked" : "")>
                          <label class="form-check-label text-muted" for="chkSoloPagados">Solo permitir elegir cuarto a los asistentes con cuenta liquidada al 100%</label>
                      </div>
                      <div class="form-check form-switch mb-3">
                          <input class="form-check-input" type="checkbox" id="chkMostrarTodas" @(Model.ConfigPortal?.MostrarTodasLasHabitaciones == true ? "checked" : "")>
                          <label class="form-check-label text-muted" for="chkMostrarTodas">Mostrar todas las habitaciones disponibles (además de la sugerencia ideal)</label>
                      </div>
                  
                      <button class="btn btn-primary rounded-pill fw-bold w-100 mt-2" onclick="guardarConfigPortal()"><i class="fa-solid fa-save me-1"></i> Guardar Reglas</button>
                  </div>
                  
                  <div class="tab-pane fade bg-white p-3 border rounded-3 shadow-sm" id="pills-cluster" role="tabpanel">
                      <p class="text-muted small">Agrupa modalidades incompatibles (Ej: Cama Hombres y Cama Mujeres) bajo un nombre técnico común para que puedan compartir habitación de forma inteligente.</p>
                      
                      <div class="table-responsive mb-3">
                          <table class="table table-sm table-bordered align-middle">
                            <thead class="table-light"><tr><th>Nombre Descriptivo</th><th>Modalidades Vinculadas</th><th class="text-center">Quitar</th></tr></thead>
                            <tbody id="tbodyAgrupaciones"> @if(Model.Agrupaciones != null && Model.Agrupaciones.Any()) {
                                    foreach(var ag in Model.Agrupaciones) {
                                        <tr>
                                            <td class="fw-bold">@ag.Nombre_Descriptivo</td>
                                            <td>@string.Join(", ", ag.NombresSubtipos)</td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-danger border-0" onclick="eliminarAgrupacion(@ag.Id_Agrupacion)"><i class="fa-solid fa-trash"></i></button>
                                            </td>
                                        </tr>
                                    }
                                } else {
                                    <tr><td colspan="3" class="text-center text-muted py-3">No hay agrupaciones creadas.</td></tr>
                                }
                            </tbody>
                        </table>
                      </div>

                      <div class="bg-light p-3 border rounded-3">
                          <h6 class="fw-bold mb-2">Crear Nueva Agrupación</h6>
                          <input type="text" id="txtNombreAgrupacion" class="form-control form-control-sm rounded-pill mb-2" placeholder="Nombre (Ej: Camas de Hotel)">
                          <label class="form-label small fw-bold text-muted mb-1">Selecciona qué modalidades conforman este grupo:</label>
                          <div class="row px-2 mb-3">
                              @foreach(var sub in Model.Subtipos) {
                                  <div class="col-md-6 form-check mb-1">
                                      <input class="form-check-input chk-subtipo-agr" type="checkbox" value="@sub.Id_Subtipo" id="agr-sub-@sub.Id_Subtipo">
                                      <label class="form-check-label small" for="agr-sub-@sub.Id_Subtipo">@sub.Nombre</label>
                                  </div>
                              }
                          </div>
                          <button class="btn btn-dark rounded-pill fw-bold w-100 btn-sm" onclick="crearAgrupacion()"><i class="fa-solid fa-plus me-1"></i> Crear Agrupación</button>
                      </div>
                  </div>
                </div>
            </div>
        </div>
    </div>
</div>

