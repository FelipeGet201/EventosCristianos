@model RedAJP.Models.IglesiaWebPublicaViewModel

<footer style="background-color: var(--theme-surface); border-top: 1px solid rgba(128, 128, 128, 0.2); padding: 4rem 0 2rem;">
    <div class="container">
        <div class="row align-items-center mb-4 pb-4 border-bottom" style="border-color: rgba(128, 128, 128, 0.2) !important;">
            <div class="col-md-6 text-center text-md-start">
                <h3 class="mb-2" style="font-family: var(--theme-font-title); font-weight: 800; color: var(--theme-primary);">@Model.NombreIglesia</h3>
                <p class="mb-0" style="color: var(--theme-text-muted); font-family: var(--theme-font-body);">
                    <i class="fa-solid fa-location-dot me-2" style="color: var(--theme-accent);"></i> @(string.IsNullOrWhiteSpace(Model.Municipio) ? "Sede sin registrar" : Model.Municipio)
                </p>
            </div>
            <div class="col-md-6 text-center text-md-end mt-4 mt-md-0">
                <div class="d-flex justify-content-center justify-content-md-end gap-3">
                    @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                    {
                        <a href="@Model.FacebookUrl" target="_blank" class="fs-4" style="color: var(--theme-text-main);"><i class="fa-brands fa-facebook"></i></a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                    {
                        <a href="@Model.InstagramUrl" target="_blank" class="fs-4" style="color: var(--theme-text-main);"><i class="fa-brands fa-instagram"></i></a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.YoutubeUrl))
                    {
                        <a href="@Model.YoutubeUrl" target="_blank" class="fs-4" style="color: var(--theme-text-main);"><i class="fa-brands fa-youtube"></i></a>
                    }
                </div>
            </div>
        </div>
        <div class="text-center" style="color: var(--theme-text-muted); font-family: var(--theme-font-body); font-size: 0.85rem;">
            © @DateTime.Now.Year @Model.NombreIglesia.
        </div>
    </div>
</footer>