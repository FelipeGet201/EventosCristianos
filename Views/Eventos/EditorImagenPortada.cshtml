@model RedAJP.Models.EditorGraficoViewModel
@{
    Layout = "Principal";
    ViewData["Title"] = "Mapeo Dinámico de Modalidades";
}

<style>
    /* Estilos del Lienzo */
    #canvasContenedor {
        position: relative;
        background-color: #f8f9fa;
        border-radius: 12px;
        border: 2px dashed #dee2e6;
        box-shadow: inset 0 0 15px rgba(0,0,0,0.05);
        user-select: none;
        overflow: hidden;
        min-height: 400px;
    }

    #imgPortada {
        width: 100%;
        display: block;
        pointer-events: none; /* Evita que el navegador intente arrastrar la imagen de fondo */
    }

    /* Estilos de los Marcadores (Tacha) */
    .tacha-marker {
        position: absolute;
        /* Reducimos el tamaño en el editor a 24x24px para que no estorbe (en la BD se guarda la coordenada centro) */
        width: 24px;
        height: 24px;
        margin-left: -12px; /* Centra el X */
        margin-top: -12px; /* Centra el Y */
        cursor: grab;
        z-index: 10;
        transition: transform 0.1s;
    }

        .tacha-marker img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4));
            pointer-events: none;
        }

        .tacha-marker:active {
            cursor: grabbing;
            transform: scale(1.3);
            z-index: 100;
        }

    /* Etiqueta flotante sobre el marcador para saber qué asiento es */
    .marker-label {
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.8);
        color: white;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: bold;
        white-space: nowrap;
        pointer-events: none;
        margin-bottom: 4px;
        opacity: 0;
        transition: opacity 0.2s;
    }

    .tacha-marker:hover .marker-label {
        opacity: 1; /* Solo se muestra al pasar el mouse para no ensuciar la vista */
    }

    /* Estilos de la Lista Lateral (Drag & Drop) */
    .lista-arrastrables {
        max-height: 600px;
        overflow-y: auto;
        padding-right: 5px;
    }

    .mod-draggable {
        cursor: grab;
        background-color: white;
        border: 1px solid #ced4da;
        border-left: 4px solid #0d6efd;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .mod-draggable:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            background-color: #f8f9fa;
        }

        .mod-draggable:active {
            cursor: grabbing;
        }
</style>

<div class="container-fluid py-4 fade-in">
    <div class="row g-4">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-map me-2 text-primary"></i> Lienzo de: @Model.TituloEvento
                    </h5>
                    <span class="badge bg-light text-muted border">Centro dinámico autocalculado</span>
                </div>
                
                <div class="card-body p-3">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="fa-solid fa-circle-info me-2"></i> <strong>Instrucciones:</strong> Arrastra las modalidades desde el panel derecho hacia el mapa. Haz <strong>doble clic</strong> sobre una tacha en el mapa para quitarla.
                    </div>

                    <div id="canvasContenedor">
                        <img src="@Model.ImagenUrlActual" id="imgPortada" alt="Portada del Evento" />
                        <div id="capaMarcadores"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 20px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-list-ul me-2"></i> Modalidades Pendientes</h6>
                    <p class="small text-muted mb-3">Arrastra estos elementos al plano:</p>
                    
                    <div id="listaModalidades" class="lista-arrastrables d-flex flex-column gap-2 mb-4">
                    </div>

                    <hr class="my-4" />

                    <form id="formMapa" method="post" action="@Url.Action("GuardarConfiguracionGrafica", "Eventos")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idEvento" value="@Model.IdEvento" />
                        <input type="hidden" name="jsonCoordenadas" id="jsonCoordenadas" />
                        
                        <button type="button" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm mb-2" onclick="guardarMapa()">
                            <i class="fa-solid fa-save me-2"></i> Guardar Distribución
                        </button>
                        <a href="@Url.Action("Editor", new { sid = Model.IdEventoEncriptado })" class="btn btn-outline-secondary w-100 rounded-pill">
                            Cancelar
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Inicializar la variable con los datos desde el servidor
    let datosMapa = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Modalidades));
    const urlTacha = '@Url.Content("~/Images/tacha.png")'; // Asegura la ruta correcta de la imagen

    const canvas = document.getElementById('canvasContenedor');
    const capaMarcadores = document.getElementById('capaMarcadores');
    const listaModalidades = document.getElementById('listaModalidades');

    // 2. Función Principal: Dibuja la UI basándose en el estado del Array (Reactividad básica)
    function renderizarEntorno() {
        capaMarcadores.innerHTML = '';
        listaModalidades.innerHTML = '';
        let pendientes = 0;

        datosMapa.forEach(mod => {
            if (mod.Configurado && mod.X >= 0 && mod.Y >= 0) {
                // --- A) DIBUJAR EN EL MAPA ---
                const marker = document.createElement('div');
                marker.className = 'tacha-marker';
                marker.dataset.id = mod.IdSubtipo;
                marker.style.left = mod.X + '%';
                marker.style.top = mod.Y + '%';
                
                marker.innerHTML = `
                    <div class="marker-label">${mod.Nombre}</div>
                    <img src="${urlTacha}" alt="X" />
                `;

                // Doble clic para quitar del mapa y regresarlo a la lista
                marker.addEventListener('dblclick', function(e) {
                    e.stopPropagation();
                    mod.Configurado = false;
                    mod.X = -1;
                    mod.Y = -1;
                    renderizarEntorno();
                });

                capaMarcadores.appendChild(marker);
            } else {
                // --- B) DIBUJAR EN LA LISTA LATERAL ---
                pendientes++;
                const item = document.createElement('div');
                item.className = 'mod-draggable p-3 rounded-3 shadow-sm d-flex justify-content-between align-items-center';
                item.draggable = true;
                item.innerHTML = `
                    <span class="fw-bold small text-truncate"><i class="fa-solid fa-grip-vertical text-muted me-2"></i> ${mod.Nombre}</span>
                    <i class="fa-solid fa-arrow-right text-muted opacity-50"></i>
                `;

                // Evento al empezar a arrastrar desde la lista
                item.addEventListener('dragstart', (e) => {
                    e.dataTransfer.setData('text/plain', mod.IdSubtipo);
                    e.dataTransfer.effectAllowed = 'move';
                    item.style.opacity = '0.5';
                });

                item.addEventListener('dragend', () => {
                    item.style.opacity = '1';
                });

                listaModalidades.appendChild(item);
            }
        });

        if (pendientes === 0) {
            listaModalidades.innerHTML = '<div class="text-center text-success small py-3"><i class="fa-solid fa-check-circle fa-2x mb-2"></i><br/>¡Todas las modalidades han sido ubicadas!</div>';
        }
    }

    // 3. Lógica de DropZone (Soltar desde la lista al lienzo)
    canvas.addEventListener('dragover', (e) => {
        e.preventDefault(); // Necesario para permitir el drop
        e.dataTransfer.dropEffect = 'move';
    });

    canvas.addEventListener('drop', (e) => {
        e.preventDefault();
        const idSubtipo = e.dataTransfer.getData('text/plain');
        if (!idSubtipo) return;

        const mod = datosMapa.find(m => m.IdSubtipo == parseInt(idSubtipo));
        if (mod) {
            // Calcular coordenadas en porcentaje
            const rect = canvas.getBoundingClientRect();
            let posX = ((e.clientX - rect.left) / rect.width) * 100;
            let posY = ((e.clientY - rect.top) / rect.height) * 100;

            // Evitar que se salga de los bordes
            mod.X = Math.max(0, Math.min(100, parseFloat(posX.toFixed(2))));
            mod.Y = Math.max(0, Math.min(100, parseFloat(posY.toFixed(2))));
            mod.Configurado = true;
            
            renderizarEntorno();
        }
    });

    // 4. Lógica de re-posicionamiento libre (Mover un marcador que ya está en el mapa)
    let marcadorActivo = null;

    canvas.addEventListener('mousedown', (e) => {
        const markerTarget = e.target.closest('.tacha-marker');
        if (markerTarget) {
            marcadorActivo = markerTarget;
        }
    });

    window.addEventListener('mousemove', (e) => {
        if (!marcadorActivo) return;

        const rect = canvas.getBoundingClientRect();
        let posX = ((e.clientX - rect.left) / rect.width) * 100;
        let posY = ((e.clientY - rect.top) / rect.height) * 100;

        posX = Math.max(0, Math.min(100, parseFloat(posX.toFixed(2))));
        posY = Math.max(0, Math.min(100, parseFloat(posY.toFixed(2))));

        // Mover visualmente al instante
        marcadorActivo.style.left = posX + '%';
        marcadorActivo.style.top = posY + '%';

        // Actualizar el array de datos
        const modId = parseInt(marcadorActivo.dataset.id);
        const mod = datosMapa.find(m => m.IdSubtipo === modId);
        if (mod) {
            mod.X = posX;
            mod.Y = posY;
        }
    });

    window.addEventListener('mouseup', () => {
        if (marcadorActivo) {
            marcadorActivo = null;
        }
    });

    // 5. Guardar Información
    function guardarMapa() {
        // Formatear el JSON para mandarlo limpio al controlador
        document.getElementById('jsonCoordenadas').value = JSON.stringify(datosMapa);
        
        const btn = document.querySelector('#formMapa button[type="button"]');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> Guardando...';
        btn.disabled = true;

        document.getElementById('formMapa').submit();
    }

    // Disparar render inicial
    window.addEventListener('DOMContentLoaded', () => {
        renderizarEntorno();
    });
</script>