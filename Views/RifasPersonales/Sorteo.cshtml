@model List<RedAJP.Models.BoletoPersonalViewModel>
@{
    Layout = "~/Views/Shared/Principal.cshtml";
    ViewData["Title"] = "Sorteo en Vivo";
    string token = ViewBag.TokenRifa ?? "";
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-rifaspersonales');
        }
    });
</script>

<style>
    /* ESTRUCTURA MAESTRA */
    .game-wrapper { position: relative; width: 100%; height: 85vh;
overflow: hidden; border-radius: 20px; background: rgba(15, 23, 42, 0.1); border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 10px 30px rgba(0,0,0,0.2); display: flex;
font-family: 'Segoe UI', system-ui, sans-serif; transition: all 0.3s ease; }
    body.modo-live header, body.modo-live footer, body.modo-live .navbar { display: none !important;
}
    body.modo-live main { padding: 0 !important; margin: 0 !important; max-width: 100% !important; background: transparent !important;
}
    body.modo-live .game-wrapper { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; border-radius: 0;
border: none; z-index: 9999; }

    /* CONTROLES SUPERIORES */
    .top-controls-layer { position: absolute;
top: 20px; right: 20px; display: flex; gap: 12px; z-index: 3000; }
    .btn-glass-control { width: 45px; height: 45px;
border-radius: 50%; background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.2); color: white; font-size: 1.1rem; display: flex;
align-items: center; justify-content: center; cursor: pointer; transition: 0.3s; }
    .btn-glass-control:hover { background: rgba(255, 255, 255, 0.2);
color: #fbbf24; transform: scale(1.1); }

    /* PANEL LATERAL */
    .discard-panel { width: 0;
background: rgba(15, 23, 42, 0.7); border-right: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; overflow: hidden;
transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1); position: relative; z-index: 100; }
    .discard-panel.visible { width: 320px;
}
    .discard-panel.force-hide { width: 0 !important; border: none; padding: 0; transition: width 1s ease-in-out;
}
    .panel-header-rifa { padding: 30px 20px 20px 20px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column;
align-items: center; text-align: center; gap: 10px; }
    .img-rifa-panel { width: 60px; height: 60px; border-radius: 50%; object-fit: cover;
border: 2px solid #38bdf8; }
    .icon-rifa-panel { width: 60px; height: 60px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex;
align-items: center; justify-content: center; font-size: 2rem; color: #38bdf8; border: 2px solid #38bdf8; }
    .panel-header-titles { display: flex;
flex-direction: column; align-items: center; gap: 5px; }
    .panel-header-title { margin: 0; font-size: 1.1rem; font-weight: 700; color: white;
text-shadow: 0 2px 4px rgba(0,0,0,0.3); max-width: 100%; }
    .live-badge { display: inline-flex; align-items: center; gap: 6px;
background: rgba(239, 68, 68, 0.3); color: #ef4444; padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
border: 1px solid rgba(239, 68, 68, 0.4); margin-top: 3px; transition: all 0.3s ease; }

    /* HISTORIAL */
    .historical-header { padding: 15px 20px 5px 20px;
color: rgba(255,255,255,0.4); font-weight: 700; font-size: 0.85rem; letter-spacing: 1px; }
    .discard-list { flex: 1; overflow-y: auto; padding: 15px;
scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.2) transparent; }
    .discard-item { background: rgba(255, 255, 255, 0.05); border-radius: 8px;
padding: 12px 15px; margin-bottom: 8px; color: rgba(255,255,255,0.9); display: flex; align-items: center; border-left: 3px solid #ef4444; animation: slideInLeft 0.3s ease;
}
    .discard-number { font-weight: 800; color: #ef4444; font-size: 1.2em; margin-right: 15px; min-width: 45px;
}
    .discard-name { font-weight: 500; font-size: 0.95em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

    /* ESCENARIO CENTRAL */
    .ocean-stage { flex: 1; height: 100%; position: relative;
display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .bubble-container { width: 450px; height: 450px; border-radius: 50%;
background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.1) 0%, rgba(14, 165, 233, 0.03) 70%); border: 2px solid rgba(56, 189, 248, 0.3);
box-shadow: 0 10px 40px rgba(0,0,0,0.3); position: relative; margin-bottom: 2rem; overflow: hidden; transition: all 0.3s; max-width: 85%; max-height: 85%; aspect-ratio: 1/1;
will-change: transform, border-color, box-shadow; }
    .bubble-container.winner { border-color: #fbbf24; box-shadow: 0 0 60px rgba(251, 191, 36, 0.4);
}
    .bubble-container.eliminated-state { border-color: #ef4444; box-shadow: 0 0 50px rgba(239, 68, 68, 0.3);
}
    .bubble-container.zoom-explosion { transform: scale(4); opacity: 0; transition: all 1s cubic-bezier(0.25, 1, 0.5, 1);
}
    .bubble-inner { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;
transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }
    .bubble-inner.slide-up { transform: translateY(-60px);
}
    .status-text { font-size: 1.25rem; font-weight: 700; letter-spacing: 3px; color: #38bdf8; margin-bottom: 5px; text-transform: uppercase; min-height: 25px;
text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
    .display-num { font-size: 8.5rem; font-weight: 900; color: #ffffff; line-height: 0.9;
text-shadow: 3px 3px 0 #0ea5e9, 0 10px 20px rgba(0,0,0,0.6); font-variant-numeric: tabular-nums; margin: 10px 0; will-change: transform;
}
    .display-name { font-size: 1.6rem; font-weight: 600; color: #e2e8f0; text-transform: uppercase; letter-spacing: 1px; max-width: 85%; text-align: center;
line-height: 1.1; min-height: 1.6em; text-shadow: 0 2px 4px rgba(0,0,0,0.5); will-change: contents; }

    .btn-continue { position: absolute;
bottom: 40px; left: 50%; transform: translateX(-50%) translateY(100px); background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); color: white; border: 2px solid rgba(255,255,255,0.3);
padding: 14px 45px; border-radius: 50px; font-weight: 800; font-size: 1.2rem; text-transform: uppercase; box-shadow: 0 10px 20px rgba(185, 28, 28, 0.3);
cursor: pointer; opacity: 0; pointer-events: none; transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); display: flex; align-items: center; gap: 10px;
}
    .btn-continue.show { opacity: 1; pointer-events: all; transform: translateX(-50%) translateY(0);
}

    /* OVERLAYS Y BOTONES */
    .overlay-screen { position: absolute; inset: 0;
background: rgba(15, 23, 42, 0.7); z-index: 800; display: flex; flex-direction: column; align-items: center; justify-content: center;
}
    #winnerScreen { display: flex !important; background: rgba(15, 23, 42, 0.85); opacity: 0; visibility: hidden;
transition: opacity 1s ease; z-index: 5000; pointer-events: none; }
    #winnerScreen.visible { opacity: 1; visibility: visible; pointer-events: all;
}

    .card-config { background: rgba(30, 41, 59, 0.95); padding: 45px; border-radius: 30px; width: 90%; max-width: 500px;
text-align: center; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 20px 40px rgba(0,0,0,0.5); color: white;
}
    .config-option { display: flex; justify-content: space-between; align-items: center; padding: 15px 25px; margin-bottom: 10px; background: rgba(255,255,255,0.05);
border: 2px solid rgba(255,255,255,0.1); border-radius: 12px; color: #e2e8f0; font-weight: 600; cursor: pointer; transition: all 0.2s; font-size: 1.1rem;
}
    .config-option.selected { background: #38bdf8; color: #0f172a; border-color: #38bdf8; transform: scale(1.02);
}
    .config-option:hover:not(.selected) { background: rgba(255,255,255,0.1); }
    .config-option .badge { font-size: 1rem; padding: 5px 12px;
background: rgba(0,0,0,0.2); border-radius: 20px; }
    .config-option.selected .badge { background: rgba(0,0,0,0.8); color: white;
}

    .tracker-wrapper { display: flex; justify-content: center; align-items: center; margin-bottom: 30px; background: rgba(0,0,0,0.4); padding: 10px 30px;
border-radius: 50px; border: 1px solid rgba(255,255,255,0.05); box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
    .tracker-text { color: #38bdf8;
font-size: 1rem; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; }

    .btn-main { background: linear-gradient(135deg, #0ea5e9, #3b82f6); color: white;
border: none; padding: 18px 70px; border-radius: 60px; font-size: 1.5rem; font-weight: 800; box-shadow: 0 10px 20px rgba(14, 165, 233, 0.3);
transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer; }
    .btn-main.golden-state { background: linear-gradient(45deg, #fbbf24 0%, #d97706 50%, #fbbf24 100%);
background-size: 200% auto; color: #451a03; border: 2px solid rgba(255,255,255,0.5); box-shadow: 0 0 25px rgba(251, 191, 36, 0.5);
animation: pulseGold 2s infinite ease-in-out; text-transform: uppercase; letter-spacing: 2px; }
    .btn-main.hide-btn { opacity: 0 !important;
pointer-events: none !important; transform: translateY(20px) !important; }

    @@keyframes pulseGold { 0% { transform: scale(1);
} 50% { transform: scale(1.03); box-shadow: 0 0 35px rgba(251, 191, 36, 0.6); } 100% { transform: scale(1);
} }
    @@keyframes slideInLeft { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1;
transform: translateX(0); } }
    .shake-anim { animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both;
}
    @@keyframes shake { 10%, 90% { transform: translate3d(-2px, 0, 0);
} 30%, 70% { transform: translate3d(-4px, 0, 0); } 50% { transform: translate3d(4px, 0, 0);
} }

    /* NUEVO: Estilos para grabación */
    @@keyframes blinkRedRecord { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
    .recording-active { background: rgba(239, 68, 68, 0.8) !important; color: white !important; border-color: #ef4444 !important; animation: blinkRedRecord 1.5s infinite; }
</style>

<div class="container-fluid mt-3 mb-5">
    
    @if(Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center mt-5">
            <i class="fa-solid fa-ticket fs-3 mb-2 d-block"></i>
            No hay boletos vendidos para realizar el sorteo o todos fueron descartados.
</div>
        return;
    }

    <div class="game-wrapper shadow-lg" id="gameWrapper">
        <div class="top-controls-layer">
            <button class="btn-glass-control" onclick="toggleLiveMode()" title="Pantalla Completa">
                <i class="fa-solid fa-expand" id="iconFullscreen"></i>
            </button>
            <a href="@Url.Action("PanelAdministracion", "RifasPersonales", new { token = token })" class="btn-glass-control" title="Salir">
      
                <i class="fa-solid fa-xmark"></i>
            </a>
        </div>

        <div class="discard-panel" id="discardPanel">
            <div class="panel-header-rifa">
                @if(!string.IsNullOrEmpty(ViewBag.ImagenUrl as string))
                {
           
                    <img src="@ViewBag.ImagenUrl" alt="Rifa" class="img-rifa-panel" />
                }
                else
                {
                    <div class="icon-rifa-panel"><i class="fa-solid fa-ticket"></i></div>
                
}
                <div class="panel-header-titles">
                    <h1 class="panel-header-title">@ViewBag.TituloRifa</h1>
                    <div class="live-badge">SORTEO EN VIVO</div>
                </div>
            </div>

           
            <div class="historical-header">
                <i class="fa-solid fa-clock-rotate-left me-1"></i> HISTORIAL
            </div>
            <div class="discard-list" id="discardList"></div>
        </div>

        <div class="ocean-stage">
            <div class="tracker-wrapper" id="trackerWrapper" style="display: none;">
                 <div class="tracker-text" 
id="trackerText">INTENTO 1 DE 1</div>
            </div>

            <div class="bubble-container" id="mainBubble">
                <div class="bubble-inner" id="bubbleContent">
                    <div class="status-text" id="statusText">PREPARADO</div>
                    <div class="display-num" id="displayNum">000</div>
         
                   <div class="display-name" id="displayName">Esperando...</div>
                </div>
                <button class="btn-continue" id="btnContinue" onclick="confirmarEliminacion()">
                    <span>CONTINUAR</span> <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>

 
            <div style="height: 90px;">
                <button class="btn-main" id="btnSpin" onclick="spinRoulette()">GIRAR TÓMBOLA</button>
            </div>
        </div>

        <div class="overlay-screen" id="setupScreen">
            <div class="card-config fade-in">
                <h3 class="fw-bold mb-4"><i class="fa-solid fa-gear text-info me-2"></i> 
Configuración</h3>
                <div class="d-flex flex-column gap-2 mb-4">
                    <button class="config-option" onclick="selectMode(1, this)"><span>⚡ Directo</span> <span class="badge">1</span></button>
                    <button class="config-option selected" onclick="selectMode(3, this)"><span>🎲 Suspenso</span> <span class="badge">3</span></button>
                    <button class="config-option" onclick="selectMode(5, this)"><span>🔥 Emoción</span> <span class="badge">5</span></button>
 
                   <button class="config-option" onclick="selectMode(10, this)"><span>🤯 Drama Total</span> <span class="badge">10</span></button>
                </div>
                
                <div class="alert border-0 shadow-sm text-start p-3 mb-4 rounded-3 d-flex align-items-start gap-3" style="background-color: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.3) !important;">
                    <i class="fa-solid fa-video fs-2 mt-1" style="color: #38bdf8 !important;"></i>
                    <div class="small text-white lh-sm">
                        <strong class="d-block mb-1" style="color: #38bdf8; font-size: 1.05rem;">Grabación del Sorteo</strong>
                        Al presionar "Comenzar", tu navegador te pedirá permiso para grabar esta pestaña. El video se descargará automáticamente al revelar al ganador.
                        <div class="mt-2 text-warning" style="font-size: 0.8rem;">
                            <i class="fa-solid fa-mobile-screen-button me-1"></i> Sugerencia: De forma opcional, puedes grabar la pantalla con tu celular como respaldo extra.
                        </div>
                    </div>
                </div>

                <button class="btn btn-info w-100 rounded-pill py-3 fw-bold shadow text-dark mt-2" onclick="startGame()">COMENZAR SORTEO</button>
            </div>
        </div>

        <div class="overlay-screen" id="winnerScreen">
 
           <div class="text-center text-white fade-in">
                <p class="text-uppercase ls-2 mb-2 opacity-75" style="letter-spacing: 5px;">¡GANADOR!</p>
                <h1 class="display-1 fw-bold mb-2" id="finalNum" style="font-size: 10rem;
color: #fbbf24; text-shadow: 4px 4px 0 #b45309, 0 10px 25px rgba(0,0,0,0.8);">000</h1>
                <h2 class="display-4 fw-bold mb-5 text-white" id="finalName">Nombre</h2>
                
                <div class="d-flex flex-column align-items-center mt-4">
                    <div id="videoWaitMessage" class="fw-bold mb-3" style="display: none; color: #38bdf8; font-size: 1.1rem; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">
                        <i class="fa-solid fa-spinner fa-spin me-2"></i> Generando y descargando video...
                    </div>
                    <div class="d-flex gap-3 justify-content-center">
                        <a href="@Url.Action("Resultados", "RifasPersonales", new { token = token })" id="btnVerResultados" class="btn btn-warning text-dark fw-bold rounded-pill px-5 py-3 shadow">
                 
                            <i class="fa-solid fa-trophy me-2"></i> Ver Resultados
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <form id="antiForgeryForm">
            @Html.AntiForgeryToken()
       
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<script>
    var rawParticipantes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(b => new { 
        id = b.IdBoleto, 
        numero = b.Numero, 
        comprador = string.IsNullOrEmpty(b.NombreComprador) ?
"Boleto Vendido" : b.NombreComprador 
    })));
    
    // Lista de descartes recuperada y verificada criptográficamente desde el backend
    var descartesRecuperados = @Html.Raw(ViewBag.DescartesPrevios != null ? System.Text.Json.JsonSerializer.Serialize(ViewBag.DescartesPrevios) : "[]");
    var poolParticipantes = [...rawParticipantes];
    var targetAttempt = 3; 
    var currentAttempt = 1;
    var isSpinning = false;
    var spinInterval;
    var tempEliminado = null;
    var confettiActive = false;
    var ganadorFinal = null; 

    // NUEVO: Variables para grabación
    var mediaRecorder = null;
    var recordedChunks = [];

    var statusText = document.getElementById('statusText');
    var displayNum = document.getElementById('displayNum');
    var displayName = document.getElementById('displayName');
    var btnSpin = document.getElementById('btnSpin');
    var mainBubble = document.getElementById('mainBubble');
    var bubbleContent = document.getElementById('bubbleContent');
    var btnContinue = document.getElementById('btnContinue');
    document.addEventListener("DOMContentLoaded", function() {
        if(descartesRecuperados && descartesRecuperados.length > 0) {
            document.getElementById('setupScreen').style.display = 'none';
            document.getElementById('discardPanel').classList.add('visible');
            document.getElementById('trackerWrapper').style.display = 'flex';

            descartesRecuperados.forEach(d => {
                var div = document.createElement('div');
            
                div.className = 'discard-item';
                div.innerHTML = `<span class="discard-number">#${d.Numero.toString().padStart(3,'0')}</span><span class="discard-name">${d.NombreComprador}</span>`;
                document.getElementById('discardList').prepend(div);
            });

            var savedTarget = localStorage.getItem('rifa_@ViewBag.TokenRifa' + '_targetAttempt');
            if(savedTarget && parseInt(savedTarget) > descartesRecuperados.length) {
            
                targetAttempt = parseInt(savedTarget);
            } else {
                targetAttempt = descartesRecuperados.length + 1;
}

            currentAttempt = descartesRecuperados.length + 1;
            updateState();
}
    });

    function selectMode(n, btnElement) {
        targetAttempt = n;
        document.querySelectorAll('.config-option').forEach(b => b.classList.remove('selected'));
        if(btnElement) btnElement.classList.add('selected');
        else event.currentTarget.classList.add('selected');
    }

    // NUEVO: Función modificada para soportar grabación asíncrona
    async function startGame() {
        if(poolParticipantes.length === 0) { alert("No hay suficientes participantes.");
return; }
        if(targetAttempt > poolParticipantes.length) { 
            alert(`Solo hay ${poolParticipantes.length} boletos participantes. Ajustando intentos.`);
            targetAttempt = poolParticipantes.length; 
        }

        try {
            // Pedir permisos de grabación de pantalla al usuario
            const stream = await navigator.mediaDevices.getDisplayMedia({ video: { displaySurface: "browser" }, audio: false });
            
            mediaRecorder = new MediaRecorder(stream, { mimeType: 'video/webm' });
            
            mediaRecorder.ondataavailable = function(e) {
                if (e.data.size > 0) recordedChunks.push(e.data);
            };
            
            mediaRecorder.onstop = function() {
                const blob = new Blob(recordedChunks, { type: 'video/webm' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = 'Sorteo_' + '@ViewBag.TokenRifa' + '.webm';
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                
                // Detener los tracks para quitar el ícono rojo del navegador
                stream.getTracks().forEach(track => track.stop());

                // NUEVO: Restaurar el botón de resultados al terminar la descarga
                let btnRes = document.getElementById('btnVerResultados');
                let msgWait = document.getElementById('videoWaitMessage');
                if(btnRes && msgWait) {
                    msgWait.innerHTML = '<i class="fa-solid fa-circle-check text-success me-2"></i> ¡Video guardado con éxito!';
                    msgWait.style.color = '#10b981';
                    setTimeout(() => {
                        msgWait.style.display = 'none';
                        btnRes.style.display = 'inline-flex';
                    }, 2000);
                }
            };
            
            mediaRecorder.start();
            
            // Cambiar badge a GRABANDO
            var badge = document.querySelector('.live-badge');
            if(badge) {
                badge.innerHTML = '<i class="fa-solid fa-circle text-white me-1" style="font-size: 0.6rem;"></i> GRABANDO';
                badge.classList.add('recording-active');
            }
        } catch(err) {
            console.warn("Grabación cancelada: ", err);
            alert("⚠️ Se ha omitido la grabación. El sorteo continuará, pero no se generará su grabación.");
        }

        localStorage.setItem('rifa_@ViewBag.TokenRifa' + '_targetAttempt', targetAttempt);

        document.getElementById('setupScreen').style.display = 'none';
        document.getElementById('discardPanel').classList.add('visible');
        document.getElementById('trackerWrapper').style.display = 'flex';
        updateState();
    }

    function updateState() {
        if(currentAttempt <= targetAttempt) {
            document.getElementById('trackerText').innerText = `INTENTO ${currentAttempt} DE ${targetAttempt}`;
            if(currentAttempt === targetAttempt) {
                btnSpin.innerText = "¡GIRAR POR EL GANADOR!";
                btnSpin.className = "btn-main golden-state";
            } else {
                btnSpin.innerText = "GIRAR (ELIMINATORIA)";
                btnSpin.className = "btn-main";
            }
        }
    }

    function spinRoulette() {
        if(isSpinning || poolParticipantes.length === 0) return;
        isSpinning = true;
        btnSpin.disabled = true;

        mainBubble.classList.remove('eliminated-state', 'zoom-explosion');
        bubbleContent.classList.remove('slide-up');
        btnContinue.classList.remove('show');
        document.getElementById('discardPanel').classList.remove('force-hide');

        statusText.innerText = "MEZCLANDO...";
        statusText.style.color = "#38bdf8";
        spinInterval = setInterval(() => {
            if(poolParticipantes.length > 0) {
                var rand = poolParticipantes[Math.floor(Math.random() * poolParticipantes.length)];
                displayNum.innerText = rand.numero.toString().padStart(3,'0');
                displayName.innerText = "Buscando...";
            }
        }, 80);
        var esGanador = (currentAttempt === targetAttempt);
        var tokenAnti = document.querySelector('input[name="__RequestVerificationToken"]').value;
        
        var formData = new FormData();
        formData.append('tokenRifa', '@ViewBag.TokenRifa');
        formData.append('esGanador', esGanador);
        formData.append('intentoActual', currentAttempt);
        formData.append('__RequestVerificationToken', tokenAnti);

        var fetchPromise = fetch('@Url.Action("ProcesarTiroSorteo", "RifasPersonales")', {
            method: 'POST',
            body: formData
        }).then(r => r.json());
        var timePromise = new Promise(resolve => setTimeout(resolve, 2500));

        Promise.all([fetchPromise, timePromise]).then(values => {
            clearInterval(spinInterval);
            var response = values[0];
            
            if(response && response.exito) {
                procesarResultadoAjax(response, esGanador);
            } else if (response && response.codigoError 
=== "SYNC") {
                // MAQUILLAJE DE ERRORES: Manejo silencioso en vivo sin alarmar
                statusText.innerText = "RECONECTANDO...";
                statusText.style.color = "#fbbf24"; 
                displayNum.innerText = "---";
                displayName.innerText = 
"Ajustando señal...";
                setTimeout(() => location.reload(), 2000);
            } else {
                alert("Error: " + (response ? response.mensaje : "Error desconocido"));
                location.reload();
            }
        }).catch(err => {
    
            clearInterval(spinInterval);
            console.error(err);
            statusText.innerText = "SIN SEÑAL";
            statusText.style.color = "#ef4444";
            displayName.innerText = "Reconectando...";
            setTimeout(() => location.reload(), 3000);
        });
}

    function procesarResultadoAjax(resultado, esGanador) {
        if (!esGanador) {
            tempEliminado = { numero: resultado.numero, comprador: resultado.comprador, id: resultado.idBoleto };
            poolParticipantes = poolParticipantes.filter(p => p.id !== resultado.idBoleto);

            displayNum.innerText = tempEliminado.numero.toString().padStart(3,'0');
            displayName.innerText = tempEliminado.comprador;
            statusText.innerText = "RESULTADO";
            setTimeout(() => {
                mainBubble.classList.add('shake-anim');
                setTimeout(() => {
                    mainBubble.classList.remove('shake-anim');
                    mainBubble.classList.add('eliminated-state');
                    statusText.innerText = "ELIMINADO";
  
                    statusText.style.color = "#ef4444"; 
                    bubbleContent.classList.add('slide-up');
                    
                    btnSpin.classList.add('hide-btn'); 
                  
                    setTimeout(() => { btnContinue.classList.add('show'); }, 200);
                }, 400);
            }, 200);
} else {
            localStorage.removeItem('rifa_@ViewBag.TokenRifa' + '_targetAttempt');
            ganadorFinal = { numero: resultado.numero, comprador: resultado.comprador, id: resultado.idBoleto };
            displayNum.innerText = ganadorFinal.numero.toString().padStart(3,'0');
            displayName.innerText = ganadorFinal.comprador;
            statusText.innerText = "¡GANADOR!";
            statusText.style.color = "#fbbf24"; 

            btnSpin.classList.add('hide-btn'); 
            mainBubble.classList.add('winner');
            startConfettiOptimizado();

            setTimeout(() => {
                document.getElementById('discardPanel').classList.add('force-hide');
                mainBubble.classList.add('zoom-explosion');

                document.getElementById('finalNum').innerText = ganadorFinal.numero.toString().padStart(3,'0');
                document.getElementById('finalName').innerText = ganadorFinal.comprador;

                setTimeout(() => {
      
                    document.getElementById('winnerScreen').classList.add('visible');
                    
                    // NUEVO: Proceso de espera para descargar el video
                    let btnRes = document.getElementById('btnVerResultados');
                    let msgWait = document.getElementById('videoWaitMessage');
                    
                    if(mediaRecorder && mediaRecorder.state !== "inactive") {
                        if(btnRes) btnRes.style.display = 'none';
                        if(msgWait) msgWait.style.display = 'block';
                        
                        // Detener grabación 3 segundos después de mostrar la pantalla final
                        setTimeout(() => {
                            mediaRecorder.stop();
                        }, 3000);
                    }
                    
                }, 800);
            }, 1000);
}
    }

    function confirmarEliminacion() {
        mainBubble.classList.remove('eliminated-state');
        btnContinue.classList.remove('show');
        bubbleContent.classList.remove('slide-up');

        statusText.innerText = "LISTO";
        statusText.style.color = "#38bdf8";
        displayNum.innerText = "000";
        displayName.innerText = "Siguiente...";
        
        var div = document.createElement('div');
        div.className = 'discard-item';
        div.innerHTML = `<span class="discard-number">#${tempEliminado.numero.toString().padStart(3,'0')}</span><span class="discard-name">${tempEliminado.comprador}</span>`;
        document.getElementById('discardList').prepend(div);

        currentAttempt++;
        updateState();
        isSpinning = false;

        btnSpin.classList.remove('hide-btn'); 
        btnSpin.disabled = false;
}

    function startConfettiOptimizado() {
        confettiActive = true;
        let endTime = Date.now() + (8 * 1000); 
        (function frame() {
            if (!confettiActive || Date.now() > endTime) return;
            var sidebar = document.getElementById('discardPanel');
            var startX = (sidebar ? sidebar.offsetWidth : 0) / window.innerWidth;
            
            confetti({ particleCount: 3, angle: 60, spread: 55, origin: { x: startX, y: 
0.6 }, colors: ['#ffffff', '#fbbf24', '#38bdf8'], zIndex: 10001 });
            confetti({ particleCount: 3, angle: 120, spread: 55, origin: { x: 1, y: 0.6 }, colors: ['#ffffff', '#fbbf24', '#38bdf8'], zIndex: 10001 });
            requestAnimationFrame(frame);
        }());
}

    function toggleLiveMode() {
        var body = document.body;
        var activado = body.classList.toggle('modo-live');
        var elem = document.documentElement;
        var icon = document.getElementById('iconFullscreen');
        if (activado) {
            if (elem.requestFullscreen) elem.requestFullscreen();
            else if (elem.webkitRequestFullscreen) elem.webkitRequestFullscreen();
            icon.classList.replace('fa-expand', 'fa-compress');
        } else {
            if (document.exitFullscreen) document.exitFullscreen();
            icon.classList.replace('fa-compress', 'fa-expand');
        }
    }
    
    document.addEventListener('fullscreenchange', () => {
        if (!document.fullscreenElement) {
            document.body.classList.remove('modo-live');
            document.getElementById('iconFullscreen').classList.replace('fa-compress', 'fa-expand');
        }
    });
</script>