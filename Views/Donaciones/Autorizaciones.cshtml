@using RedAJP.Models
@model List<RevisionDonacionViewModel>
@{
    Layout = "Principal";
    ViewData["Title"] = "Revisión de Donaciones";
    int idUsuarioActual = 0;
    int.TryParse(User.FindFirst("IdUsuario")?.Value, out idUsuarioActual);
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-autorizacion-donaciones');
        }
    });
</script>
<style>
    .modal-verification .modal-body { padding: 0; background-color: #f8f9fa; }
    .panel-evidence {
        background-color: #212529; position: relative; height: 600px;
        display: flex; align-items: center; justify-content: center; overflow: hidden;
    }
    .panel-evidence img { max-width: 100%; max-height: 100%;
        box-shadow: 0 0 15px rgba(0,0,0,0.5); transition: transform 0.3s; }
    .panel-details { padding: 2rem; height: 600px; overflow-y: auto;
        background-color: white; display: flex; flex-direction: column; }
    
    @@media (max-width: 991px) {
        .panel-evidence { height: 300px; background-color: #000; }
        .panel-details { height: auto; max-height: 50vh; padding: 1.5rem; }
        .modal-verification .modal-dialog { margin: 0; max-width: 100%; }
        .modal-verification .modal-content { border-radius: 0; min-height: 100vh; }
    }
</style>

<div class="container py-5 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="fa-solid fa-hand-holding-dollar me-2 text-success"></i>Verificación de Donaciones</h2>
            <p class="text-muted mb-0">Revisa los comprobantes enviados y regístralos en Tesorería.</p>
        </div>
        <a href="@Url.Action("Index", "Caja")" class="btn btn-outline-secondary rounded-pill">
            Caja <i class="fa-solid fa-arrow-right me-1"></i>
        </a>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-uppercase small text-muted">
                        <tr>
                            <th class="ps-4 py-3">Fecha</th>
                            <th>Donante</th>
                            <th>Monto Reportado</th>
                            <th>Estatus</th>
                            <th class="text-end pe-4">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.Fecha.ToString("dd/MMM/yyyy")</div>
                                    <small class="text-muted">@item.Fecha.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px; height:40px;">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark text-truncate" style="max-width:200px;">@item.Donante</div>
                                            @if(!string.IsNullOrEmpty(item.Email)) {
                                                <small class="text-muted d-block" style="font-size:0.75rem;">@item.Email</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (item.MontoOriginal > 0) {
                                        <span class="fw-bold text-dark fs-6">$@item.MontoOriginal.ToString("N2")</span>
                                    } else {
                                        <span class="text-muted fst-italic small">No especificado</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Requiere2daValidacion)
                                    {
                                        <span class="badge bg-warning text-dark border border-warning rounded-pill px-3"><i class="fa-solid fa-clock me-1"></i> 2da Validación</span>
                                        <small class="d-block text-muted mt-1" style="font-size:0.7rem;">Revisado por: @item.PreRevisor</small>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill px-3">Nuevo</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @{
                                        bool esMioEnRevision = item.Requiere2daValidacion && item.IdUsuarioPreRevisor == idUsuarioActual;
                                    }
                                    
                                    <button class="btn @(item.Requiere2daValidacion ? (esMioEnRevision ? "btn-outline-info" : "btn-warning text-dark") : "btn-primary") fw-bold rounded-pill px-4 shadow-sm btn-sm"
                                            onclick="abrirVerificador(@item.IdDonacion)">
                                        @if(esMioEnRevision)
                                        {
                                            <i class="fa-solid fa-eye me-2"></i> @:Ver / Deshacer
                                        }
                                        else
                                        {
                                            <i class="fa-solid @(item.Requiere2daValidacion ? "fa-user-check" : "fa-magnifying-glass") me-2"></i> 
                                            @(item.Requiere2daValidacion ? "Confirmar" : "Revisar")
                                        }
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <i class="fa-solid fa-envelope-open-text fa-4x text-success opacity-25 mb-3"></i>
            <h4 class="fw-bold text-dark">Bandeja Limpia</h4>
            <p class="text-muted">No hay donaciones pendientes de revisión en este momento.</p>
        </div>
    }
</div>

<div class="modal fade" id="modalAlertaPersonalizada" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-body text-center p-4">
                <i class="fa-solid fa-circle-exclamation text-warning fa-3x mb-3"></i>
                <h5 class="fw-bold text-dark mb-2">Atención</h5>
                <p class="text-muted small mb-4" id="txtMensajeAlerta"></p>
                <button type="button" class="btn btn-primary rounded-pill w-100 fw-bold" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmacionPersonalizada" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-body p-4 text-center pb-2">
                <i id="iconoConfirmacion" class="fa-solid fa-3x mb-3"></i>
                <h5 class="fw-bold mb-2" id="tituloConfirmacion">Confirmar</h5>
                <p class="fs-6 text-muted mb-4" id="txtMensajeConfirmacion"></p>
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0 pb-4">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn rounded-pill px-4 fw-bold shadow-sm" id="btnEjecutarAccion">Confirmar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-verification" id="modalDashboard" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header bg-dark text-white py-2">
                <div class="d-flex align-items-center">
                    <h6 class="modal-title mb-0"><i class="fa-solid fa-scale-balanced me-2 text-success"></i> Dictamen de Donación</h6>
                    <span class="mx-2 text-white-50">|</span>
                    <small class="text-white-50" id="lblFolioModal">Folio #000</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="row g-0 h-100">

                    <div class="col-lg-7 panel-evidence">
                        <div id="loaderImg" class="text-white text-center">
                            <div class="spinner-border text-success mb-2" role="status"></div>
                            <div class="small">Cargando comprobante...</div>
                        </div>

                        <img id="imgComprobante" src="" class="d-none" onclick="window.open(this.src, '_blank')" style="cursor: zoom-in;" title="Clic para expandir">
                        <iframe id="pdfComprobante" class="w-100 h-100 d-none bg-white"></iframe>
                    </div>

                    <div class="col-lg-5 panel-details">
                        
                        <div class="d-flex align-items-center mb-4 p-3 bg-light rounded-3 border">
                            <div class="fs-1 me-3 text-secondary"><i class="fa-solid fa-circle-user"></i></div>
                            <div>
                                <small class="text-uppercase text-muted fw-bold" style="font-size:0.7rem;">Donante</small>
                                <h5 class="fw-bold text-dark mb-0" id="lblDonante">-</h5>
                                <small class="text-muted d-block mb-1" id="lblFecha">-</small>
                                <p class="mb-0 text-secondary fst-italic small d-none" id="lblComentarioUsuario" style="border-left: 3px solid #ccc; padding-left: 8px;"></p>
                            </div>
                        </div>

                        <div id="divPrimeraValidacion" class="d-none flex-grow-1 d-flex flex-column">
                            <form action="@Url.Action("Dictaminar")" method="post" id="formDictamen" class="h-100 d-flex flex-column">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idDonacion" id="hdnIdDonacion1" />
                                <input type="hidden" name="montoReportado" id="hdnMontoReportado" />
                                <input type="hidden" name="esAprobado" id="hdnAprobado1" value="false" />

                                <div class="alert alert-info border-info border-opacity-50 py-2 px-3 mb-3">
                                    <small class="fw-bold d-block text-info">Monto Reportado por el Usuario:</small>
                                    <span class="fs-4 fw-bold" id="lblMontoReportado">$0.00</span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-dark">Monto Real a Ingresar a Caja ($)</label>
                                    <input type="number" step="0.01" class="form-control form-control-lg fw-bold text-success" name="montoValidado" id="txtMontoValidado" required>
                                    <small class="text-muted" style="font-size:0.75rem;">Si ajustas este monto, se requerirá una segunda validación por seguridad.</small>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-primary mb-1">Folio del Banco / Rastreabilidad (Obligatorio para aprobar)</label>
                                    <input type="text" name="folioBancario" id="txtFolioBancario" class="form-control font-monospace bg-light border-primary border-opacity-25" placeholder="Ej. 123456789">
                                </div>

                                <div class="mb-auto">
                                    <label class="form-label fw-bold small text-dark">Notas / Motivo de Rechazo</label>
                                    <textarea name="comentarios" id="txtComentarios1" class="form-control bg-light" rows="3" placeholder="Ej: Se ajustó el monto porque el comprobante indica otra cantidad..."></textarea>
                                </div>

                                <div class="d-grid gap-2 d-md-flex mt-4">
                                    <button type="button" class="btn btn-outline-danger flex-fill fw-bold py-2" onclick="enviarPrimeraValidacion(false)">
                                        <i class="fa-solid fa-xmark me-2"></i> Rechazar
                                    </button>
                                    <button type="button" class="btn btn-success flex-fill fw-bold py-2 shadow-sm" onclick="enviarPrimeraValidacion(true)">
                                        <i class="fa-solid fa-check me-2"></i> Aprobar
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div id="divSegundaValidacion" class="d-none flex-grow-1 d-flex flex-column">
                            <form action="@Url.Action("SegundaValidacion")" method="post" id="formSegundaValidacion" class="h-100 d-flex flex-column">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idDonacion" id="hdnIdDonacion2" />
                                <input type="hidden" name="confirmar" id="hdnConfirmar" value="true" />

                                <div id="bannerEstado2daVal" class="alert mb-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <i id="iconoEstado2daVal" class="fa-solid fa-2x me-3"></i>
                                        <div>
                                            <h6 class="fw-bold mb-0" id="tituloEstado2daVal">Título</h6>
                                            <small id="subtituloEstado2daVal">Subtítulo</small>
                                        </div>
                                    </div>
                                    <hr class="my-2 opacity-25">
                                    <p class="small mb-0 text-dark">Pre-evaluado por: <strong id="lblAdmin1">Admin</strong></p>
                                </div>

                                <div class="mb-3 p-3 border rounded bg-light">
                                    <small class="text-muted fw-bold text-uppercase d-block mb-1">Monto a Ingresar a Caja</small>
                                    <h3 class="fw-bold mb-3" id="lblMontoPropuesto">$0.00</h3>
                                    
                                    <small class="text-muted fw-bold text-uppercase d-block mb-1 mt-3">Folio Propuesto</small>
                                    <h5 class="fw-bold mb-3 text-primary font-monospace" id="lblFolioPropuesto">N/A</h5>

                                    <small class="text-muted fw-bold text-uppercase d-block mb-1">Motivo / Notas del Evaluador</small>
                                    <p class="mb-0 text-dark fst-italic" id="lblNotaPropuesta">...</p>
                                </div>

                                <div id="divBotones2daVal" class="d-grid gap-2 d-md-flex mt-auto">
                                </div>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var datosDonaciones = @Html.Raw(Json.Serialize(Model));
    var idUsuarioActual = @idUsuarioActual; 
    
    var modalDashboard;
    var modalAlerta;
    var modalConfirmacion;
    var callbackConfirmacion = null;

    document.addEventListener("DOMContentLoaded", function() {
        modalDashboard = new bootstrap.Modal(document.getElementById('modalDashboard'));
        modalAlerta = new bootstrap.Modal(document.getElementById('modalAlertaPersonalizada'));
        modalConfirmacion = new bootstrap.Modal(document.getElementById('modalConfirmacionPersonalizada'));

        document.getElementById('btnEjecutarAccion').addEventListener('click', function() {
            if(callbackConfirmacion) {
                modalConfirmacion.hide();
                callbackConfirmacion();
            }
        });
    });

    function mostrarAlerta(mensaje, elementoEnfocar = null) {
        document.getElementById('txtMensajeAlerta').innerText = mensaje;
        modalAlerta.show();
        
        if(elementoEnfocar) {
            document.getElementById('modalAlertaPersonalizada').addEventListener('hidden.bs.modal', function () {
                document.getElementById(elementoEnfocar).focus();
            }, { once: true });
        }
    }

    function mostrarConfirmacion(mensaje, tipo, titulo, callbackAccion) {
        document.getElementById('txtMensajeConfirmacion').innerText = mensaje;
        document.getElementById('tituloConfirmacion').innerText = titulo;
        
        let icon = document.getElementById('iconoConfirmacion');
        let btn = document.getElementById('btnEjecutarAccion');
        let tituloDom = document.getElementById('tituloConfirmacion');

        icon.className = "fa-solid fa-3x mb-3 ";
        btn.className = "btn rounded-pill px-4 fw-bold shadow-sm w-100 ";

        if (tipo === 'aprobar') {
            icon.className += "fa-circle-check text-success";
            tituloDom.className = "fw-bold mb-2 text-success";
            btn.className += "btn-success";
            btn.innerText = "Aprobar";
        } else if (tipo === 'rechazar') {
            icon.className += "fa-triangle-exclamation text-danger";
            tituloDom.className = "fw-bold mb-2 text-danger";
            btn.className += "btn-danger";
            btn.innerText = "Rechazar";
        } else if (tipo === 'deshacer') {
            icon.className += "fa-rotate-left text-warning";
            tituloDom.className = "fw-bold mb-2 text-dark";
            btn.className += "btn-warning text-dark";
            btn.innerText = "Sí, deshacer";
        }

        callbackConfirmacion = callbackAccion;
        modalConfirmacion.show();
    }

    function abrirVerificador(idDonacion) {
        var item = datosDonaciones.find(x => x.idDonacion === idDonacion);
        if (!item) return;

        document.getElementById('lblFolioModal').innerText = "Donación #" + item.idDonacion;
        document.getElementById('lblDonante').innerText = item.donante;
        var fecha = new Date(item.fecha);
        document.getElementById('lblFecha').innerText = fecha.toLocaleDateString() + " " + fecha.toLocaleTimeString();
        var lblComentario = document.getElementById('lblComentarioUsuario');

        if (item.comentarioDonante && item.comentarioDonante.trim() !== "") {
            lblComentario.innerText = `"${item.comentarioDonante}"`;
            lblComentario.classList.remove('d-none');
        } else {
            lblComentario.classList.add('d-none');
        }

        var urlImg = '@Url.Action("VerComprobantePendiente")?id=' + item.idDonacion;
        var img = document.getElementById('imgComprobante');
        var pdf = document.getElementById('pdfComprobante');
        var loader = document.getElementById('loaderImg');

        img.classList.add('d-none');
        pdf.classList.add('d-none');
        loader.style.display = 'block';

        img.src = urlImg;
        img.onload = function() {
            loader.style.display = 'none';
            img.classList.remove('d-none');
        };
        img.onerror = function() {
            img.classList.add('d-none');
            pdf.src = urlImg;
            pdf.classList.remove('d-none');
            loader.style.display = 'none';
        };

        if(item.requiere2daValidacion) {
            document.getElementById('divPrimeraValidacion').classList.add('d-none');
            document.getElementById('divSegundaValidacion').classList.remove('d-none');
            
            document.getElementById('hdnIdDonacion2').value = item.idDonacion;
            document.getElementById('lblAdmin1').innerText = item.preRevisor;
            document.getElementById('lblNotaPropuesta').innerText = item.notas || "Sin notas adicionales.";
            
            // LLenar Folio Propuesto
            document.getElementById('lblFolioPropuesto').innerText = item.folioBancario || "N/A";

            let banner = document.getElementById('bannerEstado2daVal');
            let icono = document.getElementById('iconoEstado2daVal');
            let titulo = document.getElementById('tituloEstado2daVal');
            let subtitulo = document.getElementById('subtituloEstado2daVal');
            let lblMonto = document.getElementById('lblMontoPropuesto');
            let divBotones = document.getElementById('divBotones2daVal');
            divBotones.innerHTML = ''; 

            if(item.montoValidado < 0) {
                banner.className = "alert alert-danger border-danger border-opacity-50 mb-3";
                icono.className = "fa-solid fa-ban text-danger";
                titulo.innerText = "Propuesta de Rechazo";
                titulo.className = "fw-bold mb-0 text-danger";
                subtitulo.innerText = "Se sugiere rechazar este comprobante definitivamente.";
                
                lblMonto.innerText = "RECHAZADO";
                lblMonto.className = "fw-bold mb-3 text-danger";
            } else {
                banner.className = "alert alert-warning border-warning border-opacity-50 mb-3";
                icono.className = "fa-solid fa-pen-to-square text-warning";
                titulo.innerText = "Propuesta de Modificación";
                titulo.className = "fw-bold mb-0 text-dark";
                subtitulo.innerText = "Se ajustó el monto original reportado por el usuario.";
                
                lblMonto.innerText = "$" + item.montoValidado.toLocaleString('es-MX', {minimumFractionDigits: 2});
                lblMonto.className = "fw-bold mb-3 text-success";
            }

            if (item.idUsuarioPreRevisor === idUsuarioActual) {
                divBotones.innerHTML = `
                    <div class="w-100 text-center mt-3">
                        <p class="small mb-3 text-muted fw-bold"><i class="fa-solid fa-clock me-1"></i> Esperando que otro administrador confirme tu evaluación.</p>
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill fw-bold px-4 shadow-sm" onclick="enviarSegundaValidacion(false)">
                            <i class="fa-solid fa-rotate-left me-2"></i> Deshacer mi evaluación
                        </button>
                    </div>
                `;
            } else {
                let txtConfirmar = item.montoValidado < 0 ? "Confirmar Rechazo" : "Aprobar Modificación";
                let btnClass = item.montoValidado < 0 ? "btn-danger" : "btn-success";
                let iconClass = item.montoValidado < 0 ? "fa-ban" : "fa-check-double";
                divBotones.innerHTML = `
                    <button type="button" class="btn btn-outline-secondary flex-fill fw-bold py-2 rounded-pill" onclick="enviarSegundaValidacion(false)">
                        <i class="fa-solid fa-xmark me-2"></i> Descartar Propuesta
                    </button>
                    <button type="button" class="btn ${btnClass} flex-fill fw-bold py-2 shadow-sm rounded-pill" onclick="enviarSegundaValidacion(true)">
                        <i class="fa-solid ${iconClass} me-2"></i> ${txtConfirmar}
                    </button>
                `;
            }

        } else {
            document.getElementById('divPrimeraValidacion').classList.remove('d-none');
            document.getElementById('divSegundaValidacion').classList.add('d-none');
            
            document.getElementById('hdnIdDonacion1').value = item.idDonacion;
            document.getElementById('hdnMontoReportado').value = item.montoOriginal;
            document.getElementById('txtFolioBancario').value = ""; // Limpiar Folio
            
            if(item.montoOriginal > 0) {
                document.getElementById('lblMontoReportado').innerText = "$" + item.montoOriginal.toLocaleString('es-MX', {minimumFractionDigits: 2});
                document.getElementById('txtMontoValidado').value = item.montoOriginal;
            } else {
                document.getElementById('lblMontoReportado').innerText = "No Especificado";
                document.getElementById('txtMontoValidado').value = "";
            }
            document.getElementById('txtComentarios1').value = "";
        }

        modalDashboard.show();
    }

    function enviarPrimeraValidacion(esAprobado) {
        var montoInput = document.getElementById('txtMontoValidado').value;
        var comentario = document.getElementById('txtComentarios1').value.trim();
        var montoOriginal = document.getElementById('hdnMontoReportado').value;
        var folio = document.getElementById('txtFolioBancario').value.trim();

        if(esAprobado && (montoInput === "" || montoInput <= 0)) {
            mostrarAlerta("Para aprobar, debes especificar un monto válido mayor a 0.", "txtMontoValidado");
            return;
        }
        
        // NUEVA VALIDACIÓN EN FRONTEND: Folio
        if(esAprobado && folio === "") {
            mostrarAlerta("Para aprobar, es obligatorio ingresar el Folio del Banco.", "txtFolioBancario");
            return;
        }

        if(!esAprobado && comentario === "") {
            mostrarAlerta("Para rechazar, es obligatorio escribir un motivo para notificar al donante.", "txtComentarios1");
            return;
        }

                if(esAprobado && (parseFloat(montoInput) !== parseFloat(montoOriginal)) && parseFloat(montoOriginal) != 0 && comentario === "") {
            mostrarAlerta("Como estás modificando el monto original reportado, por favor escribe un comentario del motivo.", "txtComentarios1");
            return;
        }

        document.getElementById('hdnAprobado1').value = esAprobado;
        
        var msj = esAprobado ?
            "¿Estás seguro de aprobar y procesar como recibida esta donación en Caja?"
            : "¿Estás seguro de rechazar este comprobante?, Se mandará a una segunda Autorización";
        var tipo = esAprobado ? 'aprobar' : 'rechazar';
        var titulo = esAprobado ? 'Confirmar Aprobación' : 'Confirmar Rechazo';
        
        mostrarConfirmacion(msj, tipo, titulo, function() {
            document.getElementById('formDictamen').submit();
        });
    }

    function enviarSegundaValidacion(confirmar) {
        document.getElementById('hdnConfirmar').value = confirmar;
        var msj = "";
        var tipo = "";
        var titulo = "";
        
        if(!confirmar) {
            msj = "Se cancelará la evaluación previa y el comprobante volverá a la bandeja de pendientes. ¿Estás seguro?";
            tipo = 'deshacer';
            titulo = 'Deshacer Evaluación';
        } else {
            var esRechazo = document.getElementById('lblMontoPropuesto').innerText === "RECHAZADO";
            msj = "Se ejecutará la acción de forma definitiva y se notificará al usuario de ser necesario. ¿Continuar?";
            tipo = esRechazo ? 'rechazar' : 'aprobar';
            titulo = esRechazo ? 'Confirmar Rechazo Definitivo' : 'Confirmar Aprobación Definitiva';
        }

        mostrarConfirmacion(msj, tipo, titulo, function() {
            document.getElementById('formSegundaValidacion').submit();
        });
    }
</script>
}