@{
    Layout = null;
    var evento = ViewBag.Evento as RedAJP.Models.EventoItemViewModel;
    var subtipos = ViewBag.Subtipos as List<RedAJP.Models.SubtipoEventoItem>;
    var galeria = ViewBag.Galeria as List<RedAJP.Models.FotoGaleriaItem>;

    // Formateo de fecha localizado en español
    var culturaEs = new System.Globalization.CultureInfo("es-ES");
    string fechaFormateada = "";
    if (evento != null && evento.Fecha_Inicio != DateTime.MinValue)
    {
        string diaTexto = evento.Fecha_Inicio.ToString("dddd, d 'de' MMMM 'de' yyyy", culturaEs);
        fechaFormateada = char.ToUpper(diaTexto[0]) + diaTexto.Substring(1) + " - " + evento.Fecha_Inicio.ToString("hh:mm tt", culturaEs);
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ficha - @(evento?.Titulo ?? "Evento")</title>

    <link rel="icon" type="image/png" href="~/Images/favicon.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/x-icon" href="~/Images/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/fonts/outfit.css" />
    <link rel="stylesheet" href="~/css/estilos_pagina.css" asp-append-version="true" />

    <style>
        /* --- ESTILOS BASE Y TEMA DINÁMICO --- */
        body {
            background-color: var(--bg-body, #FAF6F0);
            font-family: var(--bs-body-font-family, 'Outfit', 'Segoe UI', system-ui, -apple-system, sans-serif);
            color: var(--texto-principal, #1F2937);
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .ficha-container {
            max-width: 860px;
            margin: 25px auto;
            background: var(--bg-card, #ffffff);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(0, 0, 0, 0.06);
        }

        /* --- HEADER --- */
        .header-ficha {
            background-color: var(--bg-header, #0A3A35);
            background-image: var(--card-header-bg, none);
            color: var(--texto-header, #ffffff);
            padding: 35px 40px;
            border-bottom: 5px solid var(--primary, #E05A2B);
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .logo-img {
            height: 76px;
            width: 76px;
            object-fit: contain;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.12);
            border: 2px solid rgba(255, 255, 255, 0.35);
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
            display: block;
        }

        .subtitulo-org {
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--secondary, #F59E0B);
            margin-bottom: 6px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .titulo-evento {
            font-size: 2.1rem;
            font-weight: 800;
            text-transform: uppercase;
            margin: 0;
            line-height: 1.15;
            letter-spacing: -0.02em;
            color: var(--texto-header, #ffffff);
        }

        .fecha-evento-header {
            margin-top: 0.5rem;
            color: rgba(255, 255, 255, 0.85);
            font-weight: 600;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
        }

        /* --- CUERPO --- */
        .body-ficha {
            padding: 35px 40px;
            background: var(--bg-card, #ffffff);
        }

        .section-title {
            color: var(--primary, #E05A2B);
            font-size: 1.25rem;
            font-weight: 700;
            border-left: 4px solid var(--secondary, #F59E0B);
            padding-left: 14px;
            margin: 30px 0 18px 0;
            page-break-after: avoid;
            break-after: avoid;
            letter-spacing: -0.01em;
        }

        .descripcion-texto {
            line-height: 1.75;
            text-align: justify;
            color: var(--texto-principal, #333333);
            font-size: 1rem;
        }

        /* --- IMÁGENES --- */
        .img-container-full {
            width: 100%;
            margin-bottom: 25px;
            text-align: center;
            background-color: var(--bg-surface, #F4EAD9);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(0, 0, 0, 0.08);
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .img-full {
            width: 100%;
            height: auto;
            display: block;
        }

        /* --- GALERÍA EN GRID --- */
        .galeria-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
        }

        .galeria-grid .img-container-full {
            margin-bottom: 0;
            height: auto;
        }

        .galeria-grid .img-full {
            max-height: 250px;
            object-fit: contain;
            width: auto;
            margin: 0 auto;
        }

        .pie-foto {
            background: var(--bg-surface, #F4EAD9);
            padding: 10px 14px;
            font-size: 0.85rem;
            font-style: italic;
            color: var(--texto-muted, #6B7280);
            border-top: 1px solid rgba(0, 0, 0, 0.06);
        }

        /* --- TABLA DE COSTOS --- */
        .table-custom {
            width: 100%;
            margin-bottom: 30px;
            border-collapse: collapse;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .table-custom th {
            border-bottom: 2px solid var(--primary, #E05A2B);
            padding: 12px 10px;
            color: var(--texto-muted, #6B7280);
            font-size: 0.85rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.04em;
        }

        .table-custom td {
            padding: 12px 10px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.06);
            font-weight: 500;
            color: var(--texto-principal, #1F2937);
        }

        .precio-destacado {
            color: var(--primary, #E05A2B);
            font-weight: 800;
            font-size: 1.05rem;
        }

        /* --- CAJA DE REGISTRO / INFO --- */
        .info-box {
            background: var(--bg-surface, #F4EAD9);
            color: var(--texto-principal, #1F2937);
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-left: 5px solid var(--primary, #E05A2B);
            padding: 24px;
            border-radius: 12px;
            text-align: center;
            margin-top: 35px;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .info-box.info-box-privado {
            background: var(--bg-header, #0A3A35);
            color: var(--texto-header, #ffffff);
            border-left-color: var(--secondary, #F59E0B);
        }

        /* --- BOTÓN IMPRIMIR --- */
        .btn-print {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 1000;
            background: var(--primary, #E05A2B);
            color: #ffffff;
            width: 58px;
            height: 58px;
            border-radius: 50%;
            border: none;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
            cursor: pointer;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-print:hover {
            background: var(--primary-dark, #B84318);
            transform: scale(1.08);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
            color: #ffffff;
        }

        /* --- REGLAS DE IMPRESIÓN --- */
        @@media print {
            @@page { margin: 1.2cm; }
            body { background: white !important; }
            .btn-print { display: none !important; }
            .ficha-container { box-shadow: none; margin: 0; width: 100%; max-width: 100%; border: none; border-radius: 0; }
            .body-ficha { padding: 20px 0; }
        }
    </style>
</head>
<body>

    <button onclick="window.print()" class="btn-print" title="Imprimir o Guardar PDF">
        <i class="fa-solid fa-print fa-lg"></i>
    </button>

    <div class="ficha-container">
        
        <div class="header-ficha">
            <div class="row align-items-center">
                <div class="col-auto">
                    <img src="~/Images/logo.png" class="logo-img" alt="Ministerio Corbán" asp-append-version="true">
                </div>
                <div class="col ps-3 ps-md-4">
                    <div class="subtitulo-org">
                        <i class="fa-solid fa-cross"></i> Ministerio Corbán
                    </div>
                    <h1 class="titulo-evento">@evento?.Titulo</h1>
                    <div class="fecha-evento-header">
                        <i class="fa-regular fa-calendar-days me-2 text-warning"></i>
                        @fechaFormateada
                    </div>
                </div>
            </div>
        </div>

        <div class="body-ficha">
            
            @if (!string.IsNullOrEmpty(evento?.Imagen_Url))
            {
                <div class="img-container-full">
                    <img src="@evento.Imagen_Url" class="img-full" alt="Portada Evento" referrerpolicy="no-referrer">
                </div>
            }

            <div class="section-title">Descripción</div>
            <div class="descripcion-texto">
                @{
                    string desc = evento?.Descripcion ?? "";
                    bool tieneHtml = System.Text.RegularExpressions.Regex.IsMatch(desc, @"<\s*([a-zA-Z]+)[^>]*>");
                    string descFinal = tieneHtml ? desc : desc.Replace("\n", "<br>");
                }
                @Html.Raw(descFinal)
            </div>

            <div class="section-title">Opciones y Costos</div>
            @if (subtipos != null && subtipos.Any())
            {
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th class="text-start">Opción</th>
                            <th class="text-center">Disponibilidad</th>
                            <th class="text-end">Precio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in subtipos)
                        {
                            int disponibles = sub.Cupo > 0 ? sub.Cupo - sub.Ocupados : 999999;
                            bool agotado = sub.Cupo > 0 && disponibles <= 0;

                            <tr>
                                <td class="text-start">@sub.Nombre</td>
                                <td class="text-center">
                                    @if (agotado)
                                    {
                                        <span class="text-danger fw-bold">Agotado</span>
                                    }
                                    else if (sub.Cupo > 0)
                                    {
                                        <span class="text-muted">@disponibles lugares</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Disponible</span>
                                    }
                                </td>
                                <td class="text-end precio-destacado">$@sub.Costo.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-3 border rounded-3 d-flex justify-content-between align-items-center mt-3" style="background-color: var(--bg-surface) !important; border-color: rgba(0,0,0,0.08) !important;">
                    <span class="text-muted text-uppercase fw-bold small">Precio General:</span>
                    <span class="fw-bold fs-5" style="color: var(--primary);">@((evento != null && evento.Costo > 0) ? "$" + evento.Costo.ToString("N2") : "Entrada Libre")</span>
                </div>
            }

            <div class="info-box shadow-sm @((evento != null && evento.EsPrivado) ? "info-box-privado" : "")">
                @if (evento != null && evento.EsPrivado)
                {
                    <h5 class="fw-bold mb-2 text-warning"><i class="fa-solid fa-lock me-2"></i> EVENTO PRIVADO</h5>
                    <p class="mb-0">Este evento requiere invitación. Por favor, repórtate con el delegado de tu iglesia local para más información.</p>
                }
                else
                {
                    <h5 class="fw-bold mb-2" style="color: var(--primary);"><i class="fa-solid fa-ticket me-2"></i> ¡REGÍSTRATE AHORA!</h5>
                    <p class="mb-0">Para participar, regístrate en <strong>MinisterioCorban.com</strong> y accede a la sección del evento.</p>
                }
            </div>

            @if (galeria != null && galeria.Any())
            {
                <div class="section-title">Galería de Imágenes</div>
                <div class="galeria-grid">
                    @foreach (var foto in galeria)
                    {
                        <div class="img-container-full">
                            <img src="@foto.Url_Foto" class="img-full" alt="Foto Galería" referrerpolicy="no-referrer">
                            @if (!string.IsNullOrEmpty(foto.Descripcion))
                            {
                                <div class="pie-foto text-center">@foto.Descripcion</div>
                            }
                        </div>
                    }
                </div>
            }

            <div class="text-center mt-5 pt-4 border-top text-muted small fw-semibold" style="border-top-color: rgba(0,0,0,0.08) !important;">
                <i class="fa-solid fa-cross me-1" style="color: var(--primary);"></i> Generado desde MinisterioCorban.com - @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
    </div>

</body>
</html>