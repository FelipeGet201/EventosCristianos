@model RedAJP.Models.IglesiaWebPublicaViewModel
@{
    Layout = "~/Views/Shared/LayoutPaginasWEB.cshtml";
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.NombreIglesia) ? "Página Inicial" : Model.NombreIglesia;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

<style>
    /* ======================================================== */
    /* MOTOR DE TEMAS: Conecta el JSON con las Variables CSS    */
    /* ======================================================== */
    :root {
        --theme-bg: @Html.Raw(Model.Diseno.TemaVisual.ColorFondo);
        --theme-surface: @Html.Raw(Model.Diseno.TemaVisual.ColorSuperficie);
        --theme-primary: @Html.Raw(Model.Diseno.TemaVisual.ColorPrimario);
        --theme-accent: @Html.Raw(Model.Diseno.TemaVisual.ColorAcento);
        --theme-text-main: @Html.Raw(Model.Diseno.TemaVisual.ColorTextoPrincipal);
        --theme-text-muted: @Html.Raw(Model.Diseno.TemaVisual.ColorTextoSecundario);
        --theme-font-title: @Html.Raw(Model.Diseno.TemaVisual.FuenteTitulos);
        --theme-font-body: @Html.Raw(Model.Diseno.TemaVisual.FuenteCuerpo);
        --theme-border: rgba(0, 0, 0, 0.08); /* Borde sutil adaptable */
        --radius-lg: @Html.Raw(Model.Diseno.TemaVisual.RadioBordes);
    }

    body {
        background-color: var(--theme-bg);
        color: var(--theme-text-main);
        font-family: var(--theme-font-body);
        -webkit-font-smoothing: antialiased;
    }
</style>

@if (Model.Diseno != null && Model.Diseno.Secciones.Any())
{
    foreach (var seccion in Model.Diseno.Secciones.OrderBy(s => s.Orden))
    {
        try
        {
            // Busca la vista parcial en la carpeta específica del módulo
            @await Html.PartialAsync($"~/Views/web/Plantillas/Modulos/{seccion.Identificador}/{seccion.Vista}.cshtml", Model)
        }
        catch (Exception ex)
        {
            <div class="container py-4">
                <div class="alert alert-danger border-danger text-center">
                    <strong>Error al cargar módulo:</strong> No se encontró la vista <code>@seccion.Vista</code> en la carpeta <code>Modulos/@seccion.Identificador/</code>.
                    <br><small>Detalle: @ex.Message</small>
                </div>
            </div>
        }
    }
}
else
{
    <div class="container py-5 text-center mt-5">
        <h2 style="font-family: var(--theme-font-title); color: var(--theme-primary);">¡Plantilla Inicializada!</h2>
        <p>Aún no has configurado los módulos de diseño. Ve al panel de administración para comenzar a armar tu página.</p>
    </div>
}