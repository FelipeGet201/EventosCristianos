@model RedAJP.Models.TableroRifaPersonalViewModel
@{
    Layout = "_LayoutRifasPersonales";
    ViewData["Title"] = "Punto de Venta";
    ViewBag.IdRifaActiva = Model.InfoRifa.IdRifa;

    bool ventaExitosa = TempData["VentaExitosa"] as bool? ?? false;
    string miNombre = User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name ?? "Mi Cuenta";
    
    var agrupadoPorVendedor = Model.Boletos
        .GroupBy(b => string.IsNullOrEmpty(b.NombrePromotorExterno) ? miNombre : b.NombrePromotorExterno)
        .OrderBy(g => g.Key == miNombre ? 0 : 1) 
        .ThenBy(g => g.Key)
        .ToList();

    bool mostrarBancos = !string.IsNullOrEmpty(Model.InfoRifa.CuentaClabe) ||
                            !string.IsNullOrEmpty(Model.InfoRifa.NumeroCuenta) || 
                            !string.IsNullOrEmpty(Model.InfoRifa.NumeroTarjeta) ||
                            !string.IsNullOrEmpty(Model.InfoRifa.Banco);
}

<style>
    .bg-pastel-blue { background-color: #e0f2fe; color: #0c4a6e; }
    .bg-pastel-green { background-color: #d1fae5; color: #064e3b; }
    .text-pastel-blue { color: #0ea5e9; }
    .border-pastel-blue { border-color: #7dd3fc !important; }

    /* ESTADO 1: Disponible */
    .boleto-disponible { background-color: #ffffff; border: 2px solid #e2e8f0; color: #475569; cursor: pointer; transition: all 0.2s ease; }
    .boleto-disponible:hover { transform: translateY(-2px); box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    
    /* ESTADO 2: Seleccionado (Añadiendo a Carrito) */
    .boleto-seleccionado { background-color: #e0f2fe; border: 2px solid #7dd3fc; color: #0c4a6e; cursor: pointer; transition: all 0.2s ease; transform: scale(1.05); box-shadow: 0 4px 10px rgba(59, 130, 246, 0.2); }
    
    /* ESTADO 3: Vendido */
    .boleto-vendido { background-color: #fef3c7; border: 2px solid #fde68a; color: #b45309; cursor: pointer !important; opacity: 1; transition: transform 0.15s ease-in-out, box-shadow 0.15s ease-in-out; }
    .boleto-vendido:hover { transform: scale(1.03) translateY(-2px); box-shadow: 0 6px 12px rgba(180, 83, 9, 0.15) !important; z-index: 5; }

    .fecha-bloque-badge { background: #f8fafc; border: 1px dashed #cbd5e1; color: #475569; font-weight: bold; padding: 0.3rem 0.8rem; border-radius: 8px; font-size: 0.9rem; }
    
    .custom-stat-total, .custom-stat-paid, .custom-stat-pending { transition: all 0.2s ease-in-out; }
    .custom-stat-total .text-uppercase, .custom-stat-paid .text-uppercase, .custom-stat-pending .text-uppercase { color: #1a1a1a; }
    .custom-stat-total { background-color: #f0f9ff !important; border-color: #bae6fd !important; }
    .custom-stat-total div.fw-bold.mt-1 { color: #0369a1 !important; }
    .custom-stat-paid { background-color: #ecfdf5; border-color: #a7f3d0; }
    .custom-stat-paid div.fw-bold.mt-1 { color: #059669; }
    .custom-stat-pending { background-color: #fff1f2; border-color: #fecaca; }
    .custom-stat-pending div.fw-bold.mt-1 { color: #e11d48; }

    .custom-btn-secondary { background-color: #64748b; color: #ffffff; border: none; }
    .custom-btn-secondary:hover { background-color: #475569; color: #ffffff; }
    .custom-btn-primary { background-color: #2563eb; color: #ffffff; border: none; box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2), 0 2px 4px -2px rgba(37, 99, 235, 0.1) !important; }
    .custom-btn-primary:hover { background-color: #1d4ed8; color: #ffffff; }
    .custom-btn-primary:disabled { background-color: #94a3b8; color: #ffffff; opacity: 0.7; cursor: not-allowed; box-shadow: none !important; }
</style>

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-rifaspersonales');
        }
    });
</script>

<div class="mb-4">
    <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-shop text-pastel-blue me-2"></i> Punto de Venta</h5>
            <p class="text-muted small mb-0 mt-1">Selecciona los boletos para reportar su venta o edita los ya vendidos.</p>
        </div>
        
        <div class="d-flex flex-column flex-sm-row gap-3 align-items-sm-center">
            <div class="input-group input-group-sm shadow-sm rounded-pill overflow-hidden" style="max-width: 100%;">
                <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="number" id="inputBuscarBoleto" class="form-control bg-light border-0" placeholder="Buscar #..." onkeyup="filtrarBoletos()">
            </div>
        </div>
    </div>
    
    <div class="card-body p-2 p-md-4" id="contenedorGruposBoletos" style="padding: 10px 0px !important;">

        @if(ViewBag.PagosRechazados != null && ((List<RedAJP.Models.PagoVendedorViewModel>)ViewBag.PagosRechazados).Any())
        {
            var rechazados = (List<RedAJP.Models.PagoVendedorViewModel>)ViewBag.PagosRechazados;
            <div class="alert bg-white border border-danger shadow-sm rounded-3 rounded-md-4 mb-3 mb-md-4 p-3 p-md-4 mx-2 mx-md-0">
                <h5 class="fw-bold text-danger mb-3"><i class="fa-solid fa-triangle-exclamation me-2"></i> Comprobantes Rechazados</h5>
                <p class="small text-muted mb-3">Los siguientes reportes de pago fueron rechazados por el administrador. Revisa el motivo e inténtalo de nuevo.</p>
                <div class="row g-3">
                    @foreach(var r in rechazados)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card bg-light border-danger border-opacity-25 shadow-sm rounded-3 h-100">
                                <div class="card-body p-3 d-flex flex-column">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="fw-bold text-dark text-truncate">@(r.NombrePromotorExterno ?? "Mi Cuenta")</span>
                                        <span class="badge bg-danger">Rechazado</span>
                                    </div>
                                    <div class="fs-4 fw-bold text-dark mb-1">$@r.Monto.ToString("N2")</div>
                                    <div class="small text-danger fw-bold mb-3 bg-danger bg-opacity-10 p-2 rounded flex-grow-1">
                                        <i class="fa-solid fa-comment-dots me-1"></i> Motivo: @(string.IsNullOrEmpty(r.Nota) ? "Sin especificar" : r.Nota)
                                    </div>
                                    <div class="d-flex gap-2 mt-auto">
                                        <form action="@Url.Action("EliminarPagoRechazado", "RifasPersonales")" method="post" class="flex-grow-1" id="formEliminarRechazado_@r.IdPago">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tokenRifa" value="@Model.InfoRifa.Token" />
                                            <input type="hidden" name="IdPago" value="@r.IdPago" />
                                            <button type="button" class="btn btn-sm btn-outline-danger w-100 rounded-pill fw-bold" onclick="abrirModalConfirmacionEliminar('formEliminarRechazado_@r.IdPago')">
                                                <i class="fa-solid fa-trash me-1"></i> Eliminar
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-danger w-100 rounded-pill fw-bold" 
                                                onclick="abrirModalReportePago('@(r.IdUsuarioVendedor?.ToString() ?? "")', '@(r.NombrePromotorExterno ?? "")', '@r.Monto')">
                                            <i class="fa-solid fa-rotate-right me-1"></i> Reintentar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if(ViewBag.PagosPendientes != null && ((List<RedAJP.Models.PagoVendedorViewModel>)ViewBag.PagosPendientes).Any())
        {
            var pendientes = (List<RedAJP.Models.PagoVendedorViewModel>)ViewBag.PagosPendientes;
            <div class="alert bg-white border border-warning shadow-sm rounded-3 rounded-md-4 mb-3 mb-md-4 p-3 p-md-4 mx-2 mx-md-0">
                <h5 class="fw-bold text-warning mb-3" style="color: #d97706 !important;"><i class="fa-solid fa-clock-rotate-left me-2"></i> Pagos en Revisión</h5>
                <p class="small text-muted mb-3">Tienes los siguientes reportes de pago en espera de ser validados por el administrador. Tu saldo se actualizará en cuanto sean aprobados.</p>
                <div class="row g-3">
                    @foreach(var p in pendientes)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card bg-light border-warning border-opacity-50 shadow-sm rounded-3 h-100">
                                <div class="card-body p-3 d-flex flex-column">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="fw-bold text-dark text-truncate">@(p.NombrePromotorExterno ?? "Mi Cuenta")</span>
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    </div>
                                    <div class="fs-4 fw-bold text-dark mb-1">$@p.Monto.ToString("N2")</div>
                                    <div class="small text-muted mb-0">
                                        <i class="fa-regular fa-calendar me-1"></i> Fecha: @p.FechaPago.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @foreach (var vendedorGrupo in agrupadoPorVendedor)
        {
            var stats = Model.Promotores.FirstOrDefault(p => p.Nombre == vendedorGrupo.Key);
            <div class="mb-3 mb-md-4 grupo-vendedor bg-light p-2 p-md-3 rounded-3 shadow-sm border border-pastel-blue mx-2 mx-md-0">
                
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center border-bottom border-pastel-blue border-2 pb-2 mb-2 gap-2">
                    <div class="d-flex flex-row flex-lg-column align-items-center align-items-lg-start justify-content-between w-100 w-lg-auto">
                        <h6 class="fw-bold text-dark text-uppercase mb-0 fs-6 fs-md-5 text-truncate pe-2">
                            <i class="fa-solid fa-user me-1 text-pastel-blue"></i> @vendedorGrupo.Key
                        </h6>
                        <span class="badge bg-light text-secondary border mt-lg-1" style="font-size:0.75rem;">Total: @vendedorGrupo.Count()</span>
                    </div>

                    @if(stats != null)
                    {
                        <div class="d-flex gap-1 gap-md-2 flex-wrap flex-nowrap-md flex-grow-1 justify-content-between justify-content-lg-center w-100 w-lg-auto">
                            <div class="custom-stat-total rounded-2 px-1 px-md-2 py-1 border border-2 text-center flex-fill" style="min-width: 85px; max-width: 140px;">
                                <div class="text-uppercase fw-bold" style="font-size:0.65rem; line-height: 1;">Ventas</div>
                                <div class="fw-bold mt-1" style="font-size:0.9rem;">$@stats.DeudaTotal.ToString("N2")</div>
                            </div>
                            <div class="custom-stat-paid rounded-2 px-1 px-md-2 py-1 border border-2 text-center flex-fill" style="min-width: 85px; max-width: 140px;">
                                <div class="text-uppercase fw-bold" style="font-size:0.65rem; line-height: 1;">Pagado</div>
                                <div class="fw-bold mt-1" style="font-size:0.9rem;">$@stats.TotalPagado.ToString("N2")</div>
                            </div>
                            <div class="custom-stat-pending rounded-2 px-1 px-md-2 py-1 border border-2 text-center flex-fill" style="min-width: 85px; max-width: 140px;">
                                <div class="text-uppercase fw-bold" style="font-size:0.65rem; line-height: 1;">Pendiente</div>
                                <div class="fw-bold mt-1" style="font-size:0.9rem;">$@stats.SaldoPendiente.ToString("N2")</div>
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2 flex-row flex-lg-grow-0 w-100 w-lg-auto mt-1 mt-lg-0">
                        <a href="@Url.Action("ImprimirPlanilla", "RifasPersonales", new { tokenRifa = Model.InfoRifa.Token, idDestino = stats?.IdUsuario, externo = stats?.NombrePromotorExterno, nombreMostrar = vendedorGrupo.Key })" 
                           target="_blank" 
                           class="custom-btn-secondary btn btn-sm rounded-pill shadow-sm fw-bold px-2 px-md-3 d-flex align-items-center justify-content-center flex-fill" 
                           title="Imprimir Planilla">
                           <i class="fa-solid fa-print me-1"></i> <span class="d-none d-sm-inline">Imprimir</span>
                        </a>
                        <button class="custom-btn-primary btn btn-sm rounded-pill shadow-sm fw-bold px-2 px-md-3 d-flex align-items-center justify-content-center flex-fill"
                                onclick="abrirModalReportePago('@stats?.IdUsuario', '@stats?.NombrePromotorExterno', '@stats?.SaldoPendiente')"
                                @(stats?.SaldoPendiente <= 0 ? "disabled" : "")>
                            <i class="fa-solid fa-upload me-1"></i> <span class="d-none d-sm-inline">Subir Pago</span><span class="d-inline d-sm-none">Pago</span>
                        </button>
                        @if (Model.InfoRifa.Estado == "Activa")
                        {
                            <button class="btn-vender-varios btn btn-sm rounded-pill fw-bold shadow-sm px-2 px-md-3 d-flex align-items-center justify-content-center flex-fill" style="background-color: #3b82f6; color: white; border: none; transition: all 0.3s ease;"
                                onclick="abrirModalVentaMasiva()" disabled>
                                <i class="fa-solid fa-cash-register me-1"></i> <span>Vender</span> (<span class="contador-seleccion">0</span>)
                            </button>
                        }
                    </div>
                </div>

                @{
                    var gruposPorFecha = vendedorGrupo
                        .GroupBy(b => b.FechaAsignacion?.ToString("dd/MM/yyyy hh:mm tt") ?? "Sin Fecha")
                        .OrderByDescending(g => g.Max(b => b.FechaAsignacion ?? DateTime.MinValue));
                }

                @foreach (var fechaGrupo in gruposPorFecha)
                {
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <div class="fecha-bloque-badge shadow-sm" style="font-size: 0.8rem;">
                                <i class="fa-regular fa-calendar-check me-1 text-pastel-blue"></i> <span class="d-none d-sm-inline">Asignación:</span> <span class="text-primary fw-bold">@fechaGrupo.Key</span>
                            </div>
                            <div class="flex-grow-1 ms-2" style="height: 1px; background-color: #e0f2fe;"></div>
                        </div>

                        <div class="row g-1 g-md-2">
                            @foreach (var boleto in fechaGrupo.OrderBy(b => b.Numero))
                            {
                                bool disponible = boleto.Estado == "Disponible" || boleto.Estado == "Asignado";
                                string claseBoleto = disponible ? "boleto-disponible" : "boleto-vendido";
                                <div class="col-3 col-sm-2 col-md-2 col-lg-1 item-boleto" data-numero="@boleto.Numero">
                                    <div class="boleto-card w-100 p-1 d-flex flex-column align-items-center position-relative @claseBoleto"
                                         data-id="@boleto.IdBoleto"
                                         data-numero="@boleto.Numero.ToString("000")"
                                         data-disponible="@(disponible ? "true" : "false")"
                                         data-nombre="@boleto.NombreComprador"
                                         data-telefono="@boleto.TelefonoComprador"
                                         data-comentarios="@boleto.Comentarios"
                                         data-marcador="@(boleto.MarcadorPersonal ? "true" : "false")"
                                         onclick="manejarClickBoleto(this)"
                                         id="bol_@boleto.IdBoleto">
                                        
                                        @if(boleto.MarcadorPersonal)
                                        {
                                            <i class="fa-solid fa-flag text-danger position-absolute top-0 end-0 mt-1 me-1" style="font-size: 0.6rem;" title="Marca de control activada"></i>
                                        }

                                        <span class="fw-bold" style="font-size:0.9rem;">#@boleto.Numero.ToString("000")</span>
                                        @if (!disponible)
                                        {
                                            <small class="text-truncate w-100 text-center fw-bold" style="font-size:0.55rem;">@boleto.NombreComprador</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted w-100 text-center" style="font-size:0.55rem;">Disp.</small>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <div class="alert bg-white border border-info rounded-3 rounded-md-4 shadow-sm d-flex align-items-center p-3 p-md-4 mb-3 mb-md-4 mx-2 mx-md-0 mt-3">
            <div class="bg-info bg-opacity-10 p-2 rounded-circle me-3 flex-shrink-0">
                <i class="fa-solid fa-lightbulb text-info fs-4"></i>
            </div>
            <div>
                <h6 class="fw-bold text-dark mb-1">Gestión de Boletos Digitales</h6>
                <p class="mb-0 small text-muted">
                    <strong>Haz clic sobre cualquier boleto ya vendido</strong> para editar los datos del comprador o generar su <i class="fa-solid fa-download mx-1 text-primary"></i> <strong>boleto digital</strong> para enviarlo por WhatsApp.
                </p>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="modalVenta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <form action="@Url.Action("RegistrarVentaMasiva", "RifasPersonales")" method="post" id="formVentaMasiva" class="modal-content border-0 shadow-lg rounded-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tokenRifa" value="@Model.InfoRifa.Token" />
            <div class="modal-header border-0 p-3 p-md-4 bg-pastel-blue">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-file-invoice-dollar me-2"></i> Reporte de Venta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3 p-md-4 bg-light">
                <div class="alert border-0 small mb-4 shadow-sm rounded-3 bg-pastel-green p-3">
                    <i class="fa-brands fa-whatsapp text-success me-1 fs-6"></i> Captura el número de teléfono para enviar una notificación automática por WhatsApp al finalizar.
                </div>
                <div id="contenedorTarjetasVenta" class="d-flex flex-column gap-3"></div>
            </div>
            <div class="modal-footer border-0 bg-white p-3 p-md-4">
                <button type="button" class="btn btn-light fw-bold px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn rounded-pill fw-bold shadow-sm px-4 px-md-5" style="background-color: #3b82f6; color: white; border: none;">
                    <i class="fa-solid fa-check-double me-2"></i> Confirmar Ventas
                </button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalEditarBoleto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="@Url.Action("EditarBoletoVendido", "RifasPersonales")" method="post" class="modal-content border-0 shadow-lg rounded-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tokenRifa" value="@Model.InfoRifa.Token" />
            <input type="hidden" name="IdBoleto" id="edit_IdBoleto" />
            
            <div class="modal-header border-0 p-4 bg-pastel-blue">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i> Editar Boleto <span id="edit_NumBoleto" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            
            <div class="modal-body p-4 bg-light">
                @if (!string.IsNullOrEmpty(Model.InfoRifa.EnlaceGrupoWhatsapp))
                {
                    <div class="mb-3 p-3 bg-white border rounded-3 shadow-sm">
                        <label class="text-muted fw-bold small mb-2"><i class="fa-brands fa-whatsapp text-success me-1"></i> Enlace del Grupo (WhatsApp)</label>
                        <div class="d-flex align-items-center bg-light border rounded-2 p-1">
                            <input type="text" class="form-control border-0 bg-transparent text-dark fw-bold px-2 shadow-none w-100" readonly value="@Model.InfoRifa.EnlaceGrupoWhatsapp" style="font-size: 0.75rem;">
                            <button type="button" class="btn border-0 rounded-1 d-flex align-items-center justify-content-center flex-shrink-0" 
                                    onclick="copiarTexto('@Model.InfoRifa.EnlaceGrupoWhatsapp', 'iconoLinkWp')" 
                                    style="background-color: #e0f2fe; color: #0ea5e9; width: 30px; height: 30px; padding: 0;" title="Copiar">
                                <i class="fa-regular fa-copy" id="iconoLinkWp"></i>
                            </button>
                        </div>
                    </div>
                }

                <div class="mb-3 form-floating">
                    <input type="text" class="form-control shadow-sm border-0" id="edit_Nombre" name="NombreComprador" placeholder="Nombre" required>
                    <label for="edit_Nombre" class="text-muted fw-bold small">Nombre del Comprador *</label>
                </div>
                
                <div class="mb-3 form-floating">
                    <input type="text" class="form-control shadow-sm border-0" id="edit_Telefono" name="TelefonoComprador" placeholder="Teléfono">
                    <label for="edit_Telefono" class="text-muted fw-bold small"><i class="fa-brands fa-whatsapp text-success me-1"></i> Teléfono</label>
                </div>
                
                <div class="mb-3 form-floating">
                    <input type="text" class="form-control shadow-sm border-0" id="edit_Comentarios" name="Comentarios" placeholder="Notas">
                    <label for="edit_Comentarios" class="text-muted fw-bold small">Notas adicionales (opcional)</label>
                </div>

                <div class="form-check form-switch p-3 bg-white border rounded-3 shadow-sm">
                    <input type="hidden" name="MarcadorPersonal" id="edit_MarcadorPersonal_Hidden" value="false" />
                    <input class="form-check-input ms-0 me-2 mt-1" type="checkbox" role="switch" id="edit_MarcadorPersonal" onchange="document.getElementById('edit_MarcadorPersonal_Hidden').value = this.checked ? 'true' : 'false';">
                    <label class="form-check-label fw-bold text-dark" for="edit_MarcadorPersonal">
                        Marca de Control Personal
                    </label>
                    <div class="small text-muted mt-1 lh-sm" style="font-size: 0.8rem;">
                        Activa esta marca para tu propio control visual (Ideal para recordar cobros o alguna otra gestión personal). <strong class="text-warning">No afecta los pagos reales ni el sistema.</strong>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 bg-white p-4 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-primary rounded-pill fw-bold shadow-sm px-3" onclick="descargarBoletoDigital()" title="Descargar Imagen">
                    <i class="fa-solid fa-download me-1"></i> <span class="d-none d-sm-inline">Boleto</span>
                </button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light rounded-pill fw-bold" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill fw-bold shadow-sm px-4">
                        <i class="fa-solid fa-save me-1"></i> Guardar
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalReportePago" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="@Url.Action("ReportarPagoComprobante", "RifasPersonales")" method="post" enctype="multipart/form-data" class="modal-content border-0 shadow-lg rounded-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tokenRifa" value="@Model.InfoRifa.Token" />
            <input type="hidden" name="IdUsuarioVendedor" id="rp_IdUsuario" />
            <input type="hidden" name="NombrePromotorExterno" id="rp_NombreExterno" />

            <div class="modal-header border-0 p-4 bg-pastel-blue">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-upload me-2"></i> Reportar Transferencia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            
            <div class="modal-body p-4 bg-light">
                <p class="small text-muted mb-4">Sube la captura de pantalla de tu transferencia. El administrador validará el pago y lo descontará de tu saldo.</p>
                <div class="alert border-0 shadow-sm rounded-3 mb-4" style="background-color: #fef3c7; border-left: 4px solid #f59e0b !important;">
                    <div class="d-flex">
                        <div class="me-3 mt-1">
                            <i class="fa-solid fa-circle-exclamation" style="color: #d97706; font-size: 1.25rem;"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #b45309;">Concepto de Transferencia (SAT)</h6>
                            <p class="small mb-0 text-dark">
                                Para evitar problemas fiscales al recibir el dinero, por favor en el concepto de tu transferencia bancaria escribe únicamente: <strong>"Aportación"</strong> o <strong>"Donativo"</strong>.<br>
                                <span class="text-danger fw-bold">Evita usar palabras como: "rifa", "boleto", "pago" o "compra".</span>
                            </p>
                        </div>
                    </div>
                </div>
                @if(mostrarBancos)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-3 position-relative overflow-hidden bg-white">
                        <div class="position-absolute top-0 bottom-0 start-0" style="width: 4px; background-color: #0ea5e9;"></div>
                        <div class="card-body p-3 ps-4">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="d-flex align-items-center justify-content-center bg-light border rounded-circle flex-shrink-0" style="width: 32px; height: 32px;">
                                    <i class="fa-solid fa-building-columns text-info" style="font-size: 0.85rem; color: #0ea5e9 !important;"></i>
                                </div>
                                <div class="d-flex flex-column flex-sm-row align-items-sm-baseline gap-sm-2">
                                    <h6 class="fw-bold mb-0" style="color: #0ea5e9; font-size: 0.95rem;">Datos para realizar pagos</h6>
                                    <span class="small text-muted" style="font-size: 0.75rem;">Utiliza esta info para tus depósitos.</span>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(Model.InfoRifa.Banco))
                            {
                                <div class="ms-1 mb-2" style="font-size: 0.85rem;">
                                    <span class="fw-bold text-dark">Banco:</span> <span class="text-muted">@Model.InfoRifa.Banco</span>
                                </div>
                            }

                            <div class="d-flex flex-wrap gap-2 w-100">
                                @if (!string.IsNullOrEmpty(Model.InfoRifa.TitularCuenta))
                                {
                                    <div class="d-flex align-items-center bg-white border rounded-2 p-1 flex-grow-1" style="height: 36px; min-width: 260px;">
                                        <span class="text-muted fw-bold px-2 text-end" style="width: 65px; font-size: 0.75rem;">Titular</span>
                                        <input type="text" class="form-control border-0 bg-transparent text-dark fw-bold px-2 shadow-none font-monospace h-100 py-0 w-100" readonly value="@Model.InfoRifa.TitularCuenta" style="font-size: 0.8rem;">
                                        <button type="button" class="btn border-0 rounded-1 d-flex align-items-center justify-content-center flex-shrink-0" 
                                                onclick="copiarTexto('@Model.InfoRifa.TitularCuenta', 'iconoTitular')" 
                                                style="background-color: #f1f5f9; color: #2563eb; width: 28px; height: 28px; padding: 0;"
                                                onmouseover="this.style.backgroundColor='#e2e8f0'" onmouseout="this.style.backgroundColor='#f1f5f9'" title="Copiar">
                                            <i class="fa-regular fa-copy" style="font-size: 0.85rem;" id="iconoTitular"></i>
                                        </button>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.InfoRifa.CuentaClabe))
                                {
                                    <div class="d-flex align-items-center bg-white border rounded-2 p-1 flex-grow-1" style="height: 36px; min-width: 220px;">
                                        <span class="text-muted fw-bold px-2 text-end" style="width: 65px; font-size: 0.75rem;">CLABE</span>
                                        <input type="text" class="form-control border-0 bg-transparent text-dark fw-bold px-2 shadow-none font-monospace h-100 py-0 w-100" readonly value="@Model.InfoRifa.CuentaClabe" style="font-size: 0.8rem;">
                                        <button type="button" class="btn border-0 rounded-1 d-flex align-items-center justify-content-center flex-shrink-0" 
                                                onclick="copiarTexto('@Model.InfoRifa.CuentaClabe', 'iconoClabe')" 
                                                style="background-color: #f1f5f9; color: #2563eb; width: 28px; height: 28px; padding: 0;"
                                                onmouseover="this.style.backgroundColor='#e2e8f0'" onmouseout="this.style.backgroundColor='#f1f5f9'" title="Copiar">
                                            <i class="fa-regular fa-copy" style="font-size: 0.85rem;" id="iconoClabe"></i>
                                        </button>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.InfoRifa.NumeroCuenta))
                                {
                                    <div class="d-flex align-items-center bg-white border rounded-2 p-1 flex-grow-1" style="height: 36px; min-width: 190px;">
                                        <span class="text-muted fw-bold px-2 text-end" style="width: 65px; font-size: 0.75rem;">Cuenta</span>
                                        <input type="text" class="form-control border-0 bg-transparent text-dark fw-bold px-2 shadow-none font-monospace h-100 py-0 w-100" readonly value="@Model.InfoRifa.NumeroCuenta" style="font-size: 0.8rem;">
