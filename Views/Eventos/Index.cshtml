<script>
    // Cuenta regresiva dinámica para el evento destacado
    document.addEventListener('DOMContentLoaded', function() {
        const countdownEl = document.querySelector('.hero-countdown-badge');
        if (countdownEl) {
            const fechaStr = countdownEl.getAttribute('data-fecha');
            if (fechaStr) {
                const fechaEvento = new Date(fechaStr).getTime();
                const textEl = countdownEl.querySelector('.countdown-text');

                function actualizar() {
                    const ahora = new Date().getTime();
                    const distancia = fechaEvento - ahora;

                    if (distancia < 0) {
                        textEl.innerText = 'En curso / Finalizado';
                        return;
                    }

                    const dias = Math.floor(distancia / (1000 * 60 * 60 * 24));
                    const horas = Math.floor((distancia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutos = Math.floor((distancia % (1000 * 60 * 60)) / (1000 * 60));

                    if (dias > 0) {
                        textEl.innerText = `Faltan ${dias}d ${horas}h ${minutos}m`;
                    } else {
                        textEl.innerText = `¡Es hoy! ${horas}h ${minutos}m`;
                    }
                }

                actualizar();
                setInterval(actualizar, 60000);
            }
        }
    });

    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-eventos');
        }
    });
</script>