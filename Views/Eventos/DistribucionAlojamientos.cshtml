    async function recargarInterfazSilenciosamente() {
        try {
            let url = new URL(window.location.href); url.searchParams.set('_t', new Date().getTime()); 
            let resp = await fetch(url.toString(), { cache: 'no-store' }); 
            let html = await resp.text(); 
            let doc = new DOMParser().parseFromString(html, 'text/html');
        
            document.getElementById('listaEspera').innerHTML = doc.getElementById('listaEspera').innerHTML; 
            document.getElementById('contadorNoAsignados').innerHTML = doc.getElementById('contadorNoAsignados').innerHTML; 
            document.getElementById('zonasTabs').innerHTML = doc.getElementById('zonasTabs').innerHTML; 
            document.getElementById('zonasTabContent').innerHTML = doc.getElementById('zonasTabContent').innerHTML;
        
            let divContadores = doc.getElementById('contenedorContadoresCupo'); 
            if(divContadores) document.getElementById('contenedorContadoresCupo').innerHTML = divContadores.innerHTML; 

            // --- NUEVAS LÍNEAS DE ACTUALIZACIÓN ---
            let tbodyAgr = doc.getElementById('tbodyAgrupaciones');
            if(tbodyAgr) document.getElementById('tbodyAgrupaciones').innerHTML = doc.getElementById('tbodyAgrupaciones').innerHTML;

            let tplAgr = doc.getElementById('templateAgrupaciones');
            if(tplAgr) document.getElementById('templateAgrupaciones').innerHTML = doc.getElementById('templateAgrupaciones').innerHTML;

            // Limpiar el formulario de creación de agrupación
            let txtAgr = document.getElementById('txtNombreAgrupacion');
            if(txtAgr) txtAgr.value = '';
            document.querySelectorAll('.chk-subtipo-agr').forEach(c => c.checked = false);
            // --------------------------------------

            restaurarTabActivo(); filtrarEspera();
        } catch (error) { location.reload(); }
    }

