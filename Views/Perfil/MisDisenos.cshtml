@model RedAJP.Models.MisDisenosViewModel

@{
    Layout = "Principal";
    ViewData["Title"] = "Mis Diseños";
}
<script>
    // Este script le dice al Layout "Abuelo" (Principal) que encienda la opción "Tienda" en el menú superior
    // El Layout "Padre" (_TiendaLayout) ya tiene su propio menú lateral activo
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-usuario');
            activarMenu('submenu-diseños');
        }
    });
</script>

<div class="fade-in py-5">

    <div class="d-flex align-items-center justify-content-between mb-5">
        <div>
            <h2 class="fw-bold mb-1">Mis Diseños Personalizados</h2>
            <p class="text-muted mb-0">Gestiona y reutiliza tus diseños.</p>
        </div>
        <a href="@Url.Action("Index", "Tienda")" class="btn btn-outline-dark rounded-pill">
            <i class="fa-solid fa-plus me-2"></i> Nuevo Diseño
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success shadow-sm mb-4"><i class="fa-solid fa-check-circle me-2"></i>@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm mb-4">@TempData["Error"]</div>
    }

    @if (Model.Lista.Count == 0)
    {
        <div class="text-center py-5 bg-light rounded-4 border border-dashed">
            <i class="fa-solid fa-palette fa-4x text-muted opacity-25 mb-3"></i>
            <h4 class="fw-bold text-muted">Aún no tienes diseños</h4>
            <a href="@Url.Action("Index", "Tienda")" class="btn btn-nautico rounded-pill px-4">Ir a la Tienda</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Lista)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm card-hover rounded-4 overflow-hidden position-relative">

                        <div class="position-absolute top-0 start-0 p-2" style="z-index: 20;">
                            <form method="post" action="@Url.Action("CancelarSolicitud", "Perfil")" onsubmit="return confirm('¿Eliminar este diseño?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idSolicitud" value="@item.Id_Solicitud" />
                                <button type="submit" class="btn btn-danger btn-sm rounded-circle shadow-sm" title="Eliminar">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form>
                        </div>

                        <div class="position-absolute top-0 end-0 p-2" style="z-index: 20;">
                            @if (item.Id_Estatus == 1)
                            {
                                <span class="badge bg-warning text-dark shadow-sm border border-white">Pendiente</span>
                            }
                            else if (item.Id_Estatus == 2)
                            {

                                <span class="badge bg-success shadow-sm border border-white">Aprobado</span>
                            }
                            else if (item.Id_Estatus == 3)
                            {

                                <span class="badge bg-danger shadow-sm border border-white">Rechazado</span>
                            }
                        </div>

                        <div class="ratio ratio-1x1 bg-light border-bottom">
                            @if (!string.IsNullOrEmpty(item.Imagen_Previo_Url))
                            {
                                <img src="@item.Imagen_Previo_Url" class="img-fluid w-100 h-100 p-3" style="object-fit: contain;">
                            }
                            else
                            {
                                <i class="fa-solid fa-image fa-2x opacity-25 m-auto"></i>
                            }
                        </div>

                        <div class="card-body p-3 d-flex flex-column">
                            <small class="text-muted mb-1">@item.Fecha.ToString("dd/MMM/yyyy")</small>
                            <h6 class="fw-bold text-dark mb-2 text-truncate">@item.Nombre_Producto</h6>

                            @if (item.Id_Estatus == 3 && !string.IsNullOrEmpty(item.Comentarios_Admin))
                            {
                                <div class="alert alert-danger p-2 small border-0 lh-sm"><strong>Nota:</strong> @item.Comentarios_Admin</div>
                            }

                            <div class="mt-auto pt-2">
                                @if (item.Id_Estatus == 2)
                                {
                                    @if (item.StockBase > 0)
                                    {
                                        <a href="@Url.Action("Detalle", "Tienda", new { id = item.Id_Producto_Base, idDiseno = item.Id_Solicitud })"
                                           class="btn btn-success w-100 rounded-pill shadow-sm fw-bold">
                                            <i class="fa-solid fa-cart-plus me-2"></i> Agregar al Carrito
                                        </a>
                                        <div class="text-center mt-1"><small class="text-success" style="font-size:0.7em">Listo para tu Compra</small></div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary w-100 rounded-pill disabled" disabled>Insumo Agotado</button>
                                    }
                                }
                                else if (item.Id_Estatus == 3)
                                {
                                    <a href="@Url.Action("Disenador", "Tienda", new { idBase = item.Id_Producto_Base })" class="btn btn-outline-secondary w-100 rounded-pill btn-sm">Intentar de nuevo</a>
                                }
                                else
                                {
                                    <button class="btn btn-light w-100 rounded-pill text-muted border" disabled>Esperando Revisión...</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .btn-nautico {
        background-color: var(--header-footer);
        color: white;
        transition: 0.3s;
    }

        .btn-nautico:hover {
            background-color: var(--pez-azul);
            color: white;
            transform: translateY(-2px);
        }

    .card-hover {
        transition: transform 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-5px);
        }
</style>