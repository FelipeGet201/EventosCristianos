@model RedAJP.Models.GestionTableroViewModel
@{
    Layout = "_LayoutRifasOficiales";
    ViewData["Title"] = "Mis Boletos";

    var misCompras = ViewBag.MisCompras as List<RedAJP.Models.BoletoItem> ?? new List<RedAJP.Models.BoletoItem>();
    string miNombre = User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name ?? "Mi Cuenta";
    var agrupadoPorVendedor = Model.Boletos
                .GroupBy(b => string.IsNullOrEmpty(b.NombrePromotorExterno) ? miNombre : b.NombrePromotorExterno)
                .OrderBy(g => g.Key == miNombre ? 0 : 1)
                .ThenBy(g => g.Key)
                .ToList();
    bool mostrarBancos = !string.IsNullOrEmpty(Model.InfoRifa.CuentaClabe) ||
                             !string.IsNullOrEmpty(Model.InfoRifa.NumeroCuenta) ||
                             !string.IsNullOrEmpty(Model.InfoRifa.NumeroTarjeta) ||
                             !string.IsNullOrEmpty(Model.InfoRifa.Banco);

    bool ventaExitosa = TempData["VentaExitosa"] as bool? ?? false;
    HashSet<int> boletosBloqueados = ViewBag.BoletosBloqueados as HashSet<int> ?? new HashSet<int>();
}

<style>
    .ticket-item {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border-radius: 12px;
        padding: 16px;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(16, 185, 129, 0.2);
        transition: transform 0.2s;
    }

        .ticket-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(16, 185, 129, 0.3);
        }

        .ticket-item::before, .ticket-item::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 20px;
            height: 20px;
            background: #fff;
            border-radius: 50%;
            transform: translateY(-50%);
        }

        .ticket-item::before {
            left: -10px;
            box-shadow: inset -3px 0 5px rgba(0,0,0,0.1);
        }

        .ticket-item::after {
            right: -10px;
            box-shadow: inset 3px 0 5px rgba(0,0,0,0.1);
        }

    .ticket-dashed-line {
        border-left: 2px dashed rgba(255,255,255,0.4);
        height: 100%;
        position: absolute;
        right: 60px;
        top: 0;
    }

    .bg-pastel-blue {
        background-color: #e0f2fe;
        color: #0c4a6e;
    }

    .bg-pastel-green {
        background-color: #d1fae5;
        color: #064e3b;
    }

    .text-pastel-blue {
        color: #0ea5e9;
    }

    .border-pastel-blue {
        border-color: #7dd3fc !important;
    }

    .pos-boleto-libre {
        background-color: #ffffff;
        border: 2px solid #e2e8f0;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s ease;
        border-radius: 8px;
        padding: 8px 0;
        text-align: center;
    }

        .pos-boleto-libre:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.05);
            border-color: #0d6efd;
        }

    .pos-boleto-seleccionado {
        background-color: #e0f2fe;
        border: 2px solid #0d6efd;
        color: #0d6efd;
        cursor: pointer;
        transform: scale(1.04);
        font-weight: 700;
        text-align: center;
        border-radius: 8px;
        padding: 8px 0;
        box-shadow: 0 4px 10px rgba(13, 110, 253, 0.15);
    }

    .pos-boleto-vendido {
        background-color: #fef3c7;
        border: 2px solid #fde68a;
        color: #b45309;
        cursor: pointer !important;
        font-weight: 700;
        text-align: center;
        border-radius: 8px;
        padding: 8px 0;
        transition: all 0.2s;
    }

    .pos-boleto-pagado {
        background-color: #d1fae5;
        border: 2px solid #6ee7b7;
        color: #065f46;
        cursor: pointer;
        font-weight: 700;
        text-align: center;
        border-radius: 8px;
        padding: 8px 0;
        transition: all 0.2s;
    }

        .pos-boleto-vendido:hover, .pos-boleto-pagado:hover {
            transform: scale(1.03);
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        }

    .fecha-bloque-badge {
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        color: #475569;
        font-weight: bold;
        padding: 0.3rem 0.8rem;
        border-radius: 8px;
        font-size: 0.9rem;
    }

    .custom-stat-total, .custom-stat-paid, .custom-stat-pending {
        transition: all 0.2s ease-in-out;
    }

        .custom-stat-total .text-uppercase, .custom-stat-paid .text-uppercase, .custom-stat-pending .text-uppercase {
            color: #1a1a1a;
        }

    .custom-stat-total {
        background-color: #f0f9ff !important;
        border-color: #bae6fd !important;
    }

        .custom-stat-total div.fw-bold.mt-1 {
            color: #0369a1 !important;
        }

    .custom-stat-paid {
        background-color: #ecfdf5;
        border-color: #a7f3d0;
    }

        .custom-stat-paid div.fw-bold.mt-1 {
            color: #059669;
        }

    .custom-stat-pending {
        background-color: #fff1f2;
        border-color: #fecaca;
    }

        .custom-stat-pending div.fw-bold.mt-1 {
            color: #e11d48;
        }
</style>

<div class="container-fluid p-0 fade-in">

    @* MENSAJE CUANDO NO HAY NADA EN ABSOLUTO *@
    @if (!misCompras.Any() && !Model.Boletos.Any())
    {
        <div class="text-center bg-white p-5 rounded-4 shadow-sm border border-light mt-4">
            <i class="fa-solid fa-ticket-simple fa-4x text-muted opacity-50 mb-3"></i>
            <h4 class="fw-bold text-dark">Sin boletos registrados</h4>
            <p class="text-muted mb-0">Aún no has adquirido boletos ni tienes asignaciones para venta en esta dinámica.</p>
        </div>
    }

    @* SECCIÓN: MIS COMPRAS PERSONALES *@
    @if (misCompras.Any())
    {
        <div class="mb-5 bg-white p-4 rounded-4 shadow-sm border border-light">
            <h5 class="fw-bolder text-dark text-uppercase mb-3 tracking-wider" style="font-size:0.9rem;">
                <i class="fa-solid fa-basket-shopping text-success me-2"></i> Mis Boletos Comprados
            </h5>
            <div class="row g-3">
                @foreach (var boleto in misCompras)
                {
                    <div class="col-md-4 col-lg-3">
                        <div class="ticket-item">
                            <div class="ticket-dashed-line"></div>
                            <div class="d-flex justify-content-between align-items-center mb-2 pe-4">
                                <span class="text-uppercase fw-bold" style="font-size: 0.65rem; opacity: 0.9;">Boleto Asegurado</span>
                                <i class="fa-solid fa-circle-check text-white"></i>
                            </div>
                            <h2 class="fw-black mb-1">#@boleto.Numero.ToString("000")</h2>
                            <div class="small mt-2" style="opacity: 0.85; font-size:0.75rem;">
                                <i class="fa-regular fa-calendar me-1"></i> @(boleto.FechaVenta?.ToString("dd/MMM/yyyy") ?? "Registrado")
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* SECCIÓN: PUNTO DE VENTA *@
    @if (Model.Boletos != null && Model.Boletos.Any())
    {
        <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 rounded-top-4">
            <div>
                <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-shop text-pastel-blue me-2"></i> Administración de Ventas (Punto de Venta)</h5>
                <p class="text-muted small mb-0 mt-1">Selecciona boletos libres asignados para reportar ventas o edita los ya vendidos.</p>
            </div>
            <div class="d-flex flex-column flex-sm-row gap-3 align-items-sm-center">
                <div class="input-group input-group-sm shadow-sm rounded-pill overflow-hidden" style="max-width: 100%;">
                    <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="number" id="inputBuscarBoleto" class="form-control bg-light border-0" placeholder="Buscar #..." onkeyup="filtrarBoletos()">
                </div>
            </div>
        </div>

        <div class="card-body p-3 p-md-4 bg-white rounded-bottom-4 shadow-sm mb-4" id="contenedorGruposBoletos">

            @if (Model.PagosRechazados.Any())
            {
                <div class="alert bg-white border border-danger shadow-sm rounded-4 mb-4 p-4">
                    <h5 class="fw-bold text-danger mb-3"><i class="fa-solid fa-triangle-exclamation me-2"></i> Comprobantes Rechazados</h5>
                    <p class="small text-muted mb-3">Los siguientes reportes de pago fueron rechazados por el administrador. Revisa el motivo e inténtalo de nuevo.</p>
                    <div class="row g-3">
                        @foreach (var r in Model.PagosRechazados)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card bg-light border-danger border-opacity-25 shadow-sm rounded-3 h-100">
                                    <div class="card-body p-3 d-flex flex-column">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="fw-bold text-dark text-truncate">@(r.NombrePromotorExterno ?? "Mi Cuenta")</span>
                                            <span class="badge bg-danger">Rechazado</span>
                                        </div>
                                        <div class="fs-4 fw-bold text-dark mb-1">$@r.Monto.ToString("N2")</div>
                                        <div class="small text-danger fw-bold mb-3 bg-danger bg-opacity-10 p-2 rounded flex-grow-1">
                                            <i class="fa-solid fa-comment-dots me-1"></i> Motivo: @(string.IsNullOrEmpty(r.Nota) ? "Sin especificar" : r.Nota)
                                        </div>
                                        <div class="d-flex gap-2 mt-auto">
                                            <form action="@Url.Action("EliminarPagoRechazado", "Rifas")" method="post" class="flex-grow-1" id="formEliminarRechazado_@r.IdPago">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idRifa" value="@Model.InfoRifa.IdRifaEncriptado" />
                                                <input type="hidden" name="IdPago" value="@r.IdPago" />
                                                <button type="button" class="btn btn-sm btn-outline-danger w-100 rounded-pill fw-bold" onclick="abrirModalConfirmacionEliminar('formEliminarRechazado_@r.IdPago')">
                                                    <i class="fa-solid fa-trash me-1"></i> Eliminar
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-danger w-100 rounded-pill fw-bold" onclick="abrirModalReportePago('@(r.IdUsuarioVendedor?.ToString() ?? "")', '@(r.NombrePromotorExterno ?? "")', '@r.BoletosPagados', '@r.IdPago')">
                                                <i class="fa-solid fa-rotate-right me-1"></i> Reintentar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Model.PagosPendientes.Any())
            {
                <div class="alert bg-white border border-warning shadow-sm rounded-4 mb-4 p-4">
                    <h5 class="fw-bold text-warning mb-3" style="color: #d97706 !important;"><i class="fa-solid fa-clock-rotate-left me-2"></i> Pagos en Revisión</h5>
                    <p class="small text-muted mb-3">Tienes los siguientes reportes de pago en espera de ser validados por el administrador.</p>
                    <div class="row g-3">
                        @foreach (var p in Model.PagosPendientes)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card bg-light border-warning border-opacity-50 shadow-sm rounded-3 h-100">
                                    <div class="card-body p-3 d-flex flex-column">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="fw-bold text-dark text-truncate">@(p.NombrePromotorExterno ?? "Mi Cuenta")</span>
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                        </div>
                                        <div class="fs-4 fw-bold text-dark mb-1">$@p.Monto.ToString("N2")</div>
                                        <div class="small text-muted mb-0">
                                            <i class="fa-regular fa-calendar me-1"></i> Fecha: @p.FechaPago.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @foreach (var vendedorGrupo in agrupadoPorVendedor)
            {
                var stats = Model.Promotores.FirstOrDefault(p => p.Nombre == vendedorGrupo.Key);
                int totalAsignados = vendedorGrupo.Count();
                int vendidosSinPagar = vendedorGrupo.Count(b => b.Estado == "Vendido_Sin_Pagar");
                int pagados = vendedorGrupo.Count(b => b.Estado == "Pagado");
                decimal totalVentasPesos = (vendidosSinPagar + pagados) * Model.InfoRifa.CostoBoleto;
                decimal totalPagadoPesos = pagados * Model.InfoRifa.CostoBoleto;
                decimal deudaPendiente = vendidosSinPagar * Model.InfoRifa.CostoBoleto;
                var sampleBoleto = vendedorGrupo.First();
                int? idUsuarioDestino = sampleBoleto.IdUsuarioAsignado;
                string externoTarget = sampleBoleto.NombrePromotorExterno;
                
                <div class="mb-4 grupo-vendedor bg-light p-3 rounded-4 shadow-sm border border-pastel-blue">
                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center border-bottom border-pastel-blue border-2 pb-3 mb-3 gap-3">
                        <div class="d-flex flex-column align-items-start w-100 w-lg-auto">
                            <h5 class="fw-bold text-dark text-uppercase mb-1 text-truncate pe-2">
                                <i class="fa-solid fa-user me-1 text-pastel-blue"></i> @vendedorGrupo.Key
                            </h5>
                            <span class="badge bg-white text-secondary border shadow-sm">Total Inventario: @totalAsignados boletos</span>
                        </div>

                        @if (stats != null)
                        {
                            <div class="d-flex gap-2 flex-wrap flex-nowrap-md flex-grow-1 justify-content-between justify-content-lg-center w-100 w-lg-auto">
                                <div class="custom-stat-total rounded-3 px-2 py-2 border border-2 text-center flex-fill" style="min-width: 90px; max-width: 140px;">
                                    <div class="text-uppercase fw-bold" style="font-size:0.7rem;">Ventas</div>
                                    <div class="fw-bold mt-1" style="font-size:1rem;">$@totalVentasPesos.ToString("N2")</div>
                                </div>
                                <div class="custom-stat-paid rounded-3 px-2 py-2 border border-2 text-center flex-fill" style="min-width: 90px; max-width: 140px;">
                                    <div class="text-uppercase fw-bold" style="font-size:0.7rem;">Pagado</div>
                                    <div class="fw-bold mt-1" style="font-size:1rem;">$@totalPagadoPesos.ToString("N2")</div>
                                </div>
                                <div class="custom-stat-pending rounded-3 px-2 py-2 border border-2 text-center flex-fill" style="min-width: 90px; max-width: 140px;">
                                    <div class="text-uppercase fw-bold" style="font-size:0.7rem;">Pendiente</div>
                                    <div class="fw-bold mt-1" style="font-size:1rem;">$@deudaPendiente.ToString("N2")</div>
                                </div>
                            </div>
                        }

                        <div class="d-flex gap-2 flex-row flex-lg-grow-0 w-100 w-lg-auto mt-2 mt-lg-0">
                            <a href="@Url.Action("ImprimirPlanilla", "Rifas", new { idRifa = Model.InfoRifa.IdRifaEncriptado, idDestino = idUsuarioDestino, externo = externoTarget, nombreMostrar = vendedorGrupo.Key })"
                                   target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill shadow-sm fw-bold px-3 d-flex align-items-center justify-content-center flex-fill">
                                <i class="fa-solid fa-print me-1"></i> <span>Imprimir</span>
                            </a>
                            <button class="btn btn-sm btn-outline-primary rounded-pill shadow-sm fw-bold px-3 d-flex align-items-center justify-content-center flex-fill"
                                    onclick="abrirModalReportePago('@idUsuarioDestino', '@externoTarget')"
                                @(deudaPendiente <= 0 ? "disabled" : "")>
                                <i class="fa-solid fa-upload me-1"></i> <span>Subir Pago</span>
                            </button>
                            @if (Model.InfoRifa.Estado == "Activa")
                            {
                                <button class="btn-vender-varios btn btn-sm btn-success rounded-pill fw-bold shadow-sm px-3 d-flex align-items-center justify-content-center flex-fill" onclick="abrirModalVentaMasiva()" disabled>
                                    <i class="fa-solid fa-cash-register me-1"></i> <span>Vender</span> (<span class="contador-seleccion">0</span>)
                                </button>
                            }
                        </div>
                    </div>

                    @{
                        var gruposPorFecha = vendedorGrupo
                            .GroupBy(b => b.FechaAsignacion?.ToString("dd/MM/yyyy hh:mm tt") ?? "Sin Fecha")
                            .OrderByDescending(g => g.Max(b => b.FechaAsignacion ?? DateTime.MinValue));
                    }

                    @foreach (var fechaGrupo in gruposPorFecha)
                    {
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-2">
                                <div class="fecha-bloque-badge shadow-sm" style="font-size: 0.8rem;">
                                    <i class="fa-regular fa-calendar-check me-1 text-pastel-blue"></i> Asignación: <span class="text-primary fw-bold">@fechaGrupo.Key</span>
                                </div>
                                <div class="flex-grow-1 ms-2" style="height: 1px; background-color: #e0f2fe;"></div>
                            </div>

                            <div class="row g-1 g-md-2">
                                @foreach (var boleto in fechaGrupo.OrderBy(b => b.Numero))
                                {
                                    bool disponible = boleto.Estado == "Disponible" || boleto.Estado == "Fisico_En_Mano";
                                    bool pagado = boleto.Estado == "Pagado";
                                    string claseBoleto = disponible ? "pos-boleto-libre" : (pagado ? "pos-boleto-pagado" : "pos-boleto-vendido");
                                    bool enPago = boletosBloqueados.Contains(boleto.Id_Boleto);
                                    
                                    <div class="col-3 col-sm-2 col-md-2 col-lg-1 item-boleto" data-numero="@boleto.Numero">
                                        <div class="w-100 p-1 d-flex flex-column align-items-center position-relative @claseBoleto"
                                             data-id="@boleto.Id_Boleto"
                                             data-numero="@boleto.Numero.ToString("000")"
                                             data-disponible="@(disponible ? "true" : "false")"
                                             data-nombre="@boleto.Comprador"
                                             data-telefono="@boleto.Telefono"
                                             data-comentarios="@boleto.Comentarios"
                                             data-marcador="@(boleto.MarcadorPersonal ? "true" : "false")"
                                             data-estado="@boleto.Estado"
                                             data-en-pago="@(enPago ? "true" : "false")"
                                             onclick="manejarClickBoleto(this)"
                                             id="bol_@boleto.Id_Boleto">

                                            @if (boleto.MarcadorPersonal)
                                            {
                                                <i class="fa-solid fa-flag text-danger position-absolute top-0 end-0 mt-1 me-1" style="font-size: 0.6rem;" title="Marca de control activada"></i>
                                            }

                                            @if (enPago)
                                            {
                                                <i class="fa-solid fa-file-invoice-dollar text-warning position-absolute bottom-0 start-0 m-1" style="font-size: 0.7rem;" title="Vinculado a un pago en revisión"></i>
                                            }

                                            <span class="fw-bold" style="font-size:0.9rem;">#@boleto.Numero.ToString("000")</span>
                                            @if (!disponible)
                                            {
                                                <small class="text-truncate w-100 text-center fw-bold" style="font-size:0.55rem; opacity: 0.9;">@boleto.Comprador</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted w-100 text-center" style="font-size:0.55rem;">Libre</small>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="alert bg-white border border-info rounded-3 shadow-sm d-flex align-items-center p-3 p-md-4 mt-3">
                <div class="bg-info bg-opacity-10 p-2 rounded-circle me-3 flex-shrink-0">
                    <i class="fa-solid fa-lightbulb text-info fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Gestión de Boletos Digitales</h6>
                    <p class="mb-0 small text-muted">
                        <strong>Haz clic sobre cualquier boleto ya vendido</strong> para editar los datos del comprador o generar su <i class="fa-solid fa-download mx-1 text-primary"></i> <strong>boleto digital</strong> para enviarlo por WhatsApp.
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@* MODALES Y TEMPLATES *@
<div class="modal fade" id="modalVenta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <form action="@Url.Action("RegistrarVentaMasiva", "Rifas")" method="post" id="formVentaMasiva" class="modal-content border-0 shadow-lg rounded-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="idRifaOrigen" value="@Model.InfoRifa.IdRifaEncriptado" />
            <div class="modal-header border-0 p-3 p-md-4 bg-pastel-blue">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-file-invoice-dollar me-2"></i> Reporte de Venta Individualizada</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3 p-md-4 bg-light">
                <div class="alert border-0 small mb-4 shadow-sm rounded-3 bg-pastel-green p-3">
                    <i class="fa-brands fa-whatsapp text-success me-1 fs-6"></i> Captura el número de teléfono para enviar una notificación automática por WhatsApp al finalizar.
                </div>
                <div id="contenedorTarjetasVenta" class="d-flex flex-column gap-3"></div>
            </div>
            <div class="modal-footer border-0 bg-white p-3 p-md-4">
                <button type="button" class="btn btn-light fw-bold px-4 rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-success rounded-pill fw-bold shadow-sm px-4 px-md-5">
                    <i class="fa-solid fa-check-double me-2"></i> Confirmar Ventas
                </button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalEditarBoleto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="@Url.Action("EditarBoletoVendido", "Rifas")" method="post" class="modal-content border-0 shadow-lg rounded-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="idRifa" value="@Model.InfoRifa.IdRifaEncriptado" />
            <input type="hidden" name="IdBoleto" id="edit_IdBoleto" />

            <div class="modal-header border-0 p-4 bg-pastel-blue">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i> Editar Boleto <span id="edit_NumBoleto" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
