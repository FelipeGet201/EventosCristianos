@model RedAJP.Models.IglesiaWebPublicaViewModel

<style>
    .nav-transparente {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1040;
        /* Degradado basado en el color primario del tema con opacidad */
        background: linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, transparent 100%);
        padding: 1.5rem 0;
    }

        .nav-transparente .navbar-brand {
            font-family: var(--theme-font-title);
            font-size: 1.8rem;
            color: #ffffff !important; /* Mantenemos blanco para overlay oscuro */
            letter-spacing: 1px;
            font-weight: 700;
        }

        .nav-transparente .nav-link {
            color: rgba(255,255,255,0.85) !important;
            font-family: var(--theme-font-body);
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1.5px;
            margin: 0 10px;
            transition: color 0.3s;
        }

            .nav-transparente .nav-link:hover {
                color: var(--theme-accent) !important;
            }
</style>

<nav class="navbar navbar-expand-lg nav-transparente">
    <div class="container">
        <a class="navbar-brand text-truncate" style="max-width: 300px;" href="#">
            @(string.IsNullOrWhiteSpace(Model.NombreIglesia) ? "Nuestra Iglesia" : Model.NombreIglesia)
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navTransparenteCollapse">
            <i class="fa-solid fa-bars text-white fs-4"></i>
        </button>
        <div class="collapse navbar-collapse" id="navTransparenteCollapse">
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item"><a class="nav-link" href="#actividad">Agenda</a></li>
                <li class="nav-item"><a class="nav-link" href="#nosotros">Nosotros</a></li>
                <li class="nav-item"><a class="nav-link" href="#galeria">Galería</a></li>
                <li class="nav-item ms-lg-3 mt-3 mt-lg-0">
                    <a href="#contacto" class="btn btn-outline-light rounded-pill px-4 btn-sm" style="border-color: #fff; color: #fff;">Contacto</a>
                </li>
            </ul>
        </div>
    </div>
</nav>