@model RedAJP.Models.IglesiaWebPublicaViewModel

<style>
    .ev-horiz-card {
        background: var(--theme-surface);
        border-radius: 16px;
        border: 1px solid rgba(128, 128, 128, 0.2);
        overflow: hidden;
        transition: transform 0.3s ease;
    }

        .ev-horiz-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        }

    .ev-horiz-img {
        flex: 0 0 220px;
        min-height: 220px;
        background-color: var(--theme-bg);
        background-position: center;
        background-size: cover;
        border-right: 1px solid rgba(128, 128, 128, 0.2);
    }
    @Html.Raw("@") media (max-width: 575px) {
        .ev-horiz-img {
            flex: 0 0 180px;
            border-right: none;
            border-bottom: 1px solid rgba(128, 128, 128, 0.2);
        }
    }
</style>

<div class="container py-5 fade-in-up">
    <h2 class="mb-4" style="font-family: var(--theme-font-title); font-weight: 800; color: var(--theme-primary);">
        Agenda General
    </h2>

    @if (Model.Eventos != null && Model.Eventos.Any())
    {
        <div class="row g-4">
            @foreach (var ev in Model.Eventos)
            {
                <div class="col-lg-6 d-flex">
                    <div class="ev-horiz-card w-100 d-flex flex-column flex-sm-row">
                        @if (!string.IsNullOrWhiteSpace(ev.ImagenUrl))
                        {
                            <div class="ev-horiz-img" style="background-image: url('@ev.ImagenUrl');"></div>
                        }
                        else
                        {
                            <div class="ev-horiz-img d-flex align-items-center justify-content-center">
                                <i class="fa-regular fa-image fs-2" style="color: var(--theme-text-muted); opacity: 0.3;"></i>
                            </div>
                        }

                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <div class="d-inline-block mb-2" style="background: var(--theme-bg); color: var(--theme-text-main); font-weight: 700; padding: 0.4rem 0.8rem; border-radius: 8px; font-size: 0.85rem; font-family: var(--theme-font-body); border: 1px solid rgba(128, 128, 128, 0.2);">
                                <i class="fa-regular fa-calendar me-1" style="color: var(--theme-accent);"></i> @(ev.Fecha == default ? "Sin fecha" : ev.Fecha.ToString("dd MMMM yyyy"))
                            </div>
                            <h4 class="mb-2" style="font-family: var(--theme-font-title); font-weight: 700; color: var(--theme-primary);">
                                @(string.IsNullOrWhiteSpace(ev.Titulo) ? "Sin información" : ev.Titulo)
                            </h4>
                            <p class="mb-2" style="color: var(--theme-text-main); font-weight: 600; font-family: var(--theme-font-body); font-size: 0.9rem;">
                                <i class="fa-regular fa-clock me-1" style="color: var(--theme-accent);"></i> @(string.IsNullOrWhiteSpace(ev.Horarios) ? "Sin horarios" : ev.Horarios)
                            </p>
                            <p class="small mb-0 mt-2" style="color: var(--theme-text-muted); font-family: var(--theme-font-body);">
                                @if (!string.IsNullOrWhiteSpace(ev.Descripcion))
                                {
                                    @Html.Raw(ev.Descripcion.Replace("\n", "<br>"))
                                }
                                else
                                {
                                    <span>Sin información detallada.</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-4" style="background: var(--theme-surface); border: 1px solid rgba(128, 128, 128, 0.2); border-radius: 12px; color: var(--theme-text-muted); font-family: var(--theme-font-body);">
            No hay eventos en la agenda.
        </div>
    }
</div>