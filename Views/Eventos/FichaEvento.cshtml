@{
    Layout = null;
    var evento = ViewBag.Evento as RedAJP.Models.EventoItemViewModel;
    var subtipos = ViewBag.Subtipos as List<RedAJP.Models.SubtipoEventoItem>;
    var galeria = ViewBag.Galeria as List<RedAJP.Models.FotoGaleriaItem>;

    // Identidad visual
    var colorPrimario = "#1f2e47"; // Azul Navy
    var colorAcento = "#fbe66a";  // Amarillo
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ficha - @evento.Titulo</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            /* --- ESTILOS BASE --- */
            body {
                background-color: #f4f4f2;
                font-family: 'Segoe UI', Arial, sans-serif;
                color: #333;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .ficha-container {
                max-width: 850px;
                margin: 0 auto;
                background: white;
                box-shadow: 0 0 20px rgba(0,0,0,0.1);
            }

            /* --- HEADER --- */
            .header-ficha {
                background-color: @colorPrimario;
                color: white;
                padding: 40px;
                border-bottom: 8px solid @colorAcento;
                page-break-inside: avoid;
                break-inside: avoid;
            }

            .logo-img {
                height: 80px;
                width: auto;
                background: white;
                padding: 5px;
                border-radius: 8px;
            }

            .titulo-evento {
                font-size: 2.2rem;
                font-weight: 800;
                text-transform: uppercase;
                margin: 0;
                line-height: 1.1;
            }

            /* --- CUERPO --- */
            .body-ficha {
                padding: 40px;
            }

            .section-title {
                color: @colorPrimario;
                font-size: 1.25rem;
                font-weight: 700;
                border-left: 5px solid @colorAcento;
                padding-left: 15px;
                margin: 30px 0 20px 0;
                page-break-after: avoid;
                break-after: avoid;
            }

            .descripcion-texto {
                line-height: 1.8;
                text-align: justify;
                color: #444;
            }

            /* --- IMÁGENES --- */
            .img-container-full {
                width: 100%;
                margin-bottom: 25px;
                text-align: center;
                background-color: #f8f9fa;
                border-radius: 8px;
                overflow: hidden;
                border: 1px solid #eaeaea;
                page-break-inside: avoid;
                break-inside: avoid;
            }

            .img-full {
                width: 100%;
                height: auto;
                display: block;
            }

            /* --- GALERÍA EN GRID --- */
            .galeria-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }

                .galeria-grid .img-container-full {
                    margin-bottom: 0;
                    height: auto;
                }

                .galeria-grid .img-full {
                    max-height: 250px;
                    object-fit: contain;
                    width: auto;
                    margin: 0 auto;
                }

            .pie-foto {
                background: #f8f9fa;
                padding: 10px;
                font-size: 0.85rem;
                font-style: italic;
                color: #555;
                border-top: 1px solid #eaeaea;
            }

            /* --- TABLA DE COSTOS --- */
            .table-custom {
                width: 100%;
                margin-bottom: 30px;
                border-collapse: collapse;
                page-break-inside: avoid;
                break-inside: avoid;
            }

                .table-custom th {
                    border-bottom: 2px solid @colorPrimario;
                    padding: 12px 10px;
                    color: #555;
                    font-size: 0.9rem;
                    text-transform: uppercase;
                }

                .table-custom td {
                    padding: 12px 10px;
                    border-bottom: 1px solid #eee;
                    font-weight: 500;
                }

            /* --- MENSAJE DE REGISTRO --- */
            .info-box {
                background: @(evento.EsPrivado? colorPrimario : colorAcento);
                color: @(evento.EsPrivado ? "white" : colorPrimario);
                padding: 25px;
                border-radius: 8px;
                text-align: center;
                margin-top: 40px;
                page-break-inside: avoid;
                break-inside: avoid;
            }

            /* --- BOTÓN IMPRIMIR --- */
            .btn-print {
                position: fixed;
                bottom: 30px;
                right: 30px;
                z-index: 1000;
                background: @colorPrimario;
                color: white;
                width: 60px;
                height: 60px;
                border-radius: 50%;
                border: none;
                box-shadow: 0 5px 15px rgba(0,0,0,0.3);
                cursor: pointer;
                transition: transform 0.2s ease;
            }

            /* --- REGLAS DE IMPRESIÓN --- */
            @@media print {
                @@page { margin: 1.5cm; }
                body { background: white; }
                .btn-print { display: none !important; }
                .ficha-container { box-shadow: none; margin: 0; width: 100%; max-width: 100%; }
                .body-ficha { padding: 20px 0; }
            }
    </style>
</head>
<body>

    <button onclick="window.print()" class="btn-print" title="Imprimir o Guardar PDF">
        <i class="fa-solid fa-print fa-lg"></i>
    </button>

    <div class="ficha-container">
        
        <div class="header-ficha">
            <div class="row align-items-center">
                <div class="col-auto">
                    <img src="/Images/logo_ajp.jpg" class="logo-img rounded-circle" alt="Logo">
                </div>
                <div class="col ps-3 ps-md-4">
                    <h1 class="titulo-evento">@evento.Titulo</h1>
                    <div class="mt-2 text-white-50 fw-semibold fs-5">
                        <i class="fa-regular fa-calendar-days me-2 text-white"></i>
                        @evento.Fecha_Inicio.ToString("D") - @evento.Fecha_Inicio.ToString("hh:mm tt")
                    </div>
                </div>
            </div>
        </div>

        <div class="body-ficha">
            
            @if (!string.IsNullOrEmpty(evento.Imagen_Url))
            {
                <div class="img-container-full">
                    <img src="@evento.Imagen_Url" class="img-full" alt="Portada Evento" referrerpolicy="no-referrer">
                </div>
            }

            <div class="section-title">Descripción</div>
            <div class="descripcion-texto">
                @{
                    string desc = evento.Descripcion ?? "";
                    // Detección de HTML como en la vista Detalle [cite: 119, 120]
                    bool tieneHtml = System.Text.RegularExpressions.Regex.IsMatch(desc, @"<\s*([a-zA-Z]+)[^>]*>");
                    string descFinal = tieneHtml ? desc : desc.Replace("\n", "<br>"); // Reemplaza saltos de línea solo si es texto plano [cite: 121]
                }
                @Html.Raw(descFinal)
            </div>

            <div class="section-title">Opciones y Costos</div>
            @if (subtipos != null && subtipos.Any())
            {
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th class="text-start">Opción</th>
                            <th class="text-center">Disponibilidad</th>
                            <th class="text-end">Precio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in subtipos)
                        {
                            // Lógica de disponibilidad real (Cupo - Ocupados) [cite: 127, 128]
                            int disponibles = sub.Cupo > 0 ? sub.Cupo - sub.Ocupados : 999999;
                            bool agotado = sub.Cupo > 0 && disponibles <= 0;

                            <tr>
                                <td class="text-start">@sub.Nombre</td>
                                <td class="text-center">
                                    @if (agotado)
                                    {
                                        <span class="text-danger fw-bold" style="color: #dc3545 !important;">Agotado</span>
                                        // Estilo Agotado [cite: 135]
                                    }
                                    else if (sub.Cupo > 0)
                                    {
                                        <span class="text-muted">@disponibles lugares</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Disponible</span>
                                    }
                                </td>
                                <td class="text-end fw-bold fs-6" style="color: @colorPrimario">$@sub.Costo.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-3 border rounded d-flex justify-content-between bg-light mt-3">
                    <span class="text-muted text-uppercase fw-bold small">Precio General:</span>
                    <span class="fw-bold fs-5 text-success">@(evento.Costo > 0 ? "$" + evento.Costo.ToString("N2") : "Entrada Libre")</span>
                </div>
            }

            <div class="info-box shadow-sm">
                @if (evento.EsPrivado)
                {
                    <h5 class="fw-bold mb-2"><i class="fa-solid fa-lock me-2"></i> EVENTO PRIVADO</h5>
                    <p class="mb-0">Este evento requiere invitación. Por favor, repórtate con el delegado de tu iglesia local para más información.</p>
                }
                else
                {
                    <h5 class="fw-bold mb-2"><i class="fa-solid fa-ticket me-2"></i> ¡REGÍSTRATE AHORA!</h5>
                    <p class="mb-0">Para participar, regístrate en <strong>LosPescadores.org</strong> y accede a la sección del evento.</p>
                }
            </div>

            @if (galeria != null && galeria.Any())
            {
                <div class="section-title">Galería de Imágenes</div>
                <div class="galeria-grid">
                    @foreach (var foto in galeria)
                    {
                        <div class="img-container-full">
                            <img src="@foto.Url_Foto" class="img-full" alt="Foto Galería" referrerpolicy="no-referrer">
                            @if (!string.IsNullOrEmpty(foto.Descripcion))
                            {
                                <div class="pie-foto text-center">@foto.Descripcion</div>
                            }
                        </div>
                    }
                </div>
            }

            <div class="text-center mt-5 pt-4 border-top text-muted small fw-semibold">
                Generado desde LosPescadores.org - @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
    </div>

</body>
</html>