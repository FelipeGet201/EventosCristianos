@model RedAJP.Models.EncuestaResponderViewModel
@{
    Layout = "Principal";
}
<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-herramientas');
            activarMenu('submenu-encuestas');
        }
    });
</script>
<div class="container py-5 d-flex justify-content-center align-items-center" style="height: 80vh;">
    <div class="card border-0 shadow-lg rounded-4 p-5 text-center" style="background: rgba(255,255,255,0.95); max-width: 500px;">
        <i class="fa-solid fa-clock fa-4x text-secondary mb-4"></i>
        <h2 class="fw-bold text-dark">Encuesta Cerrada</h2>
        <p class="text-muted">"@Model.Titulo" ya no acepta más respuestas.</p>
        <a href="/" class="btn btn-outline-dark rounded-pill mt-3">Volver al Inicio</a>
    </div>
</div>