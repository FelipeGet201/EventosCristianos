@if (p_Crear)
{
    <div class="modal fade" id="modalSolicitarTraspaso" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header bg-primary text-white border-0" style="border-radius: 20px 20px 0 0;">
            
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-hand-holding-dollar me-2"></i>Solicitar Dinero</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" action="@Url.Action("SolicitarTraspaso", "Caja")">
                    @Html.AntiForgeryToken()
       
                    <div class="modal-body p-4">
                        <p class="text-muted small mb-3">
                            Solicita fondos a otro encargado con saldo.
                            El dinero se sumará a tu total cuando él acepte entregarte el efectivo.
                        </p>

                        <div class="form-floating mb-3">
                            <select class="form-select fw-bold" id="IdUsuarioDestino" name="IdUsuarioDestino" required onchange="actualizarMontoMaximo()">
                            
                                <option value="" data-max="0">Selecciona al encargado...</option>
                                @foreach (var u in usuariosCombo)
                                {
                        
                                    <option value="@u.Id" data-max="@u.Saldo.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                        @u.Nombre (Máx: @u.Saldo.ToString("C", cultura))
                                    </option>
       
                                }
                            </select>
                            <label>¿A quién le pides dinero?</label>
               
                        </div>

                        <div class="form-check form-switch mb-3 ps-5 bg-light p-2 rounded border border-primary border-opacity-25">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="chkTodo" name="SolicitarTodo" value="true" onchange="actualizarMontoMaximo()">
                     
                            <label class="form-check-label small fw-bold text-primary" for="chkTodo">Solicitar Todos los Fondos</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="number" step="0.01" class="form-control fw-bold text-success fs-5"
                                   id="MontoTraspaso" name="MontoTraspaso" required placeholder="0.00">
                            <label>Monto a solicitar ($)</label>
                        </div>

                        <div class="form-floating mb-1">
                
                            <input type="text" class="form-control" id="ConceptoTraspaso" name="ConceptoTraspaso" required placeholder="Para qué...">
                            <label>
                                ¿Para qué lo necesitas?
                                (Concepto)
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
   
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Enviar Solicitud</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal fade" id="modalRespuestaTraspaso" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header border-0 pb-0 justify-content-center mt-3">
                    <div id="iconoRespuesta" class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 60px;
                        height: 60px;">
                        <i id="iconoRespuestaClase" class="fa-solid fa-question fa-2x text-white"></i>
                    </div>
                </div>
                <form method="post" action="@Url.Action("ResponderTraspaso", "Caja")">
               
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="modalIdTraspaso" name="idTraspaso" value="" />
                    <input type="hidden" id="modalAccionRespuesta" name="respuesta" value="" />

                    <div class="modal-body text-center p-4">
                      
                        <h5 class="fw-bold mb-2" id="tituloRespuesta">Confirmación</h5>
                        <p class="text-muted mb-0" id="mensajeRespuesta"></p>
                        <h3 class="fw-bold mt-3 mb-0" id="montoRespuesta"></h3>
                    </div>

                    
                    <div class="modal-footer border-0 pt-0 justify-content-center mb-2">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" id="btnConfirmarRespuesta" class="btn rounded-pill px-4 shadow-sm text-white">Confirmar</button>
                    </div>
              
                </form>
            </div>
        </div>
    </div>
}
<script>
    var modalVisor;
    // Inicializar Tooltips
    document.addEventListener("DOMContentLoaded", function() {
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl)
    });

    // ==========================================
    // CONFIGURACIÓN DE GRÁFICAS
    // ==========================================

    // 1. FUENTES DE INGRESO (Barras)
    
    const ctxBar = document.getElementById('graficaFuentes').getContext('2d');
    new Chart(ctxBar, {
    type: 'bar',
    data: {
    labels: ['Eventos', 'Rifas', 'Tienda', 'Manuales (Caja/Banco)'],
    datasets: [{
                   
    label: 'Ingresos',
    data: [@ViewBag.EventosMes, @ViewBag.RifasMes, @ViewBag.TiendaMes, @ViewBag.IngresosManualesMes],
    backgroundColor: ['#3498db', '#9b59b6', '#e67e22', '#2ecc71'],
    borderRadius: 5
    }]
    },
 
    options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: { y: { beginAtZero: true, grid: { borderDash: [2, 4] } }, x: {
    grid: { display: false } } }
    }
    });
    // 2. GASTOS VS INGRESOS (Dona)
    const ctxPie = document.getElementById('graficaGastos').getContext('2d');
    const ing = @ViewBag.IngresosManualesMes + @totalWebMes;
    const egr = @ViewBag.EgresosManualesMes;
    let dataPie = [ing, egr];
    let colorPie = ['#3498db', '#e74c3c'];
    if(ing <= 0 && egr <= 0) { dataPie=[1]; colorPie=['#ecf0f1'];
    }

    new Chart(ctxPie, {
    type: 'doughnut',
    data: {
    labels: ['Total Entradas', 'Total Salidas'],
    datasets: [{ data: dataPie, backgroundColor: colorPie, borderWidth: 0, hoverOffset: 4 }]
    },
      
    options: {
    responsive: true, maintainAspectRatio: false, cutout: '75%',
    plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8 } } }
    }
    });
    // 3. NUEVA GRÁFICA: SALDOS POR USUARIO (Dona con centro vacío)
    @if (saldosUsuarios.Any())
    {
        <text>
            const ctxSaldos = document.getElementById('graficaSaldosUsuarios').getContext('2d');
            const userLabels = [ @Html.Raw(string.Join(",", saldosUsuarios.Select(u => $"'{u.Nombre}'"))) ];
            const userData = [ @string.Join(",", saldosUsuarios.Select(u => u.Saldo.ToString().Replace(",", "."))) ];
            const coloresSaldos = ['#2ecc71', '#3498db', '#9b59b6', '#f1c40f', '#e67e22', '#1abc9c', '#34495e'];
            new Chart(ctxSaldos, {
            type: 'pie',
            data: {
            labels: userLabels,
            datasets: [{
                    
            data: userData,
            backgroundColor: coloresSaldos,
            borderWidth: 2,
            borderColor: '#fff'
                
            }]
            },
            options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins:
            {
            legend: {
            position: 'bottom',
            labels: {
              
            usePointStyle: true,
            padding: 20
            }
                   
            },
            tooltip: {
            callbacks: {
            label: function(c) {
    
            return ' ' + c.label + ': $' + c.raw.toLocaleString('en-US', {minimumFractionDigits: 2});
            }
            }
            }
            }
            }
          
            });
        </text>
    }

    modalVisor = new bootstrap.Modal(document.getElementById('modalVisorComprobante'));
    });

    // ==========================================
    // LOGICA DEL CHECKBOX: SOLICITAR TODO
    // ==========================================
    function actualizarMontoMaximo() {
    var select = document.getElementById('IdUsuarioDestino');
    var chk = document.getElementById('chkTodo');
    var txtMonto = document.getElementById('MontoTraspaso');
    var txtConcepto = document.getElementById('ConceptoTraspaso');

    var maxVal = 0;
    if (select.selectedIndex >= 0) {
    maxVal = select.options[select.selectedIndex].getAttribute('data-max');
    }

    if (chk.checked && select.value !== "") {
    txtMonto.value = maxVal;
    txtMonto.readOnly = true;
    txtConcepto.value = "Traspaso Total de Fondos";
    } else {
    if(chk.checked && select.value === "") { txtMonto.value = "";
    }
    txtMonto.readOnly = false;
    if(txtConcepto.value === "Traspaso Total de Fondos") {
    txtConcepto.value = "";
    }
    }
    }

    // Funciones del Modal General
    // Funciones del Modal General
    const hoy = new Date().toISOString().split('T')[0];

    function abrirModalNuevo() {
        document.getElementById('modalTitulo').innerText = "Registrar Movimiento";
        document.getElementById('Id_Movimiento').value = 0;
        document.getElementById('Concepto').value = "";
        document.getElementById('Monto').value = "";
        document.getElementById('Fecha').value = hoy;
        document.getElementById('optIngreso').checked = true;
        document.getElementById('metodoEfectivo').checked = true;
        document.getElementById('ArchivoComprobante').value = "";
        document.getElementById('FolioBancario').value = "";
        document.getElementById('avisoArchivoExistente').classList.add('d-none');
    
        // Reset Vincular Evento
        document.getElementById('Id_Evento').value = "";
        document.getElementById('chkVincularEvento').checked = false;
        evaluarTipoMovimiento();

        new bootstrap.Modal(document.getElementById('modalCaja')).show();
    }

    function abrirModalEditar(id, concepto, monto, tipo, fecha, idArchivo, esBanco, folio, idEvento) {
        document.getElementById('modalTitulo').innerText = "Editar Movimiento";
        document.getElementById('Id_Movimiento').value = id;
        document.getElementById('Concepto').value = concepto;
        document.getElementById('Monto').value = monto.toString().replace(',', '.');
        document.getElementById('Fecha').value = fecha;
        document.getElementById('FolioBancario').value = folio;

        if (tipo === 'Ingreso') document.getElementById('optIngreso').checked = true;
        else document.getElementById('optEgreso').checked = true;

        if (esBanco === true) document.getElementById('metodoBanco').checked = true;
        else document.getElementById('metodoEfectivo').checked = true;

        document.getElementById('ArchivoComprobante').value = "";
        if (idArchivo > 0) document.getElementById('avisoArchivoExistente').classList.remove('d-none');
        else document.getElementById('avisoArchivoExistente').classList.add('d-none');

        // Lógica de Evento al Editar
        evaluarTipoMovimiento();
        if(idEvento && idEvento > 0){
        document.getElementById('chkVincularEvento').checked = true;
        document.getElementById('Id_Evento').value = idEvento;
        toggleComboEvento();
        } else {
        document.getElementById('chkVincularEvento').checked = false;
        document.getElementById('Id_Evento').value = "";
        toggleComboEvento();
        }

        new bootstrap.Modal(document.getElementById('modalCaja')).show();
    }
    function evaluarTipoMovimiento() {
        var esGasto = document.getElementById('optEgreso').checked;
        var esBanco = document.getElementById('metodoBanco').checked; // NUEVA LÍNEA
        var divContenedor = document.getElementById('divContenedorEvento');
    
        if (esGasto && esBanco) {
        divContenedor.classList.remove('d-none');
        } else {
        divContenedor.classList.add('d-none');
        document.getElementById('chkVincularEvento').checked = false;
        toggleComboEvento();
        }
    }

    function toggleComboEvento() {
        var checkActivo = document.getElementById('chkVincularEvento').checked;
        var divCombo = document.getElementById('divComboEvento');
        var selectEvento = document.getElementById('Id_Evento');
    
        if (checkActivo) {
        divCombo.classList.remove('d-none');
        selectEvento.required = true;
        } else {
        divCombo.classList.add('d-none');
        selectEvento.required = false;
        selectEvento.value = "";
        }
    }
    function abrirModalBorrar(idMovimiento) {
    document.getElementById('IdEliminarModal').value = idMovimiento;
    new bootstrap.Modal(document.getElementById('modalBorrar')).show();
    }

    // Modal de Traspasos
    function abrirModalSolicitarTraspaso() {
    document.getElementById('MontoTraspaso').value = "";
    document.getElementById('MontoTraspaso').readOnly = false;
    document.getElementById('ConceptoTraspaso').value = "";
    document.getElementById('IdUsuarioDestino').value = "";
    document.getElementById('chkTodo').checked = false;
    actualizarMontoMaximo();
    new bootstrap.Modal(document.getElementById('modalSolicitarTraspaso')).show();
    }

    // Visor de Archivos
    function abrirVisorComprobante(idArchivo) {
    var urlBase = '@Url.Action("VerComprobante", "Caja")';
    var urlPreview = urlBase + '?id=' + idArchivo;
    var urlDescarga = urlBase + '?id=' + idArchivo + '&descargar=true';
    var img = document.getElementById('imgComprobanteCaja');
    var pdf = document.getElementById('pdfComprobanteCaja');
    var loader = document.getElementById('loaderComprobante');
    var btnDescargar = document.getElementById('btnDescargarComprobante');

    img.classList.add('d-none');
    pdf.classList.add('d-none');
    loader.style.display = 'block';
    img.src = "";
    pdf.src = "";
    btnDescargar.href = urlDescarga;

    img.src = urlPreview;
    img.onload = function() { loader.style.display = 'none'; img.classList.remove('d-none'); };
    img.onerror = function() {
    img.classList.add('d-none');
    pdf.src = urlPreview;
    pdf.classList.remove('d-none');
    loader.style.display = 'none';
    };
    modalVisor.show();
    }
    // Lógica para filtrar el Historial de Caja Personal por JS
    function filtrarHistorialJS() {
    var anioSeleccionado = document.getElementById('filtroAnioHistorial').value;
    var mesSeleccionado = document.getElementById('filtroMesHistorial').value;
    var filas = document.querySelectorAll('.fila-historial');
    var contVisibles = 0;
    filas.forEach(function(fila) {
    var anioFila = fila.getAttribute('data-anio');
    var mesFila = fila.getAttribute('data-mes');

    var coincideAnio = (anioSeleccionado === "ALL" || anioSeleccionado === anioFila);
    var coincideMes = (mesSeleccionado === "ALL" || mesSeleccionado === mesFila);

    if (coincideAnio && coincideMes) {
           
    fila.style.display = '';
    contVisibles++;
    } else {
    fila.style.display = 'none';
    }
    });
    // Manejo del mensaje "Sin datos" si el filtro oculta todo
    var rowSinDatos = document.getElementById('rowSinDatosHist');
    if (contVisibles === 0 && filas.length > 0) {
    if(!rowSinDatos) {
    var tbody = document.getElementById('bodyHistorialPersonal');
    tbody.insertAdjacentHTML('beforeend', '<tr id="rowSinDatosHist"><td colspan="4" class="text-center py-4 text-muted">No hay movimientos en este periodo.</td></tr>');
    } else {
    rowSinDatos.style.display = '';
    }
    } else if (rowSinDatos) {
    rowSinDatos.style.display = 'none';
    }
    }

    // Lógica para el Modal de Confirmación de Traspasos
    function abrirModalRespuestaTraspaso(id, accion, nombre, monto) {
    document.getElementById('modalIdTraspaso').value = id;
    document.getElementById('modalAccionRespuesta').value = accion;
    document.getElementById('montoRespuesta').innerText = monto;

    var icono = document.getElementById('iconoRespuesta');
    var iconoClase = document.getElementById('iconoRespuestaClase');
    var btn = document.getElementById('btnConfirmarRespuesta');
    var titulo = document.getElementById('tituloRespuesta');
    var mensaje = document.getElementById('mensajeRespuesta');

    if (accion === 'Aceptar') {
    icono.className = 'bg-success rounded-circle d-flex align-items-center justify-content-center shadow-sm';
    iconoClase.className = 'fa-solid fa-check fa-2x text-white';
    btn.className = 'btn btn-success rounded-pill px-4 shadow-sm text-white';
    titulo.innerText = 'Entregar Fondos';
    mensaje.innerHTML = '¿Confirmas que ya entregaste el efectivo físicamente a <strong>' + nombre + '</strong>?';
    btn.innerText = 'Sí, ya lo entregué';
    } else {
    icono.className = 'bg-danger rounded-circle d-flex align-items-center justify-content-center shadow-sm';
    iconoClase.className = 'fa-solid fa-xmark fa-2x text-white';
    btn.className = 'btn btn-danger rounded-pill px-4 shadow-sm text-white';
    titulo.innerText = 'Rechazar Solicitud';
    mensaje.innerHTML = '¿Estás seguro de rechazar y anular la solicitud de <strong>' + nombre + '</strong>?';
    btn.innerText = 'Sí, rechazar';
    }

    new bootstrap.Modal(document.getElementById('modalRespuestaTraspaso')).show();
    }
    function abrirModalDetalle(id, concepto, monto, tipo, esBanco, idArchivo, idEvento, nombreEvento) {
        document.getElementById('detIdMovimiento').value = id;
        document.getElementById('detConcepto').innerText = concepto;
    
        // Configurar Monto
        var montoFormateado = monto.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
        var elMonto = document.getElementById('detMonto');
        elMonto.innerText = (tipo === 'Ingreso' ? '+ ' : '- ') + montoFormateado;
        elMonto.className = tipo === 'Ingreso' ? 'fw-bold mb-3 text-success' : 'fw-bold mb-3 text-danger';

        // Insignias
        var insignias = '';
        if (esBanco) insignias += '<span class="badge bg-primary bg-opacity-10 text-primary border border-primary"><i class="fa-solid fa-university me-1"></i>Banco</span>';
        else insignias += '<span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="fa-solid fa-money-bill me-1"></i>Caja Chica</span>';
    
        if (tipo === 'Ingreso') insignias += '<span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">Ingreso</span>';
        else insignias += '<span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Gasto</span>';
    
        document.getElementById('detInsignias').innerHTML = insignias;

        // Archivo Adjunto
        var secArchivo = document.getElementById('detArchivoSection');
        if (idArchivo > 0) {
        secArchivo.classList.remove('d-none');
        document.getElementById('btnVerArchivoDetalle').onclick = function() {
        abrirVisorComprobante(idArchivo);
        };
        } else {
        secArchivo.classList.add('d-none');
        }

        // Lógica del Select de Eventos
        var wrapperEdicion = document.getElementById('detWrapperEdicionEvento');
        var msjBloqueo = document.getElementById('detMensajeBloqueoEvento');
        var btnGuardar = document.getElementById('btnGuardarDetalle');
        var selectEvento = document.getElementById('detIdEvento');
        var inputReadOnly = document.getElementById('detEventoReadOnly');

        var permiteEvento = (tipo === 'Egreso' && esBanco === true);

        if (wrapperEdicion) { // El usuario tiene permisos generales de edición
        if (permiteEvento) {
        wrapperEdicion.classList.remove('d-none');
        msjBloqueo.classList.add('d-none');
        btnGuardar.classList.remove('d-none');
        selectEvento.value = idEvento > 0 ? idEvento : "";
        } else {
        wrapperEdicion.classList.add('d-none');
        msjBloqueo.classList.remove('d-none');
        btnGuardar.classList.add('d-none'); // Escondemos guardar porque no hay nada que editar
        }
        } else if (inputReadOnly) { // Usuario de solo lectura
        inputReadOnly.value = nombreEvento || "Sin asignar";
        }

        new bootstrap.Modal(document.getElementById('modalDetalleMovimiento')).show();
    }
    
    function sincronizarStripe() {
        let btn = document.getElementById('btnSyncStripe');
        let btnHtmlOriginal = btn.innerHTML;
    
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> Procesando Cuentas...';

        fetch('@Url.Action("SincronizarFlujosStripe", "Caja")', {
        method: 'POST',
        headers: {
        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        }
        })
        .then(response => response.json())
        .then(data => {
        // Inicializamos los elementos del modal dinámico de Bootstrap
        let iconoContenedor = document.getElementById('stripeIconoContenedor');
        let iconoClase = document.getElementById('stripeIconoClase');
        let titulo = document.getElementById('stripeTituloRespuesta');
        let mensaje = document.getElementById('stripeMensajeRespuesta');
        
        if (data.exito) {
        iconoContenedor.className = 'bg-success rounded-circle d-flex align-items-center justify-content-center shadow-sm mx-auto mb-3';
        iconoClase.className = 'fa-solid fa-circle-check fa-2x text-white';
        titulo.innerText = '¡Proceso Exitoso!';
        titulo.className = 'fw-bold mb-2 text-success';
        mensaje.innerHTML = data.mensaje;
        } else {
        iconoContenedor.className = 'bg-danger rounded-circle d-flex align-items-center justify-content-center shadow-sm mx-auto mb-3';
        iconoClase.className = 'fa-solid fa-circle-xmark fa-2x text-white';
        titulo.innerText = 'Sincronización Interrumpida';
        titulo.className = 'fw-bold mb-2 text-danger';
        mensaje.innerHTML = data.mensaje;
            
        // Si falló, reactivamos el botón original en el fondo
        btn.disabled = false;
        btn.innerHTML = btnHtmlOriginal;
        }
        
        // Detonamos el modal nativo en lugar del alert plano
        new bootstrap.Modal(document.getElementById('modalResultadoStripe')).show();
        })
        .catch(error => {
        let iconoContenedor = document.getElementById('stripeIconoContenedor');
        let iconoClase = document.getElementById('stripeIconoClase');
        let titulo = document.getElementById('stripeTituloRespuesta');
        let mensaje = document.getElementById('stripeMensajeRespuesta');
        
        iconoContenedor.className = 'bg-danger rounded-circle d-flex align-items-center justify-content-center shadow-sm mx-auto mb-3';
        iconoClase.className = 'fa-solid fa-wifi-slash fa-2x text-white';
        titulo.innerText = 'Error de Red';
        mensaje.innerHTML = 'No se pudo establecer comunicación estable con el servidor de la organización.';
        
        new bootstrap.Modal(document.getElementById('modalResultadoStripe')).show();
        });
    }
</script>

