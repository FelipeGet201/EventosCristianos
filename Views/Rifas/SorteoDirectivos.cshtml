@model RedAJP.Models.SorteoDirectivosViewModel
@using RedAJP.Globales
@{
    Layout = "_LayoutRifasOficiales";
    ViewBag.Title = "Sorteo Directivos — " + Model.InfoRifa.Titulo;
}

<style>
    .sorteo-header {
        background: linear-gradient(135deg, #2b32b2 0%, #1488cc 100%);
        border-radius: 16px;
        padding: 1.5rem;
        color: #fff;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 12px rgba(20,136,204,0.3);
    }
    
    .status-badge {
        font-size: 0.85rem;
        padding: 0.5rem 1rem;
        border-radius: 50rem;
        font-weight: 700;
        background: rgba(255,255,255,0.2);
        color: #fff;
    }

    .card-proceso {
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        overflow: hidden;
    }
    
    .card-proceso .card-header {
        background: #f8f9fa;
        border-bottom: 1px solid #e2e8f0;
        padding: 1.25rem 1.5rem;
        font-weight: 700;
        color: #2d3748;
    }

    .candidato-box {
        background: #ebf4ff;
        border: 2px solid #3182ce;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .candidato-box .ticket-num {
        font-size: 2.5rem;
        font-weight: 900;
        color: #2b6cb0;
        line-height: 1;
        margin-bottom: 0.5rem;
    }

    .confirmacion-item {
        display: flex;
        align-items: center;
        padding: 1rem;
        border-radius: 10px;
        background: #f8f9fa;
        margin-bottom: 0.5rem;
        border: 1px solid #e2e8f0;
    }
    
    .confirmacion-item.success {
        background: #f0fff4;
        border-color: #9ae6b4;
    }
    
    .circle-check {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #48bb78;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1rem;
        font-size: 1.2rem;
    }
    
    .circle-pending {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #e2e8f0;
        color: #a0aec0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1rem;
    }

    .btn-confirmar {
        background: #48bb78;
        color: white;
        font-weight: 700;
        padding: 0.8rem 2rem;
        border-radius: 50rem;
        border: none;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(72,187,120,0.3);
    }
    .btn-confirmar:hover { background: #38a169; transform: translateY(-1px); }
    .btn-confirmar:disabled { background: #a0aec0; box-shadow: none; transform: none; cursor: not-allowed; }

    .nav-tabs .nav-link {
        font-weight: 600;
        color: #718096;
        border: none;
        border-bottom: 3px solid transparent;
        padding: 1rem 1.5rem;
    }
    .nav-tabs .nav-link.active {
        color: #3182ce;
        border-bottom-color: #3182ce;
        background: transparent;
    }

    .winner-box {
        background: linear-gradient(135deg, #f6e05e 0%, #d69e2e 100%);
        border-radius: 16px;
        padding: 2rem;
        color: #744210;
        text-align: center;
        box-shadow: 0 10px 25px rgba(214,158,46,0.3);
    }
    .winner-box .icon { font-size: 4rem; margin-bottom: 1rem; }
    .winner-box .ticket { font-size: 3rem; font-weight: 900; line-height: 1; }
    .winner-box .name { font-size: 1.5rem; font-weight: 700; margin-top: 0.5rem; }
</style>

<div class="sorteo-header d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div>
        <h5 class="fw-bold mb-1"><i class="fa-solid fa-trophy me-2"></i>Sorteo Formal y Ganador</h5>
        <p class="mb-0 text-white-50 small">@Model.InfoRifa.Titulo</p>
    </div>
    <div>
        @if (Model.YaTieneGanador)
        {
            <span class="status-badge bg-success bg-opacity-25"><i class="fa-solid fa-check-circle me-1"></i> FINALIZADA — @(Model.Modalidad ?? "PLATAFORMA")</span>
        }
        else if (Model.HayProcesoEnCurso)
        {
            <span class="status-badge bg-warning text-dark"><i class="fa-solid fa-spinner fa-spin me-1"></i> EN PROCESO (@Model.TotalConfirmaciones/3)</span>
        }
        else
        {
            <span class="status-badge"><i class="fa-solid fa-hourglass-start me-1"></i> ESPERANDO SORTEO</span>
        }
    </div>
</div>

@if (Model.YaTieneGanador)
{
    <!-- ESTADO: YA HAY GANADOR -->
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="winner-box">
                <i class="fa-solid fa-crown icon"></i>
                <div class="text-uppercase fw-bold mb-2">Boleto Ganador Oficial</div>
                <div class="ticket">#@Model.NumeroGanador.ToString("D4")</div>
                <div class="name">@Model.NombreGanador</div>
                
                <div class="mt-4 pt-3 border-top border-dark border-opacity-10 text-start">
                    <p class="mb-1"><i class="fa-solid fa-gavel me-2"></i> <strong>Modalidad:</strong> Sorteo por @(Model.Modalidad == "MANUAL" ? "Tómbola Física (MANUAL)" : "Plataforma")</p>
                    @if (Model.FechaConfirmadoGanador.HasValue)
                    {
                        <p class="mb-0"><i class="fa-regular fa-calendar-check me-2"></i> <strong>Confirmado el:</strong> @Model.FechaConfirmadoGanador.Value.ToString("dd MMM yyyy, HH:mm")</p>
                    }
                </div>
            </div>

            @if (Model.Modalidad != "MANUAL" && Model.Confirmaciones.Any())
            {
                <div class="card card-proceso mt-4">
                    <div class="card-header"><i class="fa-solid fa-file-signature me-2"></i>Historial de Autorizaciones</div>
                    <div class="card-body p-4">
                        @for (int i = 0; i < Model.Confirmaciones.Count; i++)
                        {
                            var c = Model.Confirmaciones[i];
                            <div class="confirmacion-item success">
                                <div class="circle-check"><i class="fa-solid fa-check"></i></div>
                                <div>
                                    <div class="fw-bold">@c.NombreUsuario</div>
                                    <div class="text-muted small">Confirmó el @c.FechaConfirmacion.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
else if (Model.HayProcesoEnCurso)
{
    <!-- ESTADO: PROCESO PLATAFORMA EN CURSO -->
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card card-proceso">
                <div class="card-header bg-primary text-white border-0">
                    <i class="fa-solid fa-shield-halved me-2"></i> Proceso de Autorización en Curso
                </div>
                <div class="card-body p-4">
                    
                    <div class="candidato-box">
                        <div class="text-uppercase fw-bold text-muted mb-2">Boleto Candidato a Ganador</div>
                        <div class="ticket-num">#@Model.NumeroCandidato.ToString("D4")</div>
                        <div class="fs-5 fw-semibold text-dark">@Model.NombreCandidato</div>
                    </div>

                    <h6 class="fw-bold mb-3">Progreso de Firmas Directivas (3 requeridas)</h6>
                    
                    <!-- Mostrar confirmaciones existentes -->
                    @for (int i = 0; i < 3; i++)
                    {
                        if (i < Model.Confirmaciones.Count)
                        {
                            var c = Model.Confirmaciones[i];
                            <div class="confirmacion-item success">
                                <div class="circle-check"><i class="fa-solid fa-check"></i></div>
                                <div>
                                    <div class="fw-bold">@c.NombreUsuario</div>
                                    <div class="text-muted small">Confirmó el @c.FechaConfirmacion.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="confirmacion-item">
                                <div class="circle-pending"><i class="fa-solid fa-hourglass-half"></i></div>
                                <div class="text-muted fw-bold">Esperando firma directiva...</div>
                            </div>
                        }
                    }

                    <hr class="my-4" />

                    <div class="text-center">
                        @if (Model.UsuarioActualYaConfirmo)
                        {
                            <div class="alert alert-success d-inline-block">
                                <i class="fa-solid fa-circle-check me-2"></i> Ya has firmado este sorteo. Esperando a otros directivos.
                            </div>
                        }
                        else
                        {
                            <p class="text-danger small fw-bold mb-3">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i> Al confirmar, declaras formalmente este boleto como ganador legítimo. Esta acción no se puede deshacer.
                            </p>
                            <!-- El token anti-forgery debe estar en un form o se enviará por separado -->
                            <form id="formConfirmarProceso">
                                @Html.AntiForgeryToken()
                                <button type="button" class="btn-confirmar" id="btnConfirmarProceso" data-boleto="@Model.IdBoletoCandidato">
                                    <i class="fa-solid fa-pen-nib me-2"></i> Firmar y Confirmar Ganador
                                </button>
                            </form>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- ESTADO: INICIO (NUEVO SORTEO) -->
    <div class="card card-proceso">
        <div class="card-header p-0">
            <ul class="nav nav-tabs border-0" id="sorteoTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="plataforma-tab" data-bs-toggle="tab" data-bs-target="#plataforma" type="button" role="tab">
                        <i class="fa-solid fa-laptop me-2"></i> Sorteo por Plataforma (Requiere 3 Firmas)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="manual-tab" data-bs-toggle="tab" data-bs-target="#manual" type="button" role="tab">
                        <i class="fa-solid fa-box-open me-2"></i> Sorteo Manual / Tómbola
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-4">
            <div class="tab-content" id="sorteoTabsContent">
                
                <!-- TAB: PLATAFORMA -->
                <div class="tab-pane fade show active" id="plataforma" role="tabpanel">
                    <div class="row align-items-center">
                        <div class="col-md-5">
                            <img src="/img/illustrations/secure.svg" class="img-fluid opacity-50 p-4" alt="Seguridad" onerror="this.style.display='none'" />
                            <div class="text-center text-muted small">
                                <p><i class="fa-solid fa-lock me-1"></i> Proceso validado por 3 directivos independientes.</p>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <h4 class="fw-bold text-primary mb-3">Iniciar Proceso de Autorización</h4>
                            <p class="text-muted mb-4">Selecciona el boleto ganador obtenido. Al iniciar el proceso, tu firma será la primera registrada. Se requerirán 2 directivos adicionales para finalizar el sorteo.</p>
                            
                            <form id="formIniciarPlataforma">
                                @Html.AntiForgeryToken()
                                <div class="form-group mb-4">
                                    <label class="fw-bold mb-2">Selecciona el Boleto Ganador:</label>
                                    <select id="selBoletoPlataforma" class="form-select form-select-lg">
                                        <option value="">-- Buscar boleto --</option>
                                        @foreach(var b in Model.BoletosDisponibles)
                                        {
                                            <option value="@b.Id_Boleto">#@b.Numero.ToString("D4") — @b.Comprador</option>
                                        }
                                    </select>
                                </div>

                                <button type="button" class="btn-confirmar w-100" id="btnIniciarPlataforma">
                                    <i class="fa-solid fa-pen-nib me-2"></i> Iniciar Proceso y Firmar (1/3)
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- TAB: MANUAL -->
                <div class="tab-pane fade" id="manual" role="tabpanel">
                    <div class="row align-items-center">
                        <div class="col-md-5">
                            <img src="/img/illustrations/winner.svg" class="img-fluid opacity-50 p-4" alt="Tómbola" onerror="this.style.display='none'" />
                        </div>
                        <div class="col-md-7">
                            <h4 class="fw-bold text-warning mb-3">Registro de Sorteo Físico</h4>
                            <p class="text-muted mb-4">Utiliza esta opción ÚNICAMENTE si la rifa se llevó a cabo mediante tómbola física fuera del sistema. Esto cerrará la rifa inmediatamente con tu única firma responsable.</p>
                            
                            <form action="@Url.Action("RegistrarSorteoManual", "Rifas")" method="post" id="formManual">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idRifa" value="@Model.IdRifaEncriptado" />
                                
                                <div class="form-group mb-4">
                                    <label class="fw-bold mb-2">Boleto extraído de la tómbola:</label>
                                    <select name="idBoleto" id="selBoletoManual" class="form-select form-select-lg" required>
                                        <option value="">-- Buscar boleto --</option>
                                        @foreach(var b in Model.BoletosDisponibles)
                                        {
                                            <option value="@b.Id_Boleto">#@b.Numero.ToString("D4") — @b.Comprador</option>
                                        }
                                    </select>
                                </div>

                                <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold shadow-sm" id="btnRegistrarManual">
                                    <i class="fa-solid fa-gavel me-2"></i> Registrar Ganador Oficial
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Inicializar Select2 para búsqueda rápida de boletos
            if ($.fn.select2) {
                $('#selBoletoPlataforma, #selBoletoManual').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: '-- Buscar por número o nombre --'
                });
            }

            // Confirmación PLATAFORMA (Inicio o Continuación)
            $('#btnIniciarPlataforma, #btnConfirmarProceso').click(function () {
                var btn = $(this);
                var isInicio = btn.attr('id') === 'btnIniciarPlataforma';
                
                var idBoleto = isInicio ? $('#selBoletoPlataforma').val() : btn.data('boleto');
                
                if (!idBoleto) {
                    Swal.fire('Atención', 'Debes seleccionar un boleto.', 'warning');
                    return;
                }

                Swal.fire({
                    title: 'Firma Directiva',
                    text: '¿Estás seguro de confirmar este boleto como ganador? Esta acción quedará registrada bajo tu usuario y no se puede deshacer.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#48bb78',
                    cancelButtonColor: '#a0aec0',
                    confirmButtonText: 'Sí, firmar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        
                        btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-2"></i> Procesando...');

                        $.post('@Url.Action("ConfirmarSorteoDirectivos", "Rifas")', {
                            idRifa: '@Model.IdRifaEncriptado',
                            idBoleto: idBoleto,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() || $('form input[name="__RequestVerificationToken"]').val() || ''
                        }, function (res) {
                            if (res.exito) {
                                Swal.fire({
                                    title: res.esGanadorFinal ? '¡Sorteo Finalizado!' : 'Firma Registrada',
                                    text: res.mensaje,
                                    icon: 'success',
                                    allowOutsideClick: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', res.mensaje, 'error');
                                btn.prop('disabled', false).html('<i class="fa-solid fa-pen-nib me-2"></i> Firmar');
                            }
                        }).fail(function () {
                            Swal.fire('Error', 'Error de red al procesar la solicitud.', 'error');
                            btn.prop('disabled', false).html('<i class="fa-solid fa-pen-nib me-2"></i> Firmar');
                        });
                    }
                });
            });

            // Confirmación MANUAL
            $('#formManual').submit(function (e) {
                var form = this;
                e.preventDefault();

                if (!$('#selBoletoManual').val()) {
                    Swal.fire('Atención', 'Debes seleccionar el boleto ganador.', 'warning');
                    return;
                }

                Swal.fire({
                    title: 'Registro de Sorteo Manual',
                    text: 'Se registrará este boleto como GANADOR INMEDIATO de la rifa. Esta acción cerrará la rifa. ¿Confirmar?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d69e2e',
                    cancelButtonColor: '#a0aec0',
                    confirmButtonText: 'Sí, registrar ganador',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#btnRegistrarManual').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-2"></i> Registrando...');
                        form.submit();
                    }
                });
            });
        });
    </script>
}
