@model RedAJP.Models.ReciboViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Recibo - @Model.Folio</title>
    <link href="~/lib/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css">

    <style>
            /* --- ESTILOS GENERALES --- */
            body {
                background-color: #e9ecef;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .ticket-container {
                max-width: 800px;
                margin: 40px auto;
                background: white;
                position: relative;
                box-shadow: 0 15px 35px rgba(0,0,0,0.15);
                border-radius: 12px;
                overflow: hidden;
            }

            .header-ticket {
                background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
                color: white;
                padding: 30px;
                text-align: center;
                border-bottom: 4px solid #f59e0b;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .logo-img {
                height: 90px;
                width: 90px;
                object-fit: cover;
                border: 3px solid rgba(255,255,255,0.2);
                padding: 2px;
                background: white;
                border-radius: 50%;
            }

            .body-ticket {
                padding: 40px;
            }

            .dato-row {
                border-bottom: 1px solid #f1f1f1;
                padding: 12px 0;
            }

                .dato-row:last-child {
                    border-bottom: none;
                }

            .label {
                font-size: 0.75rem;
                text-transform: uppercase;
                color: #6c757d;
                font-weight: 700;
                letter-spacing: 0.5px;
            }

            .valor {
                font-size: 1.1rem;
                color: #212529;
                font-weight: 500;
            }

            .total-box {
                background-color: #f8f9fa;
                border: 1px solid #dee2e6;
                border-radius: 8px;
                padding: 25px 15px;
                text-align: center;
                box-shadow: inset 0 0 10px rgba(0,0,0,0.02);
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .qr-area {
                margin-top: 25px;
                display: flex;
                flex-direction: column;
                align-items: center;
                padding: 15px;
                background: #fff;
                border: 1px solid #eee;
                border-radius: 8px;
            }

            .btn-print-float {
                position: fixed;
                bottom: 30px;
                right: 30px;
                z-index: 1000;
                box-shadow: 0 4px 15px rgba(0,0,0,0.3);
                transition: transform 0.2s;
            }

                .btn-print-float:hover {
                    transform: scale(1.1);
                }

            /* --- ESTILOS IMPRESIÓN --- */
            @@media print {
                @@page {
                    margin: 0;
                    size: auto;
                }

                body {
                    background: white;
                    margin: 0;
                    padding: 0;
                }

                .ticket-container {
                    box-shadow: none;
                    margin: 20px auto; /* Un poco de margen para que no se corte */
                    width: 100%;
                    max-width: 100%;
                    /* AQUI ESTA EL CAMBIO: Borde sólido visible al imprimir */
                    border: 1px solid #ccc;
                    border-radius: 0;
                }

                .header-ticket {
                    background: #1f2937 !important;
                    color: white !important;
                    padding: 20px;
                }

                .total-box {
                    background-color: #f0f0f0 !important;
                    border: 1px solid #ddd;
                }

                .btn-print-float, .no-print {
                    display: none !important;
                }
            }
    </style>
</head>
<body>

    <button onclick="window.print()" class="btn btn-dark btn-lg rounded-circle p-4 btn-print-float" title="Imprimir">
        <i class="fa-solid fa-print fa-xl"></i>
    </button>

    <div class="container">
        <div class="ticket-container">

            <div class="header-ticket">
                <img src="/Images/logo_ajp.jpg" class="rounded-circle mb-3 shadow-sm logo-img" alt="Logo">
                <h2 class="fw-bold mb-0 text-uppercase" style="letter-spacing: 1px;">Recibo de Pago</h2>
                <p class="mb-0 opacity-75 small">ICIAR | AJP</p>
            </div>

            <div class="body-ticket">
                <div class="row">
                    <div class="col-7">
                        <div class="dato-row">
                            <div class="label">Folio de Operación</div>
                            <div class="valor font-monospace text-break">@Model.Folio</div>
                        </div>
                        <div class="dato-row">
                            <div class="label">Evento</div>
                            <div class="valor">@Model.Evento</div>
                        </div>
                        <div class="dato-row">
                            <div class="label">Participante</div>
                            <div class="valor fw-bold">@Model.Asistente</div>
                        </div>
                        
                        <div class="dato-row">
                            <div class="label">Modalidad</div>
                            <div class="valor">@(string.IsNullOrEmpty(Model.Modalidad) ? "Entrada General" : Model.Modalidad)</div>
                        </div>

                        <div class="dato-row">
                            <div class="label">Concepto Cubierto</div>
                            <div class="valor">
                                @Model.Concepto 
                                @if (Model.NumeroPago > 0)
                                {
                                    <span class="badge bg-light text-dark border ms-1">Pago #@Model.NumeroPago</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-25 text-dark border border-warning ms-1">Adicional</span>
                                }
                            </div>
                        </div>
                        <div class="dato-row">
                            <div class="label">Fecha y Hora de Emisión</div>
                            <div class="valor">@Model.FechaPago.ToString("dd/MM/yyyy") &bull; @Model.FechaPago.ToString("hh:mm tt")</div>
                        </div>

                        @if (Model.Descuento > 0)
                        {
                            <div class="dato-row border-0 pt-3">
                                <div class="alert alert-success bg-opacity-10 border-success border-opacity-25 p-2 mb-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <small class="text-uppercase fw-bold text-success" style="font-size: 0.65rem;">Cupón Aplicado</small>
                                            <div class="fw-bold text-dark small">@(Model.CodigoCupon ?? "PROMOCIÓN")</div>
                                        </div>
                                        <div class="fs-5 fw-bold text-success">-$@Model.Descuento.ToString("N2")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-5">
                        <div class="total-box mb-3">
                            <div class="label text-success mb-2">Total Pagado</div>
                            <div class="display-6 fw-bold text-success text-nowrap">$@Model.Monto.ToString("N2")</div>
                            <small class="text-muted fw-bold mt-2 d-block" style="font-size: 0.7rem;">PESOS MEXICANOS (MXN)</small>
                        </div>

                        <div class="qr-area">
                            <div id="qrcode"></div>
                            <small class="text-muted mt-2 text-center" style="font-size: 0.65rem; line-height: 1.2;">
                                <i class="fa-solid fa-shield-halved me-1"></i> Código de seguridad digital para validación de autenticidad.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="mt-5 text-center border-top pt-4">
                    <p class="text-muted small mb-1 fst-italic">"Gracias por tu aportación. Este documento sirve como comprobante de inscripción."</p>
                    <p class="text-muted small font-monospace" style="font-size: 0.6rem;">ID UNICO: @Guid.NewGuid().ToString().ToUpper().Substring(0, 12)</p>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/qrcode/qrcode.min.js"></script>

    <script>
        // SOLUCIÓN OPTIMIZADA:
        // Usamos solo la URL para garantizar que el QR sea ligero,
        // escanee rápido y NUNCA de error de "overflow" (límite de caracteres).

        var textoQR = "@Html.Raw(Model.UrlValidacion)";

        new QRCode(document.getElementById("qrcode"), {
        text: textoQR,
        width: 110,
        height: 110,
        colorDark : "#000000",
        colorLight : "#ffffff",
        correctLevel : QRCode.CorrectLevel.L // 'L' (Low) es ideal para tramas simples como una URL
        });
    </script>
</body>
</html>