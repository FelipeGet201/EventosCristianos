@model RedAJP.Models.IglesiaWebPublicaViewModel

<header class="fade-in-up" style="padding: 8rem 0; background: radial-gradient(circle at top right, var(--theme-surface), var(--theme-bg) 60%);">
    <div class="container text-center text-lg-start">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="mb-4 d-inline-flex align-items-center shadow-sm" style="background-color: var(--theme-surface); padding: 0.5rem 1.2rem; border-radius: 50px; font-family: var(--theme-font-body); font-weight: 600; color: var(--theme-text-muted); border: 1px solid rgba(128, 128, 128, 0.2);">
                    <i class="fa-solid fa-map-pin me-2" style="color: var(--theme-accent);"></i> @(string.IsNullOrWhiteSpace(Model.Municipio) ? "Ubicación" : Model.Municipio)
                </div>
                <h1 style="font-family: var(--theme-font-title); font-size: clamp(3rem, 7vw, 5.5rem); font-weight: 800; color: var(--theme-primary); line-height: 1.1; margin-bottom: 1.5rem;">
                    @Model.NombreIglesia
                </h1>
                <p class="fs-4 mb-5" style="font-family: var(--theme-font-body); color: var(--theme-text-muted); max-width: 600px;">
                    Descubre lo que vivimos como congregación. Encuentra aquí nuestra agenda, historia y mensajes.
                </p>
                <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
                    <a href="#actividad" class="btn" style="background: var(--theme-accent); color: var(--theme-bg); font-family: var(--theme-font-title); font-weight: bold; padding: 1rem 2rem; border-radius: 50px;">Ver Eventos</a>
                </div>
            </div>
        </div>
    </div>
</header>