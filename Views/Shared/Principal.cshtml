@using RedAJP.Globales
@using RedAJP.Services;
@inject ISolicitudesService SolicitudesSvc
@{
    // =========================================================================
    // 1. LÓGICA DE SERVIDOR (Permisos y Roles)
    // =========================================================================   
    int nIdUsuario = 0;
    if (User.Identity.IsAuthenticated)
    {
        var claimId = User.FindFirst("IdUsuario");
        if (claimId != null)
        {
            nIdUsuario = int.Parse(claimId.Value);
        }
    }

    bool bOcultarMascotaVista = ViewBag.bOcultarMascota != null && ViewBag.bOcultarMascota == true;
    bool p_Caja = User.TienePermiso(Parametros.Modulos.Caja, Parametros.Permisos.Leer);
    bool p_Usuarios = User.TienePermiso(Parametros.Modulos.Usuarios, Parametros.Permisos.Leer);
    bool p_Grupos = User.TienePermiso(Parametros.Modulos.Grupos, Parametros.Permisos.Leer);
    bool p_Roles = User.TienePermiso(Parametros.Modulos.Roles, Parametros.Permisos.Leer);
    bool p_ValidaTransferencias = User.TienePermiso(Parametros.Modulos.Eventos, Parametros.Permisos.Admin);
    bool p_Visitas = User.TienePermiso(Parametros.Modulos.Visitas, Parametros.Permisos.Leer);
    bool p_Encuestas = User.TienePermiso(Parametros.Modulos.Encuestas, Parametros.Permisos.Leer);
    bool p_GeneradorQR = User.TienePermiso(Parametros.Modulos.GeneradorQR, Parametros.Permisos.Leer);
    bool p_Biblioteca = User.TienePermiso(Parametros.Modulos.Biblioteca, Parametros.Permisos.Leer);
    bool p_Cupones = User.TienePermiso(Parametros.Modulos.Cupones, Parametros.Permisos.Leer);
    bool p_AlertasCorreos = User.TienePermiso(Parametros.Modulos.AlertasCorreos, Parametros.Permisos.Leer);
    bool p_Colores = User.TienePermiso(Parametros.Modulos.Colores, Parametros.Permisos.Leer);
    bool p_Comunidad = User.TienePermiso(Parametros.Modulos.Comunidad, Parametros.Permisos.Leer);
    bool p_PuedeVerDatosStripe = User.TienePermiso(Parametros.Modulos.CuentasStripe, Parametros.Permisos.Leer);
    bool p_PuedeVerEstadisticas = User.TienePermiso(Parametros.Modulos.Estadisticas, Parametros.Permisos.Leer);

    bool esMiembro = User.Identity!.IsAuthenticated;
    bool p_Material = esMiembro;
    bool p_Formatos = User.TienePermiso(Parametros.Modulos.Material, Parametros.Permisos.Leer); ;
    bool verMenuHerramientas = p_Visitas || p_Material || p_Formatos || p_Encuestas || p_GeneradorQR || p_Colores || p_Biblioteca || p_Cupones;
    bool verMenuGestion = p_Caja || p_Usuarios || p_Grupos || p_Roles || p_ValidaTransferencias || p_AlertasCorreos || p_PuedeVerEstadisticas || p_PuedeVerDatosStripe;

    string inicialUsuario = esMiembro && User.Identity != null && !string.IsNullOrEmpty(User.Identity.Name) ? User.Identity.Name.Trim().Substring(0, 1).ToUpper() : "U";

    int nContadorAlertasGestion = 0;
    int nContadorAlertasMovilAgrup = 0;

    int nTransferenciasPendientes = 0;
    if (esMiembro && p_ValidaTransferencias)
    {
        nTransferenciasPendientes = await SolicitudesSvc.ObtenerContadorTransferenciasPendAsync();
    }    
    nContadorAlertasGestion += nTransferenciasPendientes;

    nContadorAlertasMovilAgrup = nContadorAlertasGestion;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#4A1212">
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
    <title>@ViewData["Title"] - Eventos Cristianos</title>
    <link rel="icon" type="image/png" href="~/Images/favicon.ico">
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />

    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/estilos_pagina.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">
    <style>
        /* Prevenir desbordamiento horizontal global causado por la animación */
        html, body {
            overflow-x: hidden;
            max-width: 100vw;
            width: 100%;
        }
        /* Asegurar que el mar no genere scroll */
        #mar-animado {
            overflow: hidden;
            max-width: 100vw;
        }
        /* Estilo para el número sobre el candado de Gestión (Desktop) */
        .navbar-nav .nav-link i.position-relative .badge-dinamico {
            position: absolute;
            top: -10px;
            right: -12px;
            background-color: var(--acento-coral);
            color: white;
            font-size: 0.6rem;
            padding: 2px 5px;
            border-radius: 50px;
            border: 2px solid var(--header-footer);
            font-weight: bold;
            line-height: 1;
            min-width: 16px;
            text-align: center;
            z-index: 5;
        }

        /* Asegura que el icono de Gestión permita posicionamiento absoluto interno */
        #menu-gestion i {
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
        }
              

        .ajp-corto{
            display: block;
        }
        .ajp-largo{
            display: none;
        }


        @@media (max-width: 991px) {
            .ajp-corto {
                display: none;
            }
            .ajp-largo {
                display: block;
            }
            .letra-nombre{
                margin-left: 0.5rem;
            }
            .navbar-nav {
                text-align: center;
            }
                /* APLICAR BORDES SOLO A LOS ÍTEMS DE NIVEL SUPERIOR */
                /* El selector '>' asegura que solo afecte a los hijos directos del menú principal */
                .navbar-nav > .nav-item {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    border-left: none !important;
                    padding: 10px 0;
                }
            /* QUITAR BORDES EN LOS ÍTEMS DENTRO DE DROPDOWNS */
            .dropdown-menu .dropdown-item {
                border-bottom: none !important; /* Limpia las líneas internas */
                padding: 10px 15px; /* Espaciado cómodo para el dedo */
            }

            .dropdown-menu {
                min-width: 250px;
                text-align: center;
                background-color: rgba(255, 255, 255, 0.05);
                border: none;
                padding: 0; /* Quitar padding extra del contenedor */
            }
            /* Mantener el <hr> funcional dentro de los dropdowns (para tus separadores lógicos) */
            .dropdown-divider {
                border-top: 1px solid rgba(255,255,255,0.2) !important;
                margin: 0.5rem 0;
            }

            .navbar-nav .nav-link i.position-relative .badge-dinamico {
                top: -5px;
                right: -15px;
            }

            .user-avatar-btn {
                justify-content: center !important;
            }
        }        

        @@media (max-width: 770px) {
            .ajp-corto {
                display: block;
            }
            .ajp-largo {
                display: none;
            }
        }  
        /* Estilo del botón "Ojo" Para contraseñas */
        .ojo-global-btn {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #6c757d;
            cursor: pointer;
            z-index: 10;
            padding: 0;
            display: flex;
            align-items: center;
            transition: color 0.3s;
        }

            .ojo-global-btn:hover {
                color: var(--primary-dark);
            }

        /* Clase para dar espacio al texto y que no choque con el icono */
        .input-con-ojo-padding {
            padding-right: 45px !important;
        }

        /* Aseguramos posicionamiento relativo en el padre */
        .contenedor-ojo-relativo {
            position: relative !important;
        }
    </style>
