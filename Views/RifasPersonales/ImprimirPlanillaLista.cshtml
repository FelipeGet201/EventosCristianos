@model List<List<RedAJP.Models.BoletoPersonalViewModel>>
@{
    Layout = null;
    string nombreMostrar = ViewBag.NombreMostrar as string ?? "Vendedor";
    
    if (nombreMostrar.Contains("Mi Cuenta") || nombreMostrar.Contains("Venta Directa"))
    {
        string miNombre = User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name ?? "Administrador";
        nombreMostrar = miNombre + " (Venta Directa)";
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Planilla Lista - @nombreMostrar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <style>
        /* ESTO ELIMINA EL URL Y FECHA DEL NAVEGADOR AL IMPRIMIR */
        @@page { 
            size: auto; 
            margin: 0mm; 
        }

        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f1f5f9; 
            color: #0f172a; 
            padding: 20px;
        }
        
        .print-container { 
            max-width: 900px;
            margin: 0 auto; 
            background: white; 
            padding: 30px; 
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }
        
        .hoja-impresion { 
            page-break-after: always;
            padding-bottom: 1.5rem; 
            margin-bottom: 2rem; 
            border-bottom: 3px dashed #cbd5e1; 
        }
        .hoja-impresion:last-child { 
            page-break-after: auto;
            border-bottom: none; 
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .header-planilla {
            border-bottom: 3px solid #0ea5e9;
            padding-bottom: 0.8rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: flex-start;
            gap: 1rem;
        }

        .img-rifa {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 8px;
            border: 2px solid #e0f2fe;
            flex-shrink: 0;
        }
        
        .header-info {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .header-meta {
            text-align: right;
            min-width: 180px;
            font-size: 0.85rem;
            background-color: #f8fafc;
            padding: 0.5rem;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
        }

        /* DISEÑO DE LA TABLA/LISTA CON LÍNEAS GUÍA SEPARADAS */
        .list-table {
            width: 100%;
            border-collapse: separate; /* Clave para separar las líneas */
            border-spacing: 0 12px; /* Espacio vertical entre cada fila */
        }
        
        .list-table th {
            text-align: left;
            padding-bottom: 0.3rem;
            color: #475569;
            text-transform: uppercase;
            font-size: 0.8rem;
            border-bottom: 2px solid #cbd5e1;
            padding-left: 5px;
        }
        
        .list-table td {
            vertical-align: bottom;
            padding: 0; /* Quitamos padding para usar los divs internos */
        }
        
        /* Cajas de escritura independientes */
        .line-box {
            border-bottom: 1.5px solid #64748b;
            height: 32px;
            margin-right: 15px; /* Crea el espacio físico entre columnas */
            position: relative;
            background: linear-gradient(to top, #f8fafc 0%, transparent 8px); /* Sombreado sutil */
        }

        /* El "tope" o marca vertical al final de la línea */
        .line-box::after {
            content: '';
            position: absolute;
            right: 0;
            bottom: -1.5px;
            height: 8px;
            border-right: 1.5px solid #64748b;
        }

        /* Modificador si el boleto ya se vendió */
        .line-box.sold {
            border-bottom-color: #22c55e;
            background: none;
        }
        .line-box.sold::after {
            border-right-color: #22c55e;
        }

        .col-num { width: 80px; text-align: center;}
        .col-name { width: 45%; }
        .col-tel { width: 25%; }
        .col-notes { width: auto; }

        .ticket-num-badge { 
            background: #0ea5e9;
            color: white; 
            font-weight: 900; 
            font-size: 1.1rem;
            padding: 0.3rem 0;
            border-radius: 6px;
            display: inline-block;
            width: 85%;
            transform: translateY(2px);
        }

        .ticket-num-badge.vendido {
            background-color: #22c55e;
        }

        .filled-text {
            font-weight: 700;
            color: #0f172a;
            font-size: 14px;
            position: absolute;
            bottom: 3px;
            left: 5px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 95%;
        }

        @@media print {
            body { 
                background: white; 
                padding: 1.5cm; /* Margen real para la impresora */
            }
            .print-container { box-shadow: none; margin: 0; padding: 0; max-width: 100%; }
            .btn-imprimir { display: none !important; }
            .hoja-impresion { border-bottom: none; }
        }
    </style>
</head>
<body>

    <div class="print-container">
        <div class="d-flex justify-content-end mb-3 btn-imprimir gap-2">
            <a href="@Url.Action("PanelAdministracion", "RifasPersonales", new { token = ViewBag.TokenRifaStr })" class="btn btn-outline-danger shadow-sm fw-bold me-auto">
                <i class="fa-solid fa-arrow-left me-2"></i> Volver al Panel
            </a>
            <a href="@Url.Action("ImprimirPlanilla", "RifasPersonales", new { tokenRifa = ViewBag.TokenRifaStr, idDestino = ViewBag.IdDestino, externo = ViewBag.Externo, nombreMostrar = ViewBag.NombreMostrar })" class="btn btn-outline-secondary shadow-sm fw-bold">
                <i class="fa-solid fa-border-all me-2"></i> Cambiar a Formato Tarjetas
            </a>
            <button onclick="window.print()" class="btn btn-primary shadow-sm fw-bold">
                <i class="fa-solid fa-print me-2"></i> Imprimir Planillas
            </button>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-warning text-center">
                <i class="fa-solid fa-circle-exclamation fs-3 mb-2 d-block"></i>
                No hay boletos asignados para generar la planilla.
            </div>
        }
        else
        {
            foreach (var hoja in Model)
            {
                var primerBoleto = hoja.OrderBy(b => b.Numero).First();
                var ultimoBoleto = hoja.OrderBy(b => b.Numero).Last();
                string rangoBoletos = $"#{primerBoleto.Numero.ToString("000")} al #{ultimoBoleto.Numero.ToString("000")}";
                string fechaAsignacion = primerBoleto.FechaAsignacion?.ToString("dd/MMM/yyyy") ?? "Sin fecha";

                <div class="hoja-impresion">
                    
                    <div class="header-planilla">
                        @if (!string.IsNullOrEmpty(ViewBag.ImagenUrl))
                        {
                            <img src="@ViewBag.ImagenUrl" alt="Rifa" class="img-rifa" />
                        }
                        else
                        {
                            <div class="img-rifa d-flex align-items-center justify-content-center bg-light text-secondary">
                                <i class="fa-solid fa-ticket fs-2"></i>
                            </div>
                        }
                        
                        <div class="header-info">
                            <h2 class="m-0 text-primary fw-bold" style="font-size: 1.5rem; line-height: 1.2;">@ViewBag.TituloRifa</h2>
                            <p class="m-0 text-dark mt-1" style="font-size: 1.1rem;">
                                <i class="fa-solid fa-user-tag me-1 text-secondary"></i> <strong>Promotor:</strong> @nombreMostrar
                            </p>
                            @if(!string.IsNullOrEmpty(ViewBag.DescripcionRifa))
                            {
                                <p class="m-0 mt-1 text-muted" style="font-size: 0.85rem; line-height: 1.3;">@ViewBag.DescripcionRifa</p>
                            }
                        </div>

                        <div class="header-meta">
                            <div class="text-uppercase fw-bold text-muted mb-1" style="font-size: 0.7rem;">Rango de Boletos</div>
                            <div class="fw-bold text-primary fs-6 mb-2">@rangoBoletos</div>
                            
                            <div class="text-uppercase fw-bold text-muted mb-1" style="font-size: 0.7rem;">Fecha Asignación</div>
                            <div class="fw-bold text-dark"><i class="fa-regular fa-calendar me-1"></i> @fechaAsignacion</div>
                        </div>
                    </div>

                    <table class="list-table">
                        <thead>
                            <tr>
                                <th class="col-num text-center">Boleto</th>
                                <th class="col-name"><i class="fa-solid fa-user me-1"></i> Nombre del Comprador</th>
                                <th class="col-tel"><i class="fa-brands fa-whatsapp me-1 text-success"></i> Teléfono</th>
                                <th class="col-notes"><i class="fa-solid fa-pen me-1"></i> Notas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var boleto in hoja.OrderBy(b => b.Numero))
                            {
                                bool vendido = boleto.Estado == "Vendido";
                                string estadoClass = vendido ? "sold" : "";
                                
                                <tr>
                                    <td class="col-num">
                                        <div class="ticket-num-badge @(vendido ? "vendido" : "")">
                                            #@boleto.Numero.ToString("000")
                                        </div>
                                    </td>
                                    
                                    <td class="col-name">
                                        <div class="line-box @estadoClass">
                                            @if(vendido && !string.IsNullOrEmpty(boleto.NombreComprador)) {
                                                <span class="filled-text">@boleto.NombreComprador</span>
                                            }
                                        </div>
                                    </td>
                                    
                                    <td class="col-tel">
                                        <div class="line-box @estadoClass">
                                            @if(vendido && !string.IsNullOrEmpty(boleto.TelefonoComprador)) {
                                                <span class="filled-text">@boleto.TelefonoComprador</span>
                                            }
                                        </div>
                                    </td>
                                    
                                    <td class="col-notes">
                                        <div class="line-box @estadoClass" style="margin-right: 0;"> @if(vendido && !string.IsNullOrEmpty(boleto.Comentarios)) {
                                                <span class="filled-text">@boleto.Comentarios</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            }
        }
    </div>

</body>
</html>