@model RedAJP.Models.EstatusPedidoViewModel
@{
    Layout = "Principal";
    ViewData["Title"] = "Estado de tu Pedido";

    bool esPendiente = Model.Estado == "Pendiente";
    bool esPagado = Model.Estado == "Pagado";
    bool esCancelado = Model.Estado == "Cancelado";
    bool esPlanilla = ViewBag.EsPlanilla ?? false;
}
<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-rifas');
        }
    });
</script>

<style>
    .card-status {
        border-radius: 20px;
        overflow: hidden;
    }

    .bg-gradient-dark {
        background: linear-gradient(135deg, #212529 0%, #343a40 100%);
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #198754 0%, #20c997 100%);
    }

    .bg-gradient-danger {
        background: linear-gradient(135deg, #dc3545 0%, #f8d7da 100%);
    }

    .pulse-btn {
        animation: pulse-blue 2s infinite;
    }

    @@keyframes pulse-blue {
        0% {
            box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(13, 110, 253, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(13, 110, 253, 0);
        }
    }
</style>

<div class="container py-5 fade-in">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg card-status">
                <div class="card-header border-0 text-center py-5 text-white @(esPagado ? "bg-gradient-success" : (esPendiente ? "bg-gradient-dark" : "bg-gradient-danger"))">
                    <div class="mb-3">
                        @if (esPagado)
                        {
                            <i class="fa-solid fa-circle-check fa-5x"></i>
                        }
                        else if (esPendiente)
                        {
                            if (esPlanilla)
                            {

                                <i class="fa-solid fa-cash-register fa-5x text-warning"></i>
                            }
                            else
                            {

                                <i class="fa-solid fa-clock fa-5x text-warning"></i>
                            }
                        }
                        else
                        {

                            <i class="fa-solid fa-circle-xmark fa-5x"></i>
                        }
                    </div>

                    <h2 class="fw-bold mb-1">
                        @if (esPagado)
                        {
                            <span class="text-white">¡Pago Confirmado!</span>
                        }
                        else if (esPendiente)
                        {
                            if (esPlanilla)
                            {

                                <span>Liquidación de Caja</span>
                            }
                            else
                            {

                                <span>Orden Pendiente</span>
                            }
                        }
                        else
                        {

                            <span>Orden Expirada</span>
                        }
                    </h2>

                    @if (esPendiente && !esPlanilla)
                    {
                        <p class="text-white-50 mb-0 mt-2 small">Tienes 24 horas para completar tu compra.</p>
                    }
                </div>

                <div class="card-body p-5 bg-white">
                    <div class="text-center mb-4">
                        <span class="badge bg-light text-muted border text-uppercase mb-2">Ref: @Model.RefStripe</span>
                        <h4 class="fw-bold text-dark">@Model.TituloRifa</h4>

                        <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-4 mt-3 border">
                            <div class="text-start">
                                <small class="text-muted text-uppercase fw-bold" style="font-size:0.7rem;">Concepto</small>
                                <div class="fw-bold text-dark">
                                    @if (esPlanilla)
                                    {
                                        <span>Ventas Físicas</span>
                                    }
                                    else
                                    {

                                        <span>@Model.Boletos.Count Boletos</span>
                                    }
                                </div>
                            </div>
                            <div class="text-end">
                                <small class="text-muted text-uppercase fw-bold" style="font-size:0.7rem;">Total</small>
                                <div class="fw-bold text-primary fs-4">$@Model.Total.ToString("N2")</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.Boletos.Any() && Model.Boletos.Count < 20)
                    {
                        <div class="mb-4 text-center">
                            <label class="small text-muted fw-bold mb-2">BOLETOS ASIGNADOS:</label>
                            <div class="d-flex flex-wrap gap-2 justify-content-center">
                                @foreach (var num in Model.Boletos)
                                {
                                    <span class="badge bg-dark bg-opacity-75 fs-6 fw-normal px-3 py-2 rounded-pill">#@num.ToString("000")</span>
                                }
                            </div>
                        </div>
                    }

                    <hr class="opacity-10 my-4">

                    <div class="text-center">
                        @if (esPagado)
                        {
                            if (!esPlanilla)
                            {
                                <p class="text-muted small mb-3">Tu comprobante fue enviado a <strong>@Model.Email</strong></p>
                            }
                            @if (User.Identity.IsAuthenticated)
                            {
                                <a href="@Url.Action("MisBoletos")" class="btn btn-dark rounded-pill w-100 py-3 fw-bold shadow">Ir a Mis Boletos</a>
                            }
                            else
                            {

                                <a href="@Url.Action("Index")" class="btn btn-outline-dark rounded-pill w-100 py-3 fw-bold">Volver al Inicio</a>
                            }
                        }
                        else if (esPendiente)
                        {
                            <form action="@Url.Action("IniciarPagoStripe")" method="post" class="mb-3">
                                <input type="hidden" name="token" value="@Model.Token" />
                                <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-lg pulse-btn">
                                    Pagar Ahora <i class="fa-solid fa-arrow-right ms-2"></i>
                                </button>
                            </form>

                            <form id="formCancelarOrden" action="@Url.Action("CancelarOrdenManual")" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="token" value="@Model.Token" />
                                <button type="button" class="btn btn-link text-danger text-decoration-none small mt-2" data-bs-toggle="modal" data-bs-target="#modalConfirmarCancelacion">
                                    @if (ViewBag.EsPlanilla)
                                    {
                                        <span><i class="fa-solid fa-xmark me-1"></i> Cancelar Intento de Pago</span>
                                    }
                                    else
                                    {

                                        <span><i class="fa-solid fa-trash me-1"></i> Cancelar Orden y Liberar Boletos</span>
                                    }
                                </button>
                            </form>
                        }
                        else
                        {
                            <a href="@Url.Action("Index")" class="btn btn-dark rounded-pill w-100 py-3 fw-bold">Ver Nuevas Rifas</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmarCancelacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-body p-4 text-center">
                <div class="mb-3 text-danger"><i class="fa-solid fa-triangle-exclamation fa-3x"></i></div>
                <h5 class="fw-bold text-dark mb-3">¿Cancelar Orden?</h5>
                <p class="small text-muted mb-4">@(ViewBag.EsPlanilla ? "El intento de pago se cancelará, pero podrás intentar liquidar tu saldo de nuevo desde Mis Boletos." : "Se cancelará la orden actual y se liberarán los boletos para otros compradores.")</p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill fw-bold w-50 shadow-sm" data-bs-dismiss="modal">No</button>
                    <button type="button" class="btn btn-danger rounded-pill fw-bold w-50 shadow-sm" onclick="document.getElementById('formCancelarOrden').submit();">Sí, cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>