@model RedAJP.Models.IglesiaWebPublicaViewModel

<style>
    .aviso-sidebar-wrapper {
        background-color: var(--theme-surface);
        border: 1px solid rgba(128, 128, 128, 0.2);
        border-radius: 12px;
        padding: 2rem;
    }

    .aviso-sidebar-item {
        border-bottom: 1px solid rgba(128, 128, 128, 0.2);
        padding-bottom: 1rem;
        margin-bottom: 1rem;
    }

        .aviso-sidebar-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
            margin-bottom: 0;
        }
</style>

<div class="aviso-sidebar-wrapper fade-in-up">
    <h4 class="mb-4 d-flex align-items-center" style="font-family: var(--theme-font-title); font-weight: 800; color: var(--theme-primary);">
        Tablero de Avisos
    </h4>

    @if (Model.Avisos != null && Model.Avisos.Any())
    {
        <div class="d-flex flex-column">
            @foreach (var aviso in Model.Avisos)
            {
                <div class="aviso-sidebar-item">
                    <h6 class="mb-1" style="font-family: var(--theme-font-title); font-weight: 700; color: var(--theme-primary);">
                        @(string.IsNullOrWhiteSpace(aviso.Titulo) ? "Aviso" : aviso.Titulo)
                    </h6>
                    <p class="small mb-2" style="color: var(--theme-text-muted); font-family: var(--theme-font-body);">
                        @(string.IsNullOrWhiteSpace(aviso.Descripcion) ? "Sin detalles." : aviso.Descripcion)
                    </p>
                    <span class="badge" style="background-color: rgba(128, 128, 128, 0.1); color: var(--theme-accent); font-family: var(--theme-font-body);">
                        Expira: @(aviso.FechaExpiracion == default ? "--" : aviso.FechaExpiracion.ToString("dd/MM/yy"))
                    </span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center p-3" style="background: var(--theme-bg); border-radius: 8px; font-family: var(--theme-font-body); color: var(--theme-text-muted);">
            No hay avisos recientes.
        </div>
    }
</div>