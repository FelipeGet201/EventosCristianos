@model List<RedAJP.Models.PedidoEntregaViewModel>

@{
    Layout = "Principal";
    ViewData["Title"] = "Administrar Entregas";
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-entregasadmin');
        }
    });
</script>

<div class="container py-5 fade-in d-print-none">
    
    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3 mb-4 bg-white p-3 p-md-4 rounded-4 shadow-sm border">
    
    <div class="flex-grow-1 text-center text-xl-start">
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-dolly me-2 text-primary"></i>Entregas Pendientes</h2>
        <p class="text-muted mb-0">Pedidos pagados listos para entregar. (@Model.Count en total)</p>
    </div>
    
    <div class="d-flex flex-column flex-md-row justify-content-center justify-content-xl-end gap-2 align-items-stretch align-items-md-center w-100" style="max-width: 750px;">
        
        <div class="input-group rounded-pill overflow-hidden border shadow-sm bg-white flex-grow-1">
            <span class="input-group-text bg-transparent border-0 pe-1">
                <i class="fa-solid fa-magnifying-glass text-muted"></i>
            </span>
            <input type="text" id="inputBuscador" class="form-control border-0 shadow-none" placeholder="Buscar cliente, teléfono...">
        </div>

        <button type="button" class="btn btn-outline-dark rounded-pill fw-bold text-nowrap shadow-sm" onclick="mostrarResumenCompleto()">
            <i class="fa-solid fa-clipboard-list me-2"></i>Ver Resumen de Artículos
        </button>
        <button type="button" id="btnAccionGrupal" class="btn btn-primary rounded-pill fw-bold d-none shadow-sm text-nowrap" onclick="abrirModalGrupal()">
            <i class="fa-solid fa-boxes-packing me-2"></i>Asignar (<span id="contadorSeleccion">0</span>)
        </button>
    </div>
</div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5 bg-light rounded-4 border border-dashed">
            <div class="mb-3 text-muted opacity-25">
                <i class="fa-solid fa-clipboard-check fa-4x"></i>
            </div>
            <h4 class="fw-bold text-muted">¡Todo listo!</h4>
            <p class="text-muted">No hay entregas pendientes por el momento.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                string cardBorder = item.MensajesSinLeer > 0 ? "border border-danger border-opacity-50" : "border-0";
                
                <div class="col-md-6 col-xl-4 position-relative tarjeta-filtro">
                    <div class="card h-100 @cardBorder shadow-sm rounded-4 overflow-hidden hover-card">

                        <div class="position-absolute top-0 end-0 m-3 z-3">
                            <input class="form-check-input check-pedido" type="checkbox" value="@item.IdPedido" style="transform: scale(1.5); cursor: pointer;">
                        </div>

                        <div class="card-header bg-white border-bottom pt-3 pb-2 d-flex align-items-center">
                            @if (item.FechaEstimada.Year <= 1900)
                            {
                                <span class="badge bg-warning text-dark border border-warning rounded-pill shadow-sm">
                                    <i class="fa-solid fa-calendar-xmark me-1"></i> Sin Fecha Asignada
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-info bg-opacity-10 text-dark border border-info rounded-pill">
                                    <i class="fa-solid fa-calendar-check me-1 text-primary"></i> @item.FechaEstimada.ToString("dd/MM/yyyy")
                                </span>
                            }
                            <small class="fw-bold text-muted font-monospace ms-auto me-4">#@item.IdPedido</small>
                        </div>

                        <div class="card-body">
                            <div class="d-flex gap-3 mb-3">
                                <div class="rounded-3 bg-light border flex-shrink-0 overflow-hidden position-relative" style="width: 80px; height: 80px;">
                                    @if (!string.IsNullOrEmpty(item.ImagenPreviewUrl))
                                    {
                                        <img src="@item.ImagenPreviewUrl" class="w-100 h-100 object-fit-cover">
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                            <i class="fa-solid fa-image fa-lg"></i>
                                        </div>
                                    }
                                    <span class="position-absolute bottom-0 end-0 badge bg-dark m-1" style="font-size: 0.65rem;">
                                        +@item.CantidadArticulos
                                    </span>
                                </div>

                                <div class="overflow-hidden pe-2">
                                    <h6 class="fw-bold text-dark mb-1 text-truncate">@item.NombreCliente</h6>
                                    @if (!string.IsNullOrEmpty(item.Telefono))
                                    {
                                        <a href="tel:@item.Telefono" class="text-decoration-none text-muted small d-block mb-1">
                                            <i class="fa-solid fa-phone me-1 text-success"></i> @item.Telefono
                                        </a>
                                    }
                                    else
                                    {
                                        <small class="text-muted d-block mb-1">Sin teléfono</small>
                                    }
                                    <small class="text-muted"><i class="fa-regular fa-calendar me-1"></i> @item.Fecha.ToString("dd/MM/yyyy")</small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="small fw-bold text-muted text-uppercase" style="font-size: 0.7rem;">Contenido Resumido:</label>
                                <p class="small text-dark mb-0 lh-sm">
                                    @item.ResumenCompra
                                </p>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Comentarios))
                            {
                                <div class="alert alert-warning border-0 p-2 d-flex gap-2 rounded-3 mb-3">
                                    <i class="fa-solid fa-comment-dots mt-1"></i>
                                    <small class="fst-italic lh-sm">"@item.Comentarios"</small>
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-white border-top-0 p-3 pt-0">
                            <div class="d-grid gap-2">
                                @if (item.MensajesSinLeer > 0)
                                {
                                    <a href="@Url.Action("MensajesPedidoAdmin", "Tienda", new { id = item.IdPedido })"
                                       class="btn btn-sm btn-light border border-danger text-danger rounded-pill px-3 fw-bold shadow-sm d-flex justify-content-between align-items-center hover-scale">
                                        <span><i class="fa-solid fa-bell me-2"></i>Mensaje del Cliente</span>
                                        <span class="badge bg-danger rounded-pill pulse-icon">@item.MensajesSinLeer</span>
                                    </a>
                                }
                                <a href="@Url.Action("DetalleEntregaAdmin", "Tienda", new { id = item.IdPedido })" class="btn btn-sm btn-dark rounded-pill px-3 fw-bold hover-scale">
                                    Gestionar Entrega
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="modalResumen" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            
            <div class="modal-header bg-white border-bottom pb-3 pt-4 px-4">
                <div>
                    <h4 class="modal-title fw-bold text-dark mb-1">Resumen de Preparación</h4>
                    <p class="text-muted small mb-0" id="textoAlcanceResumen">Consultando requerimientos...</p>
                </div>
                <button type="button" class="btn-close mb-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 py-3 text-uppercase small fw-bold text-secondary">Producto</th>
                                <th class="py-3 text-uppercase small fw-bold text-secondary">Especificación / Talla</th>
                                <th class="text-center pe-4 py-3 text-uppercase small fw-bold text-secondary">Cantidad Necesaria</th>
                            </tr>
                        </thead>
                        <tbody id="tablaResumenBody">
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="modal-footer border-top-0 bg-light p-3">
                <button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-dark px-4 fw-bold shadow-sm" onclick="window.print()"><i class="fa-solid fa-print me-2"></i>Imprimir Lista</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalGrupal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-primary text-white border-bottom-0">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-layer-group me-2"></i>Acción Grupal</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <i class="fa-solid fa-calendar-day fa-3x text-primary mb-3"></i>
                <h5 class="fw-bold">Asignar Fecha de Entrega</h5>
                <p class="text-muted mb-4">Selecciona la fecha estimada para los <strong id="contadorModalGrupal">0</strong> pedidos seleccionados.</p>
                
                <form id="formAccionGrupal" action="/Tienda/AsignarFechaGrupal" method="POST">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="idsPedidosGrupales" name="idsPedidos" value="" />
                    <input type="date" class="form-control form-control-lg mb-3 rounded-3 border-secondary" name="fechaAsignada" required />
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">Actualizar Fecha a Todos</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-card { transition: transform 0.2s, box-shadow 0.2s; }
    .hover-card:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important; border-color: #0d6efd !important;}
    .hover-scale { transition: transform 0.2s; }
    .hover-scale:hover { transform: scale(1.02); }

    @@keyframes pulse-icon {
        0% { transform: scale(1); }
        50% { transform: scale(1.25); }
        100% { transform: scale(1); }
    }
    .pulse-icon { animation: pulse-icon 1.5s infinite; }
    
    /* =========================================
       CSS REPARADO Y COMPRIMIDO PARA IMPRESIÓN
       ========================================= */
    @@media print {
        @@page { 
            margin: 1cm; /* Margen reducido para aprovechar más la hoja */
        }
        
        /* Ocultar absolutamente TODO (menús, widgets, fondos) */
        body * { 
            visibility: hidden !important; 
        }

        /* Rescatar SOLAMENTE el Modal y su contenido */
        #modalResumen, #modalResumen * { 
            visibility: visible !important; 
        }

        /* Posicionar el Modal exactamente en la esquina superior izquierda del papel */
        #modalResumen { 
            position: absolute !important; left: 0 !important; top: 0 !important; width: 100% !important; margin: 0 !important; padding: 0 !important; display: block !important; background-color: white !important; align-items: flex-start !important; /* Fuerza a que vaya arriba */
        }

        /* MATAR EL CENTRADO VERTICAL DE BOOTSTRAP PARA LA IMPRESIÓN */
        .modal-dialog, .modal-dialog-centered { 
            max-width: 100% !important; width: 100% !important; margin: 0 !important; padding: 0 !important; transform: none !important; min-height: auto !important; /* Evita que ocupe todo el alto */ align-items: flex-start !important; /* Pega el contenido arriba */ display: block !important; 
        }

        .modal-content { border: none !important; box-shadow: none !important; }
        
        /* Ocultar botones y la "X" de cerrar */
        .modal-footer, .btn-close { display: none !important; }
        
        /* Ajustar el encabezado del modal para que no ocupe tanto espacio */
        .modal-header { padding: 10px 15px !important; border-bottom: 2px solid #000 !important; }
        .modal-title { font-size: 1.2rem !important; }

        /* COMPRESIÓN MÁXIMA DE LAS LÍNEAS DE LA TABLA */
        .table { width: 100% !important; border-collapse: collapse !important; margin-bottom: 0 !important; }
        
        .table th, .table td { 
            border-bottom: 1px solid #ccc !important; page-break-inside: avoid !important; padding: 4px 8px !important; font-size: 12px !important; 
        }
        
        /* Comprimir aún más las filas de los subtotales */
        .table-light-print td {
            padding: 2px 8px !important; font-size: 11px !important;
        }
        
        /* Comprimir la fila del Gran Total */
        tr.bg-dark td {
            padding: 6px 8px !important; font-size: 14px !important; background-color: #e9ecef !important; color: #000 !important; border-top: 2px solid #000 !important; 
        }

        .table thead { display: table-header-group !important; }
        .table-light-print { background-color: #f8f9fa !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
</style>

<script>
    const checkboxes = document.querySelectorAll('.check-pedido');
    const btnAccionGrupal = document.getElementById('btnAccionGrupal');
    const contadorSeleccion = document.getElementById('contadorSeleccion');
    const contadorModalGrupal = document.getElementById('contadorModalGrupal');
    const idsPedidosGrupales = document.getElementById('idsPedidosGrupales');

    checkboxes.forEach(chk => {
        chk.addEventListener('change', actualizarUISeleccion);
    });

    function actualizarUISeleccion() {
        const seleccionados = Array.from(checkboxes).filter(c => c.checked);
        const total = seleccionados.length;
        if (total > 0) {
            btnAccionGrupal.classList.remove('d-none');
            contadorSeleccion.innerText = total;
            contadorModalGrupal.innerText = total;
            idsPedidosGrupales.value = seleccionados.map(c => c.value).join(',');
        } else {
            btnAccionGrupal.classList.add('d-none');
        }
    }

    function abrirModalGrupal() {
        var myModal = new bootstrap.Modal(document.getElementById('modalGrupal'));
        myModal.show();
    }

    // PROCESAMIENTO AJAX CON DOBLE FILTRO (ID INTERNO + TOTAL POR ÍTEM + TOTAL GENERAL)
    function mostrarResumenCompleto() {
        const seleccionados = Array.from(checkboxes).filter(c => c.checked);
        const ids = seleccionados.map(c => c.value).join(',');

        const textoAlcance = document.getElementById('textoAlcanceResumen');
        if(ids) {
            textoAlcance.innerHTML = `Mostrando requerimientos exactos de los <strong>${seleccionados.length} pedidos seleccionados</strong>.`;
        } else {
            textoAlcance.innerHTML = `Mostrando requerimientos globales de <strong>TODOS</strong> los pedidos pendientes.`;
        }

        const tbody = document.getElementById('tablaResumenBody');
        tbody.innerHTML = `
            <tr>
                <td colspan="3" class="text-center py-5">
                    <div class="spinner-border text-dark mb-2" role="status" style="width: 2rem; height: 2rem;">
                        <span class="visually-hidden">Procesando...</span>
                    </div>
                    <p class="text-muted small fw-bold mb-0">Calculando inventario seguro...</p>
                </td>
            </tr>`;
            
        var modalElement = document.getElementById('modalResumen');
        var myModal = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
        myModal.show();
        
        fetch(`/Tienda/ObtenerResumenEntregas?ids=${ids}`)
            .then(response => {
                if (!response.ok) throw new Error('Error de conexión.');
                return response.json();
            })
            .then(data => {
                tbody.innerHTML = '';

                if (!data || data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="3" class="text-center py-5 text-muted"><i class="fa-solid fa-box-open fa-2x mb-2 d-block text-black-50"></i>No hay artículos pendientes.</td></tr>`;
                    return;
                }

                let totalGeneral = 0;
                let subtotalProducto = 0;
                let currentIdProducto = null;
                let currentNombreProducto = "";

                // Función auxiliar para inyectar la fila de subtotal de forma limpia y seria
                function agregarFilaSubtotal(nombre, total) {
                    const trSub = document.createElement('tr');
                    // 'table-light-print' fuerza el color gris sutil tanto en pantalla como en papel
                    trSub.className = "table-light table-light-print fw-bold text-secondary";
                    trSub.innerHTML = `
                        <td class="ps-4 py-2 text-end text-uppercase small" style="letter-spacing: 0.5px;">Total [${nombre}]:</td>
                        <td class="py-2"></td>
                        <td class="text-center pe-4 py-2 text-dark fs-6 font-monospace" style="border-top: 1px double #999; border-bottom: 1px double #999;">${total}</td>
                    `;
                    tbody.appendChild(trSub);
                }

                data.forEach((item, index) => {
                    totalGeneral += item.cantidad;

                    // CORTE DE CONTROL INTERNO: Detectamos cambio de producto usando su ID numérico
                    if (currentIdProducto !== null && currentIdProducto !== item.idProducto) {
                        agregarFilaSubtotal(currentNombreProducto, subtotalProducto);
                        subtotalProducto = 0; // Reseteamos contador para el siguiente producto
                    }

                    currentIdProducto = item.idProducto;
                    currentNombreProducto = item.producto;
                    subtotalProducto += item.cantidad;

                    // Fila estándar del artículo (Estilo formal y limpio)
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="ps-4 text-dark align-middle">${item.producto} <span class="text-muted small font-monospace d-block d-print-none" style="font-size:0.7rem;">ID: ${item.idProducto}</span></td>
                        <td class="text-muted align-middle">${item.especificacion}</td>
                        <td class="text-center pe-4 text-dark font-monospace align-middle" style="font-size: 1.05rem;">${item.cantidad}</td>
                    `;
                    tbody.appendChild(tr);

                    // Si es el último elemento del JSON, cerramos su subtotal correspondiente
                    if (index === data.length - 1) {
                        agregarFilaSubtotal(currentNombreProducto, subtotalProducto);
                    }
                });
                
                // FILA FINAL: GRAN TOTAL COMPLETO DE LA CARGA
                const trTotal = document.createElement('tr');
                trTotal.className = "border-top border-dark border-2 bg-dark text-white";
                trTotal.innerHTML = `
                    <td colspan="2" class="text-end fw-bold pe-4 text-uppercase align-middle pt-3 pb-3 border-bottom-0" style="font-size: 1rem; letter-spacing: 1px;">
                        Total General de Artículos:
                    </td>
                    <td class="text-center pe-4 fw-bold align-middle pt-3 pb-3 border-bottom-0 font-monospace" style="font-size: 1.4rem;">
                        ${totalGeneral}
                    </td>
                `;
                tbody.appendChild(trTotal);
            })
            .catch(error => {
                console.error('Error AJAX:', error);
                tbody.innerHTML = `
                    <tr>
                        <td colspan="3" class="text-center py-5 text-danger">
                            <i class="fa-solid fa-triangle-exclamation fa-2x mb-2"></i>
                            <h6 class="fw-bold">Error de sincronización con el servidor</h6>
                        </td>
                    </tr>`;
            });
    }

    // Funcionalidad del Buscador de Entregas
    const inputBuscador = document.getElementById('inputBuscador');
    if (inputBuscador) {
        inputBuscador.addEventListener('input', function () {
            const textoBusqueda = this.value.toLowerCase().trim();
            const tarjetas = document.querySelectorAll('.tarjeta-filtro');

            tarjetas.forEach(tarjeta => {
                const contenidoTarjeta = tarjeta.innerText.toLowerCase();
                if (contenidoTarjeta.includes(textoBusqueda)) {
                    tarjeta.classList.remove('d-none');
                } else {
                    tarjeta.classList.add('d-none');
                }
            });
        });
    }
</script>