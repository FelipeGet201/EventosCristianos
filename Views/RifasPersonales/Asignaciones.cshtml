@model RedAJP.Models.TableroRifaPersonalViewModel
@{
    Layout = "_LayoutRifasPersonales";
    ViewData["Title"] = "Gestión de Vendedores";
    var listaUsuarios = ViewBag.Usuarios as List<SelectListItem>;
    var idUsuarioActual = User.FindFirst("IdUsuario")?.Value;
}

<style>
    /* Paleta Pastel para Asignaciones */
    .bg-pastel-blue { background-color: #e0f2fe !important; color: #0c4a6e !important; }
    .text-pastel-blue { color: #0ea5e9 !important; }
    .text-pastel-dark { color: #0c4a6e !important; }
    .border-pastel-blue { border-color: #7dd3fc !important; }
    .btn-pastel-blue { background-color: #3b82f6; color: white; border: none; }
    .btn-pastel-blue:hover { background-color: #2563eb; color: white; }
    .btn-outline-pastel { border: 2px solid #7dd3fc; color: #0ea5e9; background-color: transparent; }
    .btn-outline-pastel:hover { background-color: #e0f2fe; color: #0c4a6e; border-color: #3b82f6; }
    .progress-pastel { background-color: #3b82f6; }    
</style>

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-rifaspersonales');
        }
    });
</script>

<div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
    <div class="card-body p-4 p-md-5 position-relative bg-pastel-blue">
        <div class="position-absolute top-50 end-0 translate-middle-y pe-4 d-none d-sm-block" style="opacity: 0.05; pointer-events: none;">
            <i class="fa-solid fa-ticket-alt" style="font-size: 8rem; color: #0c4a6e;"></i>
        </div>
        
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center position-relative z-1 gap-3">
            <div>
                <h2 class="fw-bold mb-1 text-pastel-dark d-flex align-items-center gap-2">
                    <span style="font-size: 2.5rem;">@Model.BoletosLibresParaAsignar</span> 
                    <span class="fs-4 fw-normal mt-2">Boletos Libres</span>
                </h2>
                <p class="mb-0 fs-6 text-pastel-dark" style="opacity: 0.8;"><i class="fa-solid fa-circle-info me-1"></i>Disponibles para asignar a tus promotores y vendedores.</p>
            </div>
            <button class="btn btn-light rounded-circle shadow-sm d-flex align-items-center justify-content-center text-pastel-blue"
                    style="width: 60px; height: 60px; flex-shrink: 0; border: 2px solid #ffffff;"
                    onclick="abrirModalAsignacion('', '', '')"
                    @(Model.BoletosLibresParaAsignar == 0 ? "disabled" : "")
                    title="Nueva Asignación">
                <i class="fa-solid fa-plus fa-xl"></i>
            </button>
        </div>
    </div>
</div>

@if(ViewBag.PagosPendientes != null && ((List<RedAJP.Models.PagoVendedorViewModel>)ViewBag.PagosPendientes).Any())
{
    var pendientes = (List<RedAJP.Models.PagoVendedorViewModel>)ViewBag.PagosPendientes;
    <div class="alert bg-white border border-warning shadow-sm rounded-4 mb-4">
        <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-bell text-warning me-2"></i> @pendientes.Count Comprobantes por Validar</h5>
        
        <div class="row g-3">
            @foreach(var p in pendientes)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card bg-light border-0 shadow-sm rounded-3">
                        <div class="card-body p-3 text-center">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="fw-bold text-dark text-truncate text-start" style="max-width: 70%;">@p.NombrePromotorExterno</span>
                                <span class="badge bg-warning text-dark">Pendiente</span>
                            </div>
                            <div class="fs-4 fw-bold text-success mb-2">$@p.Monto.ToString("N2")</div>
                            <div class="small text-muted mb-3"><i class="fa-regular fa-clock me-1"></i> @p.FechaPago.ToString("dd MMM yyyy, hh:mm tt")</div>
                            
                            <button type="button" class="btn btn-sm btn-primary w-100 rounded-pill fw-bold" 
                                    onclick="abrirModalRevision('@p.IdPago', '@p.ComprobanteUrl', '@p.NombrePromotorExterno', '@p.Monto.ToString("N2")')">
                                <i class="fa-solid fa-magnifying-glass me-1"></i> Revisar Comprobante
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-5">
    <div class="card-header bg-white border-bottom p-4">
        <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-users-gear text-pastel-blue me-2"></i> Mis Vendedores</h5>
    </div>
    <div class="card-body p-0" style="padding: 0 !important;">
        
        <div class="table-responsive d-none d-lg-block">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">Promotor</th>
                        <th class="text-center py-3">Boletos (Asig/Ven)</th>
                        <th class="py-3">Finanzas</th>
                        <th class="text-center text-pastel-blue py-3">Avance</th>
                        <th class="text-end pe-4 py-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Promotores.Any())
                    {
                        foreach (var p in Model.Promotores.OrderByDescending(x => x.Vendidos))
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    @p.Nombre
                                    @if (p.Nombre.Contains("Mi Cuenta"))
                                    {
                                        <span class="badge bg-pastel-blue ms-2"><i class="fa-solid fa-star"></i></span>
                                    }
                                    else if (p.Nombre.Contains("(Externo)"))
                                    {
                                        <span class="badge bg-light text-secondary border ms-2"><i class="fa-solid fa-user-astronaut"></i> Externo</span>
                                    }
                                </td>
                                
                                <td class="text-center">
                                    <span class="fw-bold text-dark">@p.Asignados</span> / 
                                    <span class="text-success fw-bold">@p.Vendidos</span>
                                </td>

                                <td>
                                    <div class="d-flex flex-column" style="font-size: 0.85rem;">
                                        <span><span class="text-muted">Deuda por Ventas:</span> <strong>$@p.DeudaTotal.ToString("N2")</strong></span>
                                        <span><span class="text-success">Pagado:</span> <strong>$@p.TotalPagado.ToString("N2")</strong></span>
                                        @if(p.SaldoPendiente > 0) {
                                            <span class="text-danger mt-1 fw-bold">Resta: $@p.SaldoPendiente.ToString("N2")</span>
                                        } else {
                                            <span class="text-success mt-1 fw-bold"><i class="fa-solid fa-check-circle me-1"></i>Liquidado</span>
                                        }
                                    </div>
                                </td>

                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <div class="progress flex-grow-1 bg-light" style="width: 60px; height: 8px;">
                                            <div class="progress-bar progress-pastel" style="width: @p.PorcentajeVenta%"></div>
                                        </div>
                                        <small class="text-muted fw-bold">@p.PorcentajeVenta%</small>
                                    </div>
                                </td>
                                
                                <td class="text-end pe-4">
                                    @if (p.IdUsuario == null && !string.IsNullOrEmpty(p.NombrePromotorExterno))
                                    {
                                        <button class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-2 me-1"
                                                onclick="abrirModalVincular('@p.NombrePromotorExterno')"
                                                title="Vincular a Cuenta Registrada">
                                            <i class="fa-solid fa-link"></i>
                                        </button>
                                    }

                                    <a href="@Url.Action("ImprimirPlanilla", "RifasPersonales", new { tokenRifa = Model.InfoRifa.Token, idDestino = p.IdUsuario, externo = p.NombrePromotorExterno, nombreMostrar = p.Nombre })" 
                                       target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold px-2 me-1" title="Imprimir Planilla">
                                        <i class="fa-solid fa-print"></i>
                                    </a>

                                    <button class="btn btn-sm btn-outline-pastel rounded-pill fw-bold px-2 me-1"
                                            onclick="abrirModalAsignacion('@(p.IdUsuario?.ToString() ?? "")', '@(p.NombrePromotorExterno ?? "")', '@p.Nombre')"
                                            @(Model.BoletosLibresParaAsignar == 0 ? "disabled" : "") title="Agregar Boletos">
                                        <i class="fa-solid fa-plus"></i> Bol
                                    </button>

                                    <button class="btn btn-sm btn-success rounded-pill fw-bold px-2"
                                            onclick="abrirModalAbono('@(p.IdUsuario?.ToString() ?? "")', '@(p.NombrePromotorExterno ?? "")', '@p.Nombre', '@p.SaldoPendiente')"
                                            @(p.SaldoPendiente <= 0 ? "disabled" : "") title="Registrar Pago">
                                        <i class="fa-solid fa-hand-holding-dollar"></i> Cobrar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">Aún no hay boletos asignados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-block d-lg-none mt-3">
            @if (Model.Promotores.Any())
            {
                <div class="row g-3 px-3 pb-3">
                    @foreach (var p in Model.Promotores.OrderByDescending(x => x.Vendidos))
                    {
                        <div class="col-12">
                            <div class="card border border-pastel-blue shadow-sm rounded-4 h-100" style="background-color: #ffffff;">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">@p.Nombre</h6>
                                            @if (p.Nombre.Contains("Mi Cuenta"))
                                            {
                                                <span class="badge bg-pastel-blue mb-2"><i class="fa-solid fa-star me-1"></i>Venta Directa</span>
                                            }
                                            else if (p.Nombre.Contains("(Externo)"))
                                            {
                                                <span class="badge bg-light text-secondary border mb-2"><i class="fa-solid fa-user-astronaut me-1"></i>Externo</span>
                                            }
                                        </div>
                                    </div>
                                    
                                    <div class="row text-center mb-2 bg-light rounded-3 py-2 mx-0">
                                        <div class="col-6 border-end">
                                            <span class="d-block text-muted small text-uppercase">Asignados</span>
                                            <span class="fw-bold fs-5 text-dark">@p.Asignados</span>
                                        </div>
                                        <div class="col-6">
                                            <span class="d-block text-success small text-uppercase">Vendidos</span>
                                            <span class="fw-bold fs-5 text-success">@p.Vendidos</span>
                                        </div>
                                    </div>

                                    <div class="bg-white border rounded-3 p-2 mb-3 small d-flex justify-content-between">
                                        <div>
                                            <div class="text-muted">Deuda por Ventas: <strong class="text-dark">$@p.DeudaTotal.ToString("N2")</strong></div>
                                            <div class="text-muted">Pagado: <strong class="text-success">$@p.TotalPagado.ToString("N2")</strong></div>
                                        </div>
                                        <div class="text-end">
                                            <div class="text-muted">Saldo</div>
                                            @if(p.SaldoPendiente > 0) {
                                                <strong class="text-danger">$@p.SaldoPendiente.ToString("N2")</strong>
                                            } else {
                                                <strong class="text-success">Liquidado</strong>
                                            }
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <small class="text-muted fw-bold">@p.PorcentajeVenta%</small>
                                        <div class="progress flex-grow-1 bg-light" style="height: 8px;">
                                            <div class="progress-bar progress-pastel" style="width: @p.PorcentajeVenta%"></div>
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2 flex-wrap">
                                        @if (p.IdUsuario == null && !string.IsNullOrEmpty(p.NombrePromotorExterno))
                                        {
                                            <button class="btn btn-outline-primary btn-sm rounded-pill fw-bold flex-grow-1"
                                                    onclick="abrirModalVincular('@p.NombrePromotorExterno')">
                                                <i class="fa-solid fa-link"></i> Vincular
                                            </button>
                                        }

                                        <a href="@Url.Action("ImprimirPlanilla", "RifasPersonales", new { tokenRifa = Model.InfoRifa.Token, idDestino = p.IdUsuario, externo = p.NombrePromotorExterno, nombreMostrar = p.Nombre })" 
                                           target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill fw-bold flex-grow-1">
                                            <i class="fa-solid fa-print"></i>
                                        </a>

                                        <button class="btn btn-outline-pastel btn-sm rounded-pill fw-bold flex-grow-1"
                                                onclick="abrirModalAsignacion('@(p.IdUsuario?.ToString() ?? "")', '@(p.NombrePromotorExterno ?? "")', '@p.Nombre')"
                                                @(Model.BoletosLibresParaAsignar == 0 ? "disabled" : "")>
                                            <i class="fa-solid fa-plus"></i> Bol
                                        </button>

                                        <button class="btn btn-success btn-sm rounded-pill fw-bold flex-grow-1"
                                                onclick="abrirModalAbono('@(p.IdUsuario?.ToString() ?? "")', '@(p.NombrePromotorExterno ?? "")', '@p.Nombre', '@p.SaldoPendiente')"
                                                @(p.SaldoPendiente <= 0 ? "disabled" : "")>
                                            <i class="fa-solid fa-dollar-sign"></i> Cobrar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-folder-open fa-2xl mb-3 text-secondary opacity-50"></i>
                    <p class="mb-0">Aún no hay boletos asignados.</p>
                </div>
            }
        </div>

    </div>
</div>

<div class="modal fade" id="modalRevisionPago" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            
            <div class="modal-header border-0 p-4 bg-light">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-money-check-dollar text-primary me-2"></i> Revisión de Comprobante</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            
            <div class="modal-body p-0">
                <div class="row g-0">
                    <div class="col-md-7 bg-dark d-flex align-items-center justify-content-center p-3" style="min-height: 300px;">
                        <img src="" id="imgComprobanteRevision" class="img-fluid rounded shadow" style="max-height: 60vh; object-fit: contain;" alt="Comprobante">
                    </div>
                    
                    <div class="col-md-5 p-4 bg-white d-flex flex-column">
                        <div class="mb-4">
                            <p class="small text-muted text-uppercase fw-bold mb-1">Vendedor / Promotor</p>
                            <h6 class="fw-bold text-dark" id="lblVendedorRevision">---</h6>
                        </div>
                        
                        <div class="mb-4">
                            <p class="small text-muted text-uppercase fw-bold mb-1">Monto Reportado</p>
                            <h2 class="fw-bold text-success mb-0">$<span id="lblMontoRevision">0.00</span></h2>
                        </div>

                        <div class="mt-auto">
                            <hr class="text-muted opacity-25">
                            
                            <div id="bloqueBotonesRevision" class="d-flex flex-column gap-2">
                                <form action="@Url.Action("ValidarPagoTransferencia", "RifasPersonales")" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="tokenRifa" value="@Model.InfoRifa.Token" />
                                    <input type="hidden" name="IdPago" id="inputRevisionAprobarId" />
                                    <input type="hidden" name="AccionValidacion" value="Aprobar" />
                                    <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill fw-bold shadow-sm">
                                        <i class="fa-solid fa-check me-2"></i> Aprobar Pago
                                    </button>
                                </form>
                                
                                <button type="button" class="btn btn-outline-danger w-100 rounded-pill fw-bold" onclick="mostrarFormularioRechazo()">
                                    <i class="fa-solid fa-xmark me-2"></i> Rechazar
                                </button>
                            </div>

                            <div id="bloqueFormularioRechazo" class="d-none mt-3">
                                <form action="@Url.Action("ValidarPagoTransferencia", "RifasPersonales")" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="tokenRifa" value="@Model.InfoRifa.Token" />
                                    <input type="hidden" name="IdPago" id="inputRevisionRechazarId" />
                                    <input type="hidden" name="AccionValidacion" value="Rechazar" />
                                    
                                    <label class="form-label fw-bold small text-danger">Motivo de Rechazo (Obligatorio)</label>
                                    <textarea name="NotaRechazo" class="form-control border-danger mb-3 shadow-sm" rows="3" placeholder="Ej. El monto no coincide con la captura..." required></textarea>
                                    
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-light rounded-pill fw-bold w-50" onclick="ocultarFormularioRechazo()">Cancelar</button>
                                        <button type="submit" class="btn btn-danger rounded-pill fw-bold w-50 shadow-sm">Confirmar</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAsignacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            
            <div class="modal-header bg-pastel-blue border-0 p-4">
                <h5 class="modal-title fw-bold" id="modalAsignacionTitle">Nueva Asignación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            
            <form action="@Url.Action("AsignarBoletos", "RifasPersonales")" method="post" id="formAsignacion">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tokenRifa" value="@Model.InfoRifa.Token" />
                <input type="hidden" name="IdUsuarioDestino" id="inputUsuarioOculto" disabled />
                <input type="hidden" name="NombrePromotorExterno" id="inputExternoOculto" disabled />

                <div class="modal-body p-4 bg-light">
                    <div class="alert bg-white border border-pastel-blue small mb-4 shadow-sm text-pastel-dark">
                        <i class="fa-solid fa-circle-info me-1 text-pastel-blue"></i> Solo puedes <strong>agregar más boletos</strong> a un vendedor, no se pueden quitar.
                    </div>

                    <div id="bloqueSelectUsuario">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="chkUsuarioRegistrado" checked onchange="toggleTipoVendedor()">
                            <label class="form-check-label fw-bold text-dark" for="chkUsuarioRegistrado">Usuario registrado en plataforma</label>
                        </div>

                        <div class="mb-3" id="contenedorSelectUsuario">
                            <select name="IdUsuarioDestino" id="selectUsuarioDestino" class="form-select border-pastel-blue shadow-sm" style="width: 100%;">
                                <option value="@idUsuarioActual">-- Asignarme a Mi --</option>
                                @if (listaUsuarios != null)
                                {
                                    foreach (var user in listaUsuarios)
                                    {
                                        <option value="@user.Value">@user.Text</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3 d-none" id="contenedorPromotorExterno">
                            <label class="form-label fw-bold small text-dark text-uppercase">Nombre del Promotor</label>
                            <input type="text" name="NombrePromotorExterno" id="inputPromotorExterno" class="form-control border-pastel-blue shadow-sm" placeholder="Ej. Juan Pérez..." />
                        </div>
                    </div>

                    <div class="mb-3 d-none" id="bloqueInputUsuario">
                        <label class="form-label fw-bold small text-dark text-uppercase">Vendedor Seleccionado</label>
                        <input type="text" id="inputNombreVendedor" class="form-control bg-white text-muted fw-bold border-pastel-blue" readonly />
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <div class="mb-2">
                        <label class="form-label fw-bold small text-pastel-blue text-uppercase">Cantidad a Agregar</label>
                        <input type="number" name="CantidadBoletos" id="inputCantidad" class="form-control form-control-lg border-pastel-blue shadow-sm text-center fw-bold text-pastel-blue" min="1" max="@Model.BoletosLibresParaAsignar" placeholder="0" required />
                    </div>
                    <div class="text-end small text-muted">
                        Máximo a asignar: <strong>@Model.BoletosLibresParaAsignar</strong>
                    </div>
                </div>

                <div class="modal-footer border-0 bg-white p-4">
                    <button type="submit" class="btn btn-pastel-blue btn-lg w-100 rounded-pill fw-bold shadow-sm">
                        <i class="fa-solid fa-check me-2"></i> Confirmar Boletos
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAbono" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            
            <div class="modal-header border-0 p-4" style="background-color: #d1fae5; color: #064e3b;">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-hand-holding-dollar me-2"></i> Registrar Pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            
            <form action="@Url.Action("RegistrarAbonoManual", "RifasPersonales")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tokenRifa" value="@Model.InfoRifa.Token" />
                <input type="hidden" name="IdUsuarioVendedor" id="inputAbonoIdOculto" />
                <input type="hidden" name="NombrePromotorExterno" id="inputAbonoExtOculto" />

                <div class="modal-body p-4 bg-light">
                    <p class="small text-muted mb-4">Registra un pago que te entregaron directamente. Esto descontará automáticamente el saldo de <strong id="lblVendedorCobro" class="text-dark"></strong>.</p>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-success text-uppercase">Monto del Abono ($)</label>
                        <input type="number" name="MontoAbono" id="inputMontoAbono" class="form-control form-control-lg border-success shadow-sm text-center fw-bold text-success" step="0.01" min="1" placeholder="0.00" required />
                        <div class="text-end small text-muted mt-1">Saldo pendiente: $<strong id="lblSaldoMaximo">0.00</strong></div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold small text-dark text-uppercase">Nota (Opcional)</label>
                        <input type="text" name="NotaAbono" class="form-control shadow-sm" placeholder="Ej. Me dio en efectivo..." />
                    </div>
                </div>

                <div class="modal-footer border-0 bg-white p-4">
                    <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill fw-bold shadow-sm">
                        <i class="fa-solid fa-check me-2"></i> Aplicar Abono
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalVincular" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white border-0 p-4">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-link me-2"></i> Vincular Promotor</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="@Url.Action("VincularPromotorExterno", "RifasPersonales")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tokenRifa" value="@Model.InfoRifa.Token" />
                <input type="hidden" name="NombrePromotorExterno" id="inputVincularExternoOculto" />

                <div class="modal-body p-4 bg-light">
                    <p class="small text-muted mb-4">Selecciona un usuario registrado en la plataforma para transferirle toda la información, ventas y deudas de <strong id="lblNombreVincular" class="text-dark"></strong>.</p>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark text-uppercase">Usuario a Vincular</label>
                        <select name="IdUsuarioDestino" id="selectUsuarioVincular" class="form-select shadow-sm border-primary" style="width: 100%;" required>
                            <option value="">Selecciona un usuario...</option>
                            @if (listaUsuarios != null)
                            {
                                foreach (var user in listaUsuarios)
                                {
                                    <option value="@user.Value">@user.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-white p-4">
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm">
                        <i class="fa-solid fa-exchange-alt me-2"></i> Confirmar Vinculación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        var modalAsignacionJS = null;
        var modalAbonoJS = null;
        var modalRevisionJS = null;
        var modalVincularJS = null; // NUEVO

        document.addEventListener("DOMContentLoaded", function() {
            modalAsignacionJS = new bootstrap.Modal(document.getElementById('modalAsignacion'));
            modalAbonoJS = new bootstrap.Modal(document.getElementById('modalAbono'));
            modalRevisionJS = new bootstrap.Modal(document.getElementById('modalRevisionPago'));
            modalVincularJS = new bootstrap.Modal(document.getElementById('modalVincular')); // NUEVO

            $('#selectUsuarioDestino').select2({
                theme: 'bootstrap-5',
                dropdownParent: $('#modalAsignacion'),
                placeholder: "Buscar usuario...",
                width: '100%'
            });

            // NUEVO: Select2 para el modal de vinculación
            $('#selectUsuarioVincular').select2({
                theme: 'bootstrap-5',
                dropdownParent: $('#modalVincular'),
                placeholder: "Buscar usuario para vincular...",
                width: '100%'
            });
        });

        // NUEVO METODO PARA ABRIR EL MODAL DE VINCULAR
        function abrirModalVincular(nombreExterno) {
            document.getElementById('lblNombreVincular').innerText = nombreExterno;
            document.getElementById('inputVincularExternoOculto').value = nombreExterno;
            $('#selectUsuarioVincular').val('').trigger('change'); // Resetear dropdown
            modalVincularJS.show();
        }

        // ==========================================
        // FUNCIONES DE REVISIÓN DE COMPROBANTES
        // ==========================================
        function abrirModalRevision(idPago, imgUrl, nombre, monto) {
            // Llenar datos visuales
            document.getElementById('imgComprobanteRevision').src = imgUrl;
            document.getElementById('lblVendedorRevision').innerText = nombre;
            document.getElementById('lblMontoRevision').innerText = monto;

            // Llenar IDs ocultos en los formularios
            document.getElementById('inputRevisionAprobarId').value = idPago;
            document.getElementById('inputRevisionRechazarId').value = idPago;

            // Asegurarse de que el formulario de rechazo esté oculto al abrir
            ocultarFormularioRechazo();
            // Abrir Modal
            modalRevisionJS.show();
        }

        function mostrarFormularioRechazo() {
            document.getElementById('bloqueBotonesRevision').classList.add('d-none');
            document.getElementById('bloqueFormularioRechazo').classList.remove('d-none');
        }

        function ocultarFormularioRechazo() {
            document.getElementById('bloqueFormularioRechazo').classList.add('d-none');
            document.getElementById('bloqueBotonesRevision').classList.remove('d-none');
        }

        // ==========================================
        // FUNCIONES DE ASIGNACIÓN
        // ==========================================
        function toggleTipoVendedor() {
            const isRegistrado = document.getElementById('chkUsuarioRegistrado').checked;
            const selectContainer = document.getElementById('contenedorSelectUsuario');
            const externoContainer = document.getElementById('contenedorPromotorExterno');
            
            const selectDestino = $('#selectUsuarioDestino');
            const inputExterno = document.getElementById('inputPromotorExterno');
            if (isRegistrado) {
                selectContainer.classList.remove('d-none');
                externoContainer.classList.add('d-none');
                inputExterno.value = '';
                inputExterno.disabled = true;
                selectDestino.prop('disabled', false);
            } else {
                selectContainer.classList.add('d-none');
                externoContainer.classList.remove('d-none');
                selectDestino.val('').trigger('change');
                selectDestino.prop('disabled', true);
                inputExterno.disabled = false;
            }
        }

        function abrirModalAsignacion(idUsuario, nombreExterno, nombreMostrar) {
            const isEdit = nombreMostrar != null && nombreMostrar !== '';
            const title = document.getElementById('modalAsignacionTitle');
            const bloqueSelect = document.getElementById('bloqueSelectUsuario');
            const bloqueInput = document.getElementById('bloqueInputUsuario');
            const inputNombre = document.getElementById('inputNombreVendedor');
            
            const selectDestino = $('#selectUsuarioDestino');
            const inputPromotorExt = document.getElementById('inputPromotorExterno');
            
            const inputOcultoId = document.getElementById('inputUsuarioOculto');
            const inputOcultoExt = document.getElementById('inputExternoOculto');

            document.getElementById('inputCantidad').value = '';
            if (isEdit) {
                title.innerText = 'Agregar Boletos a Promotor';
                bloqueSelect.classList.add('d-none');
                bloqueInput.classList.remove('d-none');
                inputNombre.value = nombreMostrar;
                
                selectDestino.prop('disabled', true);
                inputPromotorExt.disabled = true;

                inputOcultoId.disabled = false;
                inputOcultoId.value = idUsuario;
                
                inputOcultoExt.disabled = false;
                inputOcultoExt.value = nombreExterno;
            }
            else {
                title.innerText = 'Nueva Asignación';
                bloqueSelect.classList.remove('d-none');
                bloqueInput.classList.add('d-none');
                
                inputOcultoId.disabled = true;
                inputOcultoExt.disabled = true;

                const chk = document.getElementById('chkUsuarioRegistrado');
                chk.checked = true;
                toggleTipoVendedor();
                
                selectDestino.val('@idUsuarioActual').trigger('change');
            }

            modalAsignacionJS.show();
        }

        // ==========================================
        // FUNCIONES DE ABONO MANUAL
        // ==========================================
        function abrirModalAbono(idUsuario, nombreExterno, nombreMostrar, saldoPendiente) {
            document.getElementById('lblVendedorCobro').innerText = nombreMostrar;
            document.getElementById('lblSaldoMaximo').innerText = parseFloat(saldoPendiente).toFixed(2);
            
            document.getElementById('inputMontoAbono').value = parseFloat(saldoPendiente).toFixed(2);
            document.getElementById('inputMontoAbono').max = saldoPendiente;

            document.getElementById('inputAbonoIdOculto').value = idUsuario;
            document.getElementById('inputAbonoExtOculto').value = nombreExterno;

            modalAbonoJS.show();
        }
    </script>
}