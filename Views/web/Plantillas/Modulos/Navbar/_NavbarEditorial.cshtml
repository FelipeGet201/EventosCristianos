@model RedAJP.Models.IglesiaWebPublicaViewModel

<style>
    .nav-editorial {
        background-color: var(--theme-surface);
        border-bottom: 1px solid rgba(128, 128, 128, 0.2); /* Borde dinámico */
        padding: 1.5rem 0;
    }

        .nav-editorial .navbar-brand {
            font-family: var(--theme-font-title);
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--theme-primary) !important;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .nav-editorial .nav-link {
            color: var(--theme-text-muted) !important;
            font-family: var(--theme-font-title);
            font-weight: 600;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 0 15px;
            transition: color 0.3s;
        }

            .nav-editorial .nav-link:hover {
                color: var(--theme-accent) !important;
            }
</style>

<nav class="navbar navbar-expand-lg nav-editorial sticky-top">
    <div class="container d-flex justify-content-between align-items-center">
        <a class="navbar-brand text-truncate" style="max-width: 300px;" href="#">
            @(string.IsNullOrWhiteSpace(Model.NombreIglesia) ? "Congregación" : Model.NombreIglesia)
        </a>
        <button class="navbar-toggler border-0 rounded-0" type="button" data-bs-toggle="collapse" data-bs-target="#navEditorialCollapse">
            <i class="fa-solid fa-bars fs-4" style="color: var(--theme-text-main);"></i>
        </button>
        <div class="collapse navbar-collapse" id="navEditorialCollapse">
            <ul class="navbar-nav ms-auto text-center mt-3 mt-lg-0">
                <li class="nav-item"><a class="nav-link" href="#nosotros">Historia</a></li>
                <li class="nav-item"><a class="nav-link" href="#actividad">Agenda</a></li>
                <li class="nav-item"><a class="nav-link" href="#galeria">Multimedia</a></li>
                <li class="nav-item"><a class="nav-link" style="color: var(--theme-accent) !important; font-weight: 800;" href="#contacto">Contacto</a></li>
            </ul>
        </div>
    </div>
</nav>