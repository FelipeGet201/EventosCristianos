<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>f6f90453-2a99-4c29-b263-11a91966d174</UserSecretsId>
		<AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Plantillas\**" />
		<Compile Remove="wwwroot\Libros\**" />
		<Content Remove="Plantillas\**" />
		<Content Remove="wwwroot\Libros\**" />
		<EmbeddedResource Remove="Plantillas\**" />
		<EmbeddedResource Remove="wwwroot\Libros\**" />
		<None Remove="Plantillas\**" />
		<None Remove="wwwroot\Libros\**" />
	</ItemGroup>

	<ItemGroup>
	  <Content Remove="appsettings.Development.json" />
	  <Content Remove="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="appsettings.dev.data" />
	  <None Remove="appsettings.prd.data" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="appsettings.dev.data">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	  <Content Include="appsettings.prd.data">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<None Include="appsettings.json" />
		<None Include="wwwroot\Images\ixoye.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="CloudinaryDotNet" Version="1.28.0" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
		<PackageReference Include="QRCoder" Version="1.7.0" />
		<PackageReference Include="QuestPDF" Version="2025.12.4" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
		<PackageReference Include="Stripe.net" Version="50.1.0" />
		<PackageReference Include="Twilio" Version="7.14.3" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="wwwroot\css\estilos_pagina.css">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\css\movimiento_peces.css">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\js\movimiento_peces.js">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Properties\PublishProfiles\" />
	  <Folder Include="wwwroot\Images\plantillas\demo\" />
	  <Folder Include="wwwroot\img\" />
	</ItemGroup>
</Project>
