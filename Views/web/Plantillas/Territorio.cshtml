@model RedAJP.Models.IglesiaWebPublicaViewModel
@{
    Layout = "~/Views/Shared/LayoutPaginasWEB.cshtml";
    string nombreReal = string.IsNullOrWhiteSpace(Model.NombreIglesia) ? "" : Model.NombreIglesia;
    ViewData["Title"] = nombreReal;

    bool hasEventos = Model.Eventos != null && Model.Eventos.Any();
    bool hasAvisos = Model.Avisos != null && Model.Avisos.Any();
    bool hasMap = (Model.Latitud.HasValue && Model.Longitud.HasValue) || !string.IsNullOrWhiteSpace(Model.MapaUrl);
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;700;800;900&display=swap" rel="stylesheet">

<style>
    :root {
        --geo-bg: #F4F7F9;
        --geo-surface: #FFFFFF;
        --geo-primary: #0F172A;
        --geo-text: #334155;
        --geo-muted: #64748B;
        --geo-border: #E2E8F0;
        --geo-accent: #E11D48;
        --geo-accent-hover: #BE123C;
        --font-heading: 'Outfit', sans-serif;
        --font-body: 'Inter', sans-serif;
    }

    body {
        background-color: var(--geo-bg);
        color: var(--geo-text);
        font-family: var(--font-body);
        line-height: 1.7;
        overflow-x: hidden;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-heading);
        color: var(--geo-primary);
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0;
    }

    /* Navbar Flotante Limpio */
    .navbar-geo {
        background-color: var(--geo-surface);
        border-bottom: 1px solid var(--geo-border);
        padding: 1rem 0;
    }

    .navbar-brand {
        font-family: var(--font-heading);
        font-weight: 900;
        font-size: 1.5rem;
        color: var(--geo-primary) !important;
        letter-spacing: -0.5px;
    }

    .nav-link-geo {
        color: var(--geo-muted);
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-left: 2rem;
        text-decoration: none;
        transition: color 0.3s;
    }

        .nav-link-geo:hover {
            color: var(--geo-primary);
        }

    /* Botones */
    .btn-geo {
        background-color: var(--geo-accent);
        color: #ffffff;
        border: none;
        border-radius: 50px;
        padding: 14px 30px;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(225, 29, 72, 0.2);
    }

        .btn-geo:hover {
            background-color: var(--geo-accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(225, 29, 72, 0.3);
            color: #ffffff;
        }

    .btn-geo-outline {
        background-color: var(--geo-surface);
        color: var(--geo-primary);
        border: 2px solid var(--geo-border);
        border-radius: 50px;
        padding: 12px 28px;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: all 0.3s ease;
    }

        .btn-geo-outline:hover {
            border-color: var(--geo-primary);
            background-color: var(--geo-bg);
            color: var(--geo-primary);
        }

    /* Hero Dividido (Split Screen con el Mapa) */
    .split-hero {
        display: flex;
        flex-direction: column;
        min-height: 80vh;
        background: var(--geo-surface);
        border-bottom: 1px solid var(--geo-border);
    }

    @@media (min-width: 992px) {
        .split-hero {
            flex-direction: row;
            height: 85vh;
        }
    }

    .hero-info-panel {
        flex: 1;
        padding: 4rem 2rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    @@media (min-width: 992px) {
        .hero-info-panel {
            padding: 0 5%;
        }
    }

    @@media (min-width: 1400px) {
        .hero-info-panel {
            padding: 0 10%;
        }
    }

    .hero-map-panel {
        flex: 1;
        min-height: 400px;
        background: var(--geo-bg);
        position: relative;
    }

        .hero-map-panel iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            filter: contrast(1.1);
        }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        background: rgba(225, 29, 72, 0.1);
        color: var(--geo-accent);
        padding: 8px 16px;
        border-radius: 50px;
        font-weight: 800;
        font-size: 0.85rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 2rem;
    }

    .display-hero {
        color: var(--geo-primary);
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        margin-bottom: 1.5rem;
        line-height: 1.1;
    }

    /* Tablero Horizontal de Horarios */
    .dashboard-bar {
        background: var(--geo-primary);
        color: #ffffff;
        padding: 2.5rem 0;
        border-bottom: 4px solid var(--geo-accent);
    }

    .dashboard-item {
        border-right: 1px solid rgba(255,255,255,0.1);
        padding: 0 2rem;
    }

        .dashboard-item:last-child {
            border-right: none;
        }

    @@media (max-width: 767px) {
        .dashboard-item {
            border-right: none;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding: 1.5rem 0;
        }

            .dashboard-item:last-child {
                border-bottom: none;
            }
    }

    /* Secciones Generales */
    .geo-section {
        padding: 6rem 0;
    }

    .section-title {
        font-size: clamp(2rem, 4vw, 3rem);
        margin-bottom: 3rem;
    }

    .geo-label {
        font-family: var(--font-heading);
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--geo-muted);
        display: block;
        margin-bottom: 0.5rem;
    }

    /* Tarjetas de Contenido */
    .geo-card {
        background: var(--geo-surface);
        border: 1px solid var(--geo-border);
        border-radius: 16px;
        padding: 2rem;
        height: 100%;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .geo-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        }

    .event-card {
        padding: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .event-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        background: var(--geo-bg);
        border-bottom: 1px solid var(--geo-border);
    }

    .event-date {
        background: var(--geo-bg);
        border: 1px solid var(--geo-border);
        border-radius: 8px;
        padding: 8px 15px;
        display: inline-block;
        font-weight: 700;
        color: var(--geo-primary);
        margin-bottom: 1rem;
    }

    /* Puntos Doctrinales Adaptados */
    .doctrina-wrapper {
        border: none;
        background: transparent;
        padding: 0;
    }

        .doctrina-wrapper .doctrina-header {
            display: none;
        }

        .doctrina-wrapper .accordion {
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid var(--geo-border);
            background: var(--geo-surface);
            box-shadow: 0 10px 30px rgba(0,0,0,0.02) !important;
        }

        .doctrina-wrapper .doctrina-item {
            border-bottom: 1px solid var(--geo-border) !important;
        }

        .doctrina-wrapper .doctrina-btn {
            background: transparent;
            color: var(--geo-primary);
            font-family: var(--font-heading);
            font-size: 1.1rem;
            padding: 1.2rem 1.5rem;
        }

            .doctrina-wrapper .doctrina-btn:not(.collapsed) {
                background: rgba(15, 23, 42, 0.03);
                color: var(--geo-primary);
                box-shadow: none;
            }

        .doctrina-wrapper .doctrina-num {
            color: var(--geo-accent) !important;
            font-family: var(--font-heading);
            font-weight: 900;
            font-size: 1.2rem;
        }

        .doctrina-wrapper .doctrina-body {
            padding: 1.5rem;
            color: var(--geo-text) !important;
        }

    /* Galería */
    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1rem;
    }

    .gallery-item {
        border-radius: 12px;
        overflow: hidden;
        aspect-ratio: 1/1;
        background: var(--geo-border);
        position: relative;
    }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .gallery-item:hover img {
            transform: scale(1.05);
        }

    .gallery-caption {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 2rem 1rem 1rem;
        background: linear-gradient(to top, rgba(15,23,42,0.9), transparent);
        color: #ffffff;
        font-weight: 600;
        font-family: var(--font-body);
        font-size: 0.95rem;
    }

    /* Footer */
    .geo-footer {
        background: var(--geo-primary);
        color: #F8FAFC;
        padding: 4rem 0 2rem;
    }

    .social-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        transition: all 0.3s ease;
        text-decoration: none;
    }

        .social-icon:hover {
            background: var(--geo-accent);
            border-color: var(--geo-accent);
            color: white;
            transform: translateY(-3px);
        }
</style>

<nav class="navbar-geo sticky-top">
    <div class="container d-flex justify-content-between align-items-center">
        <a class="navbar-brand text-decoration-none" href="#">@nombreReal</a>
        <div class="d-none d-lg-flex align-items-center">
            @if (hasEventos || hasAvisos)
            {
                <a href="#actividad" class="nav-link-geo">Actividad</a>
            }
            <a href="#identidad" class="nav-link-geo">Identidad</a>
            @if (Model.Galeria != null && Model.Galeria.Any())
            {
                <a href="#galeria" class="nav-link-geo">Galería</a>
            }
            @if (Model.Multimedia != null && Model.Multimedia.Any())
            {
                <a href="#multimedia" class="nav-link-geo">Multimedia</a>
            }
        </div>
        <button class="btn btn-light border d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#navGeo">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>
</nav>

<div class="collapse bg-white border-bottom d-lg-none" id="navGeo">
    <div class="container py-3 d-flex flex-column text-center gap-3">
        @if (hasEventos || hasAvisos)
        {
            <a href="#actividad" class="text-dark text-decoration-none fw-bold text-uppercase">Actividad</a>
        }
        <a href="#identidad" class="text-dark text-decoration-none fw-bold text-uppercase">Identidad</a>
        @if (Model.Galeria != null && Model.Galeria.Any())
        {
            <a href="#galeria" class="text-dark text-decoration-none fw-bold text-uppercase">Galería</a>
        }
        @if (Model.Multimedia != null && Model.Multimedia.Any())
        {
            <a href="#multimedia" class="text-dark text-decoration-none fw-bold text-uppercase">Multimedia</a>
        }
    </div>
</div>

<main>
    <section class="split-hero fade-in-up">
        <div class="hero-info-panel">
            <div class="hero-badge align-self-start">
                <i class="fa-solid fa-map-pin me-2"></i> Encuéntranos
            </div>

            <h1 class="display-hero">@nombreReal</h1>

            @if (!string.IsNullOrWhiteSpace(Model.DireccionCompleta) || !string.IsNullOrWhiteSpace(Model.Municipio))
            {
                <div class="mb-5">
                    @if (!string.IsNullOrWhiteSpace(Model.DireccionCompleta))
                    {
                        <p class="fs-5 fw-medium mb-1" style="color: var(--geo-primary);">@Model.DireccionCompleta</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Municipio))
                    {
                        <p class="fs-5 text-muted">@Model.Municipio</p>
                    }
                </div>
            }

            <div class="d-flex flex-wrap gap-3">
                @if (!string.IsNullOrWhiteSpace(Model.MapaUrl))
                {
                    <a href="@Model.MapaUrl" target="_blank" class="btn-geo">
                        <i class="fa-solid fa-location-arrow me-2"></i> Iniciar Ruta en Maps
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Whatsapp))
                {
                    <a href="https://wa.me/52@(Model.Whatsapp)" target="_blank" class="btn-geo-outline">
                        <i class="fa-brands fa-whatsapp me-2"></i> Escribir Directo
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Telefono))
                {
                    <a href="tel:@Model.Telefono" class="btn-geo-outline d-flex d-sm-none">
                        <i class="fa-solid fa-phone me-2"></i> Llamar
                    </a>
                }
            </div>
        </div>

        @if (hasMap)
        {
            <div class="hero-map-panel border-start">
                @if (Model.Latitud.HasValue && Model.Longitud.HasValue)
                {
                    <iframe src="https://maps.google.com/maps?q=@@latLng&z=15&output=embed" frameborder="0" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>
                }
                else if (!string.IsNullOrWhiteSpace(Model.MapaUrl) && Model.MapaUrl.Contains("google"))
                {
                    <iframe src="@Model.MapaUrl" frameborder="0" allowfullscreen></iframe>
                }
            </div>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Horarios))
    {
        <div class="dashboard-bar fade-in-up">
            <div class="container">
                <div class="row text-center text-md-start">
                    @{
                        var lineas = Model.Horarios.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries).Take(3);
                        foreach (var linea in lineas)
                        {
                            var partes = linea.Split(" | ");
                            if (partes.Length == 3)
                            {
                                <div class="col-md-4 dashboard-item">
                                    <span class="d-block text-white text-uppercase fw-bold opacity-75 mb-1" style="font-size: 0.8rem; letter-spacing: 1px;">@partes[0]</span>
                                    <span class="d-block text-white fs-4 fw-bold mb-1">@partes[1]</span>
                                    <span class="d-block text-white opacity-75 small theme-strict-text">@partes[2]</span>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    }

    @if (hasEventos || hasAvisos)
    {
        <section id="actividad" class="geo-section fade-in-up">
            <div class="container">
                <div class="row g-5">

                    @if (hasEventos)
                    {
                        <div class="@(hasAvisos ? "col-lg-7" : "col-lg-10 mx-auto")">
                            <span class="geo-label">Agenda Local</span>
                            <h2 class="section-title">Próximos Eventos</h2>
                            <div class="row g-4">
                                @foreach (var ev in Model.Eventos)
                                {
                                    <div class="col-md-6">
                                        <div class="geo-card event-card border-0 shadow-sm">
                                            @if (!string.IsNullOrWhiteSpace(ev.ImagenUrl))
                                            {
                                                <img src="@ev.ImagenUrl" alt="Evento" class="event-img" loading="lazy">
                                            }
                                            <div class="p-4 d-flex flex-column flex-grow-1">
                                                @if (ev.Fecha != default)
                                                {
                                                    <div class="event-date align-self-start">
                                                        <i class="fa-regular fa-calendar-days me-2" style="color: var(--geo-accent);"></i> @ev.Fecha.ToString("dd MMM yyyy")
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(ev.Titulo))
                                                {
                                                    <h4 class="mb-2 fs-5">@ev.Titulo</h4>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(ev.Horarios))
                                                {
                                                    <p class="text-muted fw-medium small mb-2"><i class="fa-regular fa-clock me-1"></i> @ev.Horarios</p>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(ev.Descripcion))
                                                {
                                                    <p class="text-muted small mb-0 mt-auto theme-strict-text">
                                                        @Html.Raw(ev.Descripcion.Replace("\n", "<br>"))
                                                    </p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (hasAvisos)
                    {
                        <div class="@(hasEventos ? "col-lg-5" : "col-lg-8 mx-auto")">
                            <span class="geo-label">Tablero de Avisos</span>
                            <h2 class="section-title">Información</h2>
                            <div class="d-flex flex-column gap-3">
                                @foreach (var aviso in Model.Avisos)
                                {
                                    <div class="geo-card p-4 border-0 shadow-sm" style="border-left: 4px solid var(--geo-accent) !important;">
                                        @if (!string.IsNullOrWhiteSpace(aviso.Titulo))
                                        {
                                            <h6 class="mb-2 fs-5">@aviso.Titulo</h6>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(aviso.Descripcion))
                                        {
                                            <p class="text-muted small mb-3 theme-strict-text">@Html.Raw(aviso.Descripcion.Replace("\n", "<br>").Replace("\r\n", "<br>"))</p>
                                        }
                                        @if (aviso.FechaInicio != default || aviso.FechaExpiracion != default)
                                        {
                                            <div class="border-top pt-3 d-flex justify-content-between text-muted" style="border-color: var(--geo-border); font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">
                                                @if (aviso.FechaInicio != default)
                                                {
                                                    <span>Del: @aviso.FechaInicio.ToString("dd/MM/yy")</span>
                                                }
                                                @if (aviso.FechaExpiracion != default)
                                                {
                                                    <span>Al: @aviso.FechaExpiracion.ToString("dd/MM/yy")</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                </div>
            </div>
        </section>
    }

    <section id="identidad" class="geo-section bg-white border-top border-bottom">
        <div class="container fade-in-up">
            <div class="row g-5">

                @if (!string.IsNullOrWhiteSpace(Model.Historia))
                {
                    <div class="col-lg-5">
                        <span class="geo-label">Identidad Local</span>
                        <h2 class="section-title">Quiénes Somos</h2>
                        <div class="text-muted theme-strict-text" style="line-height: 1.8; text-align: justify;">
                            @Html.Raw(Model.Historia.Replace("\n", "<br>").Replace("\r\n", "<br>"))
                        </div>
                    </div>
                }

                <div class="@(!string.IsNullOrWhiteSpace(Model.Historia) ? "col-lg-7" : "col-lg-8 mx-auto")">
                    <span class="geo-label">Fundamentos</span>
                    <h2 class="section-title">Nuestra Doctrina</h2>
                    @await Html.PartialAsync("../_PuntosDoctrinales.cshtml")
                </div>

            </div>
        </div>
    </section>

    @if ((Model.Galeria != null && Model.Galeria.Any()) || (Model.Multimedia != null && Model.Multimedia.Any()))
    {
        <section class="geo-section fade-in-up">
            <div class="container">

                @if (Model.Galeria != null && Model.Galeria.Any())
                {
                    <div id="galeria" class="@(Model.Multimedia != null && Model.Multimedia.Any() ? "mb-5 pb-5 border-bottom" : "")">
                        <span class="geo-label text-center">Registros Visuales</span>
                        <h2 class="section-title text-center">Nuestras Instalaciones</h2>
                        <div class="gallery-grid">
                            @foreach (var img in Model.Galeria)
                            {
                                @if (!string.IsNullOrWhiteSpace(img.UrlImagen))
                                {
                                    <div class="gallery-item shadow-sm">
                                        <img src="@img.UrlImagen" alt="@(img.Titulo ?? "Foto")" loading="lazy">
                                        @if (!string.IsNullOrWhiteSpace(img.Titulo))
                                        {
                                            <div class="gallery-caption">
                                                <span class="text-truncate d-block">@img.Titulo</span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }

                @if (Model.Multimedia != null && Model.Multimedia.Any())
                {
                    <div id="multimedia">
                        <span class="geo-label text-center">Contenido en Línea</span>
                        <h2 class="section-title text-center">Mensajes Destacados</h2>
                        <div class="row g-4 justify-content-center">
                            @foreach (var m in Model.Multimedia)
                            {
                                @if (!string.IsNullOrWhiteSpace(m.UrlEmbed))
                                {
                                    <div class="col-lg-6">
                                        <div class="geo-card p-3 border-0 shadow-sm">
                                            @if (!string.IsNullOrWhiteSpace(m.Titulo))
                                            {
                                                <h6 class="mb-3 px-2 text-center fs-5">@m.Titulo</h6>
                                            }
                                            <div class="ratio ratio-16x9 rounded-3 overflow-hidden bg-light border">
                                                @{
                                                    string embedUrl = m.UrlEmbed;
                                                    string ytId = "";
                                                    if (embedUrl.Contains("youtu.be/")) ytId = embedUrl.Split(new[] { "youtu.be/" }, StringSplitOptions.None)[1];
                                                    else if (embedUrl.Contains("watch?v=")) ytId = embedUrl.Split(new[] { "watch?v=" }, StringSplitOptions.None)[1];
                                                    else if (embedUrl.Contains("embed/")) ytId = embedUrl.Split(new[] { "embed/" }, StringSplitOptions.None)[1];
                                                    else if (embedUrl.Contains("/shorts/")) ytId = embedUrl.Split(new[] { "shorts/" }, StringSplitOptions.None)[1];
                                                    else if (embedUrl.Contains("/live/")) ytId = embedUrl.Split(new[] { "live/" }, StringSplitOptions.None)[1];
                                                    if (!string.IsNullOrEmpty(ytId)) { embedUrl = "https://www.youtube.com/embed/" + ytId.Split('?')[0].Split('&')[0].Trim('/'); }
                                                }
                                                <iframe src="@embedUrl" frameborder="0" allowfullscreen></iframe>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }

            </div>
        </section>
    }
</main>

<footer class="geo-footer">
    <div class="container">
        <div class="row g-4 align-items-center mb-4 pb-4 border-bottom" style="border-color: rgba(255,255,255,0.1) !important;">
            <div class="col-md-6 text-center text-md-start">
                <h3 class="mb-3 text-white fs-3">@nombreReal</h3>

                @if (!string.IsNullOrWhiteSpace(Model.Municipio))
                {
                    <p class="mb-0 text-white-50">
                        <i class="fa-solid fa-location-dot me-2" style="color: var(--geo-accent);"></i> @Model.Municipio
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Telefono))
                {
                    <div class="mt-3">
                        <a href="tel:@Model.Telefono" class="text-white-50 text-decoration-none d-block"><i class="fa-solid fa-phone me-2"></i> @Model.Telefono</a>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl) || !string.IsNullOrWhiteSpace(Model.InstagramUrl) || !string.IsNullOrWhiteSpace(Model.YoutubeUrl))
            {
                <div class="col-md-6 text-center text-md-end mt-4 mt-md-0">
                    <div class="d-flex justify-content-center justify-content-md-end gap-3">
                        @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                        {
                            <a href="@Model.FacebookUrl" target="_blank" class="social-icon"><i class="fa-brands fa-facebook-f"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                        {
                            <a href="@Model.InstagramUrl" target="_blank" class="social-icon"><i class="fa-brands fa-instagram"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.YoutubeUrl))
                        {
                            <a href="@Model.YoutubeUrl" target="_blank" class="social-icon"><i class="fa-brands fa-youtube"></i></a>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-white-50" style="font-size: 0.85rem;">
            <p class="mb-2 mb-md-0">© @DateTime.Now.Year @nombreReal. Todos los derechos reservados.</p>
            @if (!string.IsNullOrWhiteSpace(Model.PlantillaVista))
            {
                <p class="mb-0">Plantilla: @Model.PlantillaVista</p>
            }
        </div>
    </div>
</footer>