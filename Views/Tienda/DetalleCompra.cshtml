@model RedAJP.Models.PedidoDetalleViewModel
@{
    Layout = "Principal";
    ViewData["Title"] = $"Pedido #{Model.IdPedido}";
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-usuario');
            activarMenu('submenu-miscompras');
        }
    });
</script>

<div class="container py-5 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Pedido #@Model.IdPedido</h2>
        <a href="@Url.Action("MisCompras")" class="btn btn-outline-secondary rounded-pill">
            <i class="fa-solid fa-arrow-left me-2"></i> Volver
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-box-open me-2 text-muted"></i> Productos</h5>
                </div>
                <div class="card-body p-0">
                    @foreach (var item in Model.Productos)
                    {
                        <div class="d-flex align-items-center p-3 border-bottom">
                            <div class="rounded-3 bg-light overflow-hidden flex-shrink-0" style="width: 70px; height: 70px;">
                                @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                {
                                    <img src="@item.ImagenUrl" class="w-100 h-100 object-fit-cover">
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100 text-muted"><i class="fa-solid fa-image"></i></div>
                                }
                            </div>
                            <div class="ms-3 flex-grow-1">
                                <h6 class="mb-1 fw-bold">@item.Nombre</h6>
                                <small class="text-muted d-block">@item.Especificaciones</small>
                                <small class="text-primary fw-bold">@item.Cantidad x $@item.Precio.ToString("N2")</small>
                            </div>
                            <div class="text-end fw-bold">
                                $@item.Subtotal.ToString("N2")
                            </div>
                        </div>
                    }

                    <div class="p-3 bg-light">
                        @if (Model.MontoDescuento > 0)
                        {
                            <div class="d-flex justify-content-end mb-2 text-muted small">
                                <span class="me-3">Subtotal:</span>
                                <span>$@((Model.Total + Model.MontoDescuento).ToString("N2"))</span>
                            </div>
                            <div class="d-flex justify-content-end mb-2 text-success fw-bold small">
                                <span class="me-3"><i class="fa-solid fa-ticket me-1"></i> Descuento (@Model.CodigoCupon):</span>
                                <span>-$@Model.MontoDescuento.ToString("N2")</span>
                            </div>
                            <hr class="my-2 ms-auto" style="width: 200px;">
                        }
                        <div class="text-end">
                            <span class="fs-5 fw-bold text-dark">Total: $@Model.Total.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 position-relative overflow-hidden bg-white">
                <div class="position-absolute top-0 start-0 h-100 bg-primary" style="width: 4px;"></div>
                <div class="card-body d-flex flex-wrap justify-content-between align-items-center p-4 ps-5">
                    <div>
                        <h5 class="fw-bold text-dark mb-1"><i class="fa-regular fa-comments text-primary me-2"></i> Mensajes del Pedido</h5>
                        <p class="text-muted small mb-0">Comunícate con administración para dudas de la entrega.</p>
                    </div>

                    <div class="position-relative mt-3 mt-md-0">
                        <a href="@Url.Action("MensajesPedido", "Tienda", new { id = Model.IdPedido })" class="btn btn-outline-primary rounded-pill px-4 shadow-sm fw-bold">
                            <i class="fa-solid fa-paper-plane me-1"></i> Abrir Chat
                        </a>
                        @if (Model.MensajesSinLeer > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light border-2 shadow-sm pulse">
                                @Model.MensajesSinLeer
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center bg-white">
                <div class="card-body p-4">
                    <h5 class="text-muted mb-3">Estatus del Pedido</h5>

                    @if (Model.IdEstatus == 30) // LISTO PARA RECOGER
                    {
                        <span class="badge bg-success fs-6 mb-3 px-3 py-2">
                            <i class="fa-solid fa-check me-2"></i> @Model.NombreEstatus
                        </span>
                        <div class="alert alert-warning mt-2 border-0 rounded-3">
                            <p class="mb-1 small text-uppercase fw-bold text-muted">Código de Entrega</p>
                            <h1 class="fw-bold text-dark display-6 mb-0" style="letter-spacing: 2px;">@Model.CodigoEntrega</h1>
                            <hr>
                            <small class="text-muted d-block">Muestra este código en tienda para recoger tus productos.</small>
                        </div>
                    }
                    else if (Model.IdEstatus == 15) // PENDIENTE / VERIFICANDO
                    {
                        <span class="badge bg-warning text-dark fs-6 mb-4 px-3 py-2">
                            <i class="fa-solid fa-clock me-2"></i> @Model.NombreEstatus
                        </span>

                        <div class="d-grid gap-2">
                            @if (string.IsNullOrEmpty(Model.IdPagoMP))
                            {
                                <div class="alert alert-light border small text-muted mb-3">
                                    Parece que no completaste el pago. Puedes retomar tu carrito ahora.
                                </div>
                                <form action="@Url.Action("ReactivarPedido", "Tienda")" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idPedido" value="@Model.IdPedido" />
                                    <button type="submit" class="btn btn-warning text-dark fw-bold w-100 py-2 shadow-sm rounded-pill">
                                        <i class="fa-solid fa-credit-card me-2"></i> Retomar Pago
                                    </button>
                                </form>
                            }
                            else
                            {
                                <div class="alert alert-light border small text-muted mb-3">
                                    Tienes un pago registrado o un ticket pendiente (Ref: @Model.IdPagoMP).
                                </div>
                                <form action="@Url.Action("ReactivarPedido", "Tienda")" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idPedido" value="@Model.IdPedido" />
                                    <button type="submit" class="btn btn-outline-primary fw-bold w-100 py-2 rounded-pill">
                                        <i class="fa-solid fa-rotate me-2"></i> Verificar Estatus
                                    </button>
                                </form>
                            }
                        </div>
                    }
                    else if (Model.IdEstatus == 50) // ENTREGADO
                    {
                        <div class="py-4">
                            <div class="mb-3">
                                <span class="fa-stack fa-2x">
                                    <i class="fa-solid fa-circle fa-stack-2x text-light"></i>
                                    <i class="fa-solid fa-check fa-stack-1x text-success"></i>
                                </span>
                            </div>
                            <h4 class="fw-bold">¡Entregado!</h4>
                            <p class="text-muted small">Esperamos que disfrutes tu compra.</p>
                            <span class="badge bg-dark">Finalizado</span>
                        </div>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">@Model.NombreEstatus</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>