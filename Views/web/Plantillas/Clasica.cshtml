@model RedAJP.Models.IglesiaWebPublicaViewModel
@{
    Layout = "~/Views/Shared/LayoutPaginasWEB.cshtml";
    ViewData["Title"] = Model.NombreIglesia;

    // Imagen de fondo para el Header
    string heroBg = Model.Galeria.FirstOrDefault()?.UrlImagen ?? "";

    // Lógica inteligente para el Título Principal: Evita duplicar la palabra "Iglesia"
    string nombrePrincipal = Model.NombreIglesia?.Trim() ?? "";
    if (!string.IsNullOrEmpty(nombrePrincipal) && !nombrePrincipal.StartsWith("Iglesia", StringComparison.OrdinalIgnoreCase))
    {
        nombrePrincipal = "IGLESIA " + nombrePrincipal;
    }
}

<style>
    /* ========================================== */
    /* ESTILOS GENERALES CLÁSICA                  */
    /* ========================================== */
    .clasica-hero {
        /* Bajamos la opacidad a 0.70 y usamos Html.Raw para que la URL no se rompa */
        background: linear-gradient(rgba(0, 43, 54, 0.70), rgba(0, 95, 115, 0.70)), url('@Html.Raw(heroBg)') center/cover no-repeat;
        color: #ffffff;
        padding: 120px 0;
    }

    .clasica-navbar {
        background-color: #002b36;
    }

    .section-title {
        color: #005f73;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 2rem;
        position: relative;
        padding-bottom: 10px;
    }

        .section-title::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            height: 4px;
            width: 60px;
            background-color: #ee9b00; /* Dorado */
            border-radius: 2px;
        }

        .section-title.text-center::after {
            left: 50%;
            transform: translateX(-50%);
        }

    .card-evento {
        transition: transform 0.3s, box-shadow 0.3s;
        border: 1px solid #e9ecef;
    }

        .card-evento:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .bg-light-alt {
        background-color: #f8f9fa;
    }

    .text-readable {
        color: #333333;
        line-height: 1.8;
    }

    /* ========================================== */
    /* ADAPTACIÓN DE LOS PUNTOS DOCTRINALES       */
    /* ========================================== */
    .doctrina-wrapper .doctrina-main-title {
        color: #005f73;
    }

    .doctrina-wrapper .doctrina-badge {
        background-color: #005f73 !important;
    }

    .doctrina-wrapper .doctrina-num {
        color: #ee9b00 !important;
        font-size: 1.2rem;
        font-weight: 900;
    }

    .doctrina-wrapper .doctrina-title {
        color: #002b36 !important;
        font-size: 1.05rem;
    }

    .doctrina-wrapper .accordion-button:not(.collapsed) {
        background-color: #f4f6f8;
        border-bottom: 2px solid #005f73;
    }

    .doctrina-wrapper .accordion-button:focus {
        box-shadow: 0 0 0 0.25rem rgba(0, 95, 115, 0.25);
    }
</style>

<nav class="navbar navbar-expand-lg navbar-dark clasica-navbar sticky-top shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="#"><i class="fa-solid fa-church me-2 text-warning"></i> @Model.NombreIglesia</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto fw-semibold">
                @if (!string.IsNullOrEmpty(Model.Historia))
                {
                    <li class="nav-item"><a class="nav-link" href="#nosotros">Nosotros</a></li>
                }
                <li class="nav-item"><a class="nav-link" href="#doctrina">Doctrina</a></li>
                @if (Model.Eventos.Any() || Model.Avisos.Any())
                {
                    <li class="nav-item"><a class="nav-link" href="#actividad">Actividad</a></li>
                }
                @if (Model.Multimedia.Any())
                {
                    <li class="nav-item"><a class="nav-link" href="#medios">Mensajes</a></li>
                }
                @if (Model.Galeria.Any())
                {
                    <li class="nav-item"><a class="nav-link" href="#galeria">Galería</a></li>
                }
                <li class="nav-item"><a class="nav-link text-warning" href="#contacto">Contacto</a></li>
            </ul>
        </div>
    </div>
</nav>

<header class="clasica-hero text-center fade-in-up">
    <div class="container px-4">
        <h1 class="display-3 fw-bold mb-3 text-white text-uppercase">@nombrePrincipal</h1>

        @if (!string.IsNullOrEmpty(Model.Municipio))
        {
            <p class="fs-4 mb-4 text-white opacity-75"><i class="fa-solid fa-location-dot me-2"></i> @Model.Municipio</p>
        }

        <div class="d-flex justify-content-center gap-3 flex-wrap mt-4">
            @if (!string.IsNullOrEmpty(Model.Whatsapp))
            {
                <a href="https://wa.me/52@(Model.Whatsapp)?text=Hola,%20me%20gustaría%20solicitar%20información." target="_blank" class="btn btn-warning btn-lg rounded-pill fw-bold shadow-sm px-4 text-dark">
                    <i class="fa-brands fa-whatsapp me-2"></i> WhatsApp
                </a>
            }
            @if (!string.IsNullOrEmpty(Model.Telefono))
            {
                <a href="tel:@Model.Telefono" class="btn btn-warning btn-lg rounded-pill fw-bold shadow-sm px-4 text-dark">
                    <i class="fa-solid fa-phone me-2"></i> Llamar
                </a>
            }
            @if (!string.IsNullOrEmpty(Model.Horarios))
            {
                <a href="#contacto" class="btn btn-outline-light btn-lg rounded-pill fw-bold px-4">
                    Ver Horarios
                </a>
            }
        </div>
    </div>
</header>

<main>
    @if (!string.IsNullOrEmpty(Model.Historia) || Model.Avisos.Any() || Model.Galeria.Any())
    {
        <section class="container py-5" id="nosotros">
            <div class="row g-5 @(string.IsNullOrEmpty(Model.Historia) ? "justify-content-center" : "")">

                @if (!string.IsNullOrEmpty(Model.Historia))
                {
                    <div class="col-lg-7 fade-in-up">
                        <h2 class="section-title">Quiénes Somos</h2>
                        <div class="text-readable fs-5 text-justify theme-strict-text">
                            @Html.Raw(Model.Historia.Replace("\n", "<br>").Replace("\r\n", "<br>"))
                        </div>
                    </div>
                }

                @if (Model.Avisos.Any() || Model.Galeria.Any())
                {
                    <div class="@(string.IsNullOrEmpty(Model.Historia) ? "col-lg-8 mx-auto" : "col-lg-5") fade-in-up">
                        @if (Model.Avisos.Any())
                        {
                            <div class="card border-0 shadow-sm rounded-4 bg-light-alt p-4 h-100">
                                <h4 class="fw-bold text-dark mb-4"><i class="fa-solid fa-bullhorn text-warning me-2"></i> Avisos Próximos</h4>
                                <div class="d-flex flex-column gap-3">
                                    @foreach (var aviso in Model.Avisos)
                                    {
                                        <div class="bg-white p-3 rounded-3 shadow-sm border-start border-4 border-warning">
                                            <h6 class="fw-bold text-dark mb-1">@aviso.Titulo</h6>
                                            @if (!string.IsNullOrEmpty(aviso.Descripcion))
                                            {
                                                <p class="small text-muted mb-0 theme-strict-text">
                                                    @Html.Raw(aviso.Descripcion.Replace("\\n", "<br>").Replace("\r\n", "<br>").Replace("\n", "<br>"))
                                                </p>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else if (Model.Galeria.Any())
                        {
                            <img src="@Model.Galeria.Last().UrlImagen" class="w-100 rounded-4 shadow-sm" style="object-fit: cover; height: 100%; min-height: 300px;" alt="Iglesia" />
                        }
                    </div>
                }
            </div>
        </section>
    }

    <section class="bg-white border-top py-5" id="doctrina">
        <div class="container fade-in-up" style="max-width: 900px;">
            @await Html.PartialAsync("../_PuntosDoctrinales.cshtml")
        </div>
    </section>

    @if (Model.Eventos.Any())
    {
        <section class="bg-light-alt border-top py-5" id="actividad">
            <div class="container fade-in-up">
                <h2 class="section-title text-center">Agenda de Actividades</h2>
                <div class="row g-4 mt-2 justify-content-center">
                    @foreach (var ev in Model.Eventos)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm rounded-4 card-evento bg-white overflow-hidden">
                                @if (!string.IsNullOrEmpty(ev.ImagenUrl))
                                {
                                    <img src="@ev.ImagenUrl" class="card-img-top border-bottom" style="height: 220px; object-fit: cover;" alt="Evento">
                                }
                                <div class="card-body p-4 d-flex flex-column">
                                    <h5 class="fw-bold text-dark mb-3">@ev.Titulo</h5>
                                    @if (!string.IsNullOrEmpty(ev.Descripcion))
                                    {
                                        <p class="text-muted small mb-4 flex-grow-1 theme-strict-text">
                                            @Html.Raw(ev.Descripcion.Replace("\\n", "<br>").Replace("\r\n", "<br>").Replace("\n", "<br>"))
                                        </p>
                                    }
                                    <div class="mt-auto p-3 bg-light rounded-3">
                                        <div class="text-primary fw-bold small mb-1"><i class="fa-solid fa-calendar-day me-2"></i> @ev.Fecha.ToString("dd MMMM yyyy")</div>
                                        <div class="text-dark small fw-bold theme-strict-text">
                                            <i class="fa-solid fa-clock me-2 text-primary"></i>
                                            @if (!string.IsNullOrEmpty(ev.Horarios))
                                            {
                                                @Html.Raw(ev.Horarios.Replace("\\n", "<br>").Replace("\r\n", "<br>").Replace("\n", "<br>"))
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @if (Model.Multimedia.Any())
    {
        <section class="py-5 bg-dark text-white" id="medios">
            <div class="container fade-in-up">
                <div class="text-center mb-5">
                    <h2 class="fw-bold text-uppercase mb-2 text-white">Mensajes y Predicaciones</h2>
                    <div style="height: 4px; width: 60px; background-color: #ee9b00; border-radius: 2px; margin: 0 auto;"></div>
                </div>
                <div class="row g-4 justify-content-center">
                    @foreach (var m in Model.Multimedia)
                    {
                        <div class="col-md-6 col-lg-6 mb-4">
                            @{
                                string embedUrl = m.UrlEmbed ?? "";
                                string ytId = "";

                                if (embedUrl.Contains("youtu.be/")) ytId = embedUrl.Split(new[] { "youtu.be/" }, StringSplitOptions.None)[1];
                                else if (embedUrl.Contains("watch?v=")) ytId = embedUrl.Split(new[] { "watch?v=" }, StringSplitOptions.None)[1];
                                else if (embedUrl.Contains("embed/")) ytId = embedUrl.Split(new[] { "embed/" }, StringSplitOptions.None)[1];
                                else if (embedUrl.Contains("/shorts/")) ytId = embedUrl.Split(new[] { "/shorts/" }, StringSplitOptions.None)[1];
                                else if (embedUrl.Contains("/live/")) ytId = embedUrl.Split(new[] { "/live/" }, StringSplitOptions.None)[1];
                                if (!string.IsNullOrEmpty(ytId))
                                {
                                    ytId = ytId.Split('?')[0].Split('&')[0].Trim('/');
                                    embedUrl = "https://www.youtube.com/embed/" + ytId;
                                }
                            }
                            <div class="card bg-transparent border-0 h-100">
                                @if (!string.IsNullOrWhiteSpace(m.Titulo))
                                {
                                    <h5 class="fw-bold text-warning mb-3"><i class="fa-solid fa-play me-2"></i>@m.Titulo</h5>
                                }
                                <div class="ratio ratio-16x9 rounded-4 overflow-hidden shadow-lg border border-secondary">
                                    <iframe src="@embedUrl" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @if (Model.Galeria.Any())
    {
        <section class="container py-5 border-top" id="galeria">
            <div class="fade-in-up">
                <h2 class="section-title text-center">Nuestra Comunidad en Imágenes</h2>
                <div class="row g-4 mt-3">
                    @foreach (var img in Model.Galeria)
                    {
                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="card border-0 bg-transparent h-100">
                                <div class="ratio ratio-1x1 shadow-sm rounded-4 overflow-hidden">
                                    <img src="@img.UrlImagen" class="w-100 h-100" style="object-fit: cover; transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" alt="@img.Titulo" />
                                </div>
                                @if (!string.IsNullOrWhiteSpace(img.Titulo))
                                {
                                    <div class="text-center mt-3 px-2">
                                        <h6 class="fw-bold text-dark mb-0">@img.Titulo</h6>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</main>

<footer class="bg-dark text-white pt-5 pb-3 border-top border-4 border-primary mt-auto" id="contacto">
    <div class="container">
        <div class="row g-5 mb-4">
            <div class="col-lg-4">
                <h4 class="fw-bold mb-4 text-warning text-uppercase">@nombrePrincipal</h4>

                @if (!string.IsNullOrEmpty(Model.DireccionCompleta) || !string.IsNullOrEmpty(Model.Municipio))
                {
                    <div class="d-flex mb-3">
                        <i class="fa-solid fa-map-pin fs-5 me-3 text-secondary mt-1"></i>
                        <div>
                            <p class="mb-0 fw-bold">Dirección</p>
                            @if (!string.IsNullOrEmpty(Model.DireccionCompleta))
                            {
                                <p class="text-light small mb-0">@Model.DireccionCompleta</p>
                            }
                            @if (!string.IsNullOrEmpty(Model.Municipio))
                            {
                                <p class="text-light small mb-0">@Model.Municipio</p>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Horarios))
                {
                    <div class="d-flex mb-3">
                        <i class="fa-solid fa-clock fs-5 me-3 text-secondary mt-1"></i>
                        <div class="w-100">
                            <p class="mb-3 fw-bold text-white">Horarios Generales</p>
                            <ul class="list-unstyled mb-0">
                                @{
                                    var lineas = Model.Horarios.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
                                    foreach (var linea in lineas)
                                    {
                                        var partes = linea.Split(" | ");
                                        if (partes.Length == 3)
                                        {
                                            <li class="mb-3 pb-2 border-bottom border-secondary border-opacity-50">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="text-white fw-bold">@partes[0]</span>
                                                    <span class="badge bg-warning text-dark px-2 py-1">@partes[1]</span>
                                                </div>
                                                <small class="text-light opacity-75 d-block">@partes[2]</small>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="text-light small mb-2 theme-strict-text">@linea</li>
                                        }
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4 text-md-center">
                <h5 class="fw-bold mb-4 text-white">Comunícate con Nosotros</h5>

                <div class="d-flex flex-wrap justify-content-md-center gap-3 mb-4">
                    @if (!string.IsNullOrEmpty(Model.Whatsapp))
                    {
                        <a href="https://wa.me/52@(Model.Whatsapp)" class="btn btn-outline-light rounded-pill fw-bold px-4">
                            <i class="fa-brands fa-whatsapp me-2"></i> WhatsApp
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.Telefono))
                    {
                        <a href="tel:@Model.Telefono" class="btn btn-outline-light rounded-pill fw-bold px-4">
                            <i class="fa-solid fa-phone me-2"></i> Llamar
                        </a>
                    }
                </div>

                <div class="d-flex justify-content-md-center gap-3 mt-4">
                    @if (!string.IsNullOrEmpty(Model.FacebookUrl))
                    {
                        <a href="@Model.FacebookUrl" target="_blank" class="text-white fs-3 transition-opacity" style="opacity: 0.8;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.8'"><i class="fa-brands fa-facebook"></i></a>
                    }
                    @if (!string.IsNullOrEmpty(Model.InstagramUrl))
                    {
                        <a href="@Model.InstagramUrl" target="_blank" class="text-white fs-3 transition-opacity" style="opacity: 0.8;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.8'"><i class="fa-brands fa-instagram"></i></a>
                    }
                    @if (!string.IsNullOrEmpty(Model.YoutubeUrl))
                    {
                        <a href="@Model.YoutubeUrl" target="_blank" class="text-white fs-3 transition-opacity" style="opacity: 0.8;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.8'"><i class="fa-brands fa-youtube"></i></a>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <h5 class="fw-bold mb-4 text-white">Ubicación</h5>
                @if (Model.Latitud.HasValue && Model.Longitud.HasValue)
                {
                    string latLng = $"{Model.Latitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{Model.Longitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
                    <div class="ratio ratio-16x9 rounded-4 overflow-hidden shadow border border-secondary">
                        <iframe src="https://maps.google.com/maps?q=@latLng&z=15&output=embed" frameborder="0" style="border:0;" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.MapaUrl))
                    {
                        <div class="text-end mt-2"><a href="@Model.MapaUrl" target="_blank" class="text-warning small text-decoration-none fw-bold">Abrir ruta en Google Maps <i class="fa-solid fa-arrow-right ms-1"></i></a></div>
                    }
                }
                else if (!string.IsNullOrEmpty(Model.MapaUrl))
                {
                    <a href="@Model.MapaUrl" target="_blank" class="btn btn-outline-warning w-100 rounded-pill"><i class="fa-solid fa-map-location-dot me-2"></i> Ver Ubicación en Maps</a>
                }
            </div>
        </div>
        <hr class="border-secondary mt-2 opacity-50">
        <div class="text-center text-secondary small pt-2">© @DateTime.Now.Year @Model.NombreIglesia - Creado en la plataforma de Alianza Juvenil Los Pescadores</div>
    </div>
</footer>