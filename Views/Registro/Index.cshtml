@model RedAJP.Models.Registro

@{
    Layout = "Principal";
    ViewData["Title"] = "Nuevo Registro";
}

<script>
    window.addEventListener('load', function() {
        if(typeof activarMenu === 'function') {
            activarMenu('menu-miembros');
        }
    });
</script>

<div class="container py-5">
    <div class="row justify-content-center align-items-center">

        <div class="col-12 col-md-10 col-lg-7 col-xl-6">

            <div class="login-card-modern">
                <div class="login-header-modern">
                    <i class="fa-solid fa-wheat-awn login-wheat-icon"></i>
                    <h4 class="login-title">Crear Cuenta</h4>
                    <p class="login-subtitle">Completa tus datos para acceder a Ministerios Corbán.</p>
                </div>

                <div class="login-body">

                    <form method="post" action="@Url.Action("Index", "Registro")">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">NOMBRE COMPLETO</label>
                            <input type="text" name="NombreCompleto"
                                   class="form-control @(ViewData["ErrorNombre"] != null ? "is-invalid" : "")"
                                   placeholder="Tu nombre completo"
                                   value="@Model?.NombreCompleto"
                                   title="@ViewData["ErrorNombre"]"
                                   required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-muted">USUARIO</label>
                                <input type="text" name="Nombre_Usuario"
                                       class="form-control @(ViewData["ErrorUser"] != null ? "is-invalid" : "")"
                                       placeholder="ejemplo: juanito55"
                                       value="@Model?.Nombre_Usuario"
                                       pattern="[a-zA-Z0-9_.]+"
                                       title="Solo letras, números, puntos y guiones bajos. Sin espacios."
                                       required />
                                <div class="form-text small text-muted">
                                    <i class="fa-solid fa-info-circle me-1"></i> Para iniciar sesión (sin espacios).
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-muted">TELÉFONO CELULAR</label>
                                <input type="tel" name="Telefono"
                                       class="form-control @(ViewData["ErrorTel"] != null ? "is-invalid" : "")"
                                       placeholder="Ej: 55 1234 5678"
                                       value="@Model?.Telefono"
                                       title="@ViewData["ErrorTel"]"
                                       required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-muted">FECHA DE NACIMIENTO</label>
                                <input type="date" name="Fecha_Nacimiento"
                                       class="form-control @(ViewData["ErrorFecha"] != null ? "is-invalid" : "")"
                                       value="@(Model?.Fecha_Nacimiento > DateTime.MinValue ? Model?.Fecha_Nacimiento.ToString("yyyy-MM-dd") : "")"
                                       max="@DateTime.Now.ToString("yyyy-MM-dd")"
                                       title="@ViewData["ErrorFecha"]"
                                       required />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-muted">GÉNERO</label>
                                <select name="Genero" class="form-select @(ViewData["ErrorGenero"] != null ? "is-invalid" : "")" required>
                                    <option value="">- Selecciona -</option>
                                    <option value="H" @(Model?.Genero == "H" ? "selected" : "")>Hombre</option>
                                    <option value="M" @(Model?.Genero == "M" ? "selected" : "")>Mujer</option>
                                </select>
                                @if (ViewData["ErrorGenero"] != null)
                                {
                                    <div class="invalid-feedback">@ViewData["ErrorGenero"]</div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">CORREO ELECTRÓNICO</label>
                            <input type="email" name="Email"
                                   class="form-control @(ViewData["ErrorEmail"] != null ? "is-invalid" : "")"
                                   placeholder="ejemplo@gmail.com"
                                   value="@Model?.Email"
                                   title="@ViewData["ErrorEmail"]"
                                   required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-muted">CONTRASEÑA</label>
                                <input type="password" name="Password"
                                       class="form-control @(ViewData["ErrorPass"] != null ? "is-invalid" : "")"
                                       placeholder="********"
                                       title="@ViewData["ErrorPass"]"
                                       required />
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label small fw-bold text-muted">CONFIRMAR CONTRASEÑA</label>
                                <input type="password" name="ConfirmPassword"
                                       class="form-control @(ViewData["ErrorConfirm"] != null ? "is-invalid" : "")"
                                       placeholder="********"
                                       title="@ViewData["ErrorConfirm"]"
                                       required />
                            </div>
                        </div>

                        @if (TempData["Error"] != null)
                        {
                            <div class="text-danger text-center small mb-3 fw-bold">
                                <i class="fa-solid fa-circle-exclamation me-1"></i> @TempData["Error"]
                            </div>
                        }

                        @if (ViewData["BloqueoRegistro"] != null && (bool)ViewData["BloqueoRegistro"] == true)
                        {
                            <div class="alert alert-warning text-center shadow-sm border-0 mb-3">
                                <i class="fa-solid fa-clock fa-2x mb-2 text-warning"></i><br>
                                <strong>¡Registros por hoy Agotados!</strong><br>
                                <span class="small">El sistema ha alcanzado su límite de seguridad diario. Las inscripciones se reabrirán mañana automáticamente.</span>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-secondary py-2" disabled>
                                    <i class="fa-solid fa-lock me-2"></i> Registro Cerrado Temporalmente
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="d-grid gap-2 mb-3">
                                <button type="submit" class="btn btn-login-action py-3">
                                    CREAR MI CUENTA <i class="fa-solid fa-user-plus ms-2"></i>
                                </button>
                            </div>
                        }

                        <div class="text-center mt-3">
                            <a href="@Url.Action("Index", "Login")" class="link-register small">
                                <i class="fa-solid fa-arrow-left me-1"></i> Volver al Login
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>