@model RedAJP.Models.GestionDevolucionesViewModel
@{
    Layout = "Principal";
    ViewData["Title"] = "Devoluciones";
    var cultura = new System.Globalization.CultureInfo("es-MX");
    
    int totalPendientes = Model.Devoluciones.Count(d => d.Estado != "Completada");
    decimal montoTotalPendiente = Model.Devoluciones.Where(d => d.Estado != "Completada").Sum(d => d.SaldoPendiente);
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-devoluciones');
        }
    });
</script>
<style>
    .fade-in { animation: fadeIn 0.3s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    
    .card-hover-fx { transition: transform 0.2s ease, box-shadow 0.2s ease; border: 1px solid rgba(0,0,0,0.05); }
    .card-hover-fx:hover { transform: translateY(-2px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.08)!important; border-color: rgba(0,0,0,0.1); }
    
    .input-excedido { border-color: #dc3545 !important; box-shadow: 0 0 0 0.25rem rgba(220,53,69,.25) !important; }
    .historial-item { border-left: 3px solid #0d6efd; background-color: #f8f9fa; }
</style>

<div class="container-fluid py-4 fade-in" style="max-width: 1200px;">
    
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(Model.IdEventoEncriptado))
                    {
                        <a href="@Url.Action("PanelControl", "Eventos", new { sid = Model.IdEventoEncriptado })" 
                           class="btn btn-sm btn-light border rounded-circle shadow-sm text-secondary card-hover-fx" 
                           style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;"
                           title="Volver al Panel del Evento">
                            <i class="fa-solid fa-arrow-left"></i>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Eventos")" 
                           class="btn btn-sm btn-light border rounded-circle shadow-sm text-secondary card-hover-fx" 
                           style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;"
                           title="Volver al Catálogo de Eventos">
                            <i class="fa-solid fa-arrow-left"></i>
                        </a>
                    }
                    <div class="lh-1 ms-1">
                        <h4 class="fw-bold text-dark mb-1">Devoluciones</h4>
                        <small class="text-muted" style="font-size: 0.85rem;">
                            @(string.IsNullOrEmpty(Model.IdEventoEncriptado) ? "Reembolsos globales del sistema" : "Reembolsos de este evento")
                        </small>
                    </div>
                </div>
            </div>
            
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <div class="bg-warning-subtle border border-warning-subtle rounded-3 p-3 h-100 d-flex justify-content-between align-items-center shadow-sm">
                        <span class="text-warning-emphasis fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Pendiente Total</span>
                        <h4 class="fw-bold text-warning-emphasis mb-0 lh-1">@montoTotalPendiente.ToString("C0", cultura)</h4>
                    </div>
                </div>
                
                <div class="col-7 col-lg-5">
                    <label class="form-label small fw-bold text-secondary mb-1"><i class="fa-solid fa-magnifying-glass me-1"></i> Buscar Persona:</label>
                    <div class="input-group rounded-pill border-primary-subtle border shadow-sm bg-white overflow-hidden">
                        <input type="search" id="buscadorDevoluciones" class="form-control border-0 shadow-none bg-transparent ps-3" placeholder="Escribe un nombre..." onkeyup="filtrarDevoluciones()">
                    </div>
                </div>
                
                <div class="col-5 col-lg-3">
                    <label class="form-label small fw-bold text-secondary mb-1"><i class="fa-solid fa-filter me-1"></i> Estatus:</label>
                    <select class="form-select rounded-pill border-primary-subtle shadow-sm text-secondary fw-bold" id="filtroEstatus" onchange="filtrarDevoluciones()">
                        <option value="all">Todas (@Model.Devoluciones.Count)</option>
                        <option value="estatus-pendiente">Pendientes (@totalPendientes)</option>
                        <option value="estatus-completada">Pagadas</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden d-none d-lg-block">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-4" style="width: 25%;">Asistente / Evento</th>
                            <th style="width: 25%;">Motivo / Ref</th>
                            <th class="text-center" style="width: 15%;">Total a Devolver</th>
                            <th class="text-center" style="width: 15%;">Saldo Pendiente</th>
                            <th class="text-center" style="width: 10%;">Estatus</th>
                            <th class="pe-4 text-end" style="width: 10%;">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Devoluciones.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-check-double fa-2x mb-2 opacity-25"></i>
                                    <h6>No hay devoluciones registradas</h6>
                                </td>
                            </tr>
                        }

                        @foreach (var dev in Model.Devoluciones)
                        {
                            bool completada = dev.Estado == "Completada";
                            bool tieneAbonos = dev.MontoTotal > dev.SaldoPendiente; // Si el saldo es menor al total, es porque ya se abonó algo
                            string colorTema = completada ? "success" : (tieneAbonos ? "info" : "warning");
                            string filterClass = completada ? "estatus-completada" : "estatus-pendiente";

                            <tr class="item-devolucion @filterClass">
                                <td class="ps-4">
                                    <div class="fw-bold text-dark nombre-persona">@dev.NombrePersona</div>
                                    <small class="text-primary fw-bold" style="font-size: 0.75rem;"><i class="fa-solid fa-calendar-star me-1"></i>@dev.Evento</small>
                                </td>
                                <td>
                                    <div class="small text-dark">@dev.Motivo</div>
                                    <small class="text-muted" style="font-size: 0.7rem;">Ref: #@dev.IdDevolucion</small>
                                </td>
                                <td class="text-center fw-bold text-secondary">
                                    @dev.MontoTotal.ToString("C2", cultura)
                                </td>
                                <td class="text-center fw-bold text-@colorTema-emphasis fs-6">
                                    @dev.SaldoPendiente.ToString("C2", cultura)
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-@colorTema-subtle text-@colorTema rounded-pill px-3">@dev.Estado</span>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-flex justify-content-end align-items-center gap-2">
                                        @if (tieneAbonos)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-info rounded-pill fw-bold shadow-sm" title="Ver Historial" 
                                                    onclick="abrirModalHistorial(@dev.IdDevolucion, '@dev.NombrePersona')">
                                                <i class="fa-solid fa-clock-rotate-left"></i>
                                            </button>
                                        }

                                        @if (!completada)
                                        {
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill fw-bold shadow-sm px-3" 
                                                    onclick="abrirModalDevolucion(@dev.IdDevolucion, '@dev.NombrePersona', '@dev.SaldoPendiente.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)')">
                                                Pagar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex flex-column gap-3 d-lg-none" id="contenedorTarjetas">
        @if (!Model.Devoluciones.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white">
                <div class="card-body">
                    <i class="fa-solid fa-check-double fa-3x text-success opacity-25 mb-3"></i>
                    <h5 class="fw-bold text-dark">Todo al corriente</h5>
                    <p class="text-muted small mb-0">No se encontraron reembolsos generados.</p>
                </div>
            </div>
        }

        @foreach (var dev in Model.Devoluciones)
        {
            bool completada = dev.Estado == "Completada";
            bool tieneAbonos = dev.MontoTotal > dev.SaldoPendiente;
            string colorTema = completada ? "success" : (tieneAbonos ? "info" : "warning");
            string filterClass = completada ? "estatus-completada" : "estatus-pendiente";

            <div class="card shadow-sm rounded-4 card-hover-fx item-devolucion @filterClass">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="pe-2">
                            <h6 class="fw-bold text-dark mb-0 nombre-persona lh-1">@dev.NombrePersona</h6>
                            <small class="text-primary d-block mt-1 fw-bold" style="font-size: 0.7rem;"><i class="fa-solid fa-calendar-star me-1"></i>@dev.Evento</small>
                            <small class="text-muted" style="font-size: 0.7rem;">Ref: #@dev.IdDevolucion • @dev.Motivo</small>
                        </div>
                        <span class="badge bg-@colorTema-subtle text-@colorTema rounded-pill mt-1 border border-@colorTema-subtle">@dev.Estado</span>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-end mt-3 pt-2 border-top border-light-subtle">
                        <div>
                            <small class="text-muted fw-bold d-block text-uppercase mb-1" style="font-size:0.65rem;">Saldo Pendiente</small>
                            <h5 class="fw-bold text-@colorTema-emphasis mb-0 lh-1">@dev.SaldoPendiente.ToString("C2", cultura)</h5>
                            @if(tieneAbonos && !completada)
                            {
                                <small class="text-muted" style="font-size:0.65rem;">(De un total de @dev.MontoTotal.ToString("C2", cultura))</small>
                            }
                        </div>
                        
                        <div class="d-flex gap-2">
                            @if (tieneAbonos)
                            {
                                <button type="button" class="btn btn-sm btn-outline-info rounded-circle fw-bold shadow-sm" style="width: 32px; height: 32px;"
                                        onclick="abrirModalHistorial(@dev.IdDevolucion, '@dev.NombrePersona')">
                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                </button>
                            }

                            @if (!completada)
                            {
                                <button type="button" class="btn btn-sm btn-primary rounded-pill fw-bold shadow-sm px-3" 
                                        onclick="abrirModalDevolucion(@dev.IdDevolucion, '@dev.NombrePersona', '@dev.SaldoPendiente.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)')">
                                    Pagar
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="modalDevolucion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow-lg border-0">
            <div class="modal-header bg-light border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4 pt-2">
                <div class="text-center mb-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-2">
                        <i class="fa-solid fa-money-check-dollar fa-2x text-primary"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Abonar / Liquidar</h5>
                    <p class="text-muted small">Registra un pago parcial o total en la bitácora.</p>
                </div>

                <form action="@Url.Action("ProcesarDevolucion", "Devoluciones")" method="post" id="formDevolucion">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sid" value="@Model.IdEventoEncriptado" />
                    <input type="hidden" name="idDevolucion" id="dev_idDevolucion" />
                    
                    <div class="card border-primary-subtle bg-primary-subtle bg-opacity-10 rounded-3 mb-4 shadow-sm">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center mb-3 pb-2 border-bottom border-primary-subtle d-flex justify-content-between">
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-user-circle fa-2x text-primary me-2 opacity-75"></i>
                                    <div class="lh-1">
                                        <small class="text-uppercase fw-bold text-primary opacity-75" style="font-size: 0.6rem; letter-spacing: 0.5px;">Beneficiario</small>
                                        <div class="fw-bold text-dark mt-1" id="dev_nombrePersona"></div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-danger-subtle text-danger rounded-pill" id="badgeSaldoMaximo"></span>
                                </div>
                            </div>
                            
                            <label class="form-label small fw-bold text-dark mb-1">Monto a Entregar:</label>
                            <div class="input-group shadow-sm mb-1">
                                <span class="input-group-text bg-white border-primary-subtle fw-bold text-secondary">$</span>
                                <input type="number" step="0.01" min="0.01" class="form-control border-primary-subtle fs-5 fw-bold text-primary text-end pe-3" 
                                       name="montoAplicar" id="dev_monto" required oninput="validarMonto()" autocomplete="off" />
                                <button class="btn btn-outline-primary fw-bold px-3" type="button" onclick="liquidarCompleto()" title="Autocompletar saldo pendiente">MAX</button>
                            </div>
                            <small class="text-danger d-none fw-bold mt-1" id="alertaExceso" style="font-size: 0.7rem;"><i class="fa-solid fa-triangle-exclamation me-1"></i>El monto supera el saldo pendiente.</small>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-dark mb-1">Folio / Referencia de Pago (Obligatorio):</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white border-secondary-subtle"><i class="fa-solid fa-hashtag text-muted"></i></span>
                            <input type="text" class="form-control border-secondary-subtle" name="referenciaPago" id="dev_referencia" 
                                   placeholder="Ej. SPEI #4512 o Efectivo" maxlength="100" required autocomplete="off" />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" id="btnSubmitDevolucion" class="btn btn-primary py-2 fw-bold rounded-pill shadow-sm" onclick="this.disabled=true; this.form.submit();">
                            <i class="fa-solid fa-check-circle me-2"></i>Registrar Pago
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalHistorial" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 shadow-lg border-0">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-clock-rotate-left text-info me-2"></i>Historial de Abonos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4 bg-white">
                <div class="d-flex align-items-center mb-3">
                    <i class="fa-solid fa-user-circle fa-2x text-secondary me-2"></i>
                    <h6 class="mb-0 fw-bold text-dark" id="hist_nombrePersona"></h6>
                </div>
                
                <div id="loaderHistorial" class="text-center py-4 d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="text-muted small mt-2">Cargando pagos...</p>
                </div>

                <div id="listaHistorial" class="d-flex flex-column gap-2">
                    </div>
            </div>
        </div>
    </div>
</div>

<script>
    let saldoMaximoActual = 0;

    // Filtrado dinámico unificado
    function filtrarDevoluciones() {
        const estatusFiltro = document.getElementById('filtroEstatus').value;
        const textoBuscador = document.getElementById('buscadorDevoluciones').value.toLowerCase().trim();
        
        const items = document.querySelectorAll('.item-devolucion');
        
        items.forEach(item => {
            const nombrePersona = item.querySelector('.nombre-persona').innerText.toLowerCase();
            const cumpleTexto = textoBuscador === "" || nombrePersona.includes(textoBuscador);
            const cumpleEstatus = estatusFiltro === "all" || item.classList.contains(estatusFiltro);
            
            if (cumpleTexto && cumpleEstatus) {
                item.style.display = ''; 
            } else {
                item.style.display = 'none';
            }
        });
    }

    function abrirModalDevolucion(id, nombre, saldoPendienteStr) {
        saldoMaximoActual = parseFloat(saldoPendienteStr);
        
        document.getElementById('dev_idDevolucion').value = id;
        document.getElementById('dev_nombrePersona').innerText = nombre;
        document.getElementById('dev_referencia').value = ''; 
        document.getElementById('badgeSaldoMaximo').innerText = `Resta: $${saldoMaximoActual.toFixed(2)}`;
        
        const inputMonto = document.getElementById('dev_monto');
        inputMonto.value = saldoMaximoActual.toFixed(2); 
        inputMonto.max = saldoMaximoActual;
        
        validarMonto(); 
        
        var modal = new bootstrap.Modal(document.getElementById('modalDevolucion'));
        modal.show();
    }

    function liquidarCompleto() {
        const inputMonto = document.getElementById('dev_monto');
        inputMonto.value = saldoMaximoActual.toFixed(2);
        validarMonto();
    }

    function validarMonto() {
        const input = document.getElementById('dev_monto');
        const btn = document.getElementById('btnSubmitDevolucion');
        const alertaExceso = document.getElementById('alertaExceso');
        
        let val = parseFloat(input.value);

        if (isNaN(val) || val <= 0) {
            btn.disabled = true;
            input.classList.remove('input-excedido');
            alertaExceso.classList.add('d-none');
        } else if (val > saldoMaximoActual) {
            btn.disabled = true;
            input.classList.add('input-excedido');
            alertaExceso.classList.remove('d-none');
        } else {
            btn.disabled = false;
            input.classList.remove('input-excedido');
            alertaExceso.classList.add('d-none');
        }
    }

    // NUEVO: Funcionalidad AJAX para el Historial de Pagos
    function abrirModalHistorial(idDevolucion, nombrePersona) {
        document.getElementById('hist_nombrePersona').innerText = nombrePersona;
        const contenedor = document.getElementById('listaHistorial');
        const loader = document.getElementById('loaderHistorial');
        
        contenedor.innerHTML = '';
        loader.classList.remove('d-none');
        
        var modal = new bootstrap.Modal(document.getElementById('modalHistorial'));
        modal.show();

        // Llamada AJAX al nuevo método del controlador
        fetch(`@Url.Action("ApiHistorialPagos", "Devoluciones")?idDevolucion=${idDevolucion}`)
            .then(response => response.json())
            .then(data => {
                loader.classList.add('d-none');
                if (data.exito && data.pagos.length > 0) {
                    data.pagos.forEach(p => {
                        contenedor.innerHTML += `
                            <div class="p-3 rounded-3 historial-item mb-2 shadow-sm">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h6 class="fw-bold text-dark mb-0">${p.monto}</h6>
                                    <small class="text-muted"><i class="fa-solid fa-calendar me-1"></i>${p.fecha}</small>
                                </div>
                                <div class="small text-secondary mb-1"><span class="fw-bold text-dark">Ref:</span> ${p.referencia}</div>
                                <div class="small text-muted" style="font-size: 0.7rem;"><i class="fa-solid fa-user-shield me-1"></i>Aprobado por: ${p.admin}</div>
                            </div>
                        `;
                    });
                } else {
                    contenedor.innerHTML = `<div class="alert alert-light text-center border-0 text-muted">No se pudo cargar el historial o no existen abonos.</div>`;
                }
            })
            .catch(error => {
                loader.classList.add('d-none');
                contenedor.innerHTML = `<div class="alert alert-danger small">Error de conexión.</div>`;
            });
    }
</script>