@model RedAJP.Models.GrupoFormViewModel
@{
    Layout = "Principal";
    ViewData["Title"] = "Crear Grupo";
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-grupos');
        }
    });
</script>

<div class="container py-4 fade-in">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="fw-bold mb-0 text-primary">Nuevo Grupo de Usuarios</h5>
                </div>
                <div class="card-body p-4">
                    <form action="@Url.Action("GuardarGrupo")" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase">Nombre del Grupo</label>
                            <input type="text" name="Nombre" class="form-control" placeholder="Ej. Ventas 2024" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-uppercase">Descripción</label>
                            <textarea name="Descripcion" class="form-control" rows="3" placeholder="Descripción opcional..."></textarea>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <a href="@Url.Action("Index")" class="btn btn-light">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>