@model RedAJP.Models.IglesiaWebPublicaViewModel

<style>
    .galeria-retrato-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 2.5rem;
    }

    .galeria-retrato-item {
        aspect-ratio: 3/4;
        overflow: hidden;
        margin-bottom: 0.8rem;
        background-color: var(--theme-bg);
        border-radius: 12px;
    }

        .galeria-retrato-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: filter 0.4s ease, transform 0.4s ease;
            filter: grayscale(20%);
        }

        .galeria-retrato-item:hover img {
            filter: grayscale(0%);
            transform: scale(1.03);
        }

    .galeria-retrato-caption {
        font-family: var(--theme-font-title);
        font-size: 0.95rem;
        text-align: center;
        font-style: italic;
        color: var(--theme-text-muted);
    }
</style>

<div class="container py-5 fade-in-up">
    <div class="text-center mb-5">
        <span class="d-block mb-2" style="font-family: var(--theme-font-title); text-transform: uppercase; letter-spacing: 2px; color: var(--theme-accent); font-weight: 700;">Fotografía</span>
        <h2 style="font-family: var(--theme-font-title); font-style: italic; color: var(--theme-primary); font-size: 2.5rem;">Galería</h2>
    </div>

    @if (Model.Galeria != null && Model.Galeria.Any())
    {
        <div class="galeria-retrato-grid">
            @foreach (var img in Model.Galeria)
            {
                if (!string.IsNullOrWhiteSpace(img.UrlImagen))
                {
                    <div>
                        <div class="galeria-retrato-item shadow-sm">
                            <img src="@img.UrlImagen" alt="@(img.Titulo ?? "Fotografía")" loading="lazy">
                        </div>
                        @if (!string.IsNullOrWhiteSpace(img.Titulo))
                        {
                            <p class="galeria-retrato-caption">@img.Titulo</p>
                        }
                    </div>
                }
            }
        </div>
    }
</div>