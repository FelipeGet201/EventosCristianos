@{
    Layout = "Principal";
    ViewData["Title"] = "Enlace Enviado";
    string token = ViewBag.Token;
    string email = ViewBag.Email;
}
<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-rifas');
        }
    });
</script>

<div class="container py-5 fade-in">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">

            <div class="card border-0 shadow-lg rounded-4 p-5">
                <div class="mb-4 text-primary">
                    <i class="fa-solid fa-paper-plane fa-5x"></i>
                </div>

                <h2 class="fw-bold text-dark mb-3">¡Enlace Enviado!</h2>

                <p class="text-muted mb-4">
                    Para tu seguridad, hemos enviado el enlace de acceso a tu pedido a:
                    <br><strong class="text-dark">@email</strong>
                </p>

                <div class="alert alert-info border-0 bg-info bg-opacity-10 small text-start">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    <strong>Importante:</strong> Si cierras esta ventana sin pagar, podrás retomar tu compra desde ese correo. El enlace expira en 24 horas.
                </div>

                <div class="d-grid gap-3 mt-4">
                    <a href="@Url.Action("TuPedido", new { token = token })" class="btn btn-dark rounded-pill py-3 fw-bold shadow">
                        Continuar al Pago <i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>

                    <a href="@Url.Action("Index")" class="btn btn-link text-muted text-decoration-none">
                        Volver al Inicio
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>