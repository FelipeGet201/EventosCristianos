                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sId" value="@Model.sIdIglesia" />
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Sí, Descartar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalPublicarEditor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-success text-white border-0 py-3">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-cloud-arrow-up me-2"></i> Publicar Cambios</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <p class="fs-5 mb-0">¿Estás seguro de que deseas publicar esto en vivo?</p>
                <small class="text-muted d-block mt-2">Cualquier persona que visite el sitio web verá estos cambios inmediatamente.</small>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">Seguir Editando</button>
