    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>

    <script>

        // A. Función para el Menú (UI)
        function activarMenu(idMenu, idSubMenu = null) {
            const menu = document.getElementById(idMenu);
            if (menu) {
                menu.classList.add('active');
                if(idMenu === 'menu-gestion') menu.classList.add('text-warning');
            }
            if (idSubMenu) {
                const subMenu = document.getElementById(idSubMenu);
                if (subMenu) subMenu.classList.add('active');
            }
        }

        // B. Función para mostrar Notificaciones con SweetAlert2
        function mostrarMensaje(titulo, mensaje, tipo = 'info', onConfirm = null) {
            let swalIcon = 'info';
            if (tipo === 'exito' || tipo === 'success') swalIcon = 'success';
            else if (tipo === 'error' || tipo === 'danger') swalIcon = 'error';
            else if (tipo === 'alerta' || tipo === 'warning') swalIcon = 'warning';

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: titulo || 'Notificación',
                    html: mensaje,
                    icon: swalIcon,
                    confirmButtonText: 'Entendido',
                    customClass: {
                        popup: 'swal2-popup',
                        title: 'swal2-title',
                        htmlContainer: 'swal2-html-container',
                        confirmButton: 'btn-swal-confirm',
                        cancelButton: 'btn-swal-cancel'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed && typeof onConfirm === 'function') {
                        onConfirm();
                    }
                });
            } else {
                alert((titulo ? titulo + '\n' : '') + (mensaje ? mensaje.replace(/<[^>]*>?/gm, '') : ''));
            }
        }

        // C. Auto-detectar mensajes del Backend (TempData) al cargar
        $(document).ready(function() {
            // 1. Leemos los mensajes usando Html.Raw y Json.Serialize para respetar ñ, tildes y signos
            var msgError  = @Html.Raw(Json.Serialize(TempData["Error"]));
            var msgExito  = @Html.Raw(Json.Serialize(TempData["Exito"]));
            var msgAlerta = @Html.Raw(Json.Serialize(TempData["Alerta"]));

            // 2. Leemos el TÍTULO personalizado
            var tituloPersonalizado = @Html.Raw(Json.Serialize(TempData["Titulo"]));

            // 3. Lógica con Títulos dinámicos
            if (msgError) {
                mostrarMensaje(tituloPersonalizado || '¡Algo salió mal!', msgError, 'error');
            }
            else if (msgExito) {
                mostrarMensaje(tituloPersonalizado || '¡Excelente!', msgExito, 'exito');
            }
            else if (msgAlerta) {
                mostrarMensaje(tituloPersonalizado || 'Importante', msgAlerta, 'alerta');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // 1. Buscar todos los inputs de tipo password en la página
            const passwordInputs = document.querySelectorAll('input[type="password"]');

            passwordInputs.forEach(input => {
                // Evitar duplicados si ya se procesó (por si usaste ajax)
                if (input.getAttribute('data-ojo-activo') === 'true') return;

                // 2. Preparar el contenedor padre
                const parent = input.parentElement;
                parent.classList.add('contenedor-ojo-relativo');

                // 3. Agregar padding al input para que el texto no toque el ojo
                input.classList.add('input-con-ojo-padding');
                input.setAttribute('data-ojo-activo', 'true'); // Marcar como procesado

                // 4. Crear el botón del ojo dinámicamente
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'ojo-global-btn';
                btn.innerHTML = '<i class="fa-solid fa-eye"></i>';

                // 5. Lógica del click
                btn.addEventListener('click', function() {
                    const icono = btn.querySelector('i');
                    if (input.type === "password") {
                        input.type = "text";
                        icono.classList.remove("fa-eye");
                        icono.classList.add("fa-eye-slash");
                    } else {
                        input.type = "password";
                        icono.classList.remove("fa-eye-slash");
                        icono.classList.add("fa-eye");
                    }
                });

                // 6. Insertar el botón en el contenedor
                parent.appendChild(btn);
            });
        });
    </script>

    @if (User.Identity.IsAuthenticated && ViewBag.RequiereVinculacion == true)
