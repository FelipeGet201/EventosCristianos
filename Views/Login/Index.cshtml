@{
    Layout = "Principal";
    ViewData["Title"] = "Entrar";
    string usuarioPrevio = ViewBag.UsuarioIntentado as string;
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-miembros');
        }
    });
</script>

<div class="container d-flex justify-content-center align-items-center py-5" style="min-height: 80vh;">
    <div class="col-12 col-sm-9 col-md-7 col-lg-5 col-xl-4">

        <div class="login-card-modern">

            <div class="login-header-modern">
                <i class="fa-solid fa-wheat-awn login-wheat-icon"></i>
                <h2 class="login-title">¡Bienvenido!</h2>
                <p class="login-subtitle">Ingresa tus datos para continuar.</p>
            </div>

            <div class="login-body">
                <form method="post" action="@Url.Action("Index", "Login")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="floatingUser" placeholder="Usuario / Correo" name="user" value="@usuarioPrevio" required>
                        <label for="floatingUser">
                            <i class="fa-solid fa-user me-2"></i>Usuario / Correo
                        </label>
                    </div>

                    <div class="form-floating mb-2">
                        <input type="password" class="form-control" id="floatingPass" placeholder="Contraseña" name="password" required>
                        <label for="floatingPass">
                            <i class="fa-solid fa-key me-2"></i>Contraseña
                        </label>
                    </div>

                    <div class="d-flex justify-content-end mb-4">
                        <a href="@Url.Action("Recuperar", "Login")" class="link-forgot">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-login-action">
                            INICIAR SESIÓN <i class="fa-solid fa-arrow-right-to-bracket ms-2"></i>
                        </button>
                    </div>

                    <div class="footer-register">
                        <small class="text-muted d-block mb-1">¿Aún no tienes cuenta?</small>
                        <a href="@Url.Action("Index", "Registro")" class="link-registro link-register">
                            Registrarse
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>