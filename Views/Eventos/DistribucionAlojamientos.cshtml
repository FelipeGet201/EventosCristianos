        let ids = seleccionados.map(el => parseInt(el.dataset.id)); let subtipos = seleccionados.map(el => parseInt(el.dataset.subtipo));
        ev.dataTransfer.setData("idsSeleccionados", JSON.stringify(ids)); ev.dataTransfer.setData("subtiposSeleccionados", JSON.stringify(subtipos)); ev.dataTransfer.effectAllowed = "move";
