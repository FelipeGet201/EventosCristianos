                                                onclick="copiarTexto('@Model.InfoRifa.NumeroCuenta', 'iconoCuenta')" 
                                                style="background-color: #f1f5f9; color: #2563eb; width: 28px; height: 28px; padding: 0;"
                                                onmouseover="this.style.backgroundColor='#e2e8f0'" onmouseout="this.style.backgroundColor='#f1f5f9'" title="Copiar">
                                            <i class="fa-regular fa-copy" style="font-size: 0.85rem;" id="iconoCuenta"></i>
                                        </button>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.InfoRifa.NumeroTarjeta))
                                {
                                    <div class="d-flex align-items-center bg-white border rounded-2 p-1 flex-grow-1" style="height: 36px; min-width: 190px;">
                                        <span class="text-muted fw-bold px-2 text-end" style="width: 65px; font-size: 0.75rem;">Tarjeta</span>
                                        <input type="text" class="form-control border-0 bg-transparent text-dark fw-bold px-2 shadow-none font-monospace h-100 py-0 w-100" readonly value="@Model.InfoRifa.NumeroTarjeta" style="font-size: 0.8rem;">
                                        <button type="button" class="btn border-0 rounded-1 d-flex align-items-center justify-content-center flex-shrink-0" 
                                                onclick="copiarTexto('@Model.InfoRifa.NumeroTarjeta', 'iconoTarjeta')" 
                                                style="background-color: #f1f5f9; color: #2563eb; width: 28px; height: 28px; padding: 0;"
                                                onmouseover="this.style.backgroundColor='#e2e8f0'" onmouseout="this.style.backgroundColor='#f1f5f9'" title="Copiar">
                                            <i class="fa-regular fa-copy" style="font-size: 0.85rem;" id="iconoTarjeta"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark text-uppercase">Monto Transferido ($)</label>
                    <input type="number" name="MontoPago" id="rp_Monto" class="form-control form-control-lg border-primary shadow-sm text-center fw-bold" step="0.01" min="1" required />
                    <div class="text-end small text-muted mt-1">Saldo pendiente / Sugerido: $<strong id="rp_SaldoSugerido">0.00</strong></div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark text-uppercase">Foto del Comprobante</label>
                    <input type="file" name="comprobanteArchivo" class="form-control bg-white shadow-sm" accept="image/*" required />
                </div>
            </div>

            <div class="modal-footer border-0 bg-white p-4">
                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm">
                    <i class="fa-solid fa-paper-plane me-2"></i> Enviar a Revisión
                </button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalConfirmarEliminar" tabindex="-1" aria-hidden="true">
