        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script>
        const fueVentaExitosa = @(ventaExitosa ? "true" : "false");
        const idRifaGlobal = '@Model.InfoRifa.IdRifaEncriptado';
        const costoPorBoleto = @Model.InfoRifa.CostoBoleto.ToString(System.Globalization.CultureInfo.InvariantCulture);

        let boletosSeleccionados = [];
        let modalReportePagoJS = null;
        let modalConfirmarEliminarJS = null;
        let modalEditarBoletoJS = null;
        let modalConfirmarLiberacionJS = null;
        let formAEliminar = null;

        document.addEventListener("DOMContentLoaded", function() {
        modalReportePagoJS = new bootstrap.Modal(document.getElementById('modalReportePago'));
        modalConfirmarEliminarJS = new bootstrap.Modal(document.getElementById('modalConfirmarEliminar'));
        modalEditarBoletoJS = new bootstrap.Modal(document.getElementById('modalEditarBoleto'));
        modalConfirmarLiberacionJS = new bootstrap.Modal(document.getElementById('modalConfirmarLiberacion'));

        if (fueVentaExitosa) {
        const llavesABorrar = [];
        for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && key.startsWith(`draft_${idRifaGlobal}_`)) {
        llavesABorrar.push(key);
        }
        }
        llavesABorrar.forEach(key => { localStorage.removeItem(key); });
        }
        });

        function copiarTexto(texto, idIcono) {
        navigator.clipboard.writeText(texto).then(() => {
        const icono = document.getElementById(idIcono);
        icono.className = 'fa-solid fa-check text-success';
        setTimeout(() => { icono.className = 'fa-regular fa-copy'; }, 2000);
        });
        }

        function manejarClickBoleto(elemento) {
        let disponible = elemento.getAttribute('data-disponible') === 'true';
        let idBoleto = parseInt(elemento.getAttribute('data-id'));
        let numeroStr = elemento.getAttribute('data-numero');

        if (disponible) {
        let index = boletosSeleccionados.findIndex(b => b.id === idBoleto);
        if (index > -1) {
        boletosSeleccionados.splice(index, 1);
        elemento.classList.remove('pos-boleto-seleccionado');
        } else {
        boletosSeleccionados.push({ id: idBoleto, numero: numeroStr });
        elemento.classList.add('pos-boleto-seleccionado');
        }
        let cant = boletosSeleccionados.length;
        document.querySelectorAll('.btn-vender-varios').forEach(btn => btn.disabled = cant === 0);
        document.querySelectorAll('.contador-seleccion').forEach(el => el.innerText = cant);
        } else {
        abrirModalEditarBoleto(elemento);
        }
        }

        function abrirModalEditarBoleto(elemento) {
        let numBoleto = elemento.getAttribute('data-numero');
        let nombreBoleto = elemento.getAttribute('data-nombre') || '';
        let enPago = elemento.getAttribute('data-en-pago') === 'true';

        document.getElementById('edit_IdBoleto').value = elemento.getAttribute('data-id');
        document.getElementById('inputLiberacionId').value = elemento.getAttribute('data-id');
        document.getElementById('edit_NumBoleto').innerText = '#' + numBoleto;
        document.getElementById('edit_Nombre').value = nombreBoleto;
        document.getElementById('edit_Telefono').value = elemento.getAttribute('data-telefono') || '';
        document.getElementById('edit_Comentarios').value = elemento.getAttribute('data-comentarios') || '';
        let bloqueLiberar = document.getElementById('bloqueLiberarBoleto');
        let msjEnPago = document.getElementById('msjBoletoEnPago');

        if(elemento.classList.contains("pos-boleto-pagado") || enPago) {
        bloqueLiberar.style.display = 'none';
        msjEnPago.style.display = enPago ? 'block' : 'none';
        } else {
        bloqueLiberar.style.display = 'block';
        msjEnPago.style.display = 'none';
        }

        document.getElementById('edit_MarcadorPersonal').checked = elemento.getAttribute('data-marcador') === 'true';
        document.getElementById('boletoDigitalNum').innerText = '#' + numBoleto;
        document.getElementById('boletoDigitalNombre').innerText = nombreBoleto;
        modalEditarBoletoJS.show();
        }

        function descargarBoletoDigital() {
        let elementoOculto = document.getElementById('contenedorBoletoOculto');
        html2canvas(elementoOculto, { scale: 2, useCORS: true, backgroundColor: "#ffffff" }).then(canvas => {
        let enlace = document.createElement('a');
        enlace.download = `Boleto_#${document.getElementById('boletoDigitalNum').innerText.replace('#','')}.png`;
        enlace.href = canvas.toDataURL("image/png");
        enlace.click();
        }).catch(err => {
        mostrarMensaje('Error', 'Error al intentar generar la imagen del boleto.', 'error');
        });
        }

        function filtrarBoletos() {
        let input = document.getElementById("inputBuscarBoleto").value;
        let busquedaEntero = input !== "" ? parseInt(input, 10) : "";
        document.querySelectorAll(".item-boleto").forEach(b => {
        let numBoleto = parseInt(b.getAttribute("data-numero"), 10);
        if (input === "" || numBoleto === busquedaEntero) {
        b.style.setProperty("display", "block", "important");
        } else {
        b.style.setProperty("display", "none", "important");
        }
        });
        }

        function abrirModalVentaMasiva() {
        const container = document.getElementById('contenedorTarjetasVenta');
        const template = document.getElementById('tplTarjetaVenta');
        container.innerHTML = '';
        boletosSeleccionados.sort((a,b) => parseInt(a.numero) - parseInt(b.numero));
        boletosSeleccionados.forEach((boleto, i) => {
        const clone = template.content.cloneNode(true);
        clone.querySelector('.tpl-numero').textContent = '#' + boleto.numero;
        clone.querySelector('.tpl-input-id').value = boleto.id;
        clone.querySelector('.tpl-input-id').name = `IdsBoletos[${i}]`;

        const inputNombre = clone.querySelector('.tpl-input-nombre');
        inputNombre.name = `NombresCompradores[${i}]`;
        const inputTel = clone.querySelector('.tpl-input-tel');
        inputTel.name = `TelefonosCompradores[${i}]`;
        const inputComent = clone.querySelector('.tpl-input-coment');
        inputComent.name = `Comentarios[${i}]`;
        const hiddenMarcador = clone.querySelector('.tpl-hidden-marcador');
        hiddenMarcador.name = `MarcadoresPersonales[${i}]`;
        const chkMarcador = clone.querySelector('.tpl-chk-marcador');

        chkMarcador.addEventListener('change', (e) => {
        hiddenMarcador.value = e.target.checked ? 'true' : 'false';
        saveDraft();
        });

        const storageKey = `draft_${idRifaGlobal}_${boleto.id}`;
        const savedDataStr = localStorage.getItem(storageKey);
        if (savedDataStr) {
        try {
        const savedData = JSON.parse(savedDataStr);
        if (savedData.nombre) inputNombre.value = savedData.nombre;
        if (savedData.telefono) inputTel.value = savedData.telefono;
        if (savedData.comentarios) inputComent.value = savedData.comentarios;
        if (savedData.marcador) { chkMarcador.checked = true; hiddenMarcador.value = 'true'; }
        } catch(e){}
        }

        const saveDraft = () => {
        localStorage.setItem(storageKey, JSON.stringify({ nombre: inputNombre.value, telefono: inputTel.value, comentarios: inputComent.value, marcador: chkMarcador.checked }));
        };

        inputNombre.addEventListener('blur', saveDraft);
        inputTel.addEventListener('blur', saveDraft);
        inputComent.addEventListener('blur', saveDraft);
        container.appendChild(clone);
        });

        new bootstrap.Modal(document.getElementById('modalVenta')).show();
        }

        function abrirModalReportePago(idUsuario, nombreExterno, boletosPagados = null, idPagoPrevio = null) {
        document.getElementById('rp_IdUsuario').value = idUsuario || '';
        document.getElementById('rp_NombreExterno').value = nombreExterno || '';
        document.getElementById('rp_IdPagoPrevio').value = idPagoPrevio || '';

        const listaBoletos = document.getElementById('rp_listaBoletos');
        listaBoletos.innerHTML = '<div class="text-center py-3"><i class="fa-solid fa-spinner fa-spin text-primary fa-2x"></i><p class="text-muted small mt-2">Cargando boletos disponibles...</p></div>';

        modalReportePagoJS.show();
        let arrayBoletosPrevios = boletosPagados ? boletosPagados.split(',') : [];

        const paramIdUsuario = idUsuario ? idUsuario : '';
        const paramNombreExt = nombreExterno ? encodeURIComponent(nombreExterno) : '';
        const paramIdPagoPrevio = idPagoPrevio ? idPagoPrevio : '';

        const url = `/Rifas/ObtenerBoletosParaPago?idRifa=${idRifaGlobal}&idUsuarioVendedor=${paramIdUsuario}&nombreExterno=${paramNombreExt}&idPagoPrevio=${paramIdPagoPrevio}`;
        fetch(url)
        .then(res => res.json())
        .then(data => {
        listaBoletos.innerHTML = '';
        if(data.exito === false) {
        listaBoletos.innerHTML = `<div class="text-danger small"><i class="fa-solid fa-triangle-exclamation"></i> ${data.mensaje}</div>`;
        return;
        }

        if(data.boletos.length === 0) {
        listaBoletos.innerHTML = '<div class="text-muted small">No hay boletos con deuda pendientes de pago.</div>';
        } else {
        data.boletos.forEach(b => {
        let isChecked = arrayBoletosPrevios.length === 0 || arrayBoletosPrevios.includes(b.id.toString());
        const div = document.createElement('div');
        div.className = 'form-check mb-2 p-2 border rounded bg-light d-flex align-items-center gap-2';
        div.innerHTML = `
        <input class="form-check-input chk-pago-boleto shadow-sm m-0" type="checkbox" name="idsBoletosAPagar" value="${b.id}" id="chk_pago_${b.id}" ${isChecked ? 'checked' : ''} onchange="recalcularTotalPago()">
        <label class="form-check-label text-dark fw-medium flex-grow-1" for="chk_pago_${b.id}" style="cursor: pointer;">
        <strong class="text-primary">#${b.numero.toString().padStart(3, '0')}</strong> - ${b.comprador}
        </label>`;
        listaBoletos.appendChild(div);
        });
        }
        recalcularTotalPago();
        })
        .catch(err => {
        listaBoletos.innerHTML = '<div class="text-danger small">Error de conexión al cargar los boletos.</div>';
        });
        }

        function recalcularTotalPago() {
        const checkboxes = document.querySelectorAll('.chk-pago-boleto:checked');
        const total = checkboxes.length * costoPorBoleto;
        document.getElementById('rp_Monto').value = total.toFixed(2);
        }

        function validarEnvioPago() {
        const checkboxes = document.querySelectorAll('.chk-pago-boleto:checked');
        if(checkboxes.length === 0 && document.querySelectorAll('.chk-pago-boleto').length > 0) {
        document.getElementById('rp_errorSeleccion').classList.remove('d-none');
        return false;
        }
        document.getElementById('rp_errorSeleccion').classList.add('d-none');
        return true;
        }

        function abrirModalConfirmacionEliminar(formId) {
        formAEliminar = document.getElementById(formId);
        modalConfirmarEliminarJS.show();
        }

        function confirmarEliminar() {
        if(formAEliminar) formAEliminar.submit();
        }

        function abrirModalLiberacion() {
        modalEditarBoletoJS.hide();
        modalConfirmarLiberacionJS.show();
        }
    </script>
}