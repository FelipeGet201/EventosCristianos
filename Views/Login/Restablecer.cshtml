@{
    Layout = "Principal";
    ViewData["Title"] = "Restablecer Contraseña";
}

<script>
    window.addEventListener('load', function() {
        if(typeof activarMenu === 'function') {
            activarMenu('menu-miembros');
        }
    });
</script>

<div class="row justify-content-center align-items-center py-5" style="min-height: 80vh;">
    <div class="col-11 col-sm-8 col-md-6 col-lg-5 col-xl-4">

        <div class="login-card-modern">
            <div class="login-header-modern">
                <i class="fa-solid fa-wheat-awn login-wheat-icon"></i>
                <h4 class="login-title">Nueva Contraseña</h4>
                <p class="login-subtitle">Crea una clave segura para tu cuenta.</p>
            </div>

            <div class="login-body">
                <form method="post" action="@Url.Action("Restablecer", "Login")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" value="@ViewBag.Token" />

                    <div class="form-floating mb-3">
                        <input type="password" class="form-control" id="floatingNewPass" placeholder="Nueva Contraseña" name="password" required>
                        <label for="floatingNewPass"><i class="fa-solid fa-lock me-2"></i>Nueva Contraseña</label>
                    </div>

                    <div class="form-floating mb-4">
                        <input type="password" class="form-control" id="floatingConfirm" placeholder="Confirmar" name="confirmPassword" required>
                        <label for="floatingConfirm"><i class="fa-solid fa-circle-check me-2"></i>Confirmar Contraseña</label>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-login-action">
                            ACTUALIZAR CONTRASEÑA <i class="fa-solid fa-check ms-2"></i>
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>