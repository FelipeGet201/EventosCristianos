@model RedAJP.Models.TianguisPanelViewModel
@{
    Layout = "~/Views/Shared/Principal.cshtml";
    ViewData["Title"] = "Mi Panel Tianguis";
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-tienda');
        }
    });
</script>
<style>
    /* Pestañas estilo Pastilla Modernas y Responsivas */
    .nav-pills-custom {
        background-color: #ffffff;
        border-radius: 50px;
        padding: 6px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        display: inline-flex; /* <- Esto evita que se estire al 100% en PC */
        flex-wrap: nowrap;
        overflow-x: auto;
        white-space: nowrap;
        -ms-overflow-style: none;
        scrollbar-width: none;
        max-width: 100%;
    }

        .nav-pills-custom::-webkit-scrollbar {
            display: none;
        }

        .nav-pills-custom .nav-link {
            color: #6c757d !important;
            font-weight: 700;
            padding: 0.5rem 1.2rem;
            border-radius: 50px;
            font-size: 0.85rem;
            transition: all 0.3s ease;
            text-align: center;
        }

            .nav-pills-custom .nav-link:hover {
                color: var(--header-footer) !important;
                background-color: rgba(0, 43, 54, 0.05);
            }

            .nav-pills-custom .nav-link.active {
                background-color: var(--header-footer) !important;
                color: #ffffff !important;
                box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            }

    /* Tarjetas de artículos modernas */
    .item-card {
        border: none !important;
        border-radius: 16px !important;
        background-color: #ffffff;
        box-shadow: 0 6px 15px rgba(0,0,0,0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
    }

        .item-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.1);
        }

    /* Insignias de Estado más limpias */
    /* Insignias de Estado más limpias */
    .status-badge {
        font-size: 0.65rem;
        padding: 4px 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
    }

    .badge-estado-act {
        background-color: rgba(32, 201, 151, 0.15);
        color: #198754;
    }
    /* Verde - Activo/Disponible/Comprado */
    .badge-estado-res {
        background-color: rgba(255, 193, 7, 0.15);
        color: #d39e00;
    }
    /* Amarillo - Reservado */
    .badge-estado-cer {
        background-color: rgba(108, 117, 125, 0.15);
        color: #6c757d;
    }
    /* Gris - Cerrado/Agotado/Pausado */
    .badge-estado-neg {
        background-color: rgba(0, 184, 212, 0.1);
        color: var(--pez-azul);
    }
    /* Azul - Negociando */
    .badge-estado-per {
        background-color: rgba(220, 53, 69, 0.1);
        color: #dc3545;
    }
    /* Rojo - Perdido/Vendido a otro */

    /* Imagen responsiva */
    .img-container {
        width: 75px;
        height: 75px;
        border-radius: 12px;
        overflow: hidden;
        flex-shrink: 0;
        border: 2px solid #f8f9fa;
    }

    /* Reglas para Desktop */
    @@media (min-width: 768px) {
        .img-container {
            width: 100px;
            height: 100px;
        }

        .border-start-md {
            border-left: 1px solid #dee2e6 !important;
        }

        .min-w-action-block {
            min-width: 180px; /* Asegura que el precio y botón nunca se aplasten */
        }

        .nav-pills-custom .nav-link {
            font-size: 0.95rem;
            padding: 0.6rem 1.5rem;
        }
    }
</style>

<div class="fade-in py-3 py-md-4 mt-2">
    <div class="mb-3 mb-md-4">
        <a href="@Url.Action("Index", "Tianguis")" class="text-decoration-none fw-bold" style="color: var(--header-footer); font-size: 0.9rem; opacity: 0.8; transition: opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.8'">
            <i class="fa-solid fa-arrow-left me-2"></i> Volver al Mercado
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 gap-2">

        <h2 class="fw-bold mb-0 text-dark d-flex align-items-center fs-4 fs-md-3 text-truncate">
            <i class="fa-solid fa-gauge-high me-2"></i>
            <span class="d-none d-sm-inline">Mi Panel de Gestión</span>
            <span class="d-inline d-sm-none">Mi Panel</span>
        </h2>

        <a href="@Url.Action("Formulario", "Tianguis")" class="btn rounded-pill px-3 px-md-4 shadow-sm fw-bold text-nowrap flex-shrink-0" style="background-color: var(--acento-dorado); color: var(--header-footer); transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
            <i class="fa-solid fa-plus me-1"></i>
            <span class="d-none d-sm-inline">Nueva Publicación</span>
            <span class="d-inline d-sm-none">Publicar</span>
        </a>

    </div>

    <div class="mb-4 text-center text-md-start">
        <ul class="nav nav-pills-custom" id="miPanelTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#vendo" type="button" role="tab">
                    <i class="fa-solid fa-store me-1 d-none d-sm-inline"></i> Vendo <span class="badge bg-white text-dark ms-1 rounded-pill shadow-sm">@Model.MisPublicaciones.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="pill" data-bs-target="#compro" type="button" role="tab">
                    <i class="fa-solid fa-hand-holding-dollar me-1 d-none d-sm-inline"></i> Mis Ofertas <span class="badge bg-light text-dark ms-1 rounded-pill shadow-sm">@Model.MisOfertas.Count</span>
                </button>
            </li>
        </ul>
    </div>

    <div class="tab-content" id="miPanelTabContent">

        <div class="tab-pane fade show active" id="vendo" role="tabpanel">
            <div class="row g-3 g-md-4">
                @if (Model.MisPublicaciones.Count == 0)
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white">
                            <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3 mx-auto" style="width: 70px; height: 70px; background-color: rgba(0, 184, 212, 0.1); color: var(--pez-azul);">
                                <i class="fa-solid fa-box-open fa-2x"></i>
                            </div>
                            <h5 class="text-dark fw-bold mb-2">Aún no vendes nada</h5>
                            <p class="text-muted mb-4 small px-3">Anímate a publicar ese artículo que ya no necesitas.</p>
                            <a href="@Url.Action("Formulario", "Tianguis")" class="btn rounded-pill fw-bold mx-auto px-4 shadow-sm" style="background-color: var(--header-footer); color: #fff;">Crear Publicación</a>
                        </div>
                    </div>
                }

                @foreach (var pub in Model.MisPublicaciones)
                {
                    // LÓGICA CLARA DE COLORES PARA EL VENDEDOR
                    string colorBordePub = ""; string badgeClassPub = ""; string badgeTextPub = ""; string badgeIconPub = ""; bool estaGrisPub = false;

                    if (pub.Estado == "ACT") { colorBordePub = "var(--alga-verde)"; badgeClassPub = "badge-estado-act"; badgeTextPub = "ACTIVA"; badgeIconPub = "fa-circle-check"; }
                    else if (pub.Estado == "RES") { colorBordePub = "var(--acento-dorado)"; badgeClassPub = "badge-estado-res"; badgeTextPub = "RESERVADA"; badgeIconPub = "fa-lock"; }
                    else { colorBordePub = "#6c757d"; badgeClassPub = "badge-estado-cer"; badgeTextPub = "FINALIZADA"; badgeIconPub = "fa-handshake"; estaGrisPub = true; }

                    <div class="col-12">
                        <div class="item-card position-relative">
                            <div style="position: absolute; left: 0; top: 0; bottom: 0; width: 5px; background-color: @colorBordePub;"></div>

                            <div class="card-body p-3 p-md-4 ms-1 d-flex flex-column flex-md-row gap-3 gap-md-4 justify-content-between">

                                <div class="d-flex align-items-center gap-3 flex-grow-1" style="min-width: 0;">
                                    <div class="img-container shadow-sm">
                                        <img src="@pub.ImagenUrl" class="w-100 h-100" style="object-fit: cover; @(estaGrisPub ? "filter: grayscale(100%); opacity: 0.8;" : "")">
                                    </div>
                                    <div style="min-width: 0;">
                                        <div class="d-flex align-items-center mb-1 flex-wrap gap-2">
                                            <span class="badge rounded-pill status-badge @badgeClassPub"><i class="fa-solid @badgeIconPub me-1"></i> @badgeTextPub</span>
                                            <span class="text-muted small fw-bold d-none d-sm-block" style="font-size: 0.65rem;"><i class="fa-regular fa-calendar me-1"></i> @pub.FechaPublicacion.ToString("dd MMM yyyy")</span>
                                        </div>

                                        <h6 class="mb-1 fw-bold text-dark text-truncate fs-6 fs-md-5" title="@pub.Titulo">@pub.Titulo</h6>
                                        <div class="text-muted fw-bold" style="font-size: 0.75rem;">
                                            <i class="fa-solid fa-users me-1" style="color: var(--pez-azul);"></i> @pub.CantidadInteresados Interesado(s)
                                        </div>
                                    </div>
                                </div>

                                <hr class="d-md-none m-0 text-muted opacity-25">

                                <div class="d-flex flex-row flex-md-column justify-content-between align-items-center align-items-md-end border-start-md ps-md-4 min-w-action-block flex-shrink-0 gap-2 gap-md-3">
                                    <div class="text-start text-md-end">
                                        <span class="d-block text-muted fw-bold text-uppercase mb-0 mb-md-1" style="font-size: 0.6rem; letter-spacing: 0.5px;">
                                            @(pub.TipoVenta == "TIE" && pub.PrecioBase == 0 ? "DONACIÓN" : (pub.TipoVenta == "TIE" ? "PRECIO FIJO" : "PRECIO BASE"))
                                        </span>
                                        @if (pub.TipoVenta == "TIE" && pub.PrecioBase == 0)
                                        {
                                            <span class="fs-5 fs-md-4 fw-bold text-success" style="line-height: 1;">¡GRATIS!</span>
                                        }
                                        else
                                        {
                                            <span class="fs-5 fs-md-4 fw-bold" style="color: var(--header-footer); line-height: 1;">$@pub.PrecioBase.ToString("N2")</span>
                                        }
                                    </div>

                                    <div class="d-flex gap-2">
                                        <a href="@Url.Action("Detalle", "Tianguis", new { sId = pub.sIdPublicacion })" class="btn btn-sm btn-md fw-bold rounded-pill shadow-sm px-3 px-md-4" style="background-color: var(--pez-azul); color: white;">
                                            Administrar
                                        </a>
                                        @if (pub.Estado == "ACT")
                                        {
                                            <a href="@Url.Action("Formulario", "Tianguis", new { sId = pub.sIdPublicacion })" class="btn btn-sm btn-light text-dark fw-bold rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;" title="Editar">
                                                <i class="fa-solid fa-pen" style="font-size: 0.75rem;"></i>
                                            </a>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="compro" role="tabpanel">
            <div class="row g-3 g-md-4">
                @if (Model.MisOfertas.Count == 0)
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white">
                            <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3 mx-auto" style="width: 70px; height: 70px; background-color: rgba(255, 193, 7, 0.1); color: var(--acento-dorado);">
                                <i class="fa-regular fa-comments fa-2x"></i>
                            </div>
                            <h5 class="text-dark fw-bold mb-2">Aún no estás participando</h5>
                            <p class="text-muted mb-4 small px-3">Cuando ofertes o solicites un artículo, aparecerá aquí.</p>
                            <a href="@Url.Action("Index", "Tianguis")" class="btn btn-outline-dark rounded-pill fw-bold mx-auto px-4 shadow-sm">Explorar el Tianguis</a>
                        </div>
                    </div>
                }

                @foreach (var ofe in Model.MisOfertas)
                {
                    // LÓGICA CLARA DE COLORES PARA EL COMPRADOR
                    string colorBordeOfe = ""; string badgeClassOfe = ""; string badgeTextOfe = ""; string badgeIconOfe = ""; bool estaGrisOfe = false;

                    if (ofe.EstadoTrato == "COM") { colorBordeOfe = "var(--alga-verde)"; badgeClassOfe = "badge-estado-act"; badgeTextOfe = "COMPRADO"; badgeIconOfe = "fa-check-circle"; }
                    else if (ofe.EstadoTrato == "RES") { colorBordeOfe = "var(--acento-dorado)"; badgeClassOfe = "badge-estado-res"; badgeTextOfe = "APARTADO PARA TI"; badgeIconOfe = "fa-lock"; }
                    else if (ofe.EstadoPublicacion == "VEN" || ofe.EstadoPublicacion == "AGO") { colorBordeOfe = "#dc3545"; badgeClassOfe = "badge-estado-per"; badgeTextOfe = "FINALIZADO / VENDIDO A OTRO"; badgeIconOfe = "fa-circle-xmark"; estaGrisOfe = true; }
                    else if (ofe.EstadoPublicacion == "RES") { colorBordeOfe = "#6c757d"; badgeClassOfe = "badge-estado-cer"; badgeTextOfe = "APARTADO A OTRO"; badgeIconOfe = "fa-user-clock"; estaGrisOfe = true; }
                    else { colorBordeOfe = "var(--pez-azul)"; badgeClassOfe = "badge-estado-neg"; badgeTextOfe = "NEGOCIANDO"; badgeIconOfe = "fa-comments"; }

                    <div class="col-12">
                        <div class="item-card position-relative">
                            <div style="position: absolute; left: 0; top: 0; bottom: 0; width: 5px; background-color: @colorBordeOfe;"></div>

                            <div class="card-body p-3 p-md-4 ms-1 d-flex flex-column flex-md-row gap-3 gap-md-4 justify-content-between">

                                <div class="d-flex align-items-center gap-3 flex-grow-1" style="min-width: 0;">
                                    <div class="img-container shadow-sm">
                                        <img src="@ofe.ImagenUrl" class="w-100 h-100" style="object-fit: cover; @(estaGrisOfe ? "filter: grayscale(100%); opacity: 0.7;" : "")">
                                    </div>
                                    <div style="min-width: 0;">
                                        <div class="d-flex align-items-center mb-1 flex-wrap gap-2">
                                            <span class="badge rounded-pill status-badge @badgeClassOfe"><i class="fa-solid @badgeIconOfe me-1"></i> @badgeTextOfe</span>
                                        </div>

                                        <h6 class="mb-1 fw-bold text-dark text-truncate fs-6 fs-md-5" title="@ofe.Titulo">@ofe.Titulo</h6>
                                        <div class="d-flex flex-column gap-1 mb-1">
                                            <span class="text-muted fw-bold d-block" style="font-size: 0.75rem;"><i class="fa-solid fa-user-secret me-1"></i> @ofe.VendedorAlias</span>
                                            @if (ofe.TipoVenta == "TIE")
                                            {
                                                <div class="d-flex gap-2 align-items-center mt-1">
                                                    <span class="badge bg-light text-dark border" style="font-size:0.65rem;">
                                                        <i class="fa-solid fa-tag text-primary me-1"></i> Talla: @ofe.Talla
                                                    </span>
                                                    <span class="badge bg-light text-dark border" style="font-size:0.65rem;">
                                                        <i class="fa-solid fa-cubes text-primary me-1"></i> Cant: @ofe.Cantidad
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <hr class="d-md-none m-0 text-muted opacity-25">

                                <div class="d-flex flex-row flex-md-column justify-content-between align-items-center align-items-md-end border-start-md ps-md-4 min-w-action-block flex-shrink-0 gap-2 gap-md-3">
                                    <div class="text-start text-md-end">
                                        <span class="d-block text-muted fw-bold text-uppercase mb-0 mb-md-1" style="font-size: 0.6rem; letter-spacing: 0.5px;">
                                            @(ofe.TipoVenta == "TIE" && ofe.MiOferta == 0 ? "DONACIÓN" : "PRECIO ACORDADO")
                                        </span>
                                        @if (ofe.TipoVenta == "TIE" && ofe.MiOferta == 0)
                                        {
                                            <span class="fs-5 fs-md-4 fw-bold text-success" style="line-height: 1;">¡GRATIS!</span>
                                        }
                                        else
                                        {
                                            <span class="fs-5 fs-md-4 fw-bold" style="color: var(--header-footer); line-height: 1;">$@ofe.MiOferta.ToString("N2")</span>
                                        }
                                    </div>

                                    <div class="text-end">
                                        <a href="@Url.Action("Detalle", "Tianguis", new { sId = ofe.sIdPublicacion, sChatId = ofe.sIdInteresado })" class="btn btn-sm btn-md fw-bold rounded-pill shadow-sm px-3 px-md-4" style="background-color: var(--header-footer); color: white;">
                                            <i class="fa-regular fa-comments me-1"></i> Chat
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>