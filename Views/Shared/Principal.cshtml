            <template id="template-horario-vinculacion">
                <div class="card p-2 dynamic-row horario-row shadow-sm border-0 bg-light">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <select class="form-select form-select-sm horario-dia bg-white">
                                <option value="Domingo">Domingo</option>
                                <option value="Lunes">Lunes</option>
                                <option value="Martes">Martes</option>
                                <option value="Miércoles">Miércoles</option>
                                <option value="Jueves">Jueves</option>
                                <option value="Viernes">Viernes</option>
                                <option value="Sábado">Sábado</option>
                                <option value="Diario">Diario</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input type="text" class="form-control form-control-sm horario-hora bg-white" placeholder="Ej. 10:00 AM" />
                        </div>
                        <div class="col-md-4">
                            <input type="text" class="form-control form-control-sm horario-act bg-white" placeholder="Ej. Culto General" />
                        </div>
                        <div class="col-md-1 text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger w-100 p-1" onclick="eliminarHorarioVinculacion(this)">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
