@model RedAJP.Models.RifasIndexViewModel
@using RedAJP.Globales
@using RedAJP.Models

@{
    Layout = "Principal";
    ViewData["Title"] = "Gestión de Rifas";
    bool esAdmin = User.Identity.IsAuthenticated && User.TienePermiso(Parametros.Modulos.Rifas, Parametros.Permisos.Crear);
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
            activarMenu('menu-gestion');
            activarMenu('submenu-rifas');
        }
    });
</script>

<style>
    :root {
        --color-admin: #0d6efd;
        --color-dark-btn: #0f3d3e;
    }

    .card-rifa-h {
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        box-shadow: 0 8px 24px rgba(0,0,0,0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        background: #fff;
        cursor: pointer;
    }

        .card-rifa-h:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.1);
        }

    .rifa-img-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 240px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }

    .rifa-img-bg {
        position: absolute;
        top: -10%;
        left: -10%;
        right: -10%;
        bottom: -10%;
        background-size: cover;
        background-position: center;
        filter: blur(12px) brightness(0.5);
        z-index: 1;
    }

    .rifa-img-content {
        position: relative;
        z-index: 2;
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.35);
    }

    .badge-status {
        position: absolute;
        top: 15px;
        left: 15px;
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: bold;
        text-transform: capitalize;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        z-index: 10;
    }

    .bg-activa {
        background-color: #0d6efd;
        color: white;
    }

    .bg-historial {
        background-color: #6c757d;
        color: white;
    }

    .buyer-info-box {
        background-color: #f8fafc;
        border-radius: 10px;
        padding: 12px 15px;
        margin-bottom: 15px;
        border: 1px solid #e2e8f0;
    }

    .progress-slim {
        height: 8px;
        border-radius: 10px;
        background-color: #e2e8f0;
    }

    .custom-switch-ui .form-check-input {
        width: 2.5em;
        height: 1.25em;
        cursor: pointer;
    }

        .custom-switch-ui .form-check-input:checked {
            background-color: var(--color-admin);
            border-color: var(--color-admin);
        }

    .custom-switch-ui .form-check-label {
        cursor: pointer;
        user-select: none;
        padding-top: 0.15rem;
    }

    .btn-action {
        border-radius: 50rem;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 8px 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.2s;
        position: relative;
        z-index: 2;
    }

    .btn-outline-admin {
        border: 1px solid var(--color-admin);
        color: var(--color-admin);
        background: white;
    }

        .btn-outline-admin:hover {
            background-color: #f0f7ff;
        }

    .btn-solid-copy {
        background-color: #0d6efd;
        color: white;
        border: none;
    }

        .btn-solid-copy:hover {
            background-color: #0b5ed7;
            color: white;
        }

    .winner-box {
        background: linear-gradient(135deg, #fff8e1 0%, #fef3c7 100%);
        border: 1px solid #fde68a;
        border-radius: 12px;
        padding: 12px;
        text-align: center;
    }
</style>

<div class="container py-4 fade-in">

    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">

        <h3 class="fw-bold text-dark mb-0 position-relative d-inline-block" style="padding-right: 5px;">
            Rifas Disponibles
            <div style="width: 35px; height: 3px; background-color: #ffc107; position: absolute; bottom: -5px; left: 0;"></div>
        </h3>

        <div class="d-flex flex-wrap align-items-center gap-3 ms-md-auto">
            <div class="form-check form-switch custom-switch-ui mb-0 d-flex align-items-center gap-2">
                <input class="form-check-input m-0" type="checkbox" role="switch" id="chkMostrarFinalizadas" onchange="filtrarRifasPorEstado()">
                <label class="form-check-label fw-bold text-secondary small text-uppercase tracking-wider m-0" for="chkMostrarFinalizadas">Mostrar Finalizadas</label>
            </div>

            @if (esAdmin)
            {
                <a href="/Rifas/DatosRifa" class="btn btn-dark rounded-pill fw-bold shadow-sm px-4 py-2 d-flex align-items-center transition-all">
                    <i class="fa-solid fa-plus me-2 text-warning"></i> Nueva Rifa
                </a>
            }
        </div>
    </div>

    <div class="row" id="contenedorRifas">
        @if (Model.Rifas != null && Model.Rifas.Count > 0)
        {
            @foreach (var item in Model.Rifas)
            {
                bool esActiva = item.Estado == "Activa";
                string tokenRifa = item.IdRifaEncriptado;
                string urlCompra = $"/Rifas/Seleccion/{tokenRifa}";
                int boletosDisponibles = item.MetaBoletos - item.Vendidos;
                
                <div class="col-12 mb-4 item-rifa-card" data-activa="@(esActiva ? "true" : "false")" style="@(esActiva ? "" : "display: none;")">
                    <div class="card card-rifa-h" onclick="location.href='@urlCompra'">
                        <div class="row g-0 h-100">

                            <div class="col-md-4">
                                <div class="rifa-img-wrapper" style="@(!esActiva ? "opacity: 0.8; filter: grayscale(50%);" : "")">
                                    <span class="badge-status @(esActiva ? "bg-activa" : "bg-historial")">@item.Estado</span>
                                    
                                    @if (!item.VisiblePublico)
                                    {
                                        <span class="badge bg-dark text-white border border-secondary position-absolute top-0 end-0 m-3 p-2 rounded shadow" style="z-index: 10; font-size: 0.75rem;">
                                            <i class="fa-solid fa-eye-slash me-1 text-warning"></i> Oculto al Público
                                        </span>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                    {
                                        <div class="rifa-img-bg" style="background-image: url('@item.ImagenUrl');"></div>
                                        <img src="@item.ImagenUrl" alt="Rifa" class="rifa-img-content">
                                    }
                                    else
                                    {
                                        <div class="rifa-img-bg bg-dark"></div>
                                        <i class="fa-solid fa-gift fa-4x text-white opacity-50 position-relative" style="z-index: 2;"></i>
                                    }
                                </div>
                            </div>

                            <div class="col-md-8">
                                <div class="card-body p-4 d-flex flex-column h-100 justify-content-center">

                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h4 class="fw-bold text-dark mb-0">@item.Titulo</h4>
                                        <h3 class="fw-bold text-primary mb-0">$@item.CostoBoleto.ToString("0")</h3>
                                    </div>

                                    @if (esActiva)
                                    {
                                        <div class="buyer-info-box mt-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="text-secondary fw-bold small text-uppercase"><i class="fa-solid fa-ticket text-primary me-1"></i> Boletos Disponibles</span>
                                                <span class="badge bg-success rounded-pill px-2 py-1">@(boletosDisponibles > 0 ? $"{boletosDisponibles} restantes" : "Agotados")</span>
                                            </div>
                                            <div class="progress progress-slim">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @(item.Porcentaje > 100 ? 100 : item.Porcentaje)%"></div>
                                            </div>
                                            <div class="text-end mt-1">
                                                <small class="text-muted" style="font-size: 0.65rem; font-weight: 700;">@item.Porcentaje% Vendido</small>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted small fw-bold mt-2 mb-3"><i class="fa-regular fa-calendar-check me-1"></i> Finalizada el @item.FechaSorteoStr</p>
                                    }

                                    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mt-auto pt-2">

                                        <div class="flex-grow-1 text-start overflow-hidden">
                                            @if (esActiva)
                                            {
                                                <div class="countdown-container" data-fecha="@item.FechaSorteoIso">
                                                    <span class="badge bg-light text-dark border p-2 shadow-sm" style="font-size: 0.85rem;">
                                                        <i class="fa-solid fa-spin fa-spinner me-2"></i> Cargando contador...
                                                    </span>
                                                </div>
                                            }
                                            else
                                            {
                                                @if (item.NumeroGanador.HasValue)
                                                {
                                                    <div class="winner-box d-flex align-items-center gap-3 py-1.5 px-3 d-inline-flex">
                                                        <i class="fa-solid fa-trophy text-warning fs-5"></i>
                                                        <div class="text-start">
                                                            <small class="text-uppercase text-muted d-block fw-bold" style="font-size:0.6rem;">Ganador Oficial</small>
                                                            <span class="fw-bold text-dark small">#@item.NumeroGanador.Value.ToString("000") — @item.NombreGanador</span>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border p-2"><i class="fa-solid fa-info-circle me-1"></i> Sorteo Pendiente</span>
                                                }
                                            }
                                        </div>

                                        <div class="d-flex flex-wrap gap-2 flex-shrink-0 justify-content-start justify-content-lg-end">

                                            <a href="@urlCompra" class="btn btn-action btn-outline-admin" onclick="event.stopPropagation()" title="Ver Rifa">
                                                <i class="fa-solid fa-hand-pointer"></i>
                                            </a>

                                            @if (esAdmin)
                                            {
                                                <a href="@Url.Action("DatosRifa", "Rifas", new { id = item.IdRifaEncriptado })" class="btn btn-action btn-outline-admin" onclick="event.stopPropagation()" title="Editar configuración">
                                                    <i class="fa-solid fa-pen text-warning"></i> Editar
                                                </a>

                                                <a href="@Url.Action("Tablero", "Rifas", new { id = item.IdRifaEncriptado })" class="btn btn-action btn-outline-admin" onclick="event.stopPropagation()">
                                                    <i class="fa-solid fa-chart-pie text-primary"></i> Administrar
                                                </a>

                                                @if (esActiva && item.VisiblePublico)
                                                {
                                                    <button type="button" onclick="event.stopPropagation(); copiarLinkPublico(this, '@tokenRifa', '@item.Titulo')" class="btn btn-action btn-solid-copy">
                                                        <i class="fa-solid fa-link"></i> Compartir
                                                    </button>
                                                }
                                            }
                                            else if (User.Identity.IsAuthenticated && (Model.TotalComprados > 0 || Model.TotalPorVender > 0))
                                            {
                                                <a href="@Url.Action("MisBoletos", "Rifas", new { id = item.IdRifaEncriptado })" class="btn btn-action btn-outline-admin" onclick="event.stopPropagation()">
                                                    <i class="fa-solid fa-ticket-alt"></i> Mis Compras
                                                </a>
                                                @if (esActiva)
                                                {
                                                    <button type="button" onclick="event.stopPropagation(); copiarLinkPublico(this, '@tokenRifa', '@item.Titulo')" class="btn btn-action btn-solid-copy">
                                                        <i class="fa-solid fa-link"></i> Compartir
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div id="empty-state-rifas" class="text-center py-5 d-none w-100 mt-4">
                <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                    <i class="fa-solid fa-ticket fa-4x text-muted opacity-25"></i>
                </div>
                <h5 class="fw-bold text-dark">No hay rifas para mostrar con este filtro</h5>
                <p class="text-muted small">Prueba cambiando el interruptor de finalizadas.</p>
            </div>
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="bg-light border rounded-circle shadow-sm d-inline-flex p-4 mb-4" style="width: 110px; height: 110px; align-items: center; justify-content: center;">
                    <i class="fa-solid fa-ticket fa-3x text-primary opacity-50"></i>
                </div>
                <h4 class="fw-bold text-dark">Aún no hay dinámicas oficiales</h4>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="modalNotificacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4 text-center">
            <div class="modal-body p-4">
                <div class="mb-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3">
                        <i class="fa-solid fa-link fa-2x"></i>
                    </div>
                </div>
                <h5 class="fw-bold mb-2">¡Enlace Copiado!</h5>
                <p class="text-muted small mb-4" id="modalTextoCuerpo">El link se ha guardado en tu portapapeles.</p>
                <button type="button" class="btn btn-dark rounded-pill w-100 fw-bold" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCopiaManual" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 text-center">
            <div class="modal-body p-4">
                <div class="mb-3">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex p-3">
                        <i class="fa-solid fa-copy fa-2x"></i>
                    </div>
                </div>
                <h5 class="fw-bold mb-2">Copia el enlace</h5>
                <p class="text-muted small mb-3">Tu navegador requiere que copies el link manualmente:</p>
                <input type="text" id="inputCopiaManual" class="form-control text-center mb-4" readonly onclick="this.select();" />
                <button type="button" class="btn btn-dark rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
    var notifModal;
    var manualModal;

    document.addEventListener('DOMContentLoaded', function() {
        var elNotif = document.getElementById('modalNotificacion');
        if (elNotif) notifModal = new bootstrap.Modal(elNotif);
        
        var elManual = document.getElementById('modalCopiaManual');
        if (elManual) manualModal = new bootstrap.Modal(elManual);

        iniciarContadores();
        verificarEstadoInicial();
    });

    function filtrarRifasPorEstado() {
        const mostrarFinalizadas = document.getElementById('chkMostrarFinalizadas').checked;
        const tarjetas = document.querySelectorAll('.item-rifa-card');
        let visibles = 0;

        tarjetas.forEach(tarjeta => {
            const esActiva = tarjeta.getAttribute('data-activa') === 'true';
            if (esActiva) {
                tarjeta.style.display = '';
                visibles++;
            } else {
                if (mostrarFinalizadas) {
                    tarjeta.style.display = '';
                    visibles++;
                } else {
                    tarjeta.style.display = 'none';
                }
            }
        });

        const emptyState = document.getElementById('empty-state-rifas');
        if (emptyState) {
            if (visibles === 0) {
                emptyState.classList.remove('d-none');
            } else {
                emptyState.classList.add('d-none');
            }
        }
    }

    function verificarEstadoInicial() {
        const tarjetas = document.querySelectorAll('.item-rifa-card');
        let visibles = 0;
        tarjetas.forEach(t => { if(t.style.display !== 'none') visibles++; });
        
        const emptyState = document.getElementById('empty-state-rifas');
        if(emptyState && visibles === 0) {
            emptyState.classList.remove('d-none');
        }
    }

    function copiarLinkPublico(btnElement, tokenCifrado, titulo) {
        var url = window.location.origin + '/Rifas/Seleccion/' + tokenCifrado;
        navigator.clipboard.writeText(url).then(() => {
            var originalHtml = btnElement.innerHTML;
            btnElement.innerHTML = '<i class="fa-solid fa-check me-1"></i> ¡Listo!';
            document.getElementById('modalTextoCuerpo').innerText = 'El enlace para compartir la rifa "' + titulo + '" está listo.';
            if(notifModal) notifModal.show();
            setTimeout(() => { btnElement.innerHTML = originalHtml; }, 2000);
        }).catch(err => {
            document.getElementById('inputCopiaManual').value = url;
            if(manualModal) manualModal.show();
        });
    }

    function iniciarContadores() {
        const contenedores = document.querySelectorAll('.countdown-container');
        contenedores.forEach(container => {
            const fechaString = container.getAttribute('data-fecha');
            const countDownDate = new Date(fechaString).getTime();

            const x = setInterval(function() {
                const now = new Date().getTime();
                const distance = countDownDate - now;

                if (distance < 0) {
                    clearInterval(x);
                    container.innerHTML = `<span class="badge bg-success bg-opacity-10 text-success border border-success p-2 px-3 shadow-sm" style="font-size: 0.85rem;"><i class="fa-solid fa-flag-checkered me-1"></i> ¡Tiempo de Sorteo!</span>`;
                    return;
                }

                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                container.innerHTML = `<span class="badge bg-light text-dark border p-2 px-3 shadow-sm" style="font-size: 0.85rem;">
                    <i class="fa-regular fa-clock me-1 text-primary"></i>
                    Sorteo en: <strong class="ms-1">${days}d ${hours}h ${minutes}m ${seconds}s</strong>
                </span>`;
            }, 1000);
        });
    }
</script>